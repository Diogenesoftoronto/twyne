ountResponse.json() as { account?: { did?: string } };\n  // This token has now been authenticated by the issuer with its DPoP proof.\n  const encoded = body.access_token.split(\".\")[1];\n  const claims = JSON.parse(atob(encoded.replace(/-/g, \"+\").replace(/_/g, \"/\"))) as { sub?: string; product?: string; session_version?: number };\n  if (!account.account?.did || !/^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$/.test(account.account.did) || account.account.did !== claims.sub || claims.product !== \"twyne\" || !Number.isSafeInteger(claims.session_version) || claims.session_version! < 1) {\n    throw new Error(\"The verified account does not match this Twyne connection.\");\n  }\n  return { did: account.account.did, sessionVersion: claims.session_version! };\n}\n"},"/home/diogenes/Projects/twyne/convex/schema.ts":{"type":"update","unified_diff":"@@ -616,3 +616,3 @@\n     did: v.string(),\n-    verificationMethod: v.literal(\"legacy_atproto_browser_oauth\"),\n+    verificationMethod: v.union(v.literal(\"legacy_atproto_browser_oauth\"), v.literal(\"notorganic_pkce\")),\n     sessionVersion: v.number(),\n","move_path":null},"/home/diogenes/Projects/twyne/convex/providerIdentity.ts":{"type":"update","unified_diff":"@@ -1,3 +1,5 @@\n import { v } from \"convex/values\";\n-import { action, internalQuery, mutation, query } from \"./_generated/server\";\n+import { action, internalQuery, internalMutation, mutation, query } from \"./_generated/server\";\n+import { makeFunctionReference } from \"convex/server\";\n+import { redeemProviderLink } from \"./lib/providerLink\";\n import {\n@@ -23,3 +25,3 @@\n   handler: async (ctx, { productSubject }) => {\n-    return await ctx.db\n+    const link = await ctx.db\n       .query(\"providerIdentities\")\n@@ -29,2 +31,3 @@\n       .unique();\n+    return link?.verificationMethod === \"notorganic_pkce\" ? link : null;\n   },\n@@ -37,3 +40,3 @@\n     if (!identity) return null;\n-    return await ctx.db\n+    const link = await ctx.db\n       .que