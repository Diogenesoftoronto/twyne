\\\\\\":\\\\\\\"notorganic\\\\\\\",\\\\\\\"grantProgram\\\\\\\":\\\\\\\"keating_pack_50\\\\\\\"},\\\\\\\"prod_7NJAxm5EB33Dpz81qKn3IK\\\\\\\":{\\\\\\\"product\\\\\\\":\\\\\\\"stich\\\\\\\",\\\\\\\"grantProgram\\\\\\\":\\\\\\\"stich_credit_10\\\\\\\"},\\\\\\\"prod_2d0lGyx7gurUTsEibNQWT2\\\\\\\":{\\\\\\\"product\\\\\\\":\\\\\\\"stich\\\\\\\",\\\\\\\"grantProgram\\\\\\\":\\\\\\\"stich_credit_25\\\\\\\"},\\\\\\\"prod_4UcevMd3HKrPDm9IKVyxD3\\\\\\\":{\\\\\\\"product\\\\\\\":\\\\\\\"stich\\\\\\\",\\\\\\\"grantProgram\\\\\\\":\\\\\\\"stich_credit_50\\\\\\\"},\\\\\\\"prod_79EhqSWBgs6ppY9O6H4Qy4\\\\\\\":{\\\\\\\"product\\\\\\\":\\\\\\\"stich\\\\\\\",\\\\\\\"grantProgram\\\\\\\":\\\\\\\"stich_personal\\\\\\\"},\\\\\\\"prod_Mbx4qrcj9EdxNNGg6Lkcp\\\\\\\":{\\\\\\\"product\\\\\\\":\\\\\\\"stich\\\\\\\",\\\\\\\"grantProgram\\\\\\\":\\\\\\\"stich_household\\\\\\\"},\\\\\\\"prod_5xrhuvIYvm1lp0iFnBqGNN\\\\\\\":{\\\\\\\"product\\\\\\\":\\\\\\\"stich\\\\\\\",\\\\\\\"grantProgram\\\\\\\":\\\\\\\"stich_studio\\\\\\\"}}\\\",\\n  \\\"PROVIDER_ISSUER\\\": \\\"https://api.notorganic.info\\\",\\n  \\\"PUBLIC_CLIENT_PRODUCT_CATALOG\\\": \\\"{\\\\\\\"https://stich.email\\\\\\\": \\\\\\\"stich\\\\\\\", \\\\\\\"https://stich-production-4bc6.up.railway.app\\\\\\\": \\\\\\\"stich\\\\\\\", \\\\\\\"https://keating.help\\\\\\\": \\\\\\\"keating\\\\\\\"}\\\",\\n  \\\"TWYNE_ASSERTION_PUBLIC_JWK\\\": \\\"set\\\",\\n  \\\"TYPESAFE_API_KEY\\\": \\\"set\\\"\\n}\\n\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"7d6b4f\",\"wall_time_seconds\":1.677134339,\"exit_code\":0,\"original_token_count\":1179,\"output\":\"import type { JWK } from \\\"jose\\\";\\nimport { resolve } from \\\"node:path\\\";\\nimport { ADMIN_CAPS_MICROUSD, RETAIL_PRICING_VERSION } from \\\"@notorganic/core\\\";\\nimport { createGateway } from \\\"./app\\\";\\nimport { BunRealtimeRelay } from \\\"./bun-realtime\\\";\\nimport { ConvexProviderStore } from \\\"./convex-store\\\";\\nimport { ConvexAccountEvolutionStore } from \\\"./convex-account-evolution-store\\\";\\nimport {\\n  AccountEvolutionRunnerRegistry,\\n  AccountEvolutionService,\\n} from \\\"./account-evolution\\\";\\nimport { FilesystemEvolutionBlobPlane } from \\\"./filesystem-evolution-blob-plane\\\";\\nimport {\\n  EvolutionEd25519AttestationVerifier,\\n  HttpEvolutionRunner,\\n  HttpEvolutionRunnerEnvironmentConfigListSchema,\\n} from \\\"./http-evolution-runner\\\";\\nimport { OpenBaoTransit } from \\\"./openbao\\\";\\nimport { NoopTelemetry, PostHogTelemetry } from \\\"./telemetry\\\";\\nimport { parseProductId, type ModelAlias } from \\\"@notorganic/contracts\\\";\\nimport type { GatewayConfig, Product } from \\\"./types\\\";\\n\\nfunction required(name: string): string {\\n  const value = Bun.env[name]?.trim();\\n  if (!value) throw new Error(`${name} is required`);\\n  return value;\\n}\\n\\nfunction json<T>(name: string): T {\\n  try {\\n    return JSON.parse(required(name)) as T;\\n  } catch (error) {\\n    throw new Error(`${name} must contain valid JSON`, { cause: error });\\n  }\\n}\\n\\nfunction optionalJson<T>(name: string): T | undefined {\\n  const value = Bun.env[name]?.trim();\\n  if (!value) return undefined;\\n  try {\\n    return JSON.parse(value) as T;\\n  } catch (error) {\\n    throw new Error(`${name} must contain valid JSON`, { cause: error });\\n  }\\n}\\n\\nfunction optionalNonnegativeInteger(name: string): number | undefined {\\n  const value = Bun.env[name]?.trim();\\n  if (!value) return undefined;\\n  const parsed = Number(value);\\n  if (!Number.isSafeInteger(parsed) || parsed < 0) {\\n    throw new Error(`${name} must be a non-negative integer`);\\n  }\\n  return parsed;\\n}\\n\\nfunction corsAllowedOrigins(): string[] {\\n  const value = Bun.env.CORS_ALLOWED_ORIGINS?.trim();\\n  if (!value) return [];\\n  const origins = value.split(\\\",\\\").map((origin) => origin.trim());\\n  for (const origin of origins) {\\n    let parsed: URL;\\n    try {\\n      parsed = new URL(origin);\\n    } catch (error) {\\n      throw new Error(\\n        `CORS_ALLOWED_ORIGINS contains an invalid origin: ${origin}`,\\n        {\\n          cause: error,\\n        },\\n      );\\n    }\\n    if (\\n      origin === \\\"*\\\" ||\\n      (parsed.protocol !== \\\"https:\\\" && parsed.protocol !== \\\"http:\\\") ||\\n      parsed.origin !== origin\\n    ) {\\n      throw new Error(\\n        `CORS_ALLOWED_ORIGINS must contain exact http(s) origins without paths: ${origin}`,\\n      );\\n    }\\n  }\\n  return [...new Set(origins)];\\n}\\n\\nfunction publicClientProducts(): Record<string, Product> {\\n  const configured =\\n    optionalJson<Record<string, string>>(\\\"PUBLIC_CLIENT_PRODUCT_CATALOG\\\") ?? {};\\n  const catalog: Record<string, string> = {\\n    \\\"https://stich.cc\\\": \\\"stich\\\",\\n    ...configured,\\n  };\\n  return Object.fromEntries(\\n    Object.entries(catalog).map(([clientId, product]) => {\\n      let client: URL;\\n      try {\\n        client = new URL(clientId);\\n      } catch (error) {\\n        throw new Error(\\n          `PUBLIC_CLIENT_PRODUCT_CATALOG contains an invalid client id: ${clientId}`,\\n          { cause: error },\\n        );\\n      }\\n      if (client.protocol !== \\\"https:\\\" || client.origin !== clientId) {\\n        throw new Error(\\n          `PUBLIC_CLIENT_PRODUCT_CATALOG keys must be exact HTTPS origins: ${clientId}`,\\n        );\\n      }\\n      return [clientId, parseProductId(product)];\\n    }),\\n  );\\n}\\n\\nfunction signingKeys(): GatewayConfig[\\\"productAssertionKeys\\\"] {\\n  // voxq is optional, not required-on-boot like the others: its key has not\\n  // been issued yet, and a `json()` here would take the running gateway down\\n  // for every other product the moment this deploys. Until the env var is set,\\n  // voxq assertions simply find no key and are rejected — which is correct.\\n  const voxq = optionalJson<JWK>(\\\"VOXQ_ASSERTION_PUBLIC_JWK\\\");\\n  return {\\n    twyne: json<JWK>(\\\"TWYNE_ASSERTION_PUBLIC_JWK\\\"),\\n    keating: json<JWK>(\\\"KEATING_ASSERTION_PUBLIC_JWK\\\"),\\n    interleave: json<JWK>(\\\"INTERLEAVE_ASSERTION_PUBLIC_JWK\\\"),\\n    notorganic: json<JWK>(\\\"NOTORGANIC_ASSERTION_PUBLIC_JWK\\\"),\\n    ...(voxq ? { voxq } : {}),\\n  };\\n}\\n\\ninterface PaddleCatalogEntry {\\n  product: Product;\\n  grantProgram: string;\\n}\\n\\nconst paddleCatalog =\\n  optionalJson<Record<string, PaddleCatalogEntry>>(\\\"PADDLE_PRICE_CATALOG\\\") ??\\n  {};\\nconst paddleApiKey =\\n  Object.keys(paddleCatalog).length > 0\\n    ? required(\\\"PADDLE_API_KEY\\\")\\n    : Bun.env.PADDLE_API_KEY?.trim() || undefined;\\n\\nconst transit = new OpenBaoTransit({\\n  address: required(\\\"OPENBAO_ADDR\\\"),\\n  token: Bun.env.OPENBAO_TOKEN,\\n  roleId: Bun.env.OPENBAO_ROLE_ID,\\n\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"9caec0\",\"wall_time_seconds\":1.6742785100000002,\"exit_code\":0,\"original_token_count\":384,\"output\":\"# Judgement gateway integration\\n\\nInstalled in `types.ts`, `main.ts`, `app.ts`, and the capability catalog.\\nThe authenticated `POST /v1/judgement` route requires `judgement:evaluate`.\\n`GET /v1/models` advertises `judgement` only when the gateway has a TypeSafe key.\\n\\n## Configuration\\n\\nSet `TYPESAFE_API_KEY` on the gateway service only. `TYPESAFE_MODEL` is optional\\nand defaults to `jev-latest`. Products use the `judgement` alias; the gateway\\nowns the upstream version. Twyne prefers Not Organic whenever enabled and\\naccepts a direct key only in a loopback Convex runtime.\\n\\n## Requests and accounting\\n\\nSend a string or object of strings in `state` and a map of typed `questions`.\\nChoice criteria accept the documented map or Twyne's internal array of labels;\\narrays are normalized before calling TypeSafe. Scores retain ordered arrays.\\nRequests are bounded by context, question count, and the caller's credit cap.\\n\\nAn optional idempotency key (1–255 characters) enables replay of a settled\\nresponse without another upstream request or charge. Omitting the key starts\\na new evaluation. In-flight duplicates return 409. Settlement uses reported\\ninput tokens at 0.042 microUSD per token; output is free. Responses are stored\\nthrough the existing encrypted response ledger. Unknown delivery or missing\\nusage enters reconciliation instead of pretending the call cost nothing.\\n\\n## Delivery status\\n\\nThe route and product UI are implemented locally. Deployment and live\\naccount-to-ledger verification are separate from these source changes.\\n\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"621e3f\",\"wall_time_seconds\":1.7161645,\"exit_code\":0,\"original_token_count\":32,\"output\":\"{\\\"error\\\":{\\\"message\\\":\\\"Use a DPoP-bound access token.\\\",\\\"type\\\":\\\"authentication_error\\\",\\\"param\\\":null,\\\"code\\\":\\\"invalid_authorization\\\"}}\"}}"},{"type":"input_text","text":"{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"a49fd2\",\"wall_time_seconds\":1.6606354639999998,\"exit_code\":0,\"original_token_count\":410,\"output\":\"src/utils/feature-flags.ts:4: * PostHog is the source of truth for runtime rollout. The `PUBLIC_FEATURE_*`\\nsrc/utils/feature-flags.ts:15:  /** Show the pricing page and its navigation links. */\\nsrc/utils/feature-flags.ts:31:  pricing: flag(import.meta.env.PUBLIC_FEATURE_PRICING),\\nsrc/utils/feature-flags.ts:32:  localAi: flag(import.meta.env.PUBLIC_FEATURE_LOCAL_AI),\\nconvex/providerIdentity.ts:57:export const linkDidFromLegacyBrowserSession = mutation({\\nconvex/providerIdentity.ts:92:      verificationMethod: \\\"legacy_atproto_browser_oauth\\\",\\nconvex/providerIdentity.ts:101:async function linkedDidForAction(ctx: any) {\\nconvex/providerIdentity.ts:118:    const link = await linkedDidForAction(ctx);\\nconvex/providerIdentity.ts:120:      did: link.did,\\nconvex/providerIdentity.ts:123:      sessionVersion: link.sessionVersion,\\nconvex/providerIdentity.ts:147:        NOTORGANIC_ENABLED: process.env.NOTORGANIC_ENABLED,\\nconvex/providerIdentity.ts:148:        NOTORGANIC_TWYNE_PRO_V2_ENABLED:\\nconvex/providerIdentity.ts:149:          process.env.NOTORGANIC_TWYNE_PRO_V2_ENABLED,\\nconvex/providerIdentity.ts:152:    const link = await linkedDidForAction(ctx);\\nconvex/providerIdentity.ts:154:      did: link.did,\\nconvex/providerIdentity.ts:157:      sessionVersion: link.sessionVersion,\\nsrc/utils/notorganic-provider.ts:4:const linkDid = makeFunctionReference<\\\"mutation\\\", { did: string }, unknown>(\\nsrc/utils/notorganic-provider.ts:5:  \\\"providerIdentity:linkDidFromLegacyBrowserSession\\\",\\nsrc/utils/notorganic-provider.ts:20:export async function linkNotOrganicDid(\\nsrc/utils/notorganic-provider.ts:24:  await client.mutation(linkDid, { did });\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0bd95-790e-7882-b1b0-52e1002bd152","create_time":1789888606.098642}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
