ort const RELEASE_NOTES_BULLETS = 6;\n\nexport function parseChangelog(markdown: string): ChangelogEntry[] {\n  const entries: ChangelogEntry[] = [];\n  const sections = markdown.split(/^## /m);\n  for (const section of sections.slice(1)) {\n    const lines = section.split(\"\\n\");\n    const version = lines[0]?.trim().replace(/^v/, \"\") ?? \"\";\n    if (!version) continue;\n    const date = section.match(/<sub>(\\d{4}-\\d{2}-\\d{2})<\\/sub>/)?.[1] ?? null;\n    const highlights = lines\n      .filter((line) => line.startsWith(\"- \"))\n      .map((line) =>\n        line\n          .replace(/^-+\\s+/, \"\")\n          .replace(/\\*\\*/g, \"\")\n          .trim(),\n      )\n      .filter(Boolean)\n      .slice(0, RELEASE_NOTES_BULLETS);\n    entries.push({ version, date, highlights });\n  }\n  return entries;\n}\n{\n  \"name\": \"twyne\",\n  \"description\": \"Twyne — The writer's room, AI-powered editing with a room full of editors\",\n  \"engines\": {\n    \"node\": \"^20.19.0 || >=22.12.0\"\n  },\n  \"engines-annotation\": \"Mostly required by sharp which needs a Node-API v9 compatible runtime\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"version\": \"0.19.1\",\n  \"packageManager\": \"bun@1.3.6\",\n  \"scripts\": {\n    \"build\": \"qwik build\",\n    \"build.client\": \"vite build\",\n    \"build.preview\": \"vite build --ssr src/entry.preview.tsx\",\n    \"build.types\": \"tsc --incremental --noEmit\",\n    \"build.server\": \"vite build --ssr src/entry.preview.tsx\",\n    \"deploy\": \"bun run build.client && bun run build.server && bun server.js\",\n    \"preversion\": \"bun run release:check\",\n    \"postversion\": \"bun run release:check\",\n    \"release:check\": \"bun scripts/check-release-version.ts\",\n    \"release:version\": \"bun pm version\",\n    \"release:publish\": \"git push --follow-tags\",\n    \"desktop\": \"electrobun dev && electrobun run\",\n    \"desktop.build\": \"electrobun build\",\n    \"dev\": \"concurrently --names \\\"