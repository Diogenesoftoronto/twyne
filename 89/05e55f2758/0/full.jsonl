color-ink) 16%, transparent);\n   border-radius: 2px;\n@@ -2981,15 +3166,14 @@ body {\n     rotate(calc(var(--tilt) * 0.15)) scale(1.012);\n }\n \n+/* The frame hugs the preview content — the previews are live components\n+   with their own natural height, not photographs, so a fixed ratio would\n+   leave a dead band under the shorter ones. */\n .landing-plate__frame {\n   overflow: hidden;\n   border-radius: 2px;\n-  aspect-ratio: 3 / 2;\n   background: var(--color-paper-3);\n }\n-.landing-plate__frame--portrait {\n-  aspect-ratio: 4 / 5;\n-}\n .landing-plate__frame img {\n   width: 100%;\n   height: 100%;\n@@ -3007,11 +3191,7 @@ body {\n   object-fit: cover;\n   opacity: 0.18;\n   pointer-events: none;\n-  mask-image: radial-gradient(\n-    ellipse at center,\n-    #000 30%,\n-    transparent 78%\n-  );\n+  mask-image: radial-gradient(ellipse at center, #000 30%, transparent 78%);\n }\n [data-theme=\"nightpress\"] .landing-closing-photo {\n   opacity: 0.26;\nimport { expect, test, type Page } from \"@playwright/test\";\n\n/**\n * Dragging a selection to a new place in the manuscript.\n *\n * This is the interaction a writer already knows from every other editor:\n * select a passage, drag it, watch a caret follow the pointer, drop, and the\n * passage *moves*. Twyne broke all three halves of it at once, because the\n * manuscript scroller carried Qwik's `preventdefault:drop`, which fires from a\n * document-level capture listener — ProseMirror ignores any event whose default\n * is already prevented, so its drop handling never ran.\n *\n * These tests drive real pointer input rather than synthetic DataTransfer\n * events, because a synthetic event would bypass the exact layer that was\n * broken.\n */\n\nasync function seedFolio(page: Page, html: string) {\n  await page.goto(\"/\");\n  await page.evaluate(\n    async ({ html }) => {\n      const db: IDBDatabase = await new Promise((resolve, reject) => {\n        const req = indexedDB.open(\"twyne\", 2);\n        req.onupgradeneeded = () => {\n          const d = req.result;\n          for (const [name, keyPath] of [\n            [\"folios\", \"id\"],\n            [\"folio-content\", \"folioId\"],\n            [\"brief\", \"folioId\"],\n            [\"comments\", \"id\"],\n            [\"personas\", \"id\"],\n            [\"meta\", \"key\"],\n            [\"ai-settings\", \"key\"],\n            [\"lix-blob\", \"key\"],\n            [\"voice-notes\", \"id\"],\n          ] as const) {\n            if (!d.objectStoreNames.contains(name)) {\n              d.createObjectStore(name, { keyPath });\n            }\n          }\n        };\n        req.onsuccess = () => resolve(req.result);\n        req.onerror = () => reject(req.error);\n      });\n\n      const now = Date.now();\n      const id = \"e2e-drag-selection\";\n      await new Promise<void>((resolve, reject) => {\n        const t = db.transaction(\n          [\"folios\", \"folio-content\", \"meta\"],\n          \"readwrite\",\n        );\n        t.objectStore(\"folios\").put({\n          id,\n          name: \"Drag fixture\",\n          type: \"draft\",\n          createdAt: now,\n          updatedAt: now,\n          layout: { pagination: \"paginated\" },\n        });\n        t.objectStore(\"folio-content\").put({\n          folioId: id,\n          html,\n          updatedAt: now,\n        });\n        t.objectStore(\"meta\").put({\n          key: \"active-folio-id\",\n          value: id,\n          updatedAt: now,\n        });\n        t.oncomplete = () => resolve();\n        t.onerror = () => reject(t.error);\n      });\n    },\n    { html },\n  );\n}\n\nasync function openEditor(page: Page, html: string) {\n  await seedFolio(page, html);\n  await page.goto(\"/editor/\");\n  await expect(page.locator(\".ProseMirror\")).toBeVisible({ timeout: 20_000 });\n  await page.waitForFunction(\n    () => (window as any).__twynePagination?.measureCount > 0,\n    undefined,\n    { timeout: 20_000 },\n  );\n}\n\n/** The manuscript's paragraphs, in document order. */\nfunction paragraphTexts(page: Page) {\n  return page.locator(\".ProseMirror > p\").allInnerTexts();\n}\n\n/**\n * Drag from one point to another as a person would.\n *\n * Chromium only promotes a mouse gesture to a native HTML5 drag after the\n * pointer has actually travelled, so the move is stepped and there is a\n * settling move before release. Without this the browser treats the gesture as\n * a click-and-select and the test passes for the wrong reason.\n */\nasync function dragBetween(\n  page: Page,\n  from: { x: number; y: number },\n  to: { x: number; y: number },\n) {\n  await page.mouse.move(from.x, from.y);\n  await page.mouse.down();\n  await page.mouse.move(from.x + 12, from.y + 4, { steps: 6 });\n  await page.mouse.move(to.x, to.y, { steps: 24 });\n  await page.mouse.move(to.x, to.y, { steps: 4 });\n  await page.mouse.up();\n}\n\n/** Select a whole paragraph by index, leaving it highlighted. */\nasync function selectParagraph(page: Page, index: number) {\n  const para = page.locator(\".ProseMirror > p\").nth(index);\n  await para.click();\n  await page.keyboard.press(\"Home\");\n  await page.keyboard.press(\"Shift+End\");\n  return para;\n}\n\ntest.describe(\"dragging a selection\", () => {\n  test(\"moves a paragraph's text rather than copying it\", async ({ page }) => {\n    await openEditor(\n      page,\n      \"<p>Alpha paragraph.</p><p>Beta paragraph.</p><p>Gamma paragraph.</p>\",\n    );\n\n    const beta = await selectParagraph(page, 1);\n    const alpha = page.locator(\".ProseMirror > p\").first();\n\n    const betaBox = await beta.boundingBox();\n    const alphaBox = await alpha.boundingBox();\n    expect(betaBox).not.toBeNull();\n    expect(alphaBox).not.toBeNull();\n\n    await dragBetween(\n      page,\n      { x: betaBox!.x + betaBox!.width / 2, y: betaBox!.y + betaBox!.height / 2 },\n      // The very start of Alpha, so the text lands ahead of it.\n      { x: alphaBox!.x + 2, y: alphaBox!.y + alphaBox!.height / 2 },\n    );\n\n    await expect\n      .poll(async () => (await paragraphTexts(page)).join(\" | \"))\n      .toContain(\"Beta paragraph.Alpha paragraph.\");\n\n    // Moved, not copied: the phrase exists exactly once in the document.\n    const occurrences = await page.evaluate(() => {\n      const text = document.querySelector(\".ProseMirror\")?.textContent ?? \"\";\n      return text.split(\"Beta paragraph.\").length - 1;\n    });\n    expect(occurrences).toBe(1);\n  });\n\n  test(\"moves a multi-paragraph selection\", async ({ page }) => {\n    await openEditor(\n      page,\n      \"<p>One.</p><p>Two.</p><p>Three.</p><p>Four.</p>\",\n    );\n\n    const paras = page.locator(\".ProseMirror > p\");\n    // Select \"Two.\" through \"Three.\" — the user specifically asked for this to\n    // work on blocks, not just a handful of characters.\n    await paras.nth(1).click();\n    await page.keyboard.press(\"Home\");\n    await page.keyboard.press(\"Shift+ArrowDown\");\n    await page.keyboard.press(\"Shift+End\");\n\n    const source = await paras.nth(2).boundingBox();\n    const target = await paras.nth(3).boundingBox();\n    expect(source).not.toBeNull();\n    expect(target).not.toBeNull();\n\n    await dragBetween(\n      page,\n      { x: source!.x + 8, y: source!.y + source!.height / 2 },\n      // Past the end of \"Four.\", so the pair lands at the tail of the document.\n      { x: target!.x + target!.width - 2, y: target!.y + target!.height / 2 },\n    );\n\n    await expect\n      .poll(async () => (await paragraphTexts(page)).join(\" \"))\n      .toMatch(/One\\..*Four\\..*Two\\..*Three\\./s);\n  });\n\n  test(\"shows a drop caret while dragging and no file-drop overlay\", async ({\n    page,\n  }) => {\n    await openEditor(page, \"<p>Alpha paragraph.</p><p>Beta paragraph.</p>\");\n\n    const beta = await selectParagraph(page, 1);\n    const alpha = page.locator(\".ProseMirror > p\").first();\n    const betaBox = await beta.boundingBox();\n    const alphaBox = await alpha.boundingBox();\n\n    await page.mouse.move(\n      betaBox!.x + betaBox!.width / 2,\n      betaBox!.y + betaBox!.height / 2,\n    );\n    await page.mouse.down();\n    await page.mouse.move(betaBox!.x + 12, betaBox!.y + 4, { steps: 6 });\n    await page.mouse.move(alphaBox!.x + 2, alphaBox!.y + 2, { steps: 24 });\n\n    // The caret that tells the writer where the text will land.\n    await expect(page.locator(\".twyne-dropcursor\")).toBeVisible();\n    // Dragging prose must not raise the plate/tabular file-drop prompt.\n    await expect(page.locator(\".drag-overlay\")).toHaveCount(0);\n\n    await page.mouse.up();\n  });\n});\n","stderr":"","aggregated_output":"  /** PostHog AI generation handle used to attach contextual feedback. */\n  traceId?: string;\n  paragraphIndex?: number;\n  timestamp: number;\n  type: \"encouragement\" | \"suggestion\" | \"critique\" | \"perspective\";\n  /** Exact sentence from the draft this note is pinned to, when one was found. */\n  anchor?: string;\n  /** Stable id shared between the feed card and the inline mark in the manuscript. */\n  noteId?: string;\n  /** Title of the brief the note was filed against, for the timeline. */\n  briefTitle?: string;\n  /**\n   * How this note came to exist. `\"convened\"` (the default when absent) means\n   * the writer asked; `\"background\"` means the room read new material on its\n   * own while the writer was working, and the note should be presented more\n   * quietly.\n   */\n  origin?: \"convened\" | \"background\";\n}\n\n/** Payload of the `twyne:persona-notes` window event: notes to pin inline. */\nexport interface PersonaNotePayload {\n  id: string;\n  author: string;\n  color: string;\n  label: string;\n  note: string;\n  quote: string;\n  briefTitle?: string;\n}\n\nexport interface RubricCriterion {\n  id: string;\n  label: string;\n  description: string;\n  score: number;\n  maxScore: number;\n  feedback: string;\n}\n\n/**\n * One line of the writer's rubric configuration.\n *\n * The spine — the criteria Twyne ships — stays fixed so a score means the same\n * thing from one pass to the next, and so the trend line is honest. What the\n * writer controls is the weighting, whether a spine criterion is shown at all,\n * and any number of criteria of their own that the room will judge alongside\n * them. Spine entries can be disabled and reweighted but never deleted; that\n * is what keeps two runs comparable.\n */\nexport interface RubricCriterionSpec {\n  id: string;\n  label: string;\n  description: string;\n  source: \"spine\" | \"custom\";\n  enabled: boolean;\n  /** Relative weight within the criteria list. 1 is the default. */\n  weight: number;\n}\n\n/** The criteria Twyne ships. Order is the order they render in. */\nexport const SPINE_CRITERIA: ReadonlyArray<\n  Pick<RubricCriterionSpec, \"id\" | \"label\" | \"description\">\n> = [\n  {\n    id: \"targetFit\",\n    label: \"Target Fit\",\n    description:\n      \"Whether the draft is about the right thing, for the right reader — independent of how well it is written\",\n  },\n  {\n    id: \"thesis\",\n    label: \"Thesis & Argument\",\n    description: \"Clarity and strength of the central argument\",\n  },\n  {\n    id: \"evidence\",\n    label: \"Evidence & Support\",\n    description: \"Quality and relevance of supporting evidence\",\n  },\n  {\n    id: \"sufficiency\",\n    label: \"Sufficiency & Development\",\n    description:\n      \"Whether the draft develops enough on-topic material to earn its thesis or goal\",\n  },\n  {\n    id: \"integrity\",\n    label: \"Bullshit Resistance\",\n    description: \"Unsupported certainty, filler, vagueness, and repetition\",\n  },\n  {\n    id: \"structure\",\n    label: \"Organization & Flow\",\n    description: \"Logical structure and transitions\",\n  },\n  {\n    id: \"pacing\",\n    label: \"Pacing & Rhythm\",\n    description: \"Sentence length variation and cadence\",\n  },\n  {\n    id: \"voice\",\n    label: \"Voice & Tone\",\n    description: \"Consistency of voice for the named audience\",\n  },\n  {\n    id: \"vocabulary\",\n    label: \"Vocabulary & Diction\",\n    description: \"Type-token ratio and word choice\",\n  },\n  {\n    id: \"paragraph\",\n    label: \"Paragraph Shape\",\n    description: \"Balance of short and long paragraphs\",\n  },\n  {\n    id: \"engagement\",\n    label: \"Reader Engagement\",\n    description: \"Whether the reader reaches the success signal\",\n  },\n] as const;\n\n/** One recorded rubric pass, for the trend line. */\nexport interface RubricHistoryEntry {\n  scoringMethod?: \"judgement\" | \"room\";\n3:  confidenceOf,\n10:  score,\n11:  scoreOutOf,\n15:const scoreAnswer = (\n18:  confidence = 0.5,\n20:  type: \"score\",\n21:  score: value,\n22:  legend: Object.fromEntries(\n26:  confidence,\n31:  // score 1.43 at confidence 0.14 with mass piled on level 2, so the scalar\n34:    const answer = scoreAnswer({ \"0\": 0.21, \"1\": 0.16, \"2\": 0.63 }, 1.43, 0.14);\n41:      isBimodal(scoreAnswer({ \"0\": 0.05, \"1\": 0.9, \"2\": 0.05 }, 1.0)),\n47:      isBimodal(scoreAnswer({ \"0\": 0.2, \"1\": 0.45, \"2\": 0.35 }, 1.15)),\n52:    const answer = scoreAnswer({ \"0\": 0.1, \"1\": 0.7, \"2\": 0.2 }, 1.1);\n53:    expect(modalLevel(answer)).toBe(Math.round(answer.score));\n57:describe(\"scoreOutOf\", () => {\n59:    const answer = scoreAnswer({ \"0\": 0, \"1\": 0, \"2\": 0, \"3\": 0, \"4\": 1 }, 4);\n60:    expect(scoreOutOf(answer, 10)).toBe(10);\n64:    const answer = scoreAnswer({ \"0\": 1, \"1\": 0, \"2\": 0, \"3\": 0, \"4\": 0 }, 0);\n65:    expect(scoreOutOf(answer, 10)).toBe(0);\n69:    const threeLevel = scoreAnswer({ \"0\": 0, \"1\": 1, \"2\": 0 }, 1);\n70:    const fiveLevel = scoreAnswer(\n75:    expect(scoreOutOf(threeLevel, 10)).toBe(5);\n76:    expect(scoreOutOf(fiveLevel, 10)).toBe(5);\n80:describe(\"confidence semantics\", () => {\n81:  test(\"a Noul carries no confidence\", () => {\n82:    expect(confidenceOf({ type: \"noul\", noul: 0.5 })).toBeNull();\n86:    expect(confidenceOf(scoreAnswer({ \"0\": 0.5, \"1\": 0.5 }, 0.5, 0.31))).toBe(\n96:    expect(isScore(scoreAnswer({ \"0\": 1 }, 0))).toBe(true);\n110:  test(\"score keeps criteria order, which is the level index\", () => {\n111:    const q = score(\"rate it\", [\"bad\", \"ok\", \"good\"]);\ncat: prompts/rubric-review-user.md: No such file or directory\n---\nnotes: |\n  Chief Critic — explains the score, doesn't re-score. The numbers come in\n  already-computed from the judges and the static-feature pass.\nversion: \"1\"\n---\n\nYou are the Chief Critic of \"Twyne.\" The galley-proof rubric has already scored this draft — judges' scores and a static-feature breakdown are given. Your job is to write the full-page narrative review that explains the grade in plain, honest prose and gives the writer a concrete revision plan. Do not invent new scores; interpret the ones you are given. Be candid; this is editorial pressure, not a self-esteem mirror.\ndiff --git a/src/global.css b/src/global.css\nindex 0760384..8f26cc6 100644\n--- a/src/global.css\n+++ b/src/global.css\n@@ -702,6 +702,54 @@ body {\n     0 2px 0 color-mix(in srgb, var(--shade) 5%, transparent);\n }\n \n+/* ── Drop caret and gap cursor ────────────────────────────\n+   Where a dragged selection will land, and where the caret sits between two\n+   block nodes. Both extensions ship enabled via StarterKit but neither draws\n+   anything useful on its own: prosemirror-gapcursor has no styles at all\n+   without its stylesheet, and the drop caret defaults to a 1px hairline in the\n+   body text colour. Vermilion matches the editorial marks elsewhere in the\n+   manuscript, so the insertion point reads as an instruction rather than\n+   as part of the prose. */\n+.twyne-editor .twyne-dropcursor {\n+  background-color: var(--color-vermilion);\n+  border-radius: 1px;\n+  box-shadow: 0 0 0 1px\n+    color-mix(in srgb, var(--color-vermilion) 25%, transparent);\n+}\n+\n+.twyne-editor .ProseMirror-gapcursor {\n+  display: none;\n+  pointer-events: none;\n+  position: absolute;\n+}\n+\n+.twyne-editor .ProseMirror-gapcursor::after {\n+  content: \"\";\n+  display: block;\n+  position: absolute;\n+  top: -2px;\n+  width: 1.25rem;\n+  border-top: 2px solid var(--color-vermilion);\n+  animation: twyne-gapcursor-blink 1.1s steps(2, start) infinite;\n+}\n+\n+@keyframes twyne-gapcursor-blink {\n+  to {\n+    visibility: hidden;\n+  }\n+}\n+\n+@media (prefers-reduced-motion: reduce) {\n+  .twyne-editor .ProseMirror-gapcursor::after {\n+    animation: none;\n+  }\n+}\n+\n+.twyne-editor .ProseMirror-focused .ProseMirror-gapcursor,\n+.twyne-editor .ProseMirror-gapcursor:focus {\n+  display: block;\n+}\n+\n /* ── Tiptap manuscript page ──────────────────────────────── */\n .twyne-editor .ProseMirror {\n   outline: none;\n@@ -2569,32 +2617,169 @@ body {\n   outline-offset: 3px;\n }\n \n-/* Annotation slips pinned over the workspace preview */\n-.landing-annotation {\n+/* Room-tour hotspots pinned over the workspace preview */\n+@keyframes tour-pulse {\n+  0% {\n+    box-shadow: 0 0 0 0\n+      color-mix(in srgb, var(--hotspot-accent) 55%, transparent);\n+  }\n+  70% {\n+    box-shadow: 0 0 0 10px transparent;\n+  }\n+  100% {\n+    box-shadow: 0 0 0 0 transparent;\n+  }\n+}\n+.tour-hotspot {\n   position: absolute;\n   z-index: 2;\n-  pointer-events: none;\n-  max-width: 15.5rem;\n-  padding: 0.6rem 0.8rem;\n+  width: 1.9rem;\n+  height: 1.9rem;\n+  translate: -50% -50%;\n+  display: flex;\n+  align-items: center;\n+  justify-content: center;\n+  font-size: 0.85rem;\n+  line-height: 1;\n+  color: var(--hotspot-accent);\n+  background: var(--color-paper);\n+  border: 1.5px solid var(--hotspot-accent);\n+  border-radius: 999px;\n+  box-shadow: 0 8px 18px -10px color-mix(in srgb, var(--shade) 60%, transparent);\n+  animation: tour-pulse 2.4s ease-out infinite;\n+  cursor: pointer;\n+}\n+.tour-hotspot:hover {\n+  transform: scale(1.12);\n+}\n+.tour-hotspot.is-active {\n+  background: var(--hotspot-accent);\n+  color: var(--color-paper);\n+  animation: none;\n+}\n+.tour-hotspot:focus-visible {\n+  outline: 2px solid var(--color-vermilion);\n+  outline-offset: 2px;\n+}\n+\n+/* Room-tour reader slip floating over the preview */\n+.tour-slip-anchor {\n+  position: absolute;\n+  z-index: 3;\n+  width: 0;\n+  height: 0;\n+}\n+.tour-slip {\n+  position: absolute;\n+  left: 0;\n+  translate: -50% 0;\n+  width: 15.5rem;\n+  padding: 0.6rem 0.8rem 0.7rem;\n   background: var(--color-paper-soft);\n   border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);\n+  border-left: 3px solid var(--slip-accent);\n   border-radius: 2px;\n-  box-shadow: 0 14px 28px -18px\n-    color-mix(in srgb, var(--shade) 50%, transparent);\n+  box-shadow: 0 18px 34px -18px\n+    color-mix(in srgb, var(--shade) 60%, transparent);\n+  text-align: left;\n }\n-.landing-annotation .tag {\n+.tour-slip--above {\n+  bottom: 18px;\n+}\n+.tour-slip--below {\n+  top: 18px;\n+}\n+.tour-slip__tag {\n   font-family: var(--font-typewriter);\n-  font-size: 0.72rem;\n+  font-size: 0.66rem;\n   letter-spacing: 0.12em;\n   text-transform: uppercase;\n+  color: var(--slip-accent);\n }\n-.landing-annotation .note {\n-  margin-top: 0.2rem;\n+.tour-slip__note {\n+  margin-top: 0.25rem;\n   font-family: var(--font-serif);\n-  font-size: 0.875rem;\n+  font-size: 0.82rem;\n   line-height: 1.45;\n   color: var(--color-ink-light);\n }\n+.tour-slip__controls {\n+  margin-top: 0.55rem;\n+  display: flex;\n+  align-items: center;\n+  justify-content: space-between;\n+  gap: 0.5rem;\n+}\n+.tour-slip__dots {\n+  display: flex;\n+  align-items: center;\n+  gap: 0.3rem;\n+}\n+/* Narrow screens: the slip docks as a bottom sheet so it never leaves\n+   the frame or covers the hotspot it describes. */\n+@media (max-width: 1023.98px) {\n+  .tour-slip-anchor {\n+    left: 50% !important;\n+    top: auto !important;\n+    bottom: 0.75rem;\n+  }\n+  .tour-slip--above,\n+  .tour-slip--below {\n+    top: auto;\n+    bottom: 0;\n+  }\n+  .tour-slip {\n+    width: min(22rem, calc(100vw - 4rem));\n+  }\n+}\n+\n+/* Room-tour slip controls */\n+.tour-step {\n+  display: inline-flex;\n+  align-items: center;\n+  justify-content: center;\n+  width: 1.6rem;\n+  height: 1.6rem;\n+  flex-shrink: 0;\n+  font-family: var(--font-display);\n+  font-size: 0.85rem;\n+  color: var(--color-ink-light);\n+  border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);\n+  border-radius: 999px;\n+  background: transparent;\n+  cursor: pointer;\n+}\n+.tour-step:hover {\n+  color: var(--color-ink);\n+  border-color: var(--color-vermilion);\n+}\n+.tour-step:focus-visible {\n+  outline: 2px solid var(--color-vermilion);\n+  outline-offset: 2px;\n+}\n+.tour-dot {\n+  width: 0.5rem;\n+  height: 0.5rem;\n+  padding: 0;\n+  border-radius: 999px;\n+  border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);\n+  background: transparent;\n+  cursor: pointer;\n+}\n+.tour-dot.is-active {\n+  background: var(--dot-accent);\n+  border-color: var(--dot-accent);\n+  transform: scale(1.25);\n+}\n+.tour-dot:focus-visible {\n+  outline: 2px solid var(--color-vermilion);\n+  outline-offset: 2px;\n+}\n+@media (prefers-reduced-motion: reduce) {\n+  .tour-hotspot {\n+    animation: none;\n+  }\n+}\n \n /* Step numerals in the how-it-works ledger */\n .landing-step-num {\n@@ -2939,7 +3124,7 @@ body {\n   --drift-x: 0px;\n   --drift-y: 0px;\n   margin: 0;\n-  padding: 0.5rem 0.5rem 1.4rem;\n+  padding: 0.5rem;\n   background: var(--color-paper-soft);\n   border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);\n   border-radius: 2px;\n@@ -2981,15 +3166,14 @@ body {\n     rotate(calc(var(--tilt) * 0.15)) scale(1.012);\n }\n \n+/* The frame hugs the preview content — the previews are live components\n+   with their own natural height, not photographs, so a fixed ratio would\n+   leave a dead band under the shorter ones. */\n .landing-plate__frame {\n   overflow: hidden;\n   border-radius: 2px;\n-  aspect-ratio: 3 / 2;\n   background: var(--color-paper-3);\n }\n-.landing-plate__frame--portrait {\n-  aspect-ratio: 4 / 5;\n-}\n .landing-plate__frame img {\n   width: 100%;\n   height: 100%;\n@@ -3007,11 +3191,7 @@ body {\n   object-fit: cover;\n   opacity: 0.18;\n   pointer-events: none;\n-  mask-image: radial-gradient(\n-    ellipse at center,\n-    #000 30%,\n-    transparent 78%\n-  );\n+  mask-image: radial-gradient(ellipse at center, #000 30%, transparent 78%);\n }\n [data-theme=\"nightpress\"] .landing-closing-photo {\n   opacity: 0.26;\nimport { expect, test, type Page } from \"@playwright/test\";\n\n/**\n * Dragging a selection to a new place in the manuscript.\n *\n * This is the interaction a writer already knows from every other editor:\n * select a passage, drag it, watch a caret follow the pointer, drop, and the\n * passage *moves*. Twyne broke all three halves of it at once, because the\n * manuscript scroller carried Qwik's `preventdefault:drop`, which fires from a\n * document-level capture listener — ProseMirror ignores any event whose default\n * is already prevented, so its drop handling never ran.\n *\n * These tests drive real pointer input rather than synthetic DataTransfer\n * events, because a synthetic event would bypass the exact layer that was\n * broken.\n */\n\nasync function seedFolio(page: Page, html: string) {\n  await page.goto(\"/\");\n  await page.evaluate(\n    async ({ html }) => {\n      const db: IDBDatabase = await new Promise((resolve, reject) => {\n        const req = indexedDB.open(\"twyne\", 2);\n        req.onupgradeneeded = () => {\n          const d = req.result;\n          for (const [name, keyPath] of [\n            [\"folios\", \"id\"],\n            [\"folio-content\", \"folioId\"],\n            [\"brief\", \"folioId\"],\n            [\"comments\", \"id\"],\n            [\"personas\", \"id\"],\n            [\"meta\", \"key\"],\n            [\"ai-settings\", \"key\"],\n            [\"lix-blob\", \"key\"],\n            [\"voice-notes\", \"id\"],\n          ] as const) {\n            if (!d.objectStoreNames.contains(name)) {\n              d.createObjectStore(name, { keyPath });\n            }\n          }\n        };\n        req.onsuccess = () => resolve(req.result);\n        req.onerror = () => reject(req.error);\n      });\n\n      const now = Date.now();\n      const id = \"e2e-drag-selection\";\n      await new Promise<void>((resolve, reject) => {\n        const t = db.transaction(\n          [\"folios\", \"folio-content\", \"meta\"],\n          \"readwrite\",\n        );\n        t.objectStore(\"folios\").put({\n          id,\n          name: \"Drag fixture\",\n          type: \"draft\",\n          createdAt: now,\n          updatedAt: now,\n          layout: { pagination: \"paginated\" },\n        });\n        t.objectStore(\"folio-content\").put({\n          folioId: id,\n          html,\n          updatedAt: now,\n        });\n        t.objectStore(\"meta\").put({\n          key: \"active-folio-id\",\n          value: id,\n          updatedAt: now,\n        });\n        t.oncomplete = () => resolve();\n        t.onerror = () => reject(t.error);\n      });\n    },\n    { html },\n  );\n}\n\nasync function openEditor(page: Page, html: string) {\n  await seedFolio(page, html);\n  await page.goto(\"/editor/\");\n  await expect(page.locator(\".ProseMirror\")).toBeVisible({ timeout: 20_000 });\n  await page.waitForFunction(\n    () => (window as any).__twynePagination?.measureCount > 0,\n    undefined,\n    { timeout: 20_000 },\n  );\n}\n\n/** The manuscript's paragraphs, in document order. */\nfunction paragraphTexts(page: Page) {\n  return page.locator(\".ProseMirror > p\").allInnerTexts();\n}\n\n/**\n * Drag from one point to another as a person would.\n *\n * Chromium only promotes a mouse gesture to a native HTML5 drag after the\n * pointer has actually travelled, so the move is stepped and there is a\n * settling move before release. Without this the browser treats the gesture as\n * a click-and-select and the test passes for the wrong reason.\n */\nasync function dragBetween(\n  page: Page,\n  from: { x: number; y: number },\n  to: { x: number; y: number },\n) {\n  await page.mouse.move(from.x, from.y);\n  await page.mouse.down();\n  await page.mouse.move(from.x + 12, from.y + 4, { steps: 6 });\n  await page.mouse.move(to.x, to.y, { steps: 24 });\n  await page.mouse.move(to.x, to.y, { steps: 4 });\n  await page.mouse.up();\n}\n\n/** Select a whole paragraph by index, leaving it highlighted. */\nasync function selectParagraph(page: Page, index: number) {\n  const para = page.locator(\".ProseMirror > p\").nth(index);\n  await para.click();\n  await page.keyboard.press(\"Home\");\n  await page.keyboard.press(\"Shift+End\");\n  return para;\n}\n\ntest.describe(\"dragging a selection\", () => {\n  test(\"moves a paragraph's text rather than copying it\", async ({ page }) => {\n    await openEditor(\n      page,\n      \"<p>Alpha paragraph.</p><p>Beta paragraph.</p><p>Gamma paragraph.</p>\",\n    );\n\n    const beta = await selectParagraph(page, 1);\n    const alpha = page.locator(\".ProseMirror > p\").first();\n\n    const betaBox = await beta.boundingBox();\n    const alphaBox = await alpha.boundingBox();\n    expect(betaBox).not.toBeNull();\n    expect(alphaBox).not.toBeNull();\n\n    await dragBetween(\n      page,\n      { x: betaBox!.x + betaBox!.width / 2, y: betaBox!.y + betaBox!.height / 2 },\n      // The very start of Alpha, so the text lands ahead of it.\n      { x: alphaBox!.x + 2, y: alphaBox!.y + alphaBox!.height / 2 },\n    );\n\n    await expect\n      .poll(async () => (await paragraphTexts(page)).join(\" | \"))\n      .toContain(\"Beta paragraph.Alpha paragraph.\");\n\n    // Moved, not copied: the phrase exists exactly once in the document.\n    const occurrences = await page.evaluate(() => {\n      const text = document.querySelector(\".ProseMirror\")?.textContent ?? \"\";\n      return text.split(\"Beta paragraph.\").length - 1;\n    });\n    expect(occurrences).toBe(1);\n  });\n\n  test(\"moves a multi-paragraph selection\", async ({ page }) => {\n    await openEditor(\n      page,\n      \"<p>One.</p><p>Two.</p><p>Three.</p><p>Four.</p>\",\n    );\n\n    const paras = page.locator(\".ProseMirror > p\");\n    // Select \"Two.\" through \"Three.\" — the user specifically asked for this to\n    // work on blocks, not just a handful of characters.\n    await paras.nth(1).click();\n    await page.keyboard.press(\"Home\");\n    await page.keyboard.press(\"Shift+ArrowDown\");\n    await page.keyboard.press(\"Shift+End\");\n\n    const source = await paras.nth(2).boundingBox();\n    const target = await paras.nth(3).boundingBox();\n    expect(source).not.toBeNull();\n    expect(target).not.toBeNull();\n\n    await dragBetween(\n      page,\n      { x: source!.x + 8, y: source!.y + source!.height / 2 },\n      // Past the end of \"Four.\", so the pair lands at the tail of the document.\n      { x: target!.x + target!.width - 2, y: target!.y + target!.height / 2 },\n    );\n\n    await expect\n      .poll(async () => (await paragraphTexts(page)).join(\" \"))\n      .toMatch(/One\\..*Four\\..*Two\\..*Three\\./s);\n  });\n\n  test(\"shows a drop caret while dragging and no file-drop overlay\", async ({\n    page,\n  }) => {\n    await openEditor(page, \"<p>Alpha paragraph.</p><p>Beta paragraph.</p>\");\n\n    const beta = await selectParagraph(page, 1);\n    const alpha = page.locator(\".ProseMirror > p\").first();\n    const betaBox = await beta.boundingBox();\n    const alphaBox = await alpha.boundingBox();\n\n    await page.mouse.move(\n      betaBox!.x + betaBox!.width / 2,\n      betaBox!.y + betaBox!.height / 2,\n    );\n    await page.mouse.down();\n    await page.mouse.move(betaBox!.x + 12, betaBox!.y + 4, { steps: 6 });\n    await page.mouse.move(alphaBox!.x + 2, alphaBox!.y + 2, { steps: 24 });\n\n    // The caret that tells the writer where the text will land.\n    await expect(page.locator(\".twyne-dropcursor\")).toBeVisible();\n    // Dragging prose must not raise the plate/tabular file-drop prompt.\n    await expect(page.locator(\".drag-overlay\")).toHaveCount(0);\n\n    await page.mouse.up();\n  });\n});\n","exit_code":0,"duration":{"secs":0,"nanos":4430},"formatted_output":"  /** PostHog AI generation handle used to attach contextual feedback. */\n  traceId?: string;\n  paragraphIndex?: number;\n  timestamp: number;\n  type: \"encouragement\" | \"suggestion\" | \"critique\" | \"perspective\";\n  /** Exact sentence from the draft this note is pinned to, when one was found. */\n  anchor?: string;\n  /** Stable id shared between the feed card and the inline mark in the manuscript. */\n  noteId?: string;\n  /** Title of the brief the note was filed against, for the timeline. */\n  briefTitle?: string;\n  /**\n   * How this note came to exist. `\"convened\"` (the default when absent) means\n   * the writer asked; `\"background\"` means the room read new material on its\n   * own while the writer was working, and the note should be presented more\n   * quietly.\n   */\n  origin?: \"convened\" | \"background\";\n}\n\n/** Payload of the `twyne:persona-notes` window event: notes to pin inline. */\nexport interface PersonaNotePayload {\n  id: string;\n  author: string;\n  color: string;\n  label: string;\n  note: string;\n  quote: string;\n  briefTitle?: string;\n}\n\nexport interface RubricCriterion {\n  id: string;\n  label: string;\n  description: string;\n  score: number;\n  maxScore: number;\n  feedback: string;\n}\n\n/**\n * One line of the writer's rubric configuration.\n *\n * The spine — the criteria Twyne ships — stays fixed so a score means the same\n * thing from one pass to the next, and so the trend line is honest. What the\n * writer controls is the weighting, whether a spine criterion is shown at all,\n * and any number of criteria of their own that the room will judge alongside\n * them. Spine entries can be disabled and reweighted but never deleted; that\n * is what keeps two runs comparable.\n */\nexport interface RubricCriterionSpec {\n  id: string;\n  label: string;\n  description: string;\n  source: \"spine\" | \"custom\";\n  enabled: boolean;\n  /** Relative weight within the criteria list. 1 is the default. */\n  weight: number;\n}\n\n/** The criteria Twyne ships. Order is the order they render in. */\nexport const SPINE_CRITERIA: ReadonlyArray<\n  Pick<RubricCriterionSpec, \"id\" | \"label\" | \"description\">\n> = [\n  {\n    id: \"targetFit\",\n    label: \"Target Fit\",\n    description:\n      \"Whether the draft is about the right thing, for the right reader — independent of how well it is written\",\n  },\n  {\n    id: \"thesis\",\n    label: \"Thesis & Argument\",\n    description: \"Clarity and strength of the central argument\",\n  },\n  {\n    id: \"evidence\",\n    label: \"Evidence & Support\",\n    description: \"Quality and relevance of supporting evidence\",\n  },\n  {\n    id: \"sufficiency\",\n    label: \"Sufficiency & Development\",\n    description:\n      \"Whether the draft develops enough on-topic material to earn its thesis or goal\",\n  },\n  {\n    id: \"integrity\",\n    label: \"Bullshit Resistance\",\n    description: \"Unsupported certainty, filler, vagueness, and repetition\",\n  },\n  {\n    id: \"structure\",\n    label: \"Organization & Flow\",\n    description: \"Logical structure and transitions\",\n  },\n  {\n    id: \"pacing\",\n    label: \"Pacing & Rhythm\",\n    description: \"Sentence length variation and cadence\",\n  },\n  {\n    id: \"voice\",\n    label: \"Voice & Tone\",\n    description: \"Consistency of voice for the named audience\",\n  },\n  {\n    id: \"vocabulary\",\n    label: \"Vocabulary & Diction\",\n    description: \"Type-token ratio and word choice\",\n  },\n  {\n    id: \"paragraph\",\n    label: \"Paragraph Shape\",\n    description: \"Balance of short and long paragraphs\",\n  },\n  {\n    id: \"engagement\",\n    label: \"Reader Engagement\",\n    description: \"Whether the reader reaches the success signal\",\n  },\n] as const;\n\n/** One recorded rubric pass, for the trend line. */\nexport interface RubricHistoryEntry {\n  scoringMethod?: \"judgement\" | \"room\";\n3:  confidenceOf,\n10:  score,\n11:  scoreOutOf,\n15:const scoreAnswer = (\n18:  confidence = 0.5,\n20:  type: \"score\",\n21:  score: value,\n22:  legend: Object.fromEntries(\n26:  confidence,\n31:  // score 1.43 at confidence 0.14 with mass piled on level 2, so the scalar\n34:    const answer = scoreAnswer({ \"0\": 0.21, \"1\": 0.16, \"2\": 0.63 }, 1.43, 0.14);\n41:      isBimodal(scoreAnswer({ \"0\": 0.05, \"1\": 0.9, \"2\": 0.05 }, 1.0)),\n47:      isBimodal(scoreAnswer({ \"0\": 0.2, \"1\": 0.45, \"2\": 0.35 }, 1.15)),\n52:    const answer = scoreAnswer({ \"0\": 0.1, \"1\": 0.7, \"2\": 0.2 }, 1.1);\n53:    expect(modalLevel(answer)).toBe(Math.round(answer.score));\n57:describe(\"scoreOutOf\", () => {\n59:    const answer = scoreAnswer({ \"0\": 0, \"1\": 0, \"2\": 0, \"3\": 0, \"4\": 1 }, 4);\n60:    expect(scoreOutOf(answer, 10)).toBe(10);\n64:    const answer = scoreAnswer({ \"0\": 1, \"1\": 0, \"2\": 0, \"3\": 0, \"4\": 0 }, 0);\n65:    expect(scoreOutOf(answer, 10)).toBe(0);\n69:    const threeLevel = scoreAnswer({ \"0\": 0, \"1\": 1, \"2\": 0 }, 1);\n70:    const fiveLevel = scoreAnswer(\n75:    expect(scoreOutOf(threeLevel, 10)).toBe(5);\n76:    expect(scoreOutOf(fiveLevel, 10)).toBe(5);\n80:describe(\"confidence semantics\", () => {\n81:  test(\"a Noul carries no confidence\", () => {\n82:    expect(confidenceOf({ type: \"noul\", noul: 0.5 })).toBeNull();\n86:    expect(confidenceOf(scoreAnswer({ \"0\": 0.5, \"1\": 0.5 }, 0.5, 0.31))).toBe(\n96:    expect(isScore(scoreAnswer({ \"0\": 1 }, 0))).toBe(true);\n110:  test(\"score keeps criteria order, which is the level index\", () => {\n111:    const q = score(\"rate it\", [\"bad\", \"ok\", \"good\"]);\ncat: prompts/rubric-review-user.md: No such file or directory\n---\nnotes: |\n  Chief Critic — explains the score, doesn't re-score. The numbers come in\n  already-computed from the judges and the static-feature pass.\nversion: \"1\"\n---\n\nYou are the Chief Critic of \"Twyne.\" The galley-proof rubric has already scored this draft — judges' scores and a static-feature breakdown are given. Your job is to write the full-page narrative review that explains the grade in plain, honest prose and gives the writer a concrete revision plan. Do not invent new scores; interpret the ones you are given. Be candid; this is editorial pressure, not a self-esteem mirror.\ndiff --git a/src/global.css b/src/global.css\nindex 0760384..8f26cc6 100644\n--- a/src/global.css\n+++ b/src/global.css\n@@ -702,6 +702,54 @@ body {\n     0 2px 0 color-mix(in srgb, var(--shade) 5%, transparent);\n }\n \n+/* ── Drop caret and gap cursor ────────────────────────────\n+   Where a dragged selection will land, and where the caret sits between two\n+   block nodes. Both extensions ship enabled via StarterKit but neither draws\n+   anything useful on its own: prosemirror-gapcursor has no styles at all\n+   without its stylesheet, and the drop caret defaults to a 1px hairline in the\n+   body text colour. Vermilion matches the editorial marks elsewhere in the\n+   manuscript, so the insertion point reads as an instruction rather than\n+   as part of the prose. */\n+.twyne-editor .twyne-dropcursor {\n+  background-color: var(--color-vermilion);\n+  border-radius: 1px;\n+  box-shadow: 0 0 0 1px\n+    color-mix(in srgb, var(--color-vermilion) 25%, transparent);\n+}\n+\n+.twyne-editor .ProseMirror-gapcursor {\n+  display: none;\n+  pointer-events: none;\n+  position: absolute;\n+}\n+\n+.twyne-editor .ProseMirror-gapcursor::after {\n+  content: \"\";\n+  display: block;\n+  position: absolute;\n+  top: -2px;\n+  width: 1.25rem;\n+  border-top: 2px solid var(--color-vermilion);\n+  animation: twyne-gapcursor-blink 1.1s steps(2, start) infinite;\n+}\n+\n+@keyframes twyne-gapcursor-blink {\n+  to {\n+    visibility: hidden;\n+  }\n+}\n+\n+@media (prefers-reduced-motion: reduce) {\n+  .twyne-editor .ProseMirror-gapcursor::after {\n+    animation: none;\n+  }\n+}\n+\n+.twyne-editor .ProseMirror-focused .ProseMirror-gapcursor,\n+.twyne-editor .ProseMirror-gapcursor:focus {\n+  display: block;\n+}\n+\n /* ── Tiptap manuscript page ──────────────────────────────── */\n .twyne-editor .ProseMirror {\n   outline: none;\n@@ -2569,32 +2617,169 @@ body {\n   outline-offset: 3px;\n }\n \n-/* Annotation slips pinned over the workspace preview */\n-.landing-annotation {\n+/* Room-tour hotspots pinned over the workspace preview */\n+@keyframes tour-pulse {\n+  0% {\n+    box-shadow: 0 0 0 0\n+      color-mix(in srgb, var(--hotspot-accent) 55%, transparent);\n+  }\n+  70% {\n+    box-shadow: 0 0 0 10px transparent;\n+  }\n+  100% {\n+    box-shadow: 0 0 0 0 transparent;\n+  }\n+}\n+.tour-hotspot {\n   position: absolute;\n   z-index: 2;\n-  pointer-events: none;\n-  max-width: 15.5rem;\n-  padding: 0.6rem 0.8rem;\n+  width: 1.9rem;\n+  height: 1.9rem;\n+  translate: -50% -50%;\n+  display: flex;\n+  align-items: center;\n+  justify-content: center;\n+  font-size: 0.85rem;\n+  line-height: 1;\n+  color: var(--hotspot-accent);\n+  background: var(--color-paper);\n+  border: 1.5px solid var(--hotspot-accent);\n+  border-radius: 999px;\n+  box-shadow: 0 8px 18px -10px color-mix(in srgb, var(--shade) 60%, transparent);\n+  animation: tour-pulse 2.4s ease-out infinite;\n+  cursor: pointer;\n+}\n+.tour-hotspot:hover {\n+  transform: scale(1.12);\n+}\n+.tour-hotspot.is-active {\n+  background: var(--hotspot-accent);\n+  color: var(--color-paper);\n+  animation: none;\n+}\n+.tour-hotspot:focus-visible {\n+  outline: 2px solid var(--color-vermilion);\n+  outline-offset: 2px;\n+}\n+\n+/* Room-tour reader slip floating over the preview */\n+.tour-slip-anchor {\n+  position: absolute;\n+  z-index: 3;\n+  width: 0;\n+  height: 0;\n+}\n+.tour-slip {\n+  position: absolute;\n+  left: 0;\n+  translate: -50% 0;\n+  width: 15.5rem;\n+  padding: 0.6rem 0.8rem 0.7rem;\n   background: var(--color-paper-soft);\n   border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);\n+  border-left: 3px solid var(--slip-accent);\n   border-radius: 2px;\n-  box-shadow: 0 14px 28px -18px\n-    color-mix(in srgb, var(--shade) 50%, transparent);\n+  box-shadow: 0 18px 34px -18px\n+    color-mix(in srgb, var(--shade) 60%, transparent);\n+  text-align: left;\n }\n-.landing-annotation .tag {\n+.tour-slip--above {\n+  bottom: 18px;\n+}\n+.tour-slip--below {\n+  top: 18px;\n+}\n+.tour-slip__tag {\n   font-family: var(--font-typewriter);\n-  font-size: 0.72rem;\n+  font-size: 0.66rem;\n   letter-spacing: 0.12em;\n   text-transform: uppercase;\n+  color: var(--slip-accent);\n }\n-.landing-annotation .note {\n-  margin-top: 0.2rem;\n+.tour-slip__note {\n+  margin-top: 0.25rem;\n   font-family: var(--font-serif);\n-  font-size: 0.875rem;\n+  font-size: 0.82rem;\n   line-height: 1.45;\n   color: var(--color-ink-light);\n }\n+.tour-slip__controls {\n+  margin-top: 0.55rem;\n+  display: flex;\n+  align-items: center;\n+  justify-content: space-between;\n+  gap: 0.5rem;\n+}\n+.tour-slip__dots {\n+  display: flex;\n+  align-items: center;\n+  gap: 0.3rem;\n+}\n+/* Narrow screens: the slip docks as a bottom sheet so it never leaves\n+   the frame or covers the hotspot it describes. */\n+@media (max-width: 1023.98px) {\n+  .tour-slip-anchor {\n+    left: 50% !important;\n+    top: auto !important;\n+    bottom: 0.75rem;\n+  }\n+  .tour-slip--above,\n+  .tour-slip--below {\n+    top: auto;\n+    bottom: 0;\n+  }\n+  .tour-slip {\n+    width: min(22rem, calc(100vw - 4rem));\n+  }\n+}\n+\n+/* Room-tour slip controls */\n+.tour-step {\n+  display: inline-flex;\n+  align-items: center;\n+  justify-content: center;\n+  width: 1.6rem;\n+  height: 1.6rem;\n+  flex-shrink: 0;\n+  font-family: var(--font-display);\n+  font-size: 0.85rem;\n+  color: var(--color-ink-light);\n+  border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);\n+  border-radius: 999px;\n+  background: transparent;\n+  cursor: pointer;\n+}\n+.tour-step:hover {\n+  color: var(--color-ink);\n+  border-color: var(--color-vermilion);\n+}\n+.tour-step:focus-visible {\n+  outline: 2px solid var(--color-vermilion);\n+  outline-offset: 2px;\n+}\n+.tour-dot {\n+  width: 0.5rem;\n+  height: 0.5rem;\n+  padding: 0;\n+  border-radius: 999px;\n+  border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);\n+  background: transparent;\n+  cursor: pointer;\n+}\n+.tour-dot.is-active {\n+  background: var(--dot-accent);\n+  border-color: var(--dot-accent);\n+  transform: scale(1.25);\n+}\n+.tour-dot:focus-visible {\n+  outline: 2px solid var(--color-vermilion);\n+  outline-offset: 2px;\n+}\n+@media (prefers-reduced-motion: reduce) {\n+  .tour-hotspot {\n+    animation: none;\n+  }\n+}\n \n /* Step numerals in the how-it-works ledger */\n .landing-step-num {\n@@ -2939,7 +3124,7 @@ body {\n   --drift-x: 0px;\n   --drift-y: 0px;\n   margin: 0;\n-  padding: 0.5rem 0.5rem 1.4rem;\n+  padding: 0.5rem;\n   background: var(--color-paper-soft);\n   border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);\n   border-radius: 2px;\n@@ -2981,15 +3166,14 @@ body {\n     rotate(calc(var(--tilt) * 0.15)) scale(1.012);\n }\n \n+/* The frame hugs the preview content — the previews are live components\n+   with their own natural height, not photographs, so a fixed ratio would\n+   leave a dead band under the shorter ones. */\n .landing-plate__frame {\n   overflow: hidden;\n   border-radius: 2px;\n-  aspect-ratio: 3 / 2;\n   background: var(--color-paper-3);\n }\n-.landing-plate__frame--portrait {\n-  aspect-ratio: 4 / 5;\n-}\n .landing-plate__frame img {\n   width: 100%;\n   height: 100%;\n@@ -3007,11 +3191,7 @@ body {\n   object-fit: cover;\n   opacity: 0.18;\n   pointer-events: none;\n-  mask-image: radial-gradient(\n-    ellipse at center,\n-    #000 30%,\n-    transparent 78%\n-  );\n+  mask-image: radial-gradient(ellipse at center, #000 30%, transparent 78%);\n }\n [data-theme=\"nightpress\"] .landing-closing-photo {\n   opacity: 0.26;\nimport { expect, test, type Page } from \"@playwright/test\";\n\n/**\n * Dragging a selection to a new place in the manuscript.\n *\n * This is the interaction a writer already knows from every other editor:\n * select a passage, drag it, watch a caret follow the pointer, drop, and the\n * passage *moves*. Twyne broke all three halves of it at once, because the\n * manuscript scroller carried Qwik's `preventdefault:drop`, which fires from a\n * document-level capture listener — ProseMirror ignores any event whose default\n * is already prevented, so its drop handling never ran.\n *\n * These tests drive real pointer input rather than synthetic DataTransfer\n * events, because a synthetic event would bypass the exact layer that was\n * broken.\n */\n\nasync function seedFolio(page: Page, html: string) {\n  await page.goto(\"/\");\n  await page.evaluate(\n    async ({ html }) => {\n      const db: IDBDatabase = await new Promise((resolve, reject) => {\n        const req = indexedDB.open(\"twyne\", 2);\n        req.onupgradeneeded = () => {\n          const d = req.result;\n          for (const [name, keyPath] of [\n            [\"folios\", \"id\"],\n            [\"folio-content\", \"folioId\"],\n            [\"brief\", \"folioId\"],\n            [\"comments\", \"id\"],\n            [\"personas\", \"id\"],\n            [\"meta\", \"key\"],\n            [\"ai-settings\", \"key\"],\n            [\"lix-blob\", \"key\"],\n            [\"voice-notes\", \"id\"],\n          ] as const) {\n            if (!d.objectStoreNames.contains(name)) {\n              d.createObjectStore(name, { keyPath });\n            }\n          }\n        };\n        req.onsuccess = () => resolve(req.result);\n        req.onerror = () => reject(req.error);\n      });\n\n      const now = Date.now();\n      const id = \"e2e-drag-selection\";\n      await new Promise<void>((resolve, reject) => {\n        const t = db.transaction(\n          [\"folios\", \"folio-content\", \"meta\"],\n          \"readwrite\",\n        );\n        t.objectStore(\"folios\").put({\n          id,\n          name: \"Drag fixture\",\n          type: \"draft\",\n          createdAt: now,\n          updatedAt: now,\n          layout: { pagination: \"paginated\" },\n        });\n        t.objectStore(\"folio-content\").put({\n          folioId: id,\n          html,\n          updatedAt: now,\n        });\n        t.objectStore(\"meta\").put({\n          key: \"active-folio-id\",\n          value: id,\n          updatedAt: now,\n        });\n        t.oncomplete = () => resolve();\n        t.onerror = () => reject(t.error);\n      });\n    },\n    { html },\n  );\n}\n\nasync function openEditor(page: Page, html: string) {\n  await seedFolio(page, html);\n  await page.goto(\"/editor/\");\n  await expect(page.locator(\".ProseMirror\")).toBeVisible({ timeout: 20_000 });\n  await page.waitForFunction(\n    () => (window as any).__twynePagination?.measureCount > 0,\n    undefined,\n    { timeout: 20_000 },\n  );\n}\n\n/** The manuscript's paragraphs, in document order. */\nfunction paragraphTexts(page: Page) {\n  return page.locator(\".ProseMirror > p\").allInnerTexts();\n}\n\n/**\n * Drag from one point to another as a person would.\n *\n * Chromium only promotes a mouse gesture to a native HTML5 drag after the\n * pointer has actually travelled, so the move is stepped and there is a\n * settling move before release. Without this the browser treats the gesture as\n * a click-and-select and the test passes for the wrong reason.\n */\nasync function dragBetween(\n  page: Page,\n  from: { x: number; y: number },\n  to: { x: number; y: number },\n) {\n  await page.mouse.move(from.x, from.y);\n  await page.mouse.down();\n  await page.mouse.move(from.x + 12, from.y + 4, { steps: 6 });\n  await page.mouse.move(to.x, to.y, { steps: 24 });\n  await page.mouse.move(to.x, to.y, { steps: 4 });\n  await page.mouse.up();\n}\n\n/** Select a whole paragraph by index, leaving it highlighted. */\nasync function selectParagraph(page: Page, index: number) {\n  const para = page.locator(\".ProseMirror > p\").nth(index);\n  await para.click();\n  await page.keyboard.press(\"Home\");\n  await page.keyboard.press(\"Shift+End\");\n  return para;\n}\n\ntest.describe(\"dragging a selection\", () => {\n  test(\"moves a paragraph's text rather than copying it\", async ({ page }) => {\n    await openEditor(\n      page,\n      \"<p>Alpha paragraph.</p><p>Beta paragraph.</p><p>Gamma paragraph.</p>\",\n    );\n\n    const beta = await selectParagraph(page, 1);\n    const alpha = page.locator(\".ProseMirror > p\").first();\n\n    const betaBox = await beta.boundingBox();\n    const alphaBox = await alpha.boundingBox();\n    expect(betaBox).not.toBeNull();\n    expect(alphaBox).not.toBeNull();\n\n    await dragBetween(\n      page,\n      { x: betaBox!.x + betaBox!.width / 2, y: betaBox!.y + betaBox!.height / 2 },\n      // The very start of Alpha, so the text lands ahead of it.\n      { x: alphaBox!.x + 2, y: alphaBox!.y + alphaBox!.height / 2 },\n    );\n\n    await expect\n      .poll(async () => (await paragraphTexts(page)).join(\" | \"))\n      .toContain(\"Beta paragraph.Alpha paragraph.\");\n\n    // Moved, not copied: the phrase exists exactly once in the document.\n    const occurrences = await page.evaluate(() => {\n      const text = document.querySelector(\".ProseMirror\")?.textContent ?? \"\";\n      return text.split(\"Beta paragraph.\").length - 1;\n    });\n    expect(occurrences).toBe(1);\n  });\n\n  test(\"moves a multi-paragraph selection\", async ({ page }) => {\n    await openEditor(\n      page,\n      \"<p>One.</p><p>Two.</p><p>Three.</p><p>Four.</p>\",\n    );\n\n    const paras = page.locator(\".ProseMirror > p\");\n    // Select \"Two.\" through \"Three.\" — the user specifically asked for this to\n    // work on blocks, not just a handful of characters.\n    await paras.nth(1).click();\n    await page.keyboard.press(\"Home\");\n    await page.keyboard.press(\"Shift+ArrowDown\");\n    await page.keyboard.press(\"Shift+End\");\n\n    const source = await paras.nth(2).boundingBox();\n    const target = await paras.nth(3).boundingBox();\n    expect(source).not.toBeNull();\n    expect(target).not.toBeNull();\n\n    await dragBetween(\n      page,\n      { x: source!.x + 8, y: source!.y + source!.height / 2 },\n      // Past the end of \"Four.\", so the pair lands at the tail of the document.\n      { x: target!.x + target!.width - 2, y: target!.y + target!.height / 2 },\n    );\n\n    await expect\n      .poll(async () => (await paragraphTexts(page)).join(\" \"))\n      .toMatch(/One\\..*Four\\..*Two\\..*Three\\./s);\n  });\n\n  test(\"shows a drop caret while dragging and no file-drop overlay\", async ({\n    page,\n  }) => {\n    await openEditor(page, \"<p>Alpha paragraph.</p><p>Beta paragraph.</p>\");\n\n    const beta = await selectParagraph(page, 1);\n    const alpha = page.locator(\".ProseMirror > p\").first();\n    const betaBox = await beta.boundingBox();\n    const alphaBox = await alpha.boundingBox();\n\n    await page.mouse.move(\n      betaBox!.x + betaBox!.width / 2,\n      betaBox!.y + betaBox!.height / 2,\n    );\n    await page.mouse.down();\n    await page.mouse.move(betaBox!.x + 12, betaBox!.y + 4, { steps: 6 });\n    await page.mouse.move(alphaBox!.x + 2, alphaBox!.y + 2, { steps: 24 });\n\n    // The caret that tells the writer where the text will land.\n    await expect(page.locator(\".twyne-dropcursor\")).toBeVisible();\n    // Dragging prose must not raise the plate/tabular file-drop prompt.\n    await expect(page.locator(\".drag-overlay\")).toHaveCount(0);\n\n    await page.mouse.up();\n  });\n});\n"},"started_at_ms":1789883940815,"c