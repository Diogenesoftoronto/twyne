"The plan failed.\\\",\\n  voiceSamples: [{ id: \\\"v1\\\", text: \\\"The bridge grinned at our little maps.\\\" }],\\n  scraps: [{ id: \\\"s1\\\", text: \\\"The bridge had been closed since June.\\\" }],\\n  notes: [\\n    { id: \\\"n1\\\", text: \\\"Explain the background first.\\\" },\\n    { id: \\\"n2\\\", text: \\\"Start with the action.\\\" },\\n  ],\\n  revisions: [\\n    { id: \\\"r1\\\", text: \\\"A plan.\\\" },\\n    { id: \\\"r2\\\", text: \\\"A failed plan.\\\" },\\n  ],\\n  sources: [\\n    {\\n      id: \\\"source1\\\",\\n      claim: \\\"The bridge was closed.\\\",\\n      source: \\\"The bridge closed in June.\\\",\\n      previousClaim: \\\"The bridge may have been closed.\\\",\\n    },\\n  ],\\n};\\n\\ndescribe(\\\"writing lenses\\\", () =\u003e {\\n  test(\\\"every lens runs using bounded typed questions and supplied quotes\\\", async () =\u003e {\\n    for (const lens of WRITING_LENSES) {\\n      const result = await runWritingLens(lens.id, input, caller());\\n      expect(result.status).toBe(\\\"complete\\\");\\n      expect(result.findings.length).toBeGreaterThan(0);\\n      expect(result.coverage.length).toBeGreaterThan(0);\\n      for (const finding of result.findings)\\n        expect(finding.passage).toBeTruthy();\\n    }\\n\"}","type":"input_text"},{"text":"{\"chunk_id\":\"58cac5\",\"wall_time_seconds\":1.00088793,\"session_id\":44739,\"original_token_count\":0,\"output\":\"\"}","type":"input_text"},{"text":"{\"chunk_id\":\"7a34d0\",\"wall_time_seconds\":1.000989758,\"session_id\":44102,\"original_token_count\":0,\"output\":\"\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_0d2613c88aa32939016aaf7b51cc4c87d18fef8dbc5286ef93","internal_chat_message_metadata_passthrough":{"turn_id":"01a0bd69-84d5-7c33-89bf-e3198d5b775f"},"summary":[],"type":"reasoning"},{"call_id":"call_GzFMWnwHIq1egGwBscUyZ7t6","id":"ctc_0d2613c88aa32939016aaf7b529c5c87d1a5bf102343badfd3","input":"text(await tools.apply_