p and 'card' not in p: print(p,v['rect'])\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"sentence-lab {'x': 289, 'y': 308.578125, 'width': 296, 'height': 337.71875}\n.in-flow-card__head {'x': 306.390625, 'y': 322.375, 'width': 263.21875, 'height': 45.78125}\n.in-flow-card__foot {'x': 306.390625, 'y': 607.3125, 'width': 263.21875, 'height': 26.796875}\nrhythm-strip {'x': 289, 'y': 308.578125, 'width': 296, 'height': 313.984375}\n.in-flow-card__head {'x': 306.390625, 'y': 322.375, 'width': 263.21875, 'height': 45.78125}\n.in-flow-card__foot {'x': 306.390625, 'y': 583.578125, 'width': 263.21875, 'height': 26.796875}\n.numeric-stepper {'x': 454.6875, 'y': 459.21875, 'width': 105.59375, 'height': 28.796875}\n.numeric-stepper {'x': 321.046875, 'y': 494.40625, 'width': 105.59375, 'height': 28.796875}\ncontrols [{'action': 'initial', 'min': '8', 'max': '28'}, {'action': 'minimum ArrowUp', 'min': '9', 'max': '28'}, {'action': 'minimum ArrowDown', 'min': '8', 'max': '28'}, {'action': 'minimum typed 79', 'min': '79', 'max': '80'}, {'action': 'maximum typed 200', 'min': '79', 'max': '120'}, {'action': 'minimum cleared and blurred', 'min': '', 'max': '120'}, {'action': 'empty minimum ArrowUp', 'min': '80', 'max': '120'}]\nclaim-check {'x': 289, 'y': 308.578125, 'width': 296, 'height': 375.6875}\n.in-flow-card__head {'x': 306.390625, 'y': 322.375, 'width': 263.21875, 'height': 45.78125}\n.in-flow-slot {'x': 306.390625, 'y': 445.90625, 'width': 212.375, 'height': 43.375}\n.in-flow-slot {'x': 306.390625, 'y': 494.875, 'width': 263.21875, 'height': 43.375}\n.in-flow-slot {'x': 306.390625, 'y': 543.84375, 'width': 263.21875, 'height': 43.375}\n.in-flow-input {'x': 306.390625, 'y': 598.40625, 'width': 263.21875, 'height': 34.875}\n.in-flow-card__foot {'x': 306.390625, 'y': 645.28125, 'width': 263.21875, 'height': 26.796875}\nreader-questions {'x': 289, 'y': 308.578125, 'width': 296, 'height': 401.40625}\n.in-flow-card__head {'x': 306.390625, 'y': 322.375, 'width