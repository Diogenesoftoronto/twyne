col state. No credential transport or authentication\n//! is implemented here. Caller-provided identities/receipts are consistency inputs,\n//! not cryptographic proof. See fixtures/account-sync/contracts.md.\n\npub mod auth;\npub mod callback;\npub mod journal;\npub mod protocol;\npub mod store;\npub mod transport;\n\npub use auth::{AccountIdentity, SessionLease};\npub use journal::{AccountJournal, ApplyReceipt, Conflict, Dispatch, PushAcknowledgement};\npub use protocol::{PullSnapshot, SyncPayload};\npub use store::{AccountSyncStore, LoadedJournal};\n\n#[cfg(test)]\nmod tests;\n"},"started_at_ms":1791216611898,"completed_at_ms":1791216611898}}
