ay(start));\\n+    }\\n+    if (length) throw new ConnectedError(\\\"invalidRequest\\\");\\n+  } finally {\\n+    // Closing the native host pipe invalidates every account-qualified request.\\n+    session?.dispose();\\n+    reader.releaseLock();\\n+    await Promise.allSettled(active);\\n+  }\\n+}\\n+if (process.argv[2] === \\\"--version\\\") {\\n+  console.log(\\\"Twyne connected helper, protocol 1\\\");\\n+} else if (process.argv[2] === \\\"--stdio-v1\\\" && process.argv.length === 3) {\\n+  try { await run(); } catch { process.exitCode = 1; }\\n+} else {\\n+  process.exitCode = 2;\\n+}\\n*** Add File: /home/diogenes/Projects/twyne/desktop/gpui/tools/build-connected.ts\\n+import { mkdir } from \\\"node:fs/promises\\\";\\n+import { resolve } from \\\"node:path\\\";\\n+\\n+const name = process.platform === \\\"win32\\\" ? \\\"twyne-connected.exe\\\" : \\\"twyne-connected\\\";\\n+const directory = process.argv[2]\\n+  ? resolve(process.argv[2]) : resolve(import.meta.dir, \\\"../target/release\\\");\\n+await mkdir(directory, { recursive: true });\\n+const child = Bun.spawn([\\n+  process.execPath, \\\"build\\\", \\\"--compile\\\", \\\"--minify\\\",\\n+  resolve(import.meta.dir, \\\"connected/main.ts\\\"), \\\"--outfile\\\", resolve(directory, name),\\n+], { stdout: \\\"inherit\\\", stderr: \\\"inherit\\\" });\\n+if (await child.exited) throw new Error(\\\"The connected helper did not build.\\\");\\n*** End Patch\"));\nconst results=await Promise.allSettled([\n  tools.exec_command({cmd:\"rtk proxy bun test desktop/gpui/tools/connected\",yield_time_ms:1000,max_output_tokens:3800}),\n  tools.exec_command({cmd:\"rtk proxy bunx --no-install tsc --noEmit --strict --skipLibCheck --target ESNext --module ESNext --moduleResolution Bundler --types bun desktop/gpui/tools/connected/session.ts desktop/gpui/tools/connected/vault.ts desktop/gpui/tools/connected/main.ts desktop/gpui/tools/connected/session.test.ts desktop/gpui/tools/connected/vault.test.ts desktop/gpui/tools/build-c