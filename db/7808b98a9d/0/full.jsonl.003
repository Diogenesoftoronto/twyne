(\\\"/settings/\\\")\" },\n            { \"order\": 2, \"text\": \"My Desk\", \"icon\": \"house\", \"iconSize\": 16, \"action\": \"close menu, then nav(\\\"/desk/\\\")\" },\n            { \"order\": 3, \"text\": \"The Manual\", \"icon\": \"book-open\", \"iconSize\": 16, \"action\": \"close menu, then nav(\\\"/docs/\\\")\" },\n            { \"order\": 4, \"text\": \"Privacy ledger\", \"icon\": \"shield-check\", \"iconSize\": 16, \"action\": \"close menu, then nav(\\\"/privacy-ledger/\\\")\" }\n          ]\n        },\n        {\n          \"id\": \"invitations\",\n          \"condition\": \"invitations.length > 0\",\n          \"verifiedGuestBehavior\": \"cleared/hidden when not authenticated (useVisibleTask$ returns early; list spliced empty), so section is not rendered signed out\"\n        },\n        {\n          \"id\": \"shared\",\n          \"condition\": \"sharedFolios.length > 0\",\n          \"verifiedGuestBehavior\": \"cleared/hidden when not authenticated, so section is not rendered signed out\"\n        },\n        {\n          \"id\": \"auth-panel\",\n          \"condition\": \"always rendered when menu open\",\n          \"branch\": \"signed-out branch\",\n          \"label\": \"The Editor's Office (dept-label)\",\n          \"heading\": \"Sign in with your Not Organic account.\",\n          \"subtext\": \"New here? You can create one on the next page. The same account holds your plan, your credit and your published writing.\",\n          \"error\": \"optional ApplicationNotice (compact) when store.error set\",\n          \"button\": { \"idle\": \"Continue with Not Organic\", \"busy\": \"Redirecting…\", \"disabledWhen\": \"store.redirecting\" }\n        }\n      ]\n    }\n  },\n  \"signed_in_menu\": {\n    \"state\": \"verified Source: auth.value.user is truthy (auth.loading false)\",\n    \"trigger\": {\n      \"element\": \"button type=button\",\n      \"title\": \"Signed in as {accountDisplay}\",\n      \"ariaLabel\": \"Open account menu. Signed in as {accountDisplay}\",\n      \"ariaExpanded\": \"menuOpen.value\",\n      \"class\": \"icon-btn gap-1.5 border border-[var(--color-sage)] bg-[var(--color-paper-soft)] px-2 py-1.5 text-[var(--color-ink)] hover:text-[var(--color-vermilion)]\",\n      \"contentOrder\": [\n        { \"order\": 1, \"condition\": \"avatar URL valid AND failedAvatar !== avatar\", \"element\": \"img src=avatar alt=\\\"\\\" width=20 height=20 referrerPolicy=no-referrer\", \"class\": \"h-5 w-5 flex-shrink-0 rounded-full object-cover\", \"onError\": \"set failedAvatar=avatar\" },\n        { \"order\": 1, \"condition\": \"no avatar OR failedAvatar === avatar\", \"element\": \"span aria-hidden=true\", \"text\": \"accountInitials(accountDisplay)\", \"class\": \"flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-paper-3)] text-[9px] font-semibold\" },\n        { \"order\": 2, \"element\": \"span\", \"text\": \"{accountDisplay}\", \"class\": \"hidden max-w-[8.5rem] truncate text-[11px] font-semibold lg:inline\", \"style\": \"font-family: var(--font-sans)\" }\n      ]\n    },\n    \"panel\": {\n      \"identical to guest panel sections and order; differs only by conditional sections below and AuthPanel branch\",\n      \"sectionsInOrder\": [\n        { \"id\": \"nav\", \"items\": [\"Preferences\", \"My Desk\", \"The Manual\", \"Privacy ledger\"], \"note\": \"same labels, icons, order, and actions as guest_menu.nav (verified)\" },\n        {\n          \"id\": \"invitations\",\n          \"condition\": \"invitations.length > 0\",\n          \"heading\": \"Invitations\",\n          \"headingClass\": \"px-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-light)]\",\n          \"perItem\": [\n            { \"text\": \"{folioName}\", \"class\": \"truncate text-sm text-[var(--color-ink)]\" },\n            { \"text\": \"Invited as {role}\", \"class\": \"mt-0.5 text-[11px] text-[var(--color-ink-light)]\" },\n            { \"button\": \"Open\", \"