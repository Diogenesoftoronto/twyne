ndow.text_system().shape_line(\\n570-            self.label.clone(),\\n571-            px(self.size),\\n572-            &[TextRun {\\n573-                len: self.label.len(),\\n574-                font: self.face.clone(),\\n575-                color: rgb(self.color).into(),\\n576-                ..Default::default()\\n577-            }],\\n578-            None,\\n579-        );\\n580-        let mut cursor = shape.cursor();\\n581-        let parts = self\\n582-            .label\\n583-            .grapheme_indices(true)\\n584-            .enumerate()\\n585-            .map(|(index, (start, grapheme))| {\\n586-                (\\n587-                    cursor.take_until(start + grapheme.len()),\\n588-                    shape.x_for_index(start) + px(self.tracking * index as f32),\\n589-                )\\n590-            })\\n591-            .collect::<Vec<_>>();\\n592-        let mut style = Style::default();\\n593-        style.size.width = (shape.width() + px(self.tracking * parts.len() as f32)).into();\\n594-        style.size.height = px(self.line_height).into();\\n595-        style.flex_shrink = 0.;\\n596-        (\\n597-            window.request_layout(style, [], cx),\\n598-            TrackedRunLayout { parts },\\n599-        )\\n600-    }\\n601-    fn prepaint(\\n602-        &mut self,\\n603-        _: Option<&GlobalElementId>,\\n604-        _: Option<&InspectorElementId>,\\n605-        _: Bounds<Pixels>,\\n606-        _: &mut Self::RequestLayoutState,\\n\"}}}"},{"type":"input_text","text":"{\"index\":1,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"80f889\",\"wall_time_seconds\":0.00003325,\"exit_code\":0,\"original_token_count\":332,\"output\":\"    pub fn styles(mut self, build: impl FnOnce(ButtonStyles) -> ButtonStyles) -> Self {\\n        self.semantic_styles = build(self.semantic_styles);\\n        self\\n    }\\n\\n    /// Sets the label exposed to accessibility clients.\\n    pub fn accessibility_label(mut self, label: impl Into<SharedString>) -> Self {\\n        self.accessibility_label = Some(label.into());\\n        self\\n    }\\n\\n    /// Overrides the accessibility role. The default is [`Role::Button`].\\n    pub fn role(mut self, role: impl Into<RoleOverride>) -> Self {\\n        self.role = role.into();\\n        self\\n    }\\n\\n    /// Uses a caller-owned focus handle instead of creating keyed state.\\n    pub fn track_focus(mut self, focus_handle: &FocusHandle) -> Self {\\n        self.provided_focus_handle = Some(focus_handle.clone());\\n        self\\n    }\\n\\n    /// Sets the activation handler for pointer, Enter, and Space input.\\n    pub fn on_click(\\n        mut self,\\n        handler: impl Fn(&ClickEvent, &mut Window, &mut App) + 'static,\\n    ) -> Self {\\n        self.on_click = Some(Rc::new(handler));\\n        self\\n    }\\n\\n    /// Sets the focus traversal index. The default is `0`.\\n    pub fn tab_index(mut self, tab_index: isize) -> Self {\\n        self.tab_index = tab_index;\\n        self\\n    }\\n\\n    /// Sets whether the button participates in keyboard focus traversal.\\n\"}}}"},{"type":"input_text","text":"{\"index\":2,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"4f96b6\",\"wall_time_seconds\":0.000037183,\"exit_code\":0,\"original_token_count\":189,\"output\":\"#[derive(Default)]\\npub struct ButtonStyles {\\n    selected: StyleRefinement,\\n    disabled: StyleRefinement,\\n}\\n\\nimpl ButtonStyles {\\n    /// Refines the root style when the button is selected.\\n    pub fn selected(mut self, build: impl FnOnce(StateStyle) -> StateStyle) -> Self {\\n        self.selected\\n            .refine(&build(StateStyle::default()).into_refinement());\\n        self\\n    }\\n\\n    /// Refines the root style when the button is disabled.\\n    pub fn disabled(mut self, build: impl FnOnce(StateStyle) -> StateStyle) -> Self {\\n        self.disabled\\n            .refine(&build(StateStyle::default()).into_refinement());\\n        self\\n    }\\n}\\n\\nimpl Styled for Button {\\n    fn style(&mut self) -> &mut StyleRefinement {\\n        &mut self.style\\n    }\\n\"}}}"},{"type":"input_text","text":"{\"index\":3,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"7a28ae\",\"wall_time_seconds\":0.00003101,\"exit_code\":0,\"original_token_count\":40,\"output\":\"desktop/gpui/vendor/gpui-pre/src/interactive.rs:148:pub struct MouseDownEvent {\\ndesktop/gpui/vendor/gpui-pre/src/interactive.rs:494:pub struct MouseMoveEvent {\\n\"}}}"},{"type":"input_text","text":"{\"index\":4,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"38a364\",\"wall_time_seconds\":0.00002631,\"exit_code\":0,\"original_token_count\":423,\"output\":\"use super::*;\\nuse serde_json::Value;\\n\\nfn fixture() -> Value {\\n    serde_json::from_str(include_str!(\\n        \\\"../../fixtures/editor/notes/source-reference.json\\\"\\n    ))\\n    .unwrap()\\n}\\nfn references(editor: &RichEditor) -> Arc<[NoteReference]> {\\n    NoteCatalog::default().references(editor.document(), editor.revision())\\n}\\n\\n#[test]\\nfn original_note_update_conversion_empty_delete_and_history_keep_exact_tree_and_unicode_selection()\\n{\\n    let fixture = fixture();\\n    let steps = fixture[\\\"steps\\\"].as_array().unwrap();\\n    let mut editor =\\n        RichEditor::new(RichDocument::from_html(steps[0][\\\"html\\\"].as_str().unwrap()).unwrap());\\n    for step in steps.iter().skip(1) {\\n        let before = editor.document().clone();\\n        let before_selection = editor.selection();\\n        let reference = references(&editor)[0].clone();\\n        match step[\\\"action\\\"].as_str().unwrap() {\\n            \\\"selected\\\" => editor\\n                .set_selection(Selection::new(reference.position, reference.position + 1))\\n                .unwrap(),\\n            \\\"updated\\\" => {\\n                editor\\n                    .execute(Command::UpdateNote {\\n                        path: reference.path,\\n                        expected: reference.node,\\n                        text: Some(\\\"A & \\\\\\\"B\\\\\\\" — 東京 🦊\\\".into()),\\n                        kind: None,\\n                    })\\n                    .unwrap();\\n            }\\n            \\\"converted\\\" => {\\n                editor\\n                    .execute(Command::UpdateNote {\\n                        path: reference.path,\\n                        expected: reference.node,\\n                        text: None,\\n                        kind: Some(NoteKind::Footnote),\\n\"}}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10daa-98ac-7341-8bf7-59561f3acc7f","create_time":1791232735.4022346}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
