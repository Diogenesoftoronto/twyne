ditor.on(\\\"transaction\\\", refreshSlashMenu);\\n        refreshSlashMenu();\\n\\n        // Seed the colophon (word count, folios) from the loaded draft.\\n        applyDocumentMeta(store.meta, editor.getText());\\n\\n        // ── Mermaid rendering ──\\n        // Shared theme with the insert-dialog preview, so the manuscript and\\n        // the preview never drift apart. Renders wait for the theme so the\\n        // first paint isn't unthemed.\\n        const mermaidReady = initializeTwyneMermaid();\\n        function renderMermaid() {\\n          // Most manuscripts contain no diagram at all; there is no reason to\\n          // schedule a frame and hand Mermaid the document to scan for one.\\n          let hasDiagram = false;\\n          editor.state.doc.descendants((node) => {\\n            if (hasDiagram) return false;\\n            if (node.type.name === \\\"mermaidDiagram\\\") hasDiagram = true;\\n            return !hasDiagram;\\n          });\\n          if (!hasDiagram) return;\\n          void mermaidReady.then(() => {\\n            requestAnimationFrame(() => {\\n              mermaid\\n                .run({ querySelector: \\\".twyne-mermaid-diagram\\\" })\\n                .catch(() => {\\n                  // Mermaid syntax errors are benign; leave the source visible.\\n                });\\n            });\\n          });\\n        }\\n        renderMermaid();\\n\\n        // ── Multiplayer: presence + remote cursors + remote content sync ──\\n        if (sharedLixId && clientSig.value) {\\n          const mpClient = clientSig.value;\\n          const folioForSync = activeFolioId ?? \\\"\\\";\\n\\n          startPresence(mpClient, sharedLixId);\\n          watchRemoteChanges(editor, folioForSync);\\n\\n          // Report local cursor + selection to the presence layer.\\n          const reportCursor = () => {\\n            const { from, to } = editor.state.selection;\\n            updateCursor(\\n              mpClient,\\n              from,\\n              from !== to ? from : undefined,\\n              from !== to ? to : undefined,\\n            );\\n          };\\n          editor.on(\\\"selectionUpdate\\\", reportCursor);\\n\\n          // Poll presence → update remote cursor decorations.\\n          const pollPresence = async () => {\\n            try {\\n              const presence = (await mpClient.query(\\n                api.collaboration.getPresence,\\n                { lixId: sharedLixId },\\n              )) as RemoteCursor[];\\n              editor.commands.setRemoteCursors(presence);\\n            } catch {\\n              // best-effort\\n            }\\n          };\\n          void pollPresence();\\n          const presenceTimer = setInterval(pollPresence, 3000);\\n\"}\n{\"i\":1,\"chunk_id\":\"d78d9c\",\"wall_time_seconds\":0.000018862,\"exit_code\":0,\"original_token_count\":9,\"output\":\"3500:        case \\\"insert.table\\\":\\n\"}\n{\"i\":2,\"chunk_id\":\"b39bb0\",\"wall_time_seconds\":0.000010734,\"exit_code\":0,\"original_token_count\":1938,\"output\":\"//! Title and body controls for exact-text prototype drafts.\\n//! Rich/Typst workspaces keep their existing single native document editor.\\nuse super::*;\\n\\npub(super) fn title_state(\\n    window: &mut Window,\\n    cx: &mut Context<WritingRoom>,\\n) -> Entity<TextareaState> {\\n    cx.new(|cx| {\\n        TextareaState::new(window, cx)\\n            .auto_grow(1, twyne_desktop::manuscript::MAX_DOCUMENT_BYTES)\\n            .submit_on_enter(true)\\n            .placeholder(\\\"Untitled manuscript\\\")\\n    })\\n}\\n\\nimpl WritingRoom {\\n    pub(super) fn prototype_title_event(\\n        &mut self,\\n        event: &InputEvent,\\n        window: &mut Window,\\n        cx: &mut Context<Self>,\\n    ) {\\n        match event {\\n            InputEvent::Change => {\\n                self.changed(window, cx);\\n                self.reveal_caret_next_frame(window, cx);\\n            }\\n            InputEvent::PressEnter { shift: false, .. } => {\\n                if self.rich.is_none() {\\n                    self.body.update(cx, |body, cx| {\\n                        body.set_selected_range(0..0, cx);\\n                        body.focus(window, cx);\\n                    });\\n                }\\n                self.reveal_caret_next_frame(window, cx);\\n            }\\n            _ => {}\\n        }\\n    }\\n\\n    pub(super) fn prototype_caret_line_bounds(\\n        &self,\\n        window: &Window,\\n        cx: &App,\\n    ) -> Option<gpui_kit::Bounds<gpui_kit::Pixels>> {\\n        if self.rich.is_some() || self.reading {\\n            return None;\\n        }\\n        [&self.title, &self.body].into_iter().find_map(|state| {\\n            let state = state.read(cx);\\n            if !state.focus_handle(cx).is_focused(window) {\\n                return None;\\n            }\\n            let (bounds, line_height) = state.cursor_layout()?;\\n            // GPUI's caret occupies 85% of the line. Reveal the complete line,\\n            // including its leading, so title accents/descenders stay visible.\\n            Some(gpui_kit::Bounds::new(\\n                gpui_kit::point(bounds.left(), bounds.center().y - line_height / 2.),\\n                gpui_kit::size(bounds.size.width, line_height),\\n            ))\\n        })\\n    }\\n\\n    pub(super) fn prototype_manuscript_page(\\n        &self,\\n        readonly: bool,\\n        cx: &mut Context<Self>,\\n    ) -> gpui_kit::AnyElement {\\n        div()\\n            .id(\\\"manuscript-page\\\")\\n            .test_support()\\n            .flex_1()\\n            .min_h_0()\\n            .w_full()\\n            .overflow_y_scroll()\\n            .track_scroll(&self.writing_scroll)\\n            .capture_action(\\n                cx.listener(|this, _: &gpui_kit::base::input::MoveUp, window, cx| {\\n                    if this.body.read(cx).focus_handle(cx).is_focused(window)\\n                        && this.body.read(cx).selected_range() == (0..0)\\n                    {\\n                        this.title.update(cx, |title, cx| {\\n                            let end = title.text().len();\\n                            title.set_selected_range(end..end, cx);\\n                            title.focus(window, cx);\\n                        });\\n                        this.reveal_caret_next_frame(window, cx);\\n                        cx.stop_propagation();\\n                    } else {\\n                        cx.propagate();\\n                    }\\n                }),\\n            )\\n            .capture_key_down(cx.listener(|this, _, window, cx| {\\n                this.reveal_caret_next_frame(window, cx);\\n            }))\\n            .on_mouse_up(\\n                gpui_kit::MouseButton::Left,\\n                cx.listener(|this, _, window, cx| {\\n                    this.reveal_caret_next_frame(window, cx);\\n                }),\\n            )\\n            .child(\\n                div()\\n                    .flex()\\n                    .flex_col()\\n                    .min_h_full()\\n                    .pt(px(if self.desk.zen { 20. } else { 16. }))\\n                    .pb(px(if self.desk.zen { 48. } else { 16. }))\\n                    .child(\\n                        div()\\n                            .id(\\\"manuscript-title\\\")\\n                            .test_support()\\n                            .flex_shrink_0()\\n                            .min_h(px(44.))\\n                            .child(\\n                                Textarea::new(&self.title)\\n                                    .xsmall()\\n                                    .appearance(false)\\n                                    .bordered(false)\\n                                    .font_family(DISPLAY_FONT)\\n                                    .text_size(px(40.))\\n                                    .line_height(px(44.))\\n                                    .font_weight(FontWeight::BOLD)\\n                                    .text_center()\\n                                    .readonly(readonly)\\n                                    .aria_label(\\\"Manuscript title\\\"),\\n                            ),\\n                    )\\n                    .child(\\n                        div()\\n                            .flex_shrink_0()\\n                            .text_size(px(16.))\\n                            .line_height(px(17.6))\\n                            .text_center()\\n                            .text_color(rgb(palette(cx).vermilion))\\n                            .mt(px(4.8))\\n                            .mb(px(18.))\\n                            .child(\\\"✦\\\"),\\n                    )\\n                    .child(\\n                        div()\\n                            .id(\\\"body-field\\\")\\n                            .test_support()\\n                            .flex_shrink_0()\\n                            .min_h(px(32.4))\\n                            .when(!self.reading, |this| {\\n                                this.child(\\n                                    Textarea::new(&self.body)\\n                                        .xsmall()\\n                                        .appearance(false)\\n                                        .bordered(false)\\n                                        .font_family(SERIF_FONT)\\n                                        .text_size(px(18.))\\n                                        .line_height(px(32.4))\\n                                        .readonly(readonly)\\n                                        .aria_label(\\\"Manuscript body\\\"),\\n                                )\\n                            })\\n                            .when(self.reading, |this| {\\n                                this.child(\\n                                    div()\\n                                        .id(\\\"reading-view\\\")\\n                                        .font_family(SERIF_FONT)\\n                                        .text_size(px(18.))\\n                                        .line_height(relative(1.8))\\n                                        .when(self.active_document().workspace.is_none(), |this| {\\n                                            this.child(TextView::markdown(\\n                                                \\\"manuscript-preview\\\",\\n                                                self.preview.clone(),\\n                                            ))\\n                                        })\\n                                        .when(self.active_document().workspace.is_some(), |this| {\\n                                            this.child(TextView::html(\\n                                                \\\"manuscript-preview\\\",\\n                                                self.preview.clone(),\\n                                            ))\\n                                        }),\\n                                )\\n                            }),\\n                    ),\\n            )\\n            .into_any_element()\\n    }\\n}\\n\\n#[cfg(all(test, feature = \\\"ui-tests\\\"))]\\n#[path = \\\"manuscript_tests.rs\\\"]\\nmod tests;\\n\"}\n{\"i\":3,\"chunk_id\":\"922a8f\",\"wall_time_seconds\":0.004203446,\"exit_code\":2,\"original_token_count\":34,\"output\":\"/nix/store/qf2wzyq4irhgyhnq3s2hz0ldjq3w8a3x-gnused-4.10/bin/sed: can't read desktop/gpui/src/editor/core.rs: No such file or directory\\n\"}\n{\"i\":4,\"chunk_id\":\"ce094c\",\"wall_time_seconds\":0.000011151,\"exit_code\":0,\"original_token_count\":1855,\"output\":\"//! Twyne's web palette and type faces projected into native GPUI controls.\\n//!\\n//! Palette constants are generated from src/global.css. Presets and custom\\n//! overrides use the same preference shape as src/utils/theme.ts.\\n\\nuse gpui_kit::component::{Theme, ThemeMode};\\nuse gpui_kit::{App, Font, FontFallbacks, FontFeatures, Global, Hsla, SharedString, font, px, rgb};\\nuse serde::{Deserialize, Serialize};\\nuse std::{\\n    borrow::Cow,\\n    collections::BTreeMap,\\n    sync::{Arc, OnceLock},\\n};\\n\\npub const SANS_FONT: &str = \\\"DM Sans\\\";\\n/// Original DM Sans 4.004 at the actual paper-button axes opsz12/wght600.\\n/// Use only for 12px/600 UI controls; canonical/default family stays DM Sans.\\npub const BUTTON_FONT: &str = \\\"Twyne Button Sans\\\";\\n/// Exact original File U+25BE fallback. Restrict this face to that glyph;\\n/// shared Sans and Typst font selection remain unchanged.\\npub const FILE_DISCLOSURE_FONT: &str = \\\"Noto Sans Math\\\";\\n// Original Lora 3.008 outlines, instantiated for the native renderer. The\\n// derived internal name respects Lora's Reserved Font Name; source stays Lora.\\npub const SERIF_FONT: &str = \\\"Twyne Body\\\";\\npub const DISPLAY_FONT: &str = \\\"Libre Baskerville\\\";\\npub const TYPEWRITER_FONT: &str = \\\"Special Elite\\\";\\n// The web root does not load JetBrains Mono or Fira Code, though its CSS\\n// names them first. Use Twyne's existing bundled mono export fallback so\\n// native code has an available face on every supported platform.\\npub const MONO_FONT: &str = \\\"DejaVu Sans Mono\\\";\\n/// Original math textarea's actual ui-monospace fallback in the Source fixture.\\n/// The retained UA value node selects this already bundled regular face.\\npub const MATH_SOURCE_MONO_FONT: &str = \\\"Noto Sans Mono\\\";\\n/// Original app's measured Noto Mono 2.014 fallback, restricted to Source UI.\\n/// Regular400/heading600 are unchanged outlines; native comment oblique uses\\n/// the original browser's quarter-shear mechanism, with its raster gap explicit.\\npub const SOURCE_FONT: &str = \\\"Twyne Source\\\";\\n/// Original DM Sans 4.004 opsz11/wght400 for 11px Source helper and footer labels.\\npub const SOURCE_HELPER_FONT: &str = \\\"Twyne Source Label\\\";\\n/// Footer-only alias of the exact original 11px/400 optical-size face.\\n/// Default Sans/source attributes/Typst families and bytes remain unchanged.\\npub const FOOTER_FONT: &str = SOURCE_HELPER_FONT;\\npub const SERIF_CJK_FALLBACK_FONT: &str = \\\"Droid Sans Fallback\\\";\\n\\n/// Maps the canonical source family only while selecting a native UI face.\\n/// Stored HTML/Typst family names and font menu labels remain unchanged.\\npub fn resolve_ui_font_family(family: &str) -> SharedString {\\n    match family {\\n        \\\"Lora\\\" | SERIF_FONT => SERIF_FONT.into(),\\n        SANS_FONT => SANS_FONT.into(),\\n        BUTTON_FONT => BUTTON_FONT.into(),\\n        DISPLAY_FONT => DISPLAY_FONT.into(),\\n        MONO_FONT => MONO_FONT.into(),\\n        TYPEWRITER_FONT => TYPEWRITER_FONT.into(),\\n        other => other.to_owned().into(),\\n    }\\n}\\n\\n/// The exact CJK face used by the original browser's Lora writing fixture.\\n/// The caller applies this to a final Lora Font after explicit family marks;\\n/// Latin glyphs remain in the original primary face. Only the Arc is cloned.\\npub fn serif_font_fallbacks() -> FontFallbacks {\\n    static FALLBACKS: OnceLock<FontFallbacks> = OnceLock::new();\\n    FALLBACKS\\n        .get_or_init(|| FontFallbacks::from_fonts(vec![SERIF_CJK_FALLBACK_FONT.into()]))\\n        .clone()\\n}\\n\\n/// The original Source fixture selects this same Droid face for CJK/kana.\\n/// Hangul and emoji remain platform fallback boundaries; no font lookup or\\n/// generation occurs here, only a clone of the cached immutable chain.\\npub fn source_font_fallbacks() -> FontFallbacks {\\n    serif_font_fallbacks()\\n}\\n\\npub fn source_font() -> Font {\\n    let mut face = font(SOURCE_FONT);\\n    face.fallbacks = Some(source_font_fallbacks());\\n    face\\n}\\n\\n/// Original Apparatus URL/details fallback selected by Chrome at 11px/400.\\n/// This unmodified Noto Sans Mono 2.014 face is already embedded alongside the\\n/// Source originals. Restrict it to Apparatus; shared mono and Source adapters\\n/// retain their existing families, styles, and fallback chains.\\npub fn apparatus_mono_font() -> Font {\\n    font(\\\"Noto Sans Mono\\\")\\n}\\n\\n/// The original span requests600/normal and Chrome selects Regular Math3.000.\\n/// GPUI retains that original glyph/advance; Chromium fallback faux-bold is\\n/// a separate tiny-glyph raster boundary, not an invented heavier face.\\npub fn file_disclosure_font() -> Font {\\n    let mut face = font(FILE_DISCLOSURE_FONT);\\n    face.weight = gpui_kit::FontWeight::SEMIBOLD;\\n    face\\n}\\n\\n/// The original Cast circles request DM Sans 400, but their source symbols\\n/// select Inter (heart), Liberation Sans (spade/diamond/club), and Adwaita Mono\\n/// (four-point star). Apply this cached chain only to those badge glyphs.\\n/// All three exact original fallback faces are bundled for offline selection.\\npub fn cast_badge_font() -> Font {\\n    static FALLBACKS: OnceLock<FontFallbacks> = OnceLock::new();\\n    let mut face = font(SANS_FONT);\\n    face.fallbacks = Some(\\n        FALLBACKS\\n            .get_or_init(|| {\\n                FontFallbacks::from_fonts(vec![\\n                    \\\"Inter\\\".into(),\\n                    \\\"Liberation Sans\\\".into(),\\n                    \\\"Adwaita Mono\\\".into(),\\n                ])\\n            })\\n            .clone(),\\n    );\\n    face\\n}\\n\\n/// The original Manager assistance glyphs inherit Libre Baskerville 16px/600.\\n/// Its missing suit glyphs select Liberation Serif Bold; the four-point star\\n/// selects Adwaita Mono Regular. Use only for these raw Manager spans, never\\n/// the DM Sans circles or Lora card headings. All source symbols stay intact.\\npub fn cast_raw_glyph_font() -> Font {\\n    static FALLBACKS: OnceLock<FontFallbacks> = OnceLock::new();\\n    let mut face = font(DISPLAY_FONT);\\n    face.weight = gpui_kit::FontWeight::SEMIBOLD;\\n    face.fallbacks = Some(\\n        FALLBACKS\\n            .get_or_init(|| {\\n                FontFallbacks::from_fonts(vec![\\\"Liberation Serif\\\".into(), \\\"Adwaita Mono\\\".into()])\\n            })\\n            .clone(),\\n    );\\n    face\\n}\\npub const REM_PX: f32 = 16.;\\npub const DEPARTMENT_LABEL_PX: f32 = 10.;\\npub const MASTHEAD_PX: f32 = 32.;\\npub const PAPER_BUTTON_PX: f32 = 12.;\\n\\n#[derive(Clone, Copy, Debug, Default, Deserialize, Eq, PartialEq, Serialize)]\\n#[serde(rename_all = \\\"kebab-case\\\")]\\npub enum ThemePreset {\\n    System,\\n    Foolscap,\\n    Broadsheet,\\n    Nightpress,\\n    #[default]\\n    #[serde(other)]\\n    Editorial,\\n}\\n\\nimpl ThemePreset {\\n    /// The order of the original Settings Appearance cards.\\n    pub const APPEARANCE_ORDER: &'static [Self] = &[\\n        Self::Editorial,\\n        Self::Foolscap,\\n        Self::Broadsheet,\\n        Self::Nightpress,\\n        Self::System,\\n    ];\\n    pub const ALL: &'static [Self] = &[\\n        Self::System,\\n        Self::Editorial,\\n        Self::Foolscap,\\n        Self::Broadsheet,\\n        Self::Nightpress,\\n    ];\\n\\n    pub const fn id(self) -> &'static str {\\n        match self {\\n      …717 tokens truncated…i_key@secrets\\\"],\\n                            capture_output=True, timeout=20)\\nsecret = credential.stdout.decode().strip() if credential.returncode == 0 else \\\"\\\"\\nassert secret and len(secret) >= 20, \\\"Credential resolution failed before provider launch\\\"\\nenv = {k: v for k, v in os.environ.items() if k in {\\n    \\\"PATH\\\", \\\"HOME\\\", \\\"LANG\\\", \\\"LC_ALL\\\", \\\"LC_CTYPE\\\", \\\"NIX_SSL_CERT_FILE\\\", \\\"SSL_CERT_FILE\\\", \\\"LD_LIBRARY_PATH\\\", \\\"TERM\\\",\\n}}\\nenv.update(SAKANA_API_KEY=secret, CRUSH_GLOBAL_CONFIG=str(job / \\\"config\\\"),\\n           CRUSH_GLOBAL_DATA=str(job / \\\"data\\\"), CRUSH_SKILLS_DIR=str(job / \\\"skills\\\"))\\nreceipt = {\\n    \\\"status\\\": \\\"running\\\", \\\"provider\\\": \\\"sakana\\\", \\\"model\\\": \\\"fugu-max\\\", \\\"reasoningEffort\\\": \\\"high\\\",\\n    \\\"maxCompletio