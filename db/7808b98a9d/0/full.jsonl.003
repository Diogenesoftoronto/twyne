397:    pub fn submit_on_enter(mut self, submit: bool) -> Self {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:1398:        self.submit_on_enter = submit;\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:1402:    pub fn set_submit_on_enter(&mut self, submit: bool, cx: &mut Context<Self>) {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:1403:        self.submit_on_enter = submit;\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2193:    pub(super) fn enter(&mut self, action: &Enter, window: &mut Window, cx: &mut Context<Self>) {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2198:        // Clear inline completion on enter (user chose not to accept it)\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2203:        // In multi-line mode with `submit_on_enter` enabled, a plain `Enter`\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2204:        // (without Shift) is treated as submit: propagate the action and emit\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2205:        // PressEnter without inserting a newline. `Shift+Enter` still inserts\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2207:        let insert_newline = self.is_multi_line() && (!self.submit_on_enter || action.shift);\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2298:            // Single line input or submit-on-enter: just emit the event\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2304:        cx.emit(InputEvent::PressEnter {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2812:            TextAlign::Center => CURSOR_WIDTH,\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:2840:                    self.mode.is_auto_grow(),\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:3849:                    self.mode.update_auto_grow(&self.display_map);\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:4107:            self.mode.update_auto_grow(&self.display_map);\\n\"}"},{"type":"input_text","text":"{\"i\":1,\"chunk_id\":\"fc3a1b\",\"wall_time_seconds\":0.000028716,\"exit_code\":0,\"original_token_count\":867,\"output\":\"//! Observed native interface bounds for the isolated capture tool only.\\n\\nuse crate::app::WritingRoom;\\nuse gpui_kit::{App, WeakEntity, Window};\\nuse std::path::PathBuf;\\n\\npub(super) fn schedule(\\n    window: &mut Window,\\n    path: PathBuf,\\n    frames: u8,\\n    watch: bool,\\n    room: WeakEntity<WritingRoom>,\\n) {\\n    window.on_next_frame(move |window, cx| {\\n        if frames > 0 {\\n            schedule(window, path, frames - 1, watch, room);\\n        } else {\\n            match write_geometry(window, &path, cx, &room, 1) {\\n                Ok(()) => println!(\\\"TWYNE_CAPTURE_GEOMETRY_READY\\\"),\\n                Err(error) => eprintln!(\\\"TWYNE_CAPTURE_GEOMETRY_ERROR: {error:#}\\\"),\\n            }\\n            if watch {\\n                observe_next_frame(window, path, room, 2);\\n            }\\n        }\\n    });\\n    window.refresh();\\n}\\n\\nfn observe_next_frame(\\n    window: &mut Window,\\n    path: PathBuf,\\n    room: WeakEntity<WritingRoom>,\\n    sequence: u64,\\n) {\\n    window.on_next_frame(move |window, cx| {\\n        if let Err(error) = write_geometry(window, &path, cx, &room, sequence) {\\n            eprintln!(\\\"TWYNE_CAPTURE_GEOMETRY_ERROR: {error:#}\\\");\\n        } else if let Some(next) = sequence.checked_add(1) {\\n            observe_next_frame(window, path, room, next);\\n        } else {\\n            eprintln!(\\\"TWYNE_CAPTURE_GEOMETRY_ERROR: observation sequence exhausted\\\");\\n        }\\n    });\\n}\\n\\nfn write_geometry(\\n    window: &Window,\\n    path: &std::path::Path,\\n    cx: &App,\\n    room: &WeakEntity<WritingRoom>,\\n    sequence: u64,\\n) -> anyhow::Result<()> {\\n    let elements = gpui_kit::base::test_support::snapshots(window)\\n        .into_iter()\\n        .map(|snapshot| {\\n            let bounds = snapshot.bounds();\\n            serde_json::json!({\\n                \\\"path\\\": snapshot.path().iter().map(|id| format!(\\\"{id:?}\\\")).collect::<Vec<_>>(),\\n                \\\"rect\\\": {\\n                    \\\"x\\\": f32::from(bounds.left()), \\\"y\\\": f32::from(bounds.top()),\\n                    \\\"width\\\": f32::from(bounds.size.width), \\\"height\\\": f32::from(bounds.size.height),\\n                },\\n                \\\"visible\\\": snapshot.visible(),\\n                \\\"label\\\": snapshot.label(),\\n                \\\"role\\\": snapshot.role().map(|role| format!(\\\"{role:?}\\\")),\\n                \\\"value\\\": snapshot.value(),\\n                \\\"expanded\\\": snapshot.expanded(),\\n                \\\"disabled\\\": snapshot.disabled(),\\n                \\\"focused\\\": snapshot.focused(),\\n            })\\n        })\\n        .collect::<Vec<_>>();\\n    let viewport = window.viewport_size();\\n    let record = serde_json::json!({\\n        \\\"captureSequence\\\": sequence.to_string(),\\n        \\\"windowId\\\": window.window_handle().window_id().as_u64().to_string(),\\n        \\\"scaleFactor\\\": window.scale_factor(),\\n        \\\"dossierPreparationCpu\\\": twyne_desktop::dossier_paper::resize_diagnostic_snapshot(),\\n        \\\"dossierImageLifecycle\\\": room.upgrade().and_then(|room| room.read(cx).capture_dossier_image_lifecycle(window, cx)),\\n        \\\"viewport\\\": {\\\"width\\\": f32::from(viewport.width), \\\"height\\\": f32::from(viewport.height)},\\n        \\\"windowOrigin\\\": {\\\"x\\\": f32::from(window.bounds().left()), \\\"y\\\": f32::from(window.bounds().top())},\\n        \\\"elements\\\": elements,\\n        \\\"keyboardInput\\\": window.last_input_was_keyboard(),\\n        \\\"windowActive\\\": window.is_window_active(),\\n        \\\"captureReady\\\": room.upgrade().is_some_and(|room| room.read(cx).capture_apparatus_ready(cx)),\\n    });\\n    std::fs::write(path, serde_json::to_vec_pretty(&record)?)?;\\n    Ok(())\\n}\\n\"}"},{"type":"input_text","text":"{\"i\":2,\"chunk_id\":\"b4e58e\",\"wall_time_seconds\":0.000029735,\"exit_code\":0,\"original_token_count\":277,\"output\":\"        self.preview = html.into();\\n        self.rich = Some(view);\\n        self.schedule_marginalia_reconcile(window, cx);\\n        self.source_mode = readonly\\n            && self\\n                .source_session\\n                .as_ref()\\n                .is_some_and(|session| session.pending);\\n        self.reading = false;\\n    }\\n\\n    fn focus_writing(&self, window: &mut Window, cx: &mut Context<Self>) {\\n        if self.source_mode {\\n            self.source.update(cx, |state, cx| state.focus(window, cx));\\n        } else if let Some(view) = &self.rich {\\n            window.focus(&view.read(cx).focus_handle(cx), cx);\\n        } else {\\n            self.body.update(cx, |state, cx| state.focus(window, cx));\\n        }\\n    }\\n\\n    fn reveal_caret_next_frame(&mut self, window: &mut Window, cx: &mut Context<Self>) {\\n        if self.caret_reveal_pending {\\n            return;\\n        }\\n        self.caret_reveal_pending = true;\\n        let view = cx.weak_entity();\\n        window.on_next_frame(move |_, cx| {\\n            let _ = view.update(cx, |this, cx| {\\n                this.caret_reveal_pending = false;\\n\"}"},{"type":"input_text","text":"{\"i\":3,\"chunk_id\":\"ad220e\",\"wall_time_seconds\":0.000030465,\"exit_code\":0,\"original_token_count\":67,\"output\":\"4746:        AnyWindowHandle, Bounds, Point, TestAppContext, WindowBounds, WindowOptions, size,\\n4750:    pub(super) fn room(\\n4767:                WindowOptions {\\n4768:                    window_bounds: Some(WindowBounds::Windowed(Bounds {\\n4782:    fn expanded_room(\\n\"}"},{"type":"input_text","text":"{\"i\":4,\"chunk_id\":\"b0302a\",\"wall_time_seconds\":0.000026174,\"exit_code\":0,\"original_token_count\":448,\"output\":\"{\\n  \\\"binary\\\": {\\n    \\\"path\\\": \\\"/home/diogenes/Projects/twyne/desktop/gpui/t