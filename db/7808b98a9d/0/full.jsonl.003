osal only: src/gen_ui/classification.rs\\\"\\n      ],\\n      \\\"output\\\": \\\"Original Jev classification request and response semantics\\\",\\n      \\\"depends\\\": [],\\n      \\\"gate\\\": \\\"Parent review and unchanged Source fakeAsk oracle; does not prove live TypeSafe/provider transport\\\"\\n    }\\n  ],\\n  \\\"userPreview\\\": \\\"Leave open; no forced document actions or runtime replacement\\\"\\n}\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c3a-4441-7890-a25b-a9acd621d3aa","create_time":1791206552.9450183}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
