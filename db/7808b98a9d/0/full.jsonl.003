subtly from JS Math.max (NaN poison) — acceptable because inputs are guaranteed finite.', \\\"No wall-clock reading (callers pass now explicitly, matching the source's injectable Date.now() default), no async, no serialization, no dependencies beyond std.\\\", 'Tests are pure deterministic unit tests exercising the boundary, backoff, overwrite, pruning, backwards-clock, reset, and default cases; they were not executed in this proposal (no runtime available) and should be run by the coordinator via cargo test.']\\ncases ['Empty default budget: wait(0.0) == 0.0 and wait(123456.0) == 0.0; twelve successive spend(1000..1011) all report wait == 0.0 before each spend; after the 12th, wait(1012.0) == 59988.0 (= 60_000 - 12) and wait(61_001.0) == 0.0 (all entries expired by the inclusive <= boundary at exactly front + 60_000).', 'Backoff: back_off(5000.0) then wait(5000.0) == 30_000.0, wait(35_000.0) == 0.0.', 'Boundary inclusivity: spend(1000.0); wait(60_999.0) == 1.0, wait(61_000.0) == 0.0 (no separate backoff).', 'Overwrite semantics: back_off(10_000.0) then back_off(5_000.0) leaves wait(5_000.0) == 30_000.0 (earlier-issued backoff with earlier clock replaces the longer absolute quiet window).', 'Insertion order without sorting: spend(1000.0), spend(500.0), then 10 spends at 1200..1209 fills the window; wait(61_500.0) == 0.0 prunes both early entries, and refilling with 12 fresh spends blocks on the new front entry (not on any timestamp-sorted minimum).', 'Clock moving backwards: spend(5_000.0), spend(1_000.0), wait(1_000.0) == 0.0 (front entry 5000 > 1_000 - 60_000); after 12 total spends, wait(1_300.0) == 58_700.0 based on the earliest-inserted front entry and the retreated clock, and wait(61_000.0) == 0.0.', 'reset(): after spend(1_000.0) and back_off(2_000.0), reset() makes wait(1_000.0) == 0.0 and wait(2_000.0) == 0.0.', 'Interplay: with a full window (12 spends at 1000..1011), back_off(1_100.0), wait(1_100.0) == 30_000.0 (backoff dominates the 58_900.0 window wait), while back_off(1_100.0) before any spends with an empty window yields exactly 30_000.0.']\\nuse std::collections::VecDeque;\\n\\nconst WINDOW_MS: f64 = 60_000.0;\\nconst MAX_PER_WINDOW: f64 = 12.0;\\nconst BACKOFF_MS: f64 = 30_000.0;\\n\\n#[derive(Debug, Default, Clone)]\\npub struct SystemOneBudget {\\n    calls: VecDeque<f64>,\\n    backoff_until: f64,\\n}\\n\\nimpl SystemOneBudget {\\n    pub fn new() -> Self {\\n        Self {\\n            calls: VecDeque::new(),\\n            backoff_until: 0.0,\\n        }\\n    }\\n\\n    /// Milliseconds to wait before a call is allowed; 0 means go now.\\n    pub fn wait(&mut self, now: f64) -> f64 {\\n        while let Some(&first) = self.calls.front() {\\n            if first <= now - WINDOW_MS {\\n                self.calls.pop_front();\\n            } else {\\n                break;\\n            }\\n        }\\n        let window_wait = if self.calls.len() as f64 >= MAX_PER_WINDOW {\\n            self.calls.front().copied().unwrap_or(now) + WINDOW_MS - now\\n        } else {\\n            0.0\\n        };\\n        (self.backoff_until - now).max(window_wait).max(0.0)\\n    }\\n\\n    /// Record a call that is about to be made.\\n    pub fn spend(&mut self, now: f64) {\\n        self.calls.push_back(now);\\n    }\\n\\n    /// A failed call quiets every pause-driven caller for a while.\\n    pub fn back_off(&mut self, now: f64) {\\n        self.backoff_until = now + BACKOFF_MS;\\n    }\\n\\n    pub fn reset(&mut self) {\\n        self.calls.clear();\\n        self.backoff_until = 0.0;\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n    #[test]\\n    fn allows_twelve_calls_a_minute_across_every_caller() {\\n        let mut budget = SystemOneBudget::new();\\n        for i in 0..12 {\\n            let now = 1000.0 + i as f64;\\n            assert_eq!(budget.wait(now), 0.0);\\n            budget.spend(now);\\n        }\\n        assert_eq!(budget.wait(1012.0), 60_000.0 - 12.0);\\n        assert_eq!(budget.wait(61_001.0), 0.0);\\n    }\\n\\n    #[test]\\n    fn a_failure_quiets_every_caller_for_thirty_seconds() {\\n        let mut budget = SystemOneBudget::new();\\n        budget.back_off(5000.0);\\n        assert_eq!(budget.wait(5000.0), 30_000.0);\\n        assert_eq!(budget.wait(35_000.0), 0.0);\\n    }\\n\\n    #[test]\\n    fn window_expiry_is_inclusive_on_the_boundary() {\\n        let mut budget = SystemOneBudget::new();\\n        budget.spend(1000.0);\\n        assert_eq!(budget.wait(60_999.0), 1.0);\\n        assert_eq!(budget.wait(61_000.0), 0.0);\\n    }\\n\\n    #[test]\\n    fn back_off_overwrites_and_trails_a_moving_clock() {\\n        let mut budget = SystemOneBudget::new();\\n        budget.back_off(10_000.0);\\n        assert_eq!(budget.wait(10_000.0), 30_000.0);\\n        budget.back_off(5_000.0);\\n        assert_eq!(budget.wait(5_000.0), 30_000.0);\\n        assert_eq!(budget.wait(40_000.0), 0.0);\\n    }\\n\\n    #[test]\\n    fn expired_entries_are_pruned_in_insertion_order_without_sorting() {\\n        let mut budget = SystemOneBudget::new();\\n        budget.spend(1000.0);\\n        budget.spend(500.0);\\n        for i in 0..10 {\\n            budget.spend(1200.0 + i as f64);\\n        }\\n        assert_eq!(budget.wait(61_500.0), 0.0);\\n        budget.spend(61_500.0);\\n        assert_eq!(budget.wait(61_500.0), 0.0);\\n        for i in 0..10 {\\n            assert_eq!(budget.wait(61_600.0 + i as f64), 0.0);\\n            budget.spend(61_600.0 + i as f64);\\n        }\\n        assert_eq!(budget.wait(61_610.0), 500.0 + 60_000.0 - 61_610.0);\\n    }\\n\\n    #[test]\\n    fn a_clock_moving_backwards_keeps_queue_order_and_blocks_by_earliest_entry() {\\n        let mut budget = SystemOneBudget::new();\\n        budget.spend(5_000.0);\\n        budget.spend(1_000.0);\\n        assert_eq!(budget.wait(1_000.0), 0.0);\\n        budget.spend(1_100.0);\\n        for i in 0..9 {\\n            budget.spend(1_200.0 + i as f64);\\n        }\\n        assert_eq!(budget.wait(1_300.0), 60_000.0 - 1_300.0);\\n        assert_eq!(budget.wait(61_000.0), 0.0);\\n    }\\n\\n    #[test]\\n    fn reset_clears_spends_and_backoff() {\\n        let mut budget = SystemOneBudget::new();\\n        budget.spend(1_000.0);\\n        budget.back_off(2_000.0);\\n        budget.reset();\\n        assert_eq!(budget.wait(1_000.0), 0.0);\\n        assert_eq!(budget.wait(2_000.0), 0.0);\\n    }\\n\\n    #[test]\\n    fn default_starts_empty_with_zero_backoff() {\\n        let mut budget = SystemOneBudget::default();\\n        assert_eq!(budget.wait(0.0), 0.0);\\n        assert_eq!(budget.wait(123_456.0), 0.0);\\n    }\\n}\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c3a-4441-7890-a25b-a9acd621d3aa","create_time":1791207063.3975651}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
