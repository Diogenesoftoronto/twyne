, window, |this, sender, event, window, cx| {\\n                     if matches!(event, InputEvent::Change) {\\n                         this.changed(window, cx);\\n                     }\\n+                    if sender == &this.body\\n+                        && matches!(event, InputEvent::Change | InputEvent::Focus)\\n+                    {\\n+                        this.reveal_caret_next_frame(window, cx);\\n+                    }\\n*** End Patch\"));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a10d17-989f-7150-9fa5-0c502f3fed47","create_time":1791221613.702754}}}
