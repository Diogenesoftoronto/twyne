 {}\\n\\npub fn validate_component_props(component: &str, props: &Value) -> Result<(), ValidationError> {\\n    match component {\\n        \\\"SentenceLab\\\" => validate_sentence_lab(props),\\n        \\\"RhythmStrip\\\" => validate_rhythm_strip(props),\\n        \\\"ClaimCheck\\\" => validate_claim_check(props),\\n        \\\"ReaderQuestions\\\" => validate_reader_questions(props),\\n        _ => Err(ValidationError),\\n    }\\n}\\n\\nfn string_length_in_range(value: &Value, min: usize, max: usize) -> bool {\\n    value.as_str().is_some_and(|text| {\\n        let length = text.encode_utf16().count();\\n        (min..=max).contains(&length)\\n    })\\n}\\n\\nfn integer_in_range(value: &Value, min: f64, max: f64) -> bool {\\n    let Value::Number(number) = value else {\\n        return false;\\n    };\\n    number.as_f64().is_some_and(|number| {\\n        number.is_finite() && number.fract() == 0.0 && number >= min && number <= max\\n    })\\n}\\n\\nfn nonnegative_integer(value: &Value) -> bool {\\n    let Value::Number(number) = value else {\\n        return false;\\n    };\\n    number.as_f64().is_some_and(|number| {\\n        number.is_finite()\\n            && number.fract() == 0.0\\n            && (0.0..=9_007_199_254_740_991.0).contains(&number)\\n    })\\n}\\n\\nfn validate_sentence_lab(props: &Value) -> Result<(), ValidationError> {\\n    let Some(props) = props.as_object() else {\\n        return Err(ValidationError);\\n    };\\n    if !props\\n        .get(\\\"sentence\\\")\\n        .is_some_and(|value| string_length_in_range(value, 1, 1200))\\n    {\\n        return Err(ValidationError);\\n    }\\n    let Some(attempts) = props.get(\\\"attempts\\\").and_then(Value::as_array) else {\\n        return Err(ValidationError);\\n    };\\n    if attempts.len() > 6\\n        || attempts\\n            .iter()\\n            .any(|value| !string_length_in_range(value, 0, 1200))\\n    {\\n        return Err(ValidationError);\\n    }\\n    let Some(variants) = props.get(\\\"variants\\\").and_then(Value::as_array) else {\\n        return Err(ValidationError);\\n    };\\n    if variants.len() > 3\\n        || variants\\n            .iter()\\n            .any(|value| !string_length_in_range(value, 1, 1200))\\n    {\\n        return Err(ValidationError);\\n    }\\n    Ok(())\\n}\\n\\nfn validate_rhythm_strip(props: &Value) -> Result<(), ValidationError> {\\n    let Some(props) = props.as_object() else {\\n        return Err(ValidationError);\\n    };\\n    let Some(sentences) = props.get(\\\"sentences\\\").and_then(Value::as_array) else {\\n        return Err(ValidationError);\\n    };\\n    if !(1..=40).contains(&sentences.len()) {\\n        return Err(ValidationError);\\n    }\\n    for sentence in sentences {\\n        let Some(sentence) = sentence.as_object() else {\\n            return Err(ValidationError);\\n        };\\n        if !sentence.get(\\\"text\\\").is_some_and(Value::is_string)\\n            || !sentence.get(\\\"words\\\").is_some_and(nonnegative_integer)\\n        {\\n            return Err(ValidationError);\\n        }\\n    }\\n    if !props\\n        .get(\\\"targetMin\\\")\\n        .is_some_and(|value| integer_in_range(value, 1.0, 80.0))\\n        || !props\\n            .get(\\\"targetMax\\\")\\n            .is_some_and(|value| integer_in_range(value, 2.0, 120.0))\\n    {\\n        return Err(ValidationError);\\n    }\\n    Ok(())\\n}\\n\\nfn validate_claim_check(props: &Value) -> Result<(), ValidationError> {\\n    let Some(props) = props.as_object() else {\\n        return Err(ValidationError);\\n    };\\n    if !props\\n        .get(\\\"claim\\\")\\n        .is_some_and(|value| string_length_in_range(value, 1, 1200))\\n    {\\n        return Err(ValidationError);\\n    }\\n    let Some(slots) = props.get(\\\"slots\\\").and_then(Value::as_array) else {\\n        return Err(ValidationError);\\n    };\\n    if !(1..=5).contains(&slots.len()) {\\n        return Err(ValidationError);\\n    }\\n    for slot in slots {\\n        let Some(slot) = slot.as_object() else {\\n            return Err(ValidationError);\\n        };\\n        if !slot\\n            .get(\\\"label\\\")\\n            .is_some_and(|value| string_length_in_range(value, 1, 60))\\n            || !slot.get(\\\"filled\\\").is_some_and(Value::is_boolean)\\n        {\\n            return Err(ValidationError);\\n        }\\n    }\\n    Ok(())\\n}\\n\\nfn validate_reader_questions(props: &Value) -> Result<(), ValidationError> {\\n    let Some(props) = props.as_object() else {\\n        return Err(ValidationError);\\n    };\\n    if !props\\n        .get(\\\"angle\\\")\\n        .is_some_and(|value| string_length_in_range(value, 0, 200))\\n    {\\n        return Err(ValidationError);\\n    }\\n    let Some(questions) = props.get(\\\"questions\\\").and_then(Value::as_array) else {\\n        return Err(ValidationError);\\n    };\\n    if questions.len() > 4\\n        || questions\\n            .iter()\\n            .any(|value| !string_length_in_range(value, 3, 240))\\n    {\\n        return Err(ValidationError);\\n    }\\n    Ok(())\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::{ValidationError, validate_component_props};\\n    use serde_json::{Value, json};\\n    use std::error::Error;\\n\\n    fn assert_valid(component: &str, props: Value) {\\n        assert!(validate_component_props(component, &props).is_ok());\\n    }\\n\\n    fn assert_invalid(component: &str, props: Value) {\\n        assert_eq!(\\n            validate_component_props(component, &props),\\n            Err(ValidationError)\\n        );\\n    }\\n\\n    #[test]\\n    fn accepts_each_catalog_component() {\\n        assert_valid(\\n            \\\"SentenceLab\\\",\\n            json!({\\\"sentence\\\":\\\"A sentence.\\\",\\\"attempts\\\":[],\\\"variants\\\":[\\\"Another sentence.\\\"]}),\\n        );\\n        assert_valid(\\n            \\\"RhythmStrip\\\",\\n            json!({\\\"sentences\\\":[{\\\"text\\\":\\\"A sentence.\\\",\\\"words\\\":3}],\\\"targetMin\\\":8,\\\"targetMax\\\":28}),\\n        );\\n        assert_valid(\\n            \\\"ClaimCheck\\\",\\n            json!({\\\"claim\\\":\\\"A claim.\\\",\\\"slots\\\":[{\\\"label\\\":\\\"Evidence\\\",\\\"filled\\\":false}]}),\\n        );\\n        assert_valid(\\n            \\\"ReaderQuestions\\\",\\n            json!({\\\"angle\\\":\\\"\\\",\\\"questions\\\":[\\\"Why now?\\\"]}),\\n        );\\n    }\\n\\n    #[test]\\n    fn sentence_lab_enforces_limits_and_asymmetric_empty_strings() {\\n        assert_valid(\\n            \\\"SentenceLab\\\",\\n            json!({\\\"sentence\\\":\\\"x\\\",\\\"attempts\\\":[\\\"\\\",\\\"a\\\".repeat(1200)],\\\"variants\\\":[\\\"v\\\".repeat(1200)]}),\\n        );\\n        assert_invalid(\\n            \\\"SentenceLab\\\",\\n            json!({\\\"sentence\\\":\\\"x\\\",\\\"attempts\\\":vec![\\\"x\\\"; 7],\\\"variants\\\":[]}),\\n        );\\n        assert_invalid(\\n            \\\"SentenceLab\\\",\\n            json!({\\\"sentence\\\":\\\"x\\\",\\\"attempts\\\":[],\\\"variants\\\":[\\\"\\\"]}),\\n        );\\n        assert_invalid(\\n            \\\"SentenceLab\\\",\\n            json!({\\\"sentence\\\":\\\"s\\\".repeat(1201),\\\"attempts\\\":[],\\\"variants\\\":[]}),\\n        );\\n    }\\n\\n    #[test]\\n    fn string_boundaries_count_utf16_code_units() {\\n        let sentence = \\\"😀\\\".repeat(600);\\n        assert_valid(\\n            \\\"SentenceLab\\\",\\n            json!({\\\"sentence\\\":sentence,\\\"attempts\\\":[],\\\"variants\\\":[]}),\\n        );\\n        assert_invalid(\\n            \\\"SentenceLab\\\",\\n            json!({\\\"sentence\\\":\\\"😀\\\".repeat(601),\\\"attempts\\\":[],\\\"variants\\\":[]}),\\n        );\\n        assert_valid(\\n            \\\"ClaimCheck\\\",\\n            json!({\\\"claim\\\":\\\"😀\\\".repeat(600),\\\"slots\\\":[{\\\"label\\\":\\\"😀\\\".repeat(30),\\\"filled\\\":true}]}),\\n        );\\n        assert_invalid(\\n            \\\"ClaimCheck\\\",\\n            json!({\\\"claim\\\":\\\"x\\\",\\\"slots\\\":[{\\\"label\\\":\\\"😀\\\".repeat(31),\\\"filled\\\":true}]}),\\n        );\\n        assert_valid(\\n            \\\"ReaderQuestions\\\",\\n            json!({\\\"angle\\\":\\\"😀\\\".repeat(100),\\\"questions\\\":[\\\"😀\\\".repeat(120)]}),\\n\"}}"},{"type":"input_text","text":"{\"index\":3,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"7cefde\",\"wall_time_seconds\":0.000018419,\"exit_code\":0,\"original_token_count\":645,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Root-owned focused checks; leave the running immutable user preview alone.\\\"\\\"\\\"\\nimport argparse\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\nimport subprocess\\nimport time\\nimport uuid\\n\\nparser = argparse.ArgumentParser()\\nparser.add_argument(\\\"phase\\\", choices=[\\\"core\\\", \\\"desktop\\\"])\\nargs = parser.parse_args()\\nbase = Path(__file__).resolve().parents[4]\\nverification = base / \\\"desktop/gpui/target/verification\\\"\\njob = verification / (\\\"genui-\\\" + args.phase + \\\"-\\\" + uuid.uuid4().hex[:12])\\njob.mkdir()\\ninputs = [\\n    \\\"src/components/in-flow/catalog.ts\\\", \\\"src/utils/in-flow-tools.ts\\\",\\n    \\\"src/utils/struggle-signals.ts\\\", \\\"src/components/in-flow/tool-renderer.tsx\\\",\\n    \\\"src/global.css\\\", \\\"desktop/gpui/Cargo.toml\\\", \\\"desktop/gpui/Cargo.lock\\\",\\n    *[str(p.relative_to(base)) for p in (base / \\\"desktop/gpui/src/gen_ui\\\").glob(\\\"*.rs\\\")],\\n    *[str(p.relative_to(base)) for p in Path(__file__).parent.glob(\\\"*oracle.*\\\")],\\n]\\ndef sha(path):\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\nhashes = {p: sha(base / p) for p in inputs}\\ncommand = [\\\"rtk\\\", \\\"proxy\\\", \\\"devenv\\\", \\\"shell\\\", \\\"--\\\", \\\"rtk\\\", \\\"proxy\\\", \\\"cargo\\\"]\\ncommand += ([\\\"test\\\", \\\"--no-default-features\\\", \\\"--lib\\\", \\\"gen_ui\\\"] if args.phase == \\\"core\\\" else [\\\"check\\\", \\\"--features\\\", \\\"ui-tests,native-audio\\\", \\\"--all-targets\\\"])\\ncommand += [\\\"--locked\\\", \\\"--offline\\\", \\\"--manifest-path\\\", \\\"desktop/gpui/Cargo.toml\\\"]\\nreceipt = {\\\"status\\\": \\\"running\\\", \\\"phase\\\": args.phase, \\\"command\\\": command,\\n    \\\"inputs\\\": hashes, \\\"startedUnix\\\": time.time(),\\n    \\\"proofLimit\\\": \\\"Contract tests and compilation only; editor mounting, actual UI, provider/account and pixel parity remain unproven\\\"}\\n(job / \\\"receipt.json\\\").write_text(json.dumps(receipt, indent=2) + \\\"\\\\n\\\")\\n(verification / (\\\"genui-\\\" + args.phase + \\\"-pointer.json\\\")).write_text(json.dumps({\\\"path\\\": str(job)}, indent=2) + \\\"\\\\n\\\")\\nprint(json.dumps({\\\"job\\\": str(job), \\\"status\\\": \\\"running\\\"}), flush=True)\\nwith (job / \\\"cargo.log\\\").open(\\\"wb\\\") as output:\\n    result = subprocess.run(command, cwd=base, stdout=output, stderr=subprocess.STDOUT)\\ndrift = [p for p, digest in hashes.items() if sha(base / p) != digest]\\nreceipt.update(status=\\\"passed\\\" if result.returncode == 0 and not drift else \\\"failed\\\",\\n    exitCode=result.returncode, changedDuringCheck=drift, endedUnix=time.time())\\n(job / \\\"receipt.json\\\").write_text(json.dumps(receipt, indent=2) + \\\"\\\\n\\\")\\nprint((job / \\\"cargo.log\\\").read_text(errors=\\\"replace\\\")[-6500:])\\nprint(json.dumps({\\\"job\\\": str(job), \\\"status\\\": receipt[\\\"status\\\"], \\\"exitCode\\\": result.returncode}))\\nraise SystemExit(0 if receipt[\\\"status\\\"] == \\\"passed\\\" else result.returncode or 1)\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c03-2660-75c2-b09f-9987333f7d6c","create_time":1791202983.7070942}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
