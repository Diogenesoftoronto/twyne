p/gpui/fixtures/math-write/source-host/README.md\ndesktop/gpui/fixtures/math-write/native-source-form/README.md\ndesktop/gpui/fixtures/math-write/source-inline-geometry/admission-review/README.md\ndesktop/gpui/fixtures/math-write/source-inline-geometry/admission-review/field-evidence-proposal.md\ndesktop/gpui/fixtures/math-write/source-inline-geometry/admission-review/raw-fragmentation-adoption/README.md\ndesktop/gpui/fixtures/math-write/nodeview/README.md\n","stderr":"","aggregated_output":"desktop/gpui/README.md\ndesktop/gpui/PORT_PLAN.md\ndesktop/gpui/fixtures/source_view/hyphen-wrap/README.md\ndesktop/gpui/fixtures/source_view/wrapped-helper-proposal.md\ndesktop/gpui/fixtures/steering-offline/README.md\ndesktop/gpui/fixtures/dossier-stamp/README.md\ndesktop/gpui/assets/button-font-evidence/README.md\ndesktop/gpui/fixtures/source_view/README.md\ndesktop/gpui/fixtures/paper-grain/README.md\ndesktop/gpui/fixtures/apparatus-view/README.md\ndesktop/gpui/fixtures/apparatus-view/CONTRACT.md\ndesktop/gpui/assets/lora-ui-evidence/README.md\ndesktop/gpui/fixtures/rubric/README.md\ndesktop/gpui/fixtures/editor/comment-parity.md\ndesktop/gpui/fixtures/citation-anchor/README.md\ndesktop/gpui/fixtures/editor/clipboard-interoperability.md\ndesktop/gpui/fixtures/house/CONTRACT.md\ndesktop/gpui/fixtures/editor/flow-input-contract.md\ndesktop/gpui/fixtures/editor/hyphenation-contract.md\ndesktop/gpui/fixtures/editor/clipboard-contract.md\ndesktop/gpui/fixtures/editor/block-drag-contract.md\ndesktop/gpui/fixtures/editor/url-wrap-contract.md\ndesktop/gpui/fixtures/editor/notes/README.md\ndesktop/gpui/fixtures/editor/fractional-text-flow-proposal.md\ndesktop/gpui/fixtures/editor/notebook-typography-contract.md\ndesktop/gpui/fixtures/gen-ui/parent-adoption/action-review-correction.md\ndesktop/gpui/fixtures/dossier-multiply/source-stacking-audit/README.md\ndesktop/gpui/fixtures/gen-ui/README.md\ndesktop/gpui/assets/cjk-fallback-evidence/README.md\ndesktop/gpui/fixtures/apparatus/READM