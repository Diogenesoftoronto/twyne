TORGANIC_CALLBACK_PATH = \"/auth/notorganic/\";\nsrc/utils/notorganic-connect.ts:23:  /** Where to land after the session is issued. Same-origin path only. */\nsrc/utils/notorganic-connect.ts:60:  const url = new URL(\"https://id.notorganic.info/authorize\");\nsrc/utils/notorganic-connect.ts:70:    // Twyne sign-out does not clear the portal's session. Let the writer\nsrc/utils/notorganic-connect.ts:121:  attempt.briefDraft = prepareBriefDraftHandoff(sessionStorage);\nsrc/utils/notorganic-connect.ts:122:  sessionStorage.setItem(NOTORGANIC_SIGN_IN_ATTEMPT, JSON.stringify(attempt));\nsrc/utils/notorganic-connect.ts:126:/** Finish the redirect on the callback page; returns where to go next. */\nsrc/utils/notorganic-connect.ts:146:  const storage = dependencies.storage ?? sessionStorage;\nsrc/utils/notorganic-connect.ts:159:  const result = await client.$fetch(\"/sign-in/notorganic\", {\nsrc/utils/notorganic-connect.ts:166:  // The crossDomain client stores the new session cookie; refresh the atom.\nsrc/utils/notorganic-connect.ts:171:  const sessionData = record(refreshed?.data);\nsrc/utils/notorganic-connect.ts:172:  const session = record(sessionData?.session);\nsrc/utils/notorganic-connect.ts:173:  const user = record(sessionData?.user);\nsrc/utils/notorganic-connect.ts:178:    !session ||\nsrc/utils/notorganic-connect.ts:179:    typeof session.id !== \"string\" ||\nsrc/utils/notorganic-connect.ts:180:    !session.id ||\nsrc/utils/notorganic-connect.ts:181:    session.userId !== issuedUser.id ||\nsrc/utils/notorganic-connect.ts:185:      \"Twyne could not confirm your session. Please sign in again.\",\nsrc/utils/auth-client.ts:3:  convexClient,\nsrc/utils/auth-client.ts:5:} from \"@convex-dev/better-auth/client/plugins\";\nsrc/utils/auth-client.ts:8:const convexSiteUrl = import.meta.env.VITE_CONVEX_SITE_URL as\nsrc/utils/auth-client.ts:24:  isDev && !convexSiteUrl\nsrc/utils/auth-client.ts:27:        baseURL: convexSiteUrl,\nsrc/utils/auth-client.ts:34:          convexClient(),\n","exit_code":0,"duration":{"secs":0,"nanos":14579},"formatted_output":"convex/lib/notorganicSignIn.ts:4: * The browser runs PKCE against `id.notorganic.info` and posts the returned\nconvex/lib/notorganicSignIn.ts:7: * `notorganic` account row, and a normal Better Auth session is issued so every\nconvex/lib/notorganicSignIn.ts:16:export const NOTORGANIC_PROVIDER_ID = \"notorganic\";\nconvex/lib/notorganicSignIn.ts:17:export const NOTORGANIC_SIGN_IN_PATH = \"/auth/notorganic/\";\nconvex/lib/notorganicSignIn.ts:21:  sessionVersion: number;\nconvex/lib/notorganicSignIn.ts:60:  // redeemProviderLink already checked the account DID, token product and\nconvex/lib/notorganicSignIn.ts:61:  // session version. Optional profile data never establishes identity.\nconvex/lib/notorganicSignIn.ts:100:  return `${hex}@notorganic.invalid`;\nconvex/lib/notorganicSignIn.ts:116:    id: \"notorganic-sign-in\",\nconvex/lib/notorganicSignIn.ts:119:        \"/sign-in/notorganic\",\nconvex/lib/notorganicSignIn.ts:204:          const session = await adapter.createSession(user.id);\nconvex/lib/notorganicSignIn.ts:205:          await setSessionCookie(ctx, { session, user });\nconvex/auth.ts:1:import { createClient, type GenericCtx } from \"@convex-dev/better-auth\";\nconvex/auth.ts:2:import { convex, crossDomain } from \"@convex-dev/better-auth/plugins\";\nconvex/auth.ts:7:import { makeFunctionReference } from \"convex/server\";\nconvex/auth.ts:8:import { notOrganicIssuer } from \"./lib/notorganic\";\nconvex/auth.ts:12:} from \"./lib/notorganicSignIn\";\nconvex/auth.ts:25:  { did: string; subject: string; sessionVersion: number }\nconvex/auth.ts:41:    trustedOrigins: trustedOrigins(siteUrl),\nconvex/auth.ts:46:    session: {\nconvex/auth.ts:57:          if (!trustedOrigins(siteUrl).includes(origin)) {\nconvex/auth.ts:58:            throw new Error(\"This sign-in came from an untrusted origin.\");\nconvex/auth.ts:66:        onSignedIn: async ({ did, userId, sessionVersion }) => {