{"timestamp":"2026-10-05T17:41:59.689Z","ordinal":43518,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a10537-909f-77a3-96d8-dd07161f91ae","turn_id":"01a10d17-989f-7150-9fa5-0c502f3fed47","item":{"type":"CommandExecution","id":"exec-579f2c54-f10e-4a1d-8e1f-6ecdb06e37f2","process_id":"53605","command":["/bin/bash","-lc","rtk proxy sed -n '6038,6108p' desktop/gpui/src/app.rs"],"cwd":"file:///home/diogenes/Projects/twyne","parsed_cmd":[{"type":"unknown","cmd":"rtk proxy sed -n '6038,6108p' desktop/gpui/src/app.rs"}],"source":"unified_exec_startup","status":"completed","stdout":"\n    #[gpui_kit::test]\n    fn document_navigation_reveals_the_native_caret_in_long_manuscripts(cx: &mut TestAppContext) {\n        let (handle, view, store, _directory) = room(cx);\n        let path = store.root().join(\"Long.html\");\n        let html = (0..80)\n            .map(|index| format!(\"<p>Paragraph {index}: a measured line of writing.</p>\"))\n            .collect::<String>();\n        std::fs::write(&path, html).unwrap();\n        let document = import_file(&path).unwrap();\n        cx.update_window(handle, |_, window, cx| {\n            view.update(cx, |room, cx| {\n                room.add_document(document, window, cx);\n            });\n            window.render_frame(cx);\n            window.press(\"ctrl-end\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            let room = view.read(cx);\n            let viewport = room.writing_scroll.bounds();\n            let caret = rich.read(cx).caret_bounds().unwrap();\n            assert!(room.writing_scroll.offset().y < px(-100.));\n            assert!(\n                caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom(),\n                \"caret {caret:?}, viewport {viewport:?}\"\n            );\n            window.input(\" Continued\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            let caret = rich.read(cx).caret_bounds().unwrap();\n            let viewport = view.read(cx).writing_scroll.bounds();\n            assert!(caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom());\n            window.press(\"ctrl-home\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            assert_eq!(view.read(cx).writing_scroll.offset().y, px(0.));\n            assert_eq!(rich.read(cx).selection().head, 0);\n        })\n        .unwrap();\n    }\n\n    #[gpui_kit::test]\n    fn versions_restore_preserves_the_current_draft_and_saves_real_checkpoints(\n        cx: &mut TestAppContext,\n    ) {\n        let (handle, view, store, _directory) = room(cx);\n        let path = store.root().join(\"History.html\");\n        std::fs::write(&path, \"<p>The original ending.</p>\").unwrap();\n        let document = import_file(&path).unwrap();\n        let id = document.id;\n","stderr":"","aggregated_output":"\n    #[gpui_kit::test]\n    fn document_navigation_reveals_the_native_caret_in_long_manuscripts(cx: &mut TestAppContext) {\n        let (handle, view, store, _directory) = room(cx);\n        let path = store.root().join(\"Long.html\");\n        let html = (0..80)\n            .map(|index| format!(\"<p>Paragraph {index}: a measured line of writing.</p>\"))\n            .collect::<String>();\n        std::fs::write(&path, html).unwrap();\n        let document = import_file(&path).unwrap();\n        cx.update_window(handle, |_, window, cx| {\n            view.update(cx, |room, cx| {\n                room.add_document(document, window, cx);\n            });\n            window.render_frame(cx);\n            window.press(\"ctrl-end\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            let room = view.read(cx);\n            let viewport = room.writing_scroll.bounds();\n            let caret = rich.read(cx).caret_bounds().unwrap();\n            assert!(room.writing_scroll.offset().y < px(-100.));\n            assert!(\n                caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom(),\n                \"caret {caret:?}, viewport {viewport:?}\"\n            );\n            window.input(\" Continued\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            let caret = rich.read(cx).caret_bounds().unwrap();\n            let viewport = view.read(cx).writing_scroll.bounds();\n            assert!(caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom());\n            window.press(\"ctrl-home\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            assert_eq!(view.read(cx).writing_scroll.offset().y, px(0.));\n            assert_eq!(rich.read(cx).selection().head, 0);\n        })\n        .unwrap();\n    }\n\n    #[gpui_kit::test]\n    fn versions_restore_preserves_the_current_draft_and_saves_real_checkpoints(\n        cx: &mut TestAppContext,\n    ) {\n        let (handle, view, store, _directory) = room(cx);\n        let path = store.root().join(\"History.html\");\n        std::fs::write(&path, \"<p>The original ending.</p>\").unwrap();\n        let document = import_file(&path).unwrap();\n        let id = document.id;\n","exit_code":0,"duration":{"secs":0,"nanos":35620},"formatted_output":"\n    #[gpui_kit::test]\n    fn document_navigation_reveals_the_native_caret_in_long_manuscripts(cx: &mut TestAppContext) {\n        let (handle, view, store, _directory) = room(cx);\n        let path = store.root().join(\"Long.html\");\n        let html = (0..80)\n            .map(|index| format!(\"<p>Paragraph {index}: a measured line of writing.</p>\"))\n            .collect::<String>();\n        std::fs::write(&path, html).unwrap();\n        let document = import_file(&path).unwrap();\n        cx.update_window(handle, |_, window, cx| {\n            view.update(cx, |room, cx| {\n                room.add_document(document, window, cx);\n            });\n            window.render_frame(cx);\n            window.press(\"ctrl-end\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            let room = view.read(cx);\n            let viewport = room.writing_scroll.bounds();\n            let caret = rich.read(cx).caret_bounds().unwrap();\n            assert!(room.writing_scroll.offset().y < px(-100.));\n            assert!(\n                caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom(),\n                \"caret {caret:?}, viewport {viewport:?}\"\n            );\n            window.input(\" Continued\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            let caret = rich.read(cx).caret_bounds().unwrap();\n            let viewport = view.read(cx).writing_scroll.bounds();\n            assert!(caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom());\n            window.press(\"ctrl-home\", cx);\n        })\n        .unwrap();\n        cx.run_until_parked();\n        cx.update_window(handle, |_, window, cx| {\n            let rich = view.read(cx).rich.clone().unwrap();\n            for _ in 0..3 {\n                window.simulate_next_frame(cx);\n                window.render_frame(cx);\n            }\n            assert_eq!(view.read(cx).writing_scroll.offset().y, px(0.));\n            assert_eq!(rich.read(cx).selection().head, 0);\n        })\n        .unwrap();\n    }\n\n    #[gpui_kit::test]\n    fn versions_restore_preserves_the_current_draft_and_saves_real_checkpoints(\n        cx: &mut TestAppContext,\n    ) {\n        let (handle, view, store, _directory) = room(cx);\n        let path = store.root().join(\"History.html\");\n        std::fs::write(&path, \"<p>The original ending.</p>\").unwrap();\n        let document = import_file(&path).unwrap();\n        let id = document.id;\n"},"started_at_ms":1791222119689,"completed_at_ms":1791222119689}}
