Path: process.env.TWYNE_FIXTURE_CHROME ?? \"/usr/bin/google-chrome\", headless: true });\n try {\n@@ -65,3 +72,22 @@\n   let code: number, stdout: string, stderr: string;\n-  try { [code, stdout, stderr] = await Promise.all([child.exited, new Response(child.stdout).text(), new Response(child.stderr).text()]); }\n+  let browserReceipt: { queryRemoved: boolean; errors: string[] };\n+  try {\n+    const finished = Promise.all([child.exited, new Response(child.stdout).text(), new Response(child.stderr).text()]);\n+    let callback: { origin: string; state: string; synthetic: boolean } | null = null;\n+    for (let attempt = 0; attempt < 200; attempt++) {\n+      try { callback = JSON.parse(await readFile(callbackReady, \"utf8\")); break; } catch { await Bun.sleep(10); }\n+    }\n+    if (!callback || callback.origin !== callbackOrigin || !callback.synthetic) throw new Error(\"The native callback listener was not ready\");\n+    const context = await browser.newContext();\n+    await context.route(\"**/*\", (route) => new URL(route.request().url()).origin === callbackOrigin ? route.continue() : route.abort());\n+    const page = await context.newPage();\n+    const errors: string[] = [];\n+    page.on(\"pageerror\", (error) => errors.push(error.name));\n+    await page.goto(`${callbackOrigin}/auth/notorganic/?state=${encodeURIComponent(callback.state)}&code=fixture-code`, { waitUntil: \"load\" });\n+    await expect(page).toHaveURL(`${callbackOrigin}/auth/notorganic/`);\n+    if (errors.length) throw new Error(\"The native callback history cleanup did not execute\");\n+    browserReceipt = { queryRemoved: true, errors };\n+    [code, stdout, stderr] = await finished;\n+    await context.close();\n+  }\n   finally { clearTimeout(timeout); }\n@@ -76,3 +102,3 @@\n     native: { path: native, sha256: await hash(native) }, helper: { path: helper, sha256: await hash(helper) },\n-    requests, toolCalls, signOutRequests, credentialStoreAccessed: false, userLibraryTouched: false,\n+    requests, toolCalls, signOutRequests, browser: browserReceipt, credentialStoreAccessed: false, userLibraryTouched: false,\n     nativeReceipt: receipt, realConvexAuthenticationProven: false, productionRegistrationProven: false,\n@@ -80,2 +106,2 @@\n   console.log(JSON.stringify({ status: \"passed\", output, toolCalls, signOutRequests }));\n-} finally { release(); server.stop(true); }\n+} finally { release(); server.stop(true); await browser.close(); }\n","move_path":null},"/home/diogenes/Projects/twyne/desktop/gpui/fixtures/connected-work/native-probe.rs":{"type":"update","unified_diff":"@@ -9,3 +9,4 @@\n use twyne_desktop::native_accounts::{\n-    auth::{CallbackRegistration, RedemptionRequest},\n+    auth::{CallbackRegistration, SignInAttempt},\n+    callback::CallbackListener,\n     protocol::PullSnapshot,\n@@ -22,2 +23,3 @@\n     tool_dispatched: PathBuf,\n+    callback_ready: PathBuf,\n     output: PathBuf,\n@@ -45,2 +47,4 @@\n     };\n+    let listener = CallbackListener::bind(&profile.registration)?;\n+    let mut attempt = SignInAttempt::prepare(&profile.registration, [1;32], [2;32], 100, \"/\")?;\n     let helper = ConnectedHelper::start(&fixture.helper, profile, CredentialStorage::SessionOnly)?;\n@@ -50,7 +54,13 @@\n     );\n-    let accepted = helper.redeem(RedemptionRequest {\n-        code: \"fixture-code\".into(),\n-        verifier: \"v\".repeat(43),\n-        origin: fixture.callback_origin,\n-    })?;\n+    std::fs::write(&fixture.callback_ready, serde_json::to_vec(&json!({\n+        \"origin\":listener.origin(), \"state\":attempt.state(), \"synthetic\":true,\n+    }))?)?;\n+    let deadline = Instant::now() + Duration::from_secs(10);\n+    let input = loop {\n+        if let Some(input) = listener.poll(attempt.state())? { break input; }\n+        ensure!(Instant::now() < deadline, \"The synthetic browser callback did not arrive\");\n+        std::thread::sleep(Duration::from_millis(5));\n+    };\n+    let request = attempt.consume_callback(&input, 101)?;\n+    let accepted = helper.redeem(request)?;\n     let snapshot: PullSnapshot =\n@@ -104,2 +114,3 @@\n             \"authenticatedReceipt\":true, \"sourcePullDtoValidated\":true,\n+            \"nativeLoopbackCallbackConsumed\":true,\n             \"sourceRevisionConflictPreserved\":true,\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/diogenes/Projects/twyne/desktop/gpui/fixtures/connected-work/native-probe.rs\nM /home/diogenes/Projects/twyne/desktop/gpui/fixtures/connected-work/drive-native-probe.ts\n","stderr":""},"started_at_ms":1791217659902,"completed_at_ms":1791217659903}}
