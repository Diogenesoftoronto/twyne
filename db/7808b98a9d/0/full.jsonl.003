sktop/gpui/vendor/gpui-base/src/button.rs:120:        self.tab_stop = tab_stop;\\ndesktop/gpui/vendor/gpui-base/src/button.rs:126:    /// A non-focusable button leaves focus wherever it already is, which keeps a\\ndesktop/gpui/vendor/gpui-base/src/button.rs:131:    pub fn focusable(mut self, focusable: bool) -> Self {\\ndesktop/gpui/vendor/gpui-base/src/button.rs:132:        self.focusable = focusable;\\ndesktop/gpui/vendor/gpui-base/src/button.rs:136:    fn focus_handle(&self, window: &mut Window, cx: &mut App) -> FocusHandle {\\ndesktop/gpui/vendor/gpui-base/src/button.rs:137:        self.provided_focus_handle.clone().unwrap_or_else(|| {\\ndesktop/gpui/vendor/gpui-base/src/button.rs:139:                .use_keyed_state(self.id.clone(), cx, |_, cx| cx.focus_handle())\\ndesktop/gpui/vendor/gpui-base/src/button.rs:319:        let focus_handle = self.focus_handle(window, cx);\\ndesktop/gpui/vendor/gpui-base/src/button.rs:347:            .when(!disabled && self.focusable, |this| {\\ndesktop/gpui/vendor/gpui-base/src/button.rs:348:                this.track_focus(\\ndesktop/gpui/vendor/gpui-base/src/button.rs:349:                    &focus_handle\\ndesktop/gpui/vendor/gpui-base/src/button.rs:351:                        .tab_stop(self.tab_stop),\\n\"}}}"},{"type":"input_text","text":"{\"index\":1,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"264d83\",\"wall_time_seconds\":0.000026718,\"exit_code\":0,\"original_token_count\":137,\"output\":\"//! In-document insertion commands. Pure contracts/adapters are independent of\\n//! the GPUI menu and workspace host, so each can be maintained separately.\\nmod catalog;\\nmod context;\\nmod filter;\\npub mod markdown;\\npub mod parameters;\\npub mod rich;\\npub mod table_grid;\\npub use catalog::{Candidate, CommandDefinition, candidates, commands};\\npub use context::{SlashQuery, detect, detect_rich};\\n\\n#[cfg(feature = \\\"desktop\\\")]\\npub mod form;\\n#[cfg(feature = \\\"desktop\\\")]\\npub mod view;\\n#[cfg(feature = \\\"desktop\\\")]\\npub mod table_picker;\\n\\n#[cfg(test)]\\nmod tests;\\n\"}}}"},{"type":"input_text","text":"{\"index\":2,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"cca1a3\",\"wall_time_seconds\":0.000014296,\"exit_code\":0,\"original_token_count\":1312,\"output\":\"use crate::{StateStyle, StyledExt as _, TestSupportExt as _};\\nuse gpui::{\\n    AnyElement, App, Div, ElementId, InteractiveElement, Interactivity, IntoElement, ParentElement,\\n    Refineable as _, RenderOnce, Role, SharedString, StatefulInteractiveElement, StyleRefinement,\\n    Styled, Window, div, prelude::FluentBuilder as _,\\n};\\n\\n/// What the input can offer to its context menu, at the moment it is opened.\\n///\\n/// Built by the input and read by the menu, the fields are private and reached\\n/// through the methods below, so that a new capability can be added without\\n/// breaking the menu builders.\\n///\\n/// ```\\n/// use gpui_base::input::InputContextMenuCapabilities;\\n///\\n/// let capabilities = InputContextMenuCapabilities::new()\\n///     .code_editor(true)\\n///     .selection(true);\\n///\\n/// assert!(capabilities.is_editable());\\n/// assert!(capabilities.has_selection());\\n/// ```\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\\npub struct InputContextMenuCapabilities {\\n    disabled: bool,\\n    readonly: bool,\\n    code_editor: bool,\\n    selection: bool,\\n    masked: bool,\\n    go_to_definition: bool,\\n    code_actions: bool,\\n}\\n\\nimpl InputContextMenuCapabilities {\\n    pub fn new() -> Self {\\n        Self::default()\\n    }\\n\\n    pub fn disabled(mut self, disabled: bool) -> Self {\\n        self.disabled = disabled;\\n        self\\n    }\\n\\n    pub fn readonly(mut self, readonly: bool) -> Self {\\n        self.readonly = readonly;\\n        self\\n    }\\n\\n    pub fn code_editor(mut self, code_editor: bool) -> Self {\\n        self.code_editor = code_editor;\\n        self\\n    }\\n\\n    /// Set whether the input has a non-empty selection.\\n    pub fn selection(mut self, selection: bool) -> Self {\\n        self.selection = selection;\\n        self\\n    }\\n\\n    /// Set whether the input renders its value masked.\\n    pub fn masked(mut self, masked: bool) -> Self {\\n        self.masked = masked;\\n        self\\n    }\\n\\n    pub fn go_to_definition(mut self, go_to_definition: bool) -> Self {\\n        self.go_to_definition = go_to_definition;\\n        self\\n    }\\n\\n    pub fn code_actions(mut self, code_actions: bool) -> Self {\\n        self.code_actions = code_actions;\\n        self\\n    }\\n\\n    pub fn is_disabled(&self) -> bool {\\n        self.disabled\\n    }\\n\\n    pub fn is_readonly(&self) -> bool {\\n        self.readonly\\n    }\\n\\n    /// Returns true if the user is allowed to change the text.\\n    ///\\n    /// The items that write to the input (Cut, Paste, Code Actions) belong to\\n    /// this, the reading ones (Copy, Go to Definition) do not.\\n    pub fn is_editable(&self) -> bool {\\n        !self.disabled && !self.readonly\\n    }\\n\\n    pub fn is_code_editor(&self) -> bool {\\n        self.code_editor\\n    }\\n\\n    pub fn has_selection(&self) -> bool {\\n        self.selection\\n    }\\n\\n    pub fn is_masked(&self) -> bool {\\n        self.masked\\n    }\\n\\n    /// Returns true if the user is allowed to copy the text out.\\n    ///\\n    /// A masked input keeps its value out of the clipboard, so Copy and Cut\\n    /// are both unavailable while the value is hidden.\\n    pub fn is_copyable(&self) -> bool {\\n        self.selection && !self.masked\\n    }\\n\\n    pub fn has_definition(&self) -> bool {\\n        self.go_to_definition\\n    }\\n\\n    pub fn has_code_actions(&self) -> bool {\\n        self.code_actions\\n    }\\n}\\n\\n/// The foundational input frame.\\n///\\n/// It intentionally owns only input semantics, interaction forwarding, and\\n/// normal children. Applications remain responsible for all presentation.\\n#[derive(IntoElement)]\\npub struct InputBase {\\n    base: crate::ObservedElement<gpui::Stateful<Div>>,\\n    style: StyleRefinement,\\n    semantic_styles: InputStyles,\\n    children: Vec<AnyElement>,\\n    focused: bool,\\n    disabled: bool,\\n    role: crate::RoleOverride,\\n}\\n\\nimpl InputBase {\\n    pub fn new(id: impl Into<ElementId>) -> Self {\\n        Self {\\n            base: div().id(id).test_support(),\\n            style: StyleRefinement::default(),\\n            semantic_styles: InputStyles::default(),\\n            children: Vec::new(),\\n            focused: false,\\n            disabled: false,\\n            role: crate::RoleOverride::Implicit,\\n        }\\n    }\\n    pub fn role(mut self, role: impl Into<crate::RoleOverride>) -> Self {\\n        self.role = role.into();\\n        self\\n    }\\n\\n    pub fn focused(mut self, focused: bool) -> Self {\\n        self.focused = focused;\\n        self\\n    }\\n\\n    pub fn disabled(mut self, disabled: bool) -> Self {\\n        self.disabled = disabled;\\n        self\\n    }\\n\\n    pub fn styles(mut self, build: impl FnOnce(InputStyles) -> InputStyles) -> Self {\\n        self.semantic_styles = build(self.semantic_styles);\\n        self\\n    }\\n\\n    pub fn accessibility_label(mut self, label: impl Into<SharedString>) -> Self {\\n        self.base = self.base.aria_label(label.into());\\n        self\\n    }\\n\\n    fn resolved_style(&self) -> StyleRefinement {\\n        crate::state_style::resolve_style(\\n            &self.style,\\n            [\\n                self.focused.then_some(&self.semantic_styles.focused),\\n                self.disabled.then_some(&self.semantic_styles.disabled),\\n            ]\\n            .into_iter()\\n            .flatten(),\\n        )\\n    }\\n}\\n\\n#[derive(Default)]\\npub struct InputStyles {\\n    focused: StyleRefinement,\\n    disabled: StyleRefinement,\\n\"}}}"},{"type":"input_text","text":"{\"index\":3,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"f0414d\",\"wall_time_seconds\":0.000029093,\"exit_code\":0,\"original_token_count\":1064,\"output\":\"use super::*;\\nuse crate::app::tests::expanded_room;\\nuse gpui_kit::test::TestWindowExt;\\nuse gpui_kit::{TestAppContext, size};\\n\\n#[gpui_kit::test]\\nfn slash_menu_filters_inserts_and_undoes_through_markdown_controls(cx: &mut TestAppContext) {\\n    let (handle, view, store, _dir) = expanded_room(cx);\\n    cx.simulate_window_resize(handle, size(px(1000.), px(860.)));\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        window.click(\\\"body-field\\\", cx);\\n        window.input(\\\"/h2\\\", cx);\\n    })\\n    .unwrap();\\n    cx.run_until_parked();\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        assert!(window.find(\\\"slash-command-menu\\\").visible());\\n        assert_eq!(\\n            view.read(cx)\\n                .insert\\n                .menu\\n                .as_ref()\\n                .unwrap()\\n                .read(cx)\\n                .selected(),\\n            Some(\\\"paragraph.heading-2\\\")\\n        );\\n        let selection = view.read(cx).body.read(cx).selected_range();\\n        window.press(\\\"down\\\", cx);\\n        window.press(\\\"up\\\", cx);\\n        assert_eq!(view.read(cx).body.read(cx).selected_range(), selection);\\n        window.press(\\\"enter\\\", cx);\\n        assert_eq!(view.read(cx).body.read(cx).value().as_ref(), \\\"## \\\");\\n        window.input(\\\"café 🦊\\\", cx);\\n        window.press(\\\"ctrl-s\\\", cx);\\n        assert_eq!(store.load().unwrap().documents[0].body, \\\"## café 🦊\\\");\\n        window.press(\\\"ctrl-z\\\", cx);\\n        window.press(\\\"ctrl-z\\\", cx);\\n        assert_eq!(view.read(cx).body.read(cx).value().as_ref(), \\\"/h2\\\");\\n    })\\n    .unwrap();\\n}\\n\\n#[gpui_kit::test]\\nfn slash_escape_preserves_query_and_form_cancel_keeps_it_removed(cx: &mut TestAppContext) {\\n    let (handle, view, _store, _dir) = expanded_room(cx);\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        window.click(\\\"body-field\\\", cx);\\n        window.input(\\\"/link\\\", cx);\\n    })\\n    .unwrap();\\n    cx.run_until_parked();\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        window.press(\\\"escape\\\", cx);\\n        window.render_frame(cx);\\n        assert!(view.read(cx).insert.target.is_none());\\n        assert_eq!(view.read(cx).body.read(cx).value().as_ref(), \\\"/link\\\");\\n        assert_eq!(view.read(cx).body.read(cx).selected_range(), 5..5);\\n        window.render_frame(cx);\\n        assert!(view.read(cx).insert.target.is_none());\\n        window.input(\\\"x\\\", cx);\\n        window.press(\\\"backspace\\\", cx);\\n    })\\n    .unwrap();\\n    cx.run_until_parked();\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        assert!(view.read(cx).insert.target.is_some());\\n        window.press(\\\"enter\\\", cx);\\n        window.render_frame(cx);\\n        assert!(window.find(\\\"slash-insert-form\\\").visible());\\n        assert_eq!(view.read(cx).body.read(cx).value().as_ref(), \\\"\\\");\\n        window.press(\\\"escape\\\", cx);\\n    })\\n    .unwrap();\\n    cx.run_until_parked();\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        assert!(view.read(cx).insert.form.is_none());\\n        assert!(\\n            view.read(cx)\\n                .body\\n                .read(cx)\\n                .focus_handle(cx)\\n                .is_focused(window)\\n        );\\n        assert_eq!(view.read(cx).body.read(cx).value().as_ref(), \\\"\\\");\\n    })\\n    .unwrap();\\n}\\n\\n#[gpui_kit::test]\\nfn slash_link_form_inserts_real_values_and_preserves_undo(cx: &mut TestAppContext) {\\n    let (handle, view, _store, _dir) = expanded_room(cx);\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        window.click(\\\"body-field\\\", cx);\\n        window.input(\\\"café 🦊 /link\\\", cx);\\n    })\\n    .unwrap();\\n    cx.run_until_parked();\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        window.press(\\\"enter\\\", cx);\\n        window.render_frame(cx);\\n        window.input(\\\"The paper\\\", cx);\\n        window.press(\\\"tab\\\", cx);\\n        window.input(\\\"https://example.test/paper\\\", cx);\\n        window.click(\\\"slash-insert-confirm\\\", cx);\\n    })\\n    .unwrap();\\n    cx.run_until_parked();\\n    cx.update_window(handle, |_, window, cx| {\\n        window.render_frame(cx);\\n        assert!(view.read(cx).insert.form.is_none());\\n        assert!(\\n\"}}}"},{"type":"input_text","text":"{\"index\":4,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"a2a56a\",\"wall_time_seconds\":0.000016755,\"exit_code\":0,\"original_token_count\":630,\"output\":\"    // a forward declaration when Qwik extracts the initialization task.\\n    // eslint-disable-next-line qwik/no-use-visible-task\\n    useVisibleTask$(({ cleanup }) => {\\n      const runShortcut = (event: Event) => {\\n        void runRegistryCommand((event as CustomEvent<EditorCommandId>).detail);\\n      };\\n      window.addEventListener(\\\"twyne:editor-shortcut\\\", runShortcut);\\n      const followZenChoice = (event: Event) => {\\n        const detail = (event as CustomEvent<{ on?: boolean; source?: string }>)\\n          .detail;\\n        // Automatic flow quiets transient chrome; it must not undo a chosen view.\\n        if (detail?.source === \\\"flow\\\") return;\\n        store.zenMode = !!detail?.on;\\n        if (detail?.source !== \\\"preference\\\")\\n          saveEditorViewPreferences(localStorage, {\\n            zenMode: store.zenMode,\\n            compositorOpen: !!store.compositorOpen,\\n          });\\n      };\\n      window.addEventListener(\\\"twyne:zen-mode\\\", followZenChoice);\\n      const preferences = loadEditorViewPreferences(localStorage);\\n      Object.assign(store, preferences);\\n      // Explicit panel deep links remain reachable without changing a preference.\\n      if (new URLSearchParams(window.location.search).get(\\\"panel\\\"))\\n        store.zenMode = false;\\n      window.dispatchEvent(\\n        new CustomEvent(\\\"twyne:zen-mode\\\", {\\n          detail: { on: store.zenMode, source: \\\"preference\\\" },\\n        }),\\n      );\\n      cleanup(() => {\\n        window.removeEventListener(\\\"twyne:editor-shortcut\\\", runShortcut);\\n        window.removeEventListener(\\\"twyne:zen-mode\\\", followZenChoice);\\n      });\\n    });\\n\\n    const selectSlashCommand = $(async (commandId: EditorCommandId) => {\\n      const editor = store.editor;\\n      if (!editor) return;\\n      editor.commands.removeSlashCommandQuery();\\n      await runRegistryCommand(commandId);\\n      editor.commands.focus();\\n      store.slashOpen = false;\\n    });\\n\\n    const getSourcesForSelection = $(async () => {\\n      const selection = store.selectionAction;\\n      if (!selection) return;\\n      await onEditorialContext$?.(\\\"citations\\\");\\n      const result = await researchSelection({\\n        anchor: selection.text,\\n        folioId: store.activeFolioId,\\n      });\\n      const current = store.selectionAction;\\n      if (\\n        !result.ok &&\\n        current?.from === selection.from &&\\n        current.to === selection.to\\n      ) {\\n        store.selectionAction = {\\n          ...current,\\n          error: result.message ?? \\\"The Apparatus could not start.\\\",\\n        };\\n      }\\n    });\\n\\n\"}}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10daa-98ac-7341-8bf7-59561f3acc7f","create_time":1791230892.8800006}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
