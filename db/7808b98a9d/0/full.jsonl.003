eX to the same current math atom. Rendering/preview never\n    /// changes this payload, and an old descriptor cannot edit a replacement.\n    UpdateMathSource {\n        path: NodePath,\n        expected: Node,\n        source: String,\n    },\n    /// Patch the actual note atom, refusing an old descriptor rather than\n    /// editing whichever node later occupies the same path.\n    UpdateNote {\n        path: NodePath,\n        expected: Node,\n        text: Option<String>,\n        kind: Option<NoteKind>,\n    },\n    DeleteNote {\n        path: NodePath,\n        expected: Node,\n    },\n    MoveSection {\n        source: NodePath,\n        target: NodePath,\n        placement: super::DropPlacement,\n    },\n    MoveBlocks {\n        parent: NodePath,\n        source: std::ops::Range<usize>,\n        insert_at: usize,\n    },\n    Table {\n        cell: NodePath,\n        command: TableCommand,\n    },\n    Undo,\n    Redo,\n","stderr":"","aggregated_output":"\n/// Structural commands address a selected cell by its preserved node path.\n/// Merged-cell operations reject inconsistent geometry instead of flattening\n/// a table or silently losing unselected cell content.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum TableCommand {\n    AddRowBefore,\n    AddRowAfter,\n    DeleteRow,\n    AddColumnBefore,\n    AddColumnAfter,\n    DeleteColumn,\n    DeleteTable,\n    MergeCells { from: NodePath, to: NodePath },\n    SplitCell,\n    ToggleHeaderRow,\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub enum Command {\n    InsertText(String),\n    ReplaceSelection(String),\n    PasteFragment(super::RichFragment),\n    DeleteBackward,\n    DeleteForward,\n    SplitBlock,\n    ToggleMark(Mark),\n    SetMark(Mark),\n    UnsetMark(MarkKind),\n    AddComment(super::CommentAttributes),\n    RemoveComment {\n        id: String,\n    },\n    ClearFormatting,\n    Recase(TextCase),\n    SetParagraph,\n    SetHeading(u8),\n    SetAlignment(Alignment),\n    SetParagraphFormat(ParagraphFormat),\n    Indent,\n    Outdent,\n    ToggleList(ListKind),\n    ToggleBlockQuote,\n    ToggleCodeBlock,\n    InsertInline(InlineObject),\n    InsertBlock(BlockObject),\n    SetAttributes {\n        path: NodePath,\n        attributes: Vec<(String, Option<String>)>,\n    },\n    DeleteNode {\n        path: NodePath,\n    },\n    /// Commit raw LaTeX to the same current math atom. Rendering/preview never\n    /// changes this payload, and an old descriptor cannot edit a replacement.\n    UpdateMathSource {\n        path: NodePath,\n        expected: Node,\n        source: String,\n    },\n    /// Patch the actual note atom, refusing an old descriptor rather than\n    /// editing whichever node later occupies the same path.\n    UpdateNote {\n        path: NodePath,\n        expected: Node,\n        text: Option<String>,\n        kind: Option<NoteKind>,\n    },\n    DeleteNote {\n        path: NodePath,\n        expected: Node,\n    },\n    MoveSection {\n        source: NodePath,\n        target: NodePath,\n        placement: super::DropPlacement,\n    },\n    MoveBlocks {\n        parent: NodePath,\n        source: std::ops::Range<usize>,\n        insert_at: usize,\n    },\n    Table {\n        cell: NodePath,\n        command: TableCommand,\n    },\n    Undo,\n    Redo,\n","exit_code":0,"duration":{"secs":0,"nanos":17389},"formatted_output":"\n/// Structural commands address a selected cell by its preserved node path.\n/// Merged-cell operations reject inconsistent geometry instead of flattening\n/// a table or silently losing unselected cell content.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum TableCommand {\n    AddRowBefore,\n    AddRowAfter,\n    DeleteRow,\n    AddColumnBefore,\n    AddColumnAfter,\n    DeleteColumn,\n    DeleteTable,\n    MergeCells { from: NodePath, to: NodePath },\n    SplitCell,\n    ToggleHeaderRow,\n}\n\n#[derive(Clone, Debug, PartialEq)]\npub enum Command {\n    InsertText(String),\n    ReplaceSelection(String),\n    Paste