e:resources\\\"],\\n--\\n334-      }\\n335-    }\\n336-    const [kind, path] = routes[operation as keyof typeof routes];\\n337-    const epoch = this.#epoch;\\n338:    let confirmed: Awaited<ReturnType<ConnectedSession[\\\"#confirmed\\\"]>>;\\n339-    try {\\n340:      confirmed = await this.#confirmed(receipt.account.subject, epoch);\\n341-    } catch (error) {\\n342-      if (error instanceof ConnectedError && error.kind === \\\"signedOut\\\" && epoch === this.#epoch) {\\n343-        this.#reset();\\n344-        try { await this.#vaultWork(() => this.#vault.clear()); }\\n345:        catch { throw new ConnectedError(\\\"unavailable\\\"); }\\n346-      }\\n347:      throw error instanceof ConnectedError ? error : new ConnectedError(\\\"unavailable\\\");\\n348-    }\\n349-    if (confirmed.account.issuer !== receipt.account.issuer || confirmed.account.subject !== receipt.account.subject ||\\n350-      confirmed.account.tokenIdentifier !== receipt.account.tokenIdentifier) throw new ConnectedError(\\\"stale\\\");\\n351-    this.#requireEpoch(epoch);\\n352-    let sent = false;\\n353-    try {\\n354-      sent = true;\\n355-      const result = kind === \\\"query\\\"\\n356-        ? await confirmed.client.query(makeFunctionReference<\\\"query\\\">(path), args)\\n357-        : kind === \\\"mutation\\\"\\n--\\n362-    } catch (error) {\\n363-      // Source pushAll rejects the stale revision before performing any write.\\n364-      // This acknowledged rejection is distinct from a lost mutation response.\\n365-      if (operation === \\\"sync.push\\\" && error instanceof ConvexError &&\\n366:        record(error.data)?.code === \\\"SYNC_CONFLICT\\\") throw new ConnectedError(\\\"syncConflict\\\");\\n367-      // A failed/lost response to a write or tool call is never automatically\\n368-      // retried. The parent reconciles sync heads or presents an unknown result.\\n369-      if (sent && (kind === \\\"mutation\\\" || operation === \\\"knowledge.call\\\"))\\n370-      