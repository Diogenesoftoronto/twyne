deeper vermilion */\n  --color-periwinkle: #5c6bc0; /* periwinkle, departmental */\n  --color-sage: #8a9a5b; /* cabinet sage */\n  --color-mustard: #d4a017; /* color rule, badges */\n  --color-blush: #e8a598; /* salmon, soft accents */\n  --color-cobalt: #2c4a7c; /* deep ocean, callouts */\n  --color-writer-note: #7f4560; /* aubergine pencil, never a persona */\n\n  /* legacy \"brand\" mapped to vermilion for compat */\n  --color-brand: #c1272d;\n  --color-brand-light: #d65157;\n  --color-brand-dark: #9c1a1f;\n\n  /* legacy \"surface\" mapped to paper for compat */\n  --color-surface: #f4ecd8;\n  --color-surface-2: #ebe1c9;\n  --color-surface-3: #ddd0b1;\n\n  /* ── Status colors (kept, but recalibrated for paper) ── */\n  --color-accent-green: #5b7a3a;\n  --color-accent-amber: #b8860b;\n  --color-accent-red: #b3261e;\n  --color-accent-blue: #2c4a7c;\n\n  /* ── Cast colors (the persona portraits) ─────────────── */\n  --color-persona-devil: #c1272d; /* vermilion */\n  --color-persona-angel: #8a9a5b; /* sage */\n  --color-persona-scholar: #5c6bc0; /* periwinkle */\n  --color-persona-editor: #d4a017; /* mustard */\n  --color-persona-reader: #2c4a7c; /* cobalt */\n\n  /* ── Type stack ──────────────────────────────────────── */\n  --font-display: \"Libre Baskerville\", \"Playfair Display\", Georgia, serif;\n  --font-serif: \"Lora\", \"Crimson Pro\", Georgia, \"Times New Roman\", serif;\n  --font-sans: \"DM Sans\", \"Inter\", system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", \"Fira Code\", monospace;\n  --font-typewriter: \"Special Elite\", \"Courier New\", monospace;\n}\n\n/* ── Semantic z-scale ────────────────────────────────────── */\n:root {\n","stderr":"","aggregated_output":"@import \"tailwindcss\";\n\n/* Diagnostic log labels are text, not arbitrary CSS-property utilities. */\n@source not inline(\"[twyne:{account,agents,apparatus,arize,editor,eval,extract,interview,judge,litert,posthog,rateLimit,robustness,rubric,suggestion,usage}]\");\n\n/*\n * TWYNE — 