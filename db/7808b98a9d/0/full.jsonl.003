king: f32, color: u32) -> gpui_kit::AnyElement {\n    wrapped_tracked_text(\n","stderr":"","aggregated_output":"}\n\npub fn tracked_typewriter(\n    label: &str,\n    size: f32,\n    tracking: f32,\n    color: u32,\n) -> gpui_kit::AnyElement {\n    tracked_text(\n        label,\n        font(theme::TYPEWRITER_FONT),\n        size,\n        tracking,\n        color,\n        size * 1.5,\n    )\n}\n\npub fn tracked_text(\n    label: &str,\n    face: Font,\n    size: f32,\n    tracking: f32,\n    color: u32,\n    line_height: f32,\n) -> gpui_kit::AnyElement {\n    div()\n        .id(SharedString::from(format!(\"dept-{label}\")))\n        .role(Role::Label)\n        .font_family(face.family.clone())\n        .font_weight(face.weight)\n        .text_size(px(size))\n        .line_height(px(line_height))\n        .text_color(rgb(color))\n        .aria_label(label.to_owned())\n        .child(TrackedRun {\n            label: label.to_owned().into(),\n            size,\n            tracking,\n            color,\n            face,\n            line_height,\n        })\n        .into_any_element()\n}\n\n/// CSS can wrap the masthead department at spaces and hyphens. Each run\n/// retains fractional glyph advances and the trailing letter spacing.\npub fn wrapping_dept_label(label: &str, cx: &App) -> impl IntoElement {\n    let label = label.to_uppercase();\n    let color = theme::palette(cx).ink_muted;\n    wrapping_typewriter(&label, 3.2, color)\n}\n\npub fn wrapping_typewriter(label: &str, tracking: f32, color: u32) -> gpui_kit::AnyElement {\n    wrapped_tracked_text(\n","exit_code":0,"duration":{"secs":0,"nanos":20831},"formatted_output":"}\n\npub fn tracked_typewriter(\n    label: &str,\n    size: f32,\n    tracking: f32,\n    color: u32,\n) -> gpui_kit::AnyElement {\n    tracked_text(\n        label,\n        font(theme::TYPEWRITER_FONT),\n        size,\n        tracking,\n        color,\n        size * 1.5,\n    )\n}\n\npub fn tracked_text(\n    label: &str,\n    face: Fon