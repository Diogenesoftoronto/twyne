M src/utils/live-review.ts\\n M src/utils/lix.ts\\n M src/utils/my-desk-integration.test.ts\\n M src/utils/notorganic-connect.test.ts\\n M src/utils/notorganic-connect.ts\\n M src/utils/revision-history.test.ts\\n M src/utils/revision-history.ts\\n M src/utils/seo.ts\\n M src/utils/speech.test.ts\\n M src/utils/typst/compiler.worker.ts\\n M src/utils/typst/export.test.ts\\n M src/utils/typst/export.ts\\n M src/utils/typst/protocol.ts\\n M src/utils/typst/serialize.test.ts\\n M src/utils/typst/serialize.ts\\n M tests/live-voice-relay.test.ts\\n?? .github/workflows/gpui-desktop.yml\\n?? .github/workflows/typing-performance.yml\\n?? .house-shots/\\n?? convex/house.test.ts\\n?? convex/house.ts\\n?? convex/knowledge.test.ts\\n?? convex/knowledge.ts\\n?? convex/lib/notorganicSignIn.test.ts\\n?? convex/typstSync.test.ts\\n?? desktop/gpui/\\n?? docs/README.md\\n?? docs/assets/manual-media-preparation.md\\n?? docs/assets/manual-videos.json\\n?? docs/editor-typing-performance.md\\n?? docs/flow-and-context.md\\n?? docs/illuminated-initials-artwork.md\\n?? docs/manual-visuals.md\\n?? docs/social-preview-artwork.md\\n?? docs/social-preview-options.md\\n?? docs/typst-native-editor-execution.md\\n?? e2e/brief-signin.e2e.ts\\n?? e2e/draft-navigation.e2e.ts\\n?? e2e/editor-declutter.e2e.ts\\n?? e2e/editor-typing-benchmark.e2e.ts\\n?? e2e/editor-typing.e2e.ts\\n?? e2e/flow-surface.e2e.ts\\n?? e2e/helpers/\\n?? e2e/house-ui.e2e.ts\\n?? e2e/live-voice-desk.e2e.ts\\n?? e2e/manual-portraits.e2e.ts\\n?? e2e/notorganic-signin.e2e.ts\\n?? e2e/typst-editor.e2e.ts\\n?? e2e/typst-storage.e2e.ts\\n?? launch-videos/\\n?? public/assets/avatars/\\n?? public/assets/illuminated-initials/\\n?? public/assets/landing/options-2026-09/\\n?? public/assets/manual/\\n?? public/assets/page-borders/\\n?? public/assets/social/\\n?? public/assets/stamp-press/\\n?? scripts/build-social-preview.ts\\n?? scripts/build-social-video.ts\\n?? scripts/compare-typing.ts\\n?? scripts/generate-social-desk-video.ts\\n?? scr