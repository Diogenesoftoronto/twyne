ldowns_match_executed_source ... ok\\n\\ntest result: ok. 60 passed; 0 failed; 0 ignored; 0 measured; 618 filtered out; finished in 0.07s\\n\\n     Running unittests src/main.rs (desktop/gpui/target/debug/deps/twyne_desktop-59586118d18b04a7)\\n\\nrunning 5 tests\\ntest app::gen_ui_coordinator::tests::retired_scope_cannot_apply_to_a_new_editor_visit ... ok\\ntest app::gen_ui_coordinator::tests::rhythm_bar_uses_current_native_sentence_positions ... ok\\ntest app::gen_ui_coordinator::tests::changed_sentence_is_retained_and_reports_sources_notice ... ok\\ntest app::gen_ui_coordinator::tests::real_working_copy_button_replaces_only_its_sentence_and_undo_restores_the_caret ... ok\\ntest app::gen_ui_coordinator::tests::real_jot_and_keep_buttons_require_saved_data_and_survive_reopen ... ok\\n\\ntest result: ok. 5 passed; 0 failed; 0 ignored; 0 measured; 98 filtered out; finished in 3.59s\\n\\n     Running fixtures/native-audio/synthetic_loopback.rs (desktop/gpui/target/debug/deps/native_audio_contract-42116fe74da34d9d)\\n\\nrunning 0 tests\\n\\ntest result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 18 filtered out; finished in 0.00s\\n\\n\\n{\\\"job\\\": \\\"/home/diogenes/Projects/twyne/desktop/gpui/target/verification/genui-ui-0ab98615f5b5\\\", \\\"status\\\": \\\"passed\\\", \\\"exitCode\\\": 0}\\n\"}}"},{"type":"input_text","text":"{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"bf7284\",\"wall_time_seconds\":0.000009526,\"exit_code\":0,\"original_token_count\":1458,\"output\":\"//! Native request metadata and cancellation; no provider/session authority.\\n//! Timeout/byte limits below are explicit native policies, not Source token budgets.\\n\\nuse super::provider_types::AiFeature;\\nuse serde::{Deserialize, Serialize};\\nuse std::{\\n    sync::{\\n        Arc,\\n        atomic::{AtomicBool, Ordering},\\n    },\\n    time::{Duration, SystemTime, UNIX_EPOCH},\\n};\\nuse uuid::Uuid;\\n\\npub const MAX_REQUEST_BODY_BYTES: usize = 4 * 1024 * 1024; // 4 MiB\\npub const MAX_RESPONSE_BYTES: usize = 8 * 1024 * 1024; // 8 MiB\\npub const DEFAULT_TIMEOUT_MS: u64 = 60_000;\\npub const RESEARCH_TIMEOUT_MS: u64 = 30_000;\\n\\n/// Unique request identifier for logging, cancellation, and in-flight tracking.\\n#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]\\npub struct AiRequestId(pub String);\\n\\nimpl AiRequestId {\\n    pub fn new() -> Self {\\n        let now = SystemTime::now()\\n            .duration_since(UNIX_EPOCH)\\n            .unwrap_or_default()\\n            .as_millis();\\n        Self(format!(\\\"req-{now}-{}\\\", Uuid::new_v4()))\\n    }\\n}\\n\\nimpl Default for AiRequestId {\\n    fn default() -> Self {\\n        Self::new()\\n    }\\n}\\n\\n/// Native trace label, not an exact port of the Source random trace-ID format.\\n#[derive(Clone, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]\\npub struct TraceId(pub String);\\n\\nimpl TraceId {\\n    pub fn new(prefix: &str) -> Self {\\n        let now = SystemTime::now()\\n            .duration_since(UNIX_EPOCH)\\n            .unwrap_or_default()\\n            .as_millis();\\n        Self(format!(\\\"{prefix}-{now}-{}\\\", Uuid::new_v4()))\\n    }\\n}\\n\\n/// Manuscript identity at request dispatch time.\\n/// Used to detect if the user continued typing or saved a new revision while the\\n/// request was in flight, avoiding applying stale results to new text.\\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\\npub struct RevisionIdentity {\\n    pub folio_id: String,\\n    pub generation: u64,\\n}\\n\\nimpl RevisionIdentity {\\n    pub fn new(folio_id: impl Into<String>, generation: u64) -> Self {\\n        Self {\\n            folio_id: folio_id.into(),\\n            generation,\\n        }\\n    }\\n\\n    /// Check if this request's revision matches the current active document revision.\\n    pub fn is_current(&self, active_folio_id: &str, active_generation: u64) -> bool {\\n        self.folio_id == active_folio_id && self.generation == active_generation\\n    }\\n}\\n\\n/// Thread-safe cancellation token for halting inflight HTTP streams and child jobs.\\n#[derive(Clone, Debug)]\\npub struct CancellationToken {\\n    cancelled: Arc<AtomicBool>,\\n}\\n\\nimpl Default for CancellationToken {\\n    fn default() -> Self {\\n        Self::new()\\n    }\\n}\\n\\nimpl CancellationToken {\\n    pub fn new() -> Self {\\n        Self {\\n            cancelled: Arc::new(AtomicBool::new(false)),\\n        }\\n    }\\n\\n    pub fn cancel(&self) {\\n        self.cancelled.store(true, Ordering::SeqCst);\\n    }\\n\\n    pub fn is_cancelled(&self) -> bool {\\n        self.cancelled.load(Ordering::SeqCst)\\n    }\\n}\\n\\n/// Chat message in OpenAI-compatible format.\\n#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]\\npub struct ChatMessage {\\n    pub role: String,\\n    pub content: String,\\n}\\n\\nimpl ChatMessage {\\n    pub fn system(content: impl Into<String>) -> Self {\\n        Self {\\n            role: \\\"system\\\".into(),\\n            content: content.into(),\\n        }\\n    }\\n\\n    pub fn user(content: impl Into<String>) -> Self {\\n        Self {\\n            role: \\\"user\\\".into(),\\n            content: content.into(),\\n        }\\n    }\\n\\n    pub fn assistant(content: impl Into<String>) -> Self {\\n        Self {\\n            role: \\\"assistant\\\".into(),\\n            content: content.into(),\\n        }\\n    }\\n}\\n\\n/// Concrete completion request to be executed by a provider adapter.\\n#[derive(Clone)]\\npub struct CompletionRequest {\\n    pub request_id: AiRequestId,\\n    pub trace_id: Option<TraceId>,\\n    pub revision: Option<RevisionIdentity>,\\n    pub feature: AiFeature,\\n    pub provider_id: String,\\n    pub model: String,\\n    pub messages: Vec<ChatMessage>,\\n    pub temperature: f64,\\n    pub max_tokens: Option<u32>,\\n    pub stream: bool,\\n    pub timeout: Duration,\\n    pub cancel_token: CancellationToken,\\n}\\n\\nimpl CompletionRequest {\\n    pub fn new(\\n        feature: AiFeature,\\n        provider_id: impl Into<String>,\\n        model: impl Into<String>,\\n        messages: Vec<ChatMessage>,\\n    ) -> Self {\\n        let temp = feature.default_temperature();\\n        let timeout = if matches!(\\n            feature,\\n            AiFeature::ResearchExtract | AiFeature::ResearchWebSearch\\n        ) {\\n            Duration::from_millis(RESEARCH_TIMEOUT_MS)\\n        } else {\\n            Duration::from_millis(DEFAULT_TIMEOUT_MS)\\n        };\\n\\n        Self {\\n            request_id: AiRequestId::new(),\\n            trace_id: None,\\n            revision: None,\\n            feature,\\n            provider_id: provider_id.into(),\\n            model: model.into(),\\n            messages,\\n            temperature: temp,\\n            max_tokens: None,\\n            stream: false,\\n            timeout,\\n            cancel_token: CancellationToken::new(),\\n        }\\n    }\\n\\n    pub fn with_revision(mut self, folio_id: impl Into<String>, generation: u64) -> Self {\\n        self.revision = Some(RevisionIdentity::new(folio_id, generation));\\n        self\\n    }\\n\\n    pub fn with_trace(mut self, trace_prefix: &str) -> Self {\\n        self.trace_id = Some(TraceId::new(trace_prefix));\\n        self\\n    }\\n\\n    pub fn with_temperature(mut self, temperature: f64) -> Self {\\n        self.temperature = temperature;\\n        self\\n    }\\n\\n    pub fn with_max_tokens(mut self, max_tokens: Option<u32>) -> Self {\\n        self.max_tokens = max_tokens;\\n        self\\n    }\\n\\n    pub fn with_streaming(mut self, stream: bool) -> Self {\\n        self.stream = stream;\\n        self\\n    }\\n\\n    pub fn with_timeout(mut self, timeout: Duration) -> Self {\\n\"}}"},{"type":"input_text","text":"{\"i\":2,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"7ffaf4\",\"wall_time_seconds\":0.000013664,\"exit_code\":0,\"original_token_count\":1825,\"output\":\"//! Unconnected coordinator with bounded, generation-qualified request tickets.\\n//! Host result adoption still requires its own current entity/scope/revision CAS.\\nuse super::{\\n    litert_lifecycle::{LiteRtConfig, LiteRtError, LiteRtProcessManager, LiteRtState},\\n    loopback_transport::{AiError, CompletionResult, LoopbackClient, validate_request},\\n    provider_types::{\\n        AiFeature, AiProviderType, AiSettingsRecord, ResolvedFeatureConfig, resolve_feature_config,\\n        resolve_feature_config_for_persona,\\n    },\\n    request::{AiRequestId, CancellationToken, CompletionRequest, RevisionIdentity},\\n    stream_accumulator::GenerationStreamSnapshot,\\n};\\nuse std::{\\n    collections::{HashMap, VecDeque},\\n    sync::Mutex,\\n};\\nuse uuid::Uuid;\\n\\npub const MAX_IN_FLIGHT: usize = 4;\\npub const MAX_TERMINAL_TICKETS: usize = 64;\\n\\n#[derive(Clone, Debug, PartialEq, Eq)]\\npub struct RequestTicket {\\n    pub request_id: AiRequestId,\\n    nonce: Uuid,\\n    epoch: Uuid,\\n    revision: Option<RevisionIdentity>,\\n}\\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\\npub enum RequestTerminal {\\n    SucceededSynthetic,\\n    Failed,\\n    Cancelled,\\n    Stale,\\n}\\nstruct InFlightEntry {\\n    ticket: RequestTicket,\\n    cancel: CancellationToken,\\n}\\nstruct Registry {\\n    epoch: Uuid,\\n    active: Option<RevisionIdentity>,\\n    in_flight: HashMap<AiRequestId, InFlightEntry>,\\n    terminal: VecDeque<(RequestTicket, RequestTerminal)>,\\n}\\nimpl Registry {\\n    fn current(&self, ticket: &RequestTicket) -> bool {\\n        self.epoch == ticket.epoch && self.active == ticket.revision\\n    }\\n    fn invalidate(&mut self) {\\n        self.epoch = Uuid::new_v4();\\n        let entries = self\\n            .in_flight\\n            .drain()\\n            .map(|(_, entry)| entry)\\n            .collect::<Vec<_>>();\\n        for entry in entries {\\n            entry.cancel.cancel();\\n            self.remember(entry.ticket, RequestTerminal::Stale);\\n        }\\n    }\\n    fn remember(&mut self, ticket: RequestTicket, state: RequestTerminal) {\\n        self.terminal.push_back((ticket, state));\\n        while self.terminal.len() > MAX_TERMINAL_TICKETS {\\n            self.terminal.pop_front();\\n        }\\n    }\\n}\\n\\npub struct NativeAiCoordinator {\\n    litert_manager: LiteRtProcessManager,\\n    settings: AiSettingsRecord,\\n    registry: Mutex<Registry>,\\n}\\n/// A synthetic result carrying the exact ticket needed for a later adoption guard.\\n#[derive(Clone, Debug)]\\npub struct GuardedCompletion {\\n    pub ticket: RequestTicket,\\n    pub result: CompletionResult,\\n}\\n\\nimpl NativeAiCoordinator {\\n    pub fn new(config: LiteRtConfig, settings: AiSettingsRecord) -> Self {\\n        Self {\\n            litert_manager: LiteRtProcessManager::new(config),\\n            settings,\\n            registry: Mutex::new(Registry {\\n                epoch: Uuid::new_v4(),\\n                active: None,\\n                in_flight: HashMap::new(),\\n                terminal: VecDeque::new(),\\n            }),\\n        }\\n    }\\n    pub fn litert_manager(&self) -> &LiteRtProcessManager {\\n        &self.litert_manager\\n    }\\n    pub fn litert_manager_mut(&mut self) -> &mut LiteRtProcessManager {\\n        &mut self.litert_manager\\n    }\\n    pub fn litert_state(&self) -> &LiteRtState {\\n        self.litert_manager.state()\\n    }\\n    pub fn is_local_ai_ready(&self) -> bool {\\n        self.litert_manager.is_ready()\\n    }\\n    pub fn start_local_ai(&mut self) -> Result<Option<String>, LiteRtError> {\\n        self.litert_manager.start()\\n    }\\n    pub fn stop_local_ai(&mut self) {\\n        if let Ok(mut registry) = self.registry.lock() {\\n            registry.invalidate();\\n        }\\n        self.litert_manager.stop();\\n    }\\n    pub fn update_settings(&mut self, settings: AiSettingsRecord) {\\n        if self.settings != settings {\\n            if let Ok(mut registry) = self.registry.lock() {\\n                registry.invalidate();\\n            }\\n            self.settings = settings;\\n        }\\n    }\\n    pub fn settings(&self) -> &AiSettingsRecord {\\n        &self.settings\\n    }\\n    pub fn resolve_feature(&self, feature: &AiFeature) -> Option<ResolvedFeatureConfig> {\\n        resolve_feature_config(&self.settings, feature)\\n    }\\n    pub fn resolve_feature_for_persona(\\n        &self,\\n        feature: &AiFeature,\\n        id: Option<&str>,\\n        model: Option<&str>,\\n        temperature: Option<f64>,\\n    ) -> Option<ResolvedFeatureConfig> {\\n        resolve_feature_config_for_persona(&self.settings, feature, id, model, temperature)\\n    }\\n    /// Constant-size host context boundary, never manuscript serialization.\\n    /// Revisit/settings changes invalidate old tickets even if the folio/gen returns.\\n    pub fn set_active_revision(&self, revision: Option<RevisionIdentity>) -> Result<(), AiError> {\\n        let mut registry = self.registry.lock().map_err(|_| AiError::StaleRequest)?;\\n        if registry.active != revision {\\n            registry.invalidate();\\n            registry.active = revision;\\n        }\\n        Ok(())\\n    }\\n    pub fn begin_request(&self, req: &CompletionRequest) -> Result<RequestTicket, AiError> {\\n        validate_request(req)?;\\n        let mut registry = self.registry.lock().map_err(|_| AiError::StaleRequest)?;\\n        if req.revision.is_none() || registry.active != req.revision {\\n            return Err(AiError::StaleRequest);\\n        }\\n        if registry.in_flight.contains_key(&req.request_id)\\n            || registry\\n                .terminal\\n                .iter()\\n                .any(|(t, _)| t.request_id == req.request_id)\\n        {\\n            return Err(AiError::DuplicateRequest);\\n        }\\n        if registry.in_flight.len() >= MAX_IN_FLIGHT {\\n            return Err(AiError::QueueFull);\\n        }\\n        let ticket = RequestTicket {\\n            request_id: req.request_id.clone(),\\n            nonce: Uuid::new_v4(),\\n            epoch: registry.epoch,\\n            revision: req.revision.clone(),\\n        };\\n        registry.in_flight.insert(\\n            req.request_id.clone(),\\n            InFlightEntry {\\n                ticket: ticket.clone(),\\n                cancel: req.cancel_token.clone(),\\n            },\\n        );\\n        Ok(ticket)\\n    }\\n    pub fn accepts_snapshot(&self, ticket: &RequestTicket) -> bool {\\n        self.registry.lock().ok().is_some_and(|registry| {\\n            registry.current(ticket)\\n                && registry\\n                    .in_flight\\n                    .get(&ticket.request_id)\\n                    .is_some_and(|entry| entry.ticket == *ticket && !entry.cancel.is_cancelled())\\n        })\\n    }\\n    /// Exact ticket match prevents an old completion/unwind from unregistering\\n    /// a replacement request. Terminal transition is accepted once only.\\n    pub fn finish_request(\\n        &self,\\n        ticket: &RequestTicket,\\n        outcome: RequestTerminal,\\n    ) -> Result<(), AiError> {\\n        let mut registry = self.registry.lock().map_err(|_| AiError::StaleRequest)?;\\n        let entry = registry\\n            .in_flight\\n            .get(&ticket.request_id)\\n            .ok_or(AiError::StaleRequest)?;\\n        if entry.ticket != *ticket {\\n            return Err(AiError::StaleRequest);\\n        }\\n        let state = if !registry.current(ticket) {\\n            RequestTerminal::Stale\\n        } else if entry.cancel.is_cancelled() {\\n            RequestTerminal::Cancelled\\n        } else {\\n            outcome\\n\"}}"},{"type":"input_text","text":"{\"i\":3,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"293569\",\"wall_time_seconds\":0.000015153,\"exit_code\":0,\"original_token_count\":1645,\"output\":\"use super::*;\\nuse twyne_desktop::{\\n    rubric::{RubricRecord, RubricRequest, RubricStore},\\n    rubric_view::{\\n        RubricCapabilities, RubricEvent, RubricFreshness, RubricSurface, RubricView,\\n        RubricViewContext,\\n    },\\n    semantic_bridge::SemanticBridge,\\n};\\n\\n/// Accepted editorial artifacts stay separate from manuscript source. The\\n/// existing library Store owns the OS lock for this metadata writer as well.\\npub(super) struct RubricState {\\n    pub(super) store: Option<RubricStore>,\\n    pub(super) record: Arc<RubricRecord>,\\n    pub(super) pending: Option<RubricRequest>,\\n    pub(super) view: Option<Entity<RubricView>>,\\n    pub(super) subscription: Option<Subscription>,\\n    pub(super) scope: Option<String>,\\n    pub(super) route: bool,\\n    pub(super) boundary_error: Option<String>,\\n    context: RubricViewContext,\\n    context_generation: u64,\\n    context_task: Option<Task<()>>,\\n}\\n\\nimpl RubricState {\\n    pub(super) fn load(library: &Store) -> (Self, Vec<String>) {\\n        let (store, record, warnings) = match RubricStore::open(library.root()).and_then(|store| {\\n            let loaded = store.load()?;\\n            Ok((store, loaded))\\n        }) {\\n            Ok((store, loaded)) => (Some(store), loaded.record, loaded.warnings),\\n            Err(error) => (\\n                None,\\n                Arc::new(RubricRecord::default()),\\n                vec![format!(\\\"The Galley Proof could not be opened: {error:#}\\\")],\\n            ),\\n        };\\n        (\\n            Self {\\n                store,\\n                record,\\n                pending: None,\\n                view: None,\\n                subscription: None,\\n                scope: None,\\n                route: false,\\n                boundary_error: None,\\n                context: RubricViewContext::default(),\\n                context_generation: 0,\\n                context_task: None,\\n            },\\n            warnings,\\n        )\\n    }\\n}\\n\\n/// This runs only on the background executor at an opening or settled-save\\n/// boundary. The original helper supplies projection/fingerprint arithmetic;\\n/// neither measured static features nor room explanation creates a grade.\\nfn prepare_context(\\n    document: Manuscript,\\n    record: Arc<RubricRecord>,\\n    scope: &str,\\n) -> anyhow::Result<RubricViewContext> {\\n    let bridge = SemanticBridge::discover()?;\\n    let html = match document.workspace.as_deref() {\\n        Some(workspace) => std::borrow::Cow::Borrowed(workspace.content.html.as_str()),\\n        None => std::borrow::Cow::Owned(bridge.from_markdown(&document.body)?.html),\\n    };\\n    let draft = bridge.rubric_draft_context(&html)?;\\n    let display = record.display(scope)?;\\n    let result = display.result.value.as_ref();\\n    let freshness = result.map_or(RubricFreshness::Unknown, |result| {\\n        if result.draft_fingerprint.as_ref() == Some(&draft.fingerprint) {\\n            RubricFreshness::Fresh\\n        } else {\\n            RubricFreshness::Stale\\n        }\\n    });\\n    let room_parts = result\\n        .filter(|result| {\\n            result\\n                .scoring_method\\n                .as_ref()\\n                .is_none_or(|method| method.as_str() != \\\"judgement\\\")\\n        })\\n        .and_then(|result| {\\n            let judges = serde_json::to_value(&result.judges).ok()?;\\n            let static_score = serde_json::to_value(&result.static_score).ok()?;\\n            let brief = document\\n                .workspace\\n                .as_deref()\\n                .and_then(|workspace| workspace.brief.as_ref())\\n                .and_then(|brief| serde_json::to_value(brief).ok());\\n            bridge\\n                .rubric_room_parts(\\n                    &judges,\\n                    &static_score,\\n                    brief.as_ref(),\\n                    result.target_fit.as_ref().copied(),\\n                )\\n                .ok()\\n        });\\n    Ok(RubricViewContext {\\n        freshness,\\n        draft_word_count: Some(draft.word_count),\\n        minimum_words: draft.min_words,\\n        result_filed_label: result\\n            .and_then(|result| bridge.local_timestamp_ms(result.timestamp).ok())\\n            .map(|date| date.label),\\n        live_review_filed_label: display\\n            .live_review\\n            .value\\n            .as_ref()\\n            .and_then(|review| bridge.local_timestamp_ms(review.at).ok())\\n            .map(|date| date.label),\\n        live_review_status: None,\\n        room_parts,\\n    })\\n}\\n\\nimpl WritingRoom {\\n    fn rubric_capabilities(&self) -> RubricCapabilities {\\n        RubricCapabilities {\\n            persist: self.rubric.store.is_some(),\\n            refine_dossier: !self.active_document().archived,\\n            tools: self.rich.is_some()\\n                && !self.active_document().archived\\n                && self\\n                    .source_session\\n                    .as_ref()\\n                    .is_none_or(|session| !session.pending),\\n            ..RubricCapabilities::default()\\n        }\\n    }\\n\\n    pub(super) fn sync_rubric_surface(&mut self, window: &mut Window, cx: &mut Context<Self>) {\\n        let desired = if self.rubric.route {\\n            RubricSurface::Galley\\n        } else {\\n            RubricSurface::Board\\n        };\\n        if let Some(view) = &self.rubric.view\\n            && view.read(cx).surface() != desired\\n        {\\n            view.update(cx, |view, cx| view.set_surface(desired, window, cx));\\n        }\\n    }\\n\\n    pub(super) fn ensure_rubric(\\n        &mut self,\\n        window: &mut Window,\\n        cx: &mut Context<Self>,\\n    ) -> anyhow::Result<()> {\\n        let scope = Some(self.marginalia_folio_id());\\n        let capabilities = self.rubric_capabilities();\\n        let context = RubricViewContext::default();\\n        if let Some(view) = &self.rubric.view {\\n            anyhow::ensure!(\\n                view.update(cx, |view, cx| view.set_scope(\\n                    scope.clone(),\\n                    context.clone(),\\n                    window,\\n                    cx\\n                )),\\n                \\\"File the held Rubric change before opening another folio.\\\"\\n            );\\n            view.update(cx, |view, cx| view.set_capabilities(capabilities, cx));\\n        } else {\\n            let record = self.rubric.record.clone();\\n            let view = cx.new(|cx| {\\n                RubricView::new(\\n                    record,\\n                    scope.clone(),\\n                    context.clone(),\\n                    capabilities,\\n                    window,\\n                    cx,\\n                )\\n            });\\n            self.rubric.subscription = Some(cx.subscribe_in(\\n                &view,\\n                window,\\n\"}}"},{"type":"input_text","text":"{\"i\":4,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"27b172\",\"wall_time_seconds\":0.000015802,\"exit_code\":0,\"original_token_count\":2238,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Render Twyne in an isolated Xvfb display; never use the user's desktop.\\\"\\\"\\\"\\nimport argparse\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport shutil\\nimport subprocess\\nimport tempfile\\nimport time\\n\\nparser = argparse.ArgumentParser()\\nparser.add_argument(\\\"--binary\\\", required=True)\\nparser.add_argument(\\\"--output\\\", required=True)\\nparser.add_argument(\\\"--geometry\\\", help=\\\"Write observed interface bounds from the UI-test build\\\")\\nparser.add_argument(\\\"--width\\\", type=int, default=1280)\\nparser.add_argument(\\\"--height\\\", type=int, default=860)\\nparser.add_argument(\\\"--state\\\", choices=[\\\"quiet\\\", \\\"writing\\\", \\\"desk\\\", \\\"drawer\\\", \\\"board\\\", \\\"source\\\", \\\"proof\\\", \\\"split\\\", \\\"dossier\\\", \\\"settings\\\", \\\"versions\\\", \\\"house\\\", \\\"library\\\", \\\"flow\\\", \\\"tools\\\", \\\"marginalia\\\", \\\"margin-thread\\\", \\\"margin-composer\\\", \\\"cast\\\", \\\"editors\\\", \\\"analysis\\\", \\\"rubric\\\", \\\"galley\\\", \\\"apparatus\\\", \\\"apparatus-page\\\", \\\"sentence-lab\\\", \\\"rhythm-strip\\\", \\\"claim-check\\\", \\\"reader-questions\\\"], default=\\\"quiet\\\")\\nparser.add_argument(\\\"--fixture\\\")\\nparser.add_argument(\\\"--comments\\\")\\nparser.add_argument(\\\"--comments-folio\\\")\\nparser.add_argument(\\\"--cast\\\")\\nparser.add_argument(\\\"--cast-folio\\\")\\nparser.add_argument(\\\"--rubric\\\")\\nparser.add_argument(\\\"--rubric-folio\\\")\\nparser.add_argument(\\\"--apparatus\\\")\\nparser.add_argument(\\\"--apparatus-folio\\\")\\nargs = parser.parse_args()\\nif not 320 <= args.width <= 3840 or not 360 <= args.height <= 2160:\\n    parser.error(\\\"Capture size must be 320–3840 by 360–2160 pixels.\\\")\\nif bool(args.comments) != bool(args.comments_folio):\\n    parser.error(\\\"--comments and --comments-folio must be provided together\\\")\\nif bool(args.cast) != bool(args.cast_folio):\\n    parser.error(\\\"--cast and --cast-folio must be provided together\\\")\\nif bool(args.rubric) != bool(args.rubric_folio):\\n    parser.error(\\\"--rubric and --rubric-folio must be provided together\\\")\\nif bool(args.apparatus) != bool(args.apparatus_folio):\\n    parser.error(\\\"--apparatus and --apparatus-folio must be provided together\\\")\\nfor executable in (\\\"Xvfb\\\", \\\"xwd\\\", \\\"magick\\\"):\\n    if not shutil.which(executable):\\n        parser.error(f\\\"{executable} is required; run inside the project's Devenv shell.\\\")\\n\\nwith tempfile.TemporaryDirectory(prefix=\\\"twyne-native-render-\\\") as temporary:\\n    root = Path(temporary)\\n    # Let Xvfb allocate an unused display, with no TCP listener.\\n    read_fd, write_fd = os.pipe()\\n    # GPUI's X11 backend offsets a new window by two pixels. Leave room for\\n    # the full client and capture that window, so root-screen position never\\n    # shifts the comparison or clips the application's right edge.\\n    screen = f\\\"{args.width + 4}x{args.height + 4}x24\\\"\\n    server = subprocess.Popen([\\\"Xvfb\\\", \\\"-displayfd\\\", str(write_fd), \\\"-screen\\\", \\\"0\\\", screen, \\\"-nolisten\\\", \\\"tcp\\\"], pass_fds=(write_fd,), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)\\n    os.close(write_fd)\\n    app = None\\n    try:\\n        with os.fdopen(read_fd) as display_file:\\n            number = display_file.readline().strip()\\n        if not number:\\n            raise RuntimeError(\\\"The isolated display did not start.\\\")\\n        environment = os.environ.copy()\\n        environment.pop(\\\"WAYLAND_DISPLAY\\\", None)\\n        environment[\\\"DISPLAY\\\"] = f\\\":{number}\\\"\\n        environment[\\\"GPUI_X11_SCALE_FACTOR\\\"] = \\\"1\\\"\\n        environment[\\\"XDG_RUNTIME_DIR\\\"] = str(root)\\n        if environment.get(\\\"TWYNE_GPUI_RENDER_ICD\\\"):\\n            environment[\\\"VK_DRIVER_FILES\\\"] = environment[\\\"TWYNE_GPUI_RENDER_ICD\\\"]\\n        command = [str(Path(args.binary).resolve()), \\\"--data-dir\\\", str(root / \\\"library\\\"), \\\"--capture-state\\\", args.state, \\\"--capture-size\\\", f\\\"{args.width}x{args.height}\\\"]\\n        if args.fixture:\\n            command.append(str(Path(args.fixture).resolve()))\\n        if args.comments:\\n            command.extend([\\\"--capture-comments\\\", str(Path(args.comments).resolve()), \\\"--capture-comments-folio\\\", args.comments_folio])\\n        if args.cast:\\n            command.extend([\\\"--capture-cast\\\", str(Path(args.cast).resolve()), \\\"--capture-cast-folio\\\", args.cast_folio])\\n        if args.rubric:\\n            command.extend([\\\"--capture-rubric\\\", str(Path(args.rubric).resolve()), \\\"--capture-rubric-folio\\\", args.rubric_folio])\\n        if args.apparatus:\\n            command.extend([\\\"--capture-apparatus\\\", str(Path(args.apparatus).resolve()), \\\"--capture-apparatus-folio\\\", args.apparatus_folio])\\n        if args.geometry:\\n            command.extend([\\\"--capture-geometry\\\", str(Path(args.geometry).resolve()), \\\"--capture-geometry-watch\\\"])\\n        with (root / \\\"app.log\\\").open(\\\"w\\\") as log:\\n            app = subprocess.Popen(command, env=environment, stdout=log, stderr=log)\\n            # Wait for the application to render, bounded and isolated. The\\n            # saved image is native pixels, independent of GPUI's test fonts.\\n            deadline = time.monotonic() + 20\\n            while time.monotonic() < deadline:\\n                if app.poll() is not None:\\n                    raise RuntimeError((root / \\\"app.log\\\").read_text())\\n                if args.geometry:\\n                    status = (root / \\\"app.log\\\").read_text()\\n                    if \\\"TWYNE_CAPTURE_GEOMETRY_ERROR\\\" in status:\\n                        raise RuntimeError(status)\\n                    if \\\"TWYNE_CAPTURE_GEOMETRY_READY\\\" not in status:\\n                        time.sleep(0.1)\\n                        continue\\n                    try:\\n                        if not json.loads(Path(args.geometry).read_text()).get(\\\"captureReady\\\", False):\\n                            time.sleep(0.1)\\n                            continue\\n                    except (FileNotFoundError, json.JSONDecodeError):\\n                        time.sleep(0.1)\\n                        continue\\n                if args.state in (\\\"source\\\", \\\"proof\\\", \\\"split\\\"):\\n                    status = (root / \\\"app.log\\\").read_text()\\n                    if \\\"TWYNE_CAPTURE_PROOF_ERROR\\\" in status:\\n                        raise RuntimeError(status)\\n                    if \\\"TWYNE_CAPTURE_PROOF_READY\\\" not in status:\\n                        time.sleep(0.25)\\n                        continue\\n                if args.state == \\\"library\\\" and \\\"TWYNE_CAPTURE_LIBRARY_READY\\\" not in (root / \\\"app.log\\\").read_text():\\n                    time.sleep(0.25)\\n                    continue\\n                if args.state == \\\"flow\\\":\\n                    status = (root / \\\"app.log\\\").read_text()\\n                    if \\\"TWYNE_CAPTURE_FLOW_ERROR\\\" in status:\\n                        raise RuntimeError(status)\\n                    if \\\"TWYNE_CAPTURE_FLOW_READY\\\" not in status:\\n                        time.sleep(0.25)\\n                        continue\\n                    # Original chrome fade lasts 1.2 seconds after the mode\\n                    # transition. Record its settled native pixels.\\n                    time.sleep(1.25)\\n                time.sleep(0.25)\\n                capture = subprocess.run([\\\"xwd\\\", \\\"-name\\\", \\\"Twyne\\\", \\\"-silent\\\", \\\"-out\\\", str(root / \\\"frame.xwd\\\")], env=environment, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)\\n                # Asset preparation can finish after the first poll. An absent\\n                # window is not a frame, so wait within the same deadline.\\n                if capture.returncode:\\n                    time.sleep(0.1)\\n                    continue\\n                subprocess.run([\\\"magick\\\", str(root / \\\"frame.xwd\\\"), str(root / \\\"frame.png\\\")], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\n                # GPUI clears the client surface to the paper palette. Until\\n                # its first rendered frame, that surface remains black.\\n                sample_position = f\\\"%[pixel:p{{{args.width // 2},{args.height // 2}}}]\\\"\\n                sample = subprocess.check_output([\\\"magick\\\", str(root / \\\"frame.png\\\"), \\\"-format\\\", sample_position, \\\"info:\\\"]).decode()\\n                if sample not in (\\\"srgb(0,0,0)\\\", \\\"gray(0)\\\"):\\n                    time.sleep(0.4)\\n                    subprocess.run([\\\"xwd\\\", \\\"-name\\\", \\\"Twyne\\\", \\\"-silent\\\", \\\"-out\\\", str(root / \\\"frame.xwd\\\")], env=environment, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\n                    dimensions = subprocess.check_output([\\\"magick\\\", str(root / \\\"frame.xwd\\\"), \\\"-format\\\", \\\"%wx%h\\\", \\\"info:\\\"]).decode()\\n                    if dimensions != f\\\"{args.width}x{args.height}\\\":\\n                        raise RuntimeError(f\\\"Unexpected native client size: {dimensions}\\\")\\n                    subprocess.run([\\\"magick\\\", str(root / \\\"frame.xwd\\\"), str(Path(args.output).resolve())], check=True)\\n                    print(f\\\"Native {args.state} render: {Path(args.output).resolve()}\\\")\\n                    break\\n            else:\\n                raise RuntimeError(\\\"No native frame was rendered.\\\\n\\\" + (root / \\\"app.log\\\").read_text())\\n    finally:\\n        if app is not None and app.poll() is None:\\n            app.terminate()\\n            try:\\n                app.wait(timeout=5)\\n            except subprocess.TimeoutExpired:\\n                app.kill()\\n                app.wait()\\n        server.terminate()\\n        server.wait(timeout=5)\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c3a-4441-7890-a25b-a9acd621d3aa","create_time":1791207618.2320387}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
