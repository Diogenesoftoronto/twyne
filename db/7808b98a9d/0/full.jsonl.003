":"input_text","text":"            window,\n            cx,\n        );\n    }\n\n    pub(super) fn enter(&mut self, action: &Enter, window: &mut Window, cx: &mut Context<Self>) {\n        if M::handle_context_menu_action(self, Box::new(action.clone()), window, cx) {\n            return;\n        }\n\n        // Clear inline completion on enter (user chose not to accept it)\n        if M::has_inline_completion(self) {\n            M::clear_inline_completion(self, cx);\n        }\n\n        // In multi-line mode with `submit_on_enter` enabled, a plain `Enter`\n        // (without Shift) is treated as submit: propagate the action and emit\n        // PressEnter without inserting a newline. `Shift+Enter` still inserts\n        // a newline.\n        let insert_newline = self.is_multi_line() && (!self.submit_on_enter || action.shift);\n\n        if insert_newline {\n            if !self.selections.is_single() {\n                // Insert a newline (with per-line indent) at every cursor.\n                self.selections.merge_overlapping();\n                let selections: Vec<CursorSelection> = self.selections.iter().copied().collect();\n                let mut edits: Vec<(Range<usize>, String)> = Vec::with_capacity(selections.len());\n                for sel in &selections {\n"},{"type":"input_text","text":"\n                    // Add newline and indent\n                    let new_line_text = format!(\"\\n{}\", indent);\n                    self.replace_text_in_range_silent(None, &new_line_text, window, cx);\n                    self.pause_blink_cursor(cx);\n                }\n            }\n        } else {\n            // Single line input or submit-on-enter: just emit the event\n            // (e.g.: in a dialog to confirm, or a chat textarea to send).\n            self.undo_manager.break_transaction_coalescing();\n            cx.propagate();\n        }\n\n        cx.emit(InputEvent::PressEnter {\n            secondary: action.secondary,\n            shift: action.shift,\n        });\n    }\n\n    pub fn clean(&mut self, window: &mut Window, cx: &mut Context<Self>) {\n        self.replace_text(\"\", window, cx);\n        self.set_selection(0, 0);\n        self.scroll_to(0, None, cx);\n    }\n"},{"type":"input_text","text":"140:            self.document.body = self.body.to_string();\n556:                        this.body.update(cx, |body, cx| {\n575:                    if sender == &this.body\n962:            self.body.update(cx, |state, cx| state.focus(window, cx));\n992:                        [&this.title, &this.body].into_iter().find_map(|state| {\n1129:            self.body.update(cx, |state, cx| state.focus(window, cx));\n1215:        self.body\n1354:            body: self.body.read(cx).text().clone(),\n1664:        self.body.update(cx, |state, cx| {\n1843:        self.body.update(cx, |state, cx| {\n2597:            let state = self.body.read(cx);\n2613:                self.body.update(cx, |state, cx| {\n4041:                                    && this.body.read(cx).focus_handle(cx).is_focused(window)\n4042:                                    && this.body.read(cx).selected_range() == (0..0)\n4106:                                                Textarea::new(&self.body)\n4933:                view.read(cx).body.read(cx).value().to_string(),\n5347:                view.read(cx).body.read(cx).value(),\n7270:            assert_eq!(view.read(cx).body.read(cx).value().as_ref(), body);\n7315:            assert!(room.body.read(cx).input_bounds().size.height > viewport.size.height);\n7366:            assert_eq!(view.read(cx).body.read(cx).text().len(), 0);\n7379:                view.read(cx).body.read(cx).value(),\n7417:            assert_eq!(view.read(cx).body.read(cx).value(), \"Keep this draft.\");\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10d17-989f-7150-9fa5-0c502f3fed47","create_time":1791222025.6293566}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
