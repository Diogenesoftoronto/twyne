radii(px((self.radius + extent).max(0.))),\n            );\n        }\n    }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":17594},"formatted_output":"//! CSS focus outlines painted around the existing native control geometry.\n\nuse gpui_kit::{\n    AnyElement, App, BorderStyle, Bounds, Element, ElementId, FocusHandle, GlobalElementId,\n    InspectorElementId, IntoElement, LayoutId, Pixels, Window, outline, px, rgb,\n};\n\n/// Forward the real control's layout, input and accessibility subtree. The\n/// outline takes no space and follows native keyboard focus rather than clicks.\npub fn focus_outline(\n    element: impl IntoElement,\n    offset: f32,\n    radius: f32,\n    color: u32,\n) -> AnyElement {\n    FocusOutline {\n        child: element.into_any_element(),\n        offset,\n        radius,\n        color,\n    }\n    .into_any_element()\n}\n\nstruct FocusOutline {\n    child: AnyElement,\n    offset: f32,\n    radius: f32,\n    color: u32,\n}\n\nimpl IntoElement for FocusOutline {\n    type Element = Self;\n\n    fn into_element(self) -> Self {\n        self\n    }\n}\n\nimpl Element for FocusOutline {\n    type RequestLayoutState = ();\n    type PrepaintState = Option<FocusHandle>;\n\n    fn id(&self) -> Option<ElementId> {\n        None\n    }\n\n    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {\n        None\n    }\n\n    fn request_layout(\n        &mut self,\n        _: Option<&GlobalElementId>,\n        _: Option<&InspectorElementId>,\n        window: &mut Window,\n        cx: &mut App,\n    ) -> (LayoutId, Self::RequestLayoutState) {\n        (self.child.request_layout(window, cx), ())\n    }\n\n    fn prepaint(\n        &mut self,\n        _: Option<&GlobalElementId>,\n        _: Option<&InspectorElementId>,\n        _: Bounds<Pixels>,\n        _: &mut Self::RequestLayoutState,\n        window: &mut Window,\n        cx: &mut App,\n    ) -> Self::PrepaintState {\n        self.child.prepaint(window, cx)\n    }\n\n    fn paint(\n        &mut self,\n        _: Option<&GlobalElementId>,\n        _: Option<&InspectorElementId>,\n        bounds: Bounds<Pixels>,\n        _: &mut Self::RequestLayoutState,\n        focus: &mut Self::PrepaintState,\n        window: &mut Window,\n        cx: &mut App,\n    ) {\n        self.child.paint(window, cx);\n        if window.last_input_was_keyboard()\n            && focus.as_ref().is_some_and(|focus| focus.is_focused(window))\n        {\n            let extent = self.offset + 2.;\n            window.paint_quad(\n                outline(\n                    bounds.dilate(px(extent)),\n                    rgb(self.color),\n                    BorderStyle::default(),\n                )\n                .border_widths(px(2.))\n                .corner_radii(px((self.radius + extent).max(0.))),\n            );\n        }\n    }\n}\n"},"started_at_ms":1791206746567,"completed_at_ms":1791206746568}}
{"timestamp":"2026-10-05T13:25:46.605Z","ordinal":40895,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a10537-909f-77a3-96d8-dd07161f91ae","turn_id":"01a10c3a-4441-7890-a25b-a9acd621d3aa","item":{"type":"CommandExecution","id":"exec-bcba7a65-27d8-4a5a-b284-5757c3afcf04","process_id":"83259","command":["/bin/bash","-lc","rtk proxy sed -n '229,360p' desktop/gpui/vendor/gpui-base/src/input/base/mod.rs"],"cwd":"file:///home/diogenes/Projects/twyne","parsed_cmd":[{"type":"unknown","cmd":"rtk proxy sed -n '229,360p' desktop/gpui/vendor/gpui-base/src/input/base/mod.rs"}],"source":"unified_exec_startup","status":"completed","stdout":"\nimpl StatefulInteractiveElement for InputBase {}\n\nimpl RenderOnce for InputBase {\n    fn render(self, _: &mut Window, _: &mut App) -> impl IntoElement {\n        let style = self.resolved_style();\n        self.base\n            .when_some(self.role.resolve(|| Role::TextInput), |this, role| {\n                this.role(role)\n            })\n            .children(self.children)\n            .refine_style(&style)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn frame_accepts_application_owned_content_and_style() {\n        let _ = InputBase::new(\"input\")\n            .focused(true)\n            .disabled(false)\n            .styles(|styles| {\n                styles\n                    .focused(|style| style.border_1())\n                    .disabled(|style| style.opacity(0.5))\n            })\n            .child(\"value\")\n            .opacity(0.8);\n    }\n\n    #[test]\n    fn semantic_state_styles_override_the_normal_style() {\n        let focused = InputBase::new(\"focused\")\n            .focused(true)\n            .border_color(gpui::red())\n            .styles(|styles| styles.focused(|style| style.border_color(gpui::blue())));\n        assert_eq!(focused.resolved_style().border_color, Some(gpui::blue()));\n\n        let disabled = InputBase::new(\"disabled\")\n            .focused(true)\n            .disabled(true)\n            .opacity(1.)\n            .styles(|styles| {\n                styles\n                    .focused(|style| style.opacity(0.8))\n                    .disabled(|style| style.opacity(0.5))\n            });\n        assert_eq!(disabled.resolved_style().opacity, Some(0.5));\n    }\n}\n","stderr":"","aggregated_output":"\nimpl StatefulInteractiveElement for InputBase {}\n\nimpl RenderOnce for InputBase {\n    fn render(self, _: &mut Window, _: &mut App) -> impl IntoElement {\n        let style = self.resolved_style();\n        self.base\n            .when_some(self.role.resolve(|| Role::TextInput), |this, role| {\n                this.role(role)\n            })\n            .children(self.children)\n            .refine_style(&style)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn frame_accepts_application_owned_content_and_style() {\n        let _ = InputBase::new(\"input\")\n            .focused(true)\n            .disabled(false)\n            .styles(|styles| {\n                styles\n                    .focused(|style| style.border_1())\n                    .disabled(|style| style.opacity(0.5))\n            })\n            .child(\"value\")\n            .opacity(0.8);\n    }\n\n    #[test]\n    fn semantic_state_styles_override_the_normal_style() {\n        let focused = InputBase::new(\"focused\")\n            .focused(true)\n            .border_color(gpui::red())\n            .styles(|styles| styles.focused(|style| style.border_color(gpui::blue())));\n        assert_eq!(focused.resolved_style().border_color, Some(gpui::blue()));\n\n        let disabled = InputBase::new(\"disabled\")\n            .focused(true)\n            .disabled(true)\n            .opacity(1.)\n            .styles(|styles| {\n                styles\n                    .focused(|style| style.opacity(0.8))\n                    .disabled(|style| style.opacity(0.5))\n            });\n        assert_eq!(disabled.resolved_style().opacity, Some(0.5));\n    }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":17485},"formatted_output":"\nimpl StatefulInteractiveElement for InputBase {}\n\nimpl RenderOnce for InputBase {\n    fn render(self, _: &mut Window, _: &mut App) -> impl IntoElement {\n        let style = self.resolved_style();\n        self.base\n            .when_some(self.role.resolve(|| Role::TextInput), |this, role| {\n                this.role(role)\n            })\n            .children(self.children)\n            .refine_style(&style)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn frame_accepts_application_owned_content_and_style() {\n        let _ = InputBase::new(\"input\")\n            .focused(true)\n            .disabled(false)\n            .styles(|styles| {\n                styles\n                    .focused(|style| style.border_1())\n                    .disabled(|style| style.opacity(0.5))\n            })\n            .child(\"value\")\n            .opacity(0.8);\n    }\n\n    #[test]\n    fn semantic_state_styles_override_the_normal_style() {\n        let focused = InputBase::new(\"focused\")\n            .focused(true)\n            .border_color(gpui::red())\n            .styles(|styles| styles.focused(|style| style.border_color(gpui::blue())));\n        assert_eq!(focused.resolved_style().border_color, Some(gpui::blue()));\n\n        let disabled = InputBase::new(\"disabled\")\n            .focused(true)\n            .disabled(true)\n            .opacity(1.)\n            .styles(|styles| {\n                styles\n                    .focused(|style| style.opacity(0.8))\n                    .disabled(|style| style.opacity(0.5))\n            });\n        assert_eq!(disabled.resolved_style().opacity, Some(0.5));\n    }\n}\n"},"started_at_ms":1791206746605,"completed_at_ms":1791206746605}}
{"timestamp":"2026-10-05T13:25:46.684Z","ordinal":40896,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10c3d-ea3c-7f53-87b1-199305cc6628","call_id":"call_FFHzix021HI7ffDFE0x8XdbD","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"i\":0,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"1529ba\",\"wall_time_seconds\":0.000025761,\"exit_code\":0,\"original_token_count\":1013,\"output\":\"use crate::{StateStyle, StyledExt as _, TestSupportExt as _};\\nuse gpui::{\\n    AnyElement, App, Div, ElementId, InteractiveElement, Interactivity, IntoElement, ParentElement,\\n    Refineable as _, RenderOnce, Role, SharedString, StatefulInteractiveElement, StyleRefinement,\\n    Styled, Window, div, prelude::FluentBuilder as _,\\n};\\n\\n/// What the input can offer to its context menu, at the moment it is opened.\\n///\\n/// Built by the input and read by the menu, the fields are private and reached\\n/// through the methods below, so that a new capability can be added without\\n/// breaking the menu builders.\\n///\\n/// ```\\n/// use gpui_base::input::InputContextMenuCapabilities;\\n///\\n/// let capabilities = InputContextMenuCapabilities::new()\\n///     .code_editor(true)\\n///     .selection(true);\\n///\\n/// assert!(capabilities.is_editable());\\n/// assert!(capabilities.has_selection());\\n/// ```\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\\npub struct InputContextMenuCapabilities {\\n    disabled: bool,\\n    readonly: bool,\\n    code_editor: bool,\\n    selection: bool,\\n    masked: bool,\\n    go_to_definition: bool,\\n    code_actions: bool,\\n}\\n\\nimpl InputContextMenuCapabilities {\\n    pub fn new() -> Self {\\n        Self::default()\\n    }\\n\\n    pub fn disabled(mut self, disabled: bool) -> Self {\\n        self.disabled = disabled;\\n        self\\n    }\\n\\n    pub fn readonly(mut self, readonly: bool) -> Self {\\n        self.readonly = readonly;\\n        self\\n    }\\n\\n    pub fn code_editor(mut self, code_editor: bool) -> Self {\\n        self.code_editor = code_editor;\\n        self\\n    }\\n\\n    /// Set whether the input has a non-empty selection.\\n    pub fn selection(mut self, selection: bool) -> Self {\\n        self.selection = selection;\\n        self\\n    }\\n\\n    /// Set whether the input renders its value masked.\\n    pub fn masked(mut self, masked: bool) -> Self {\\n        self.masked = masked;\\n        self\\n    }\\n\\n    pub fn go_to_definition(mut self, go_to_definition: bool) -> Self {\\n        self.go_to_definition = go_to_definition;\\n        self\\n    }\\n\\n    pub fn code_actions(mut self, code_actions: bool) -> Self {\\n        self.code_actions = code_actions;\\n        self\\n    }\\n\\n    pub fn is_disabled(&self) -> bool {\\n        self.disabled\\n    }\\n\\n    pub fn is_readonly(&self) -> bool {\\n        self.readonly\\n    }\\n\\n    /// Returns true if the user is allowed to change the text.\\n    ///\\n    /// The items that write to the input (Cut, Paste, Code Actions) belong to\\n    /// this, the reading ones (Copy, Go to Definition) do not.\\n    pub fn is_editable(&self) -> bool {\\n        !self.disabled && !self.readonly\\n    }\\n\\n    pub fn is_code_editor(&self) -> bool {\\n        self.code_editor\\n    }\\n\\n    pub fn has_selection(&self) -> bool {\\n        self.selection\\n    }\\n\\n    pub fn is_masked(&self) -> bool {\\n        self.masked\\n    }\\n\\n    /// Returns true if the user is allowed to copy the text out.\\n    ///\\n    /// A masked input keeps its value out of the clipboard, so Copy and Cut\\n    /// are both unavailable while the value is hidden.\\n    pub fn is_copyable(&self) -> bool {\\n        self.selection && !self.masked\\n    }\\n\\n    pub fn has_definition(&self) -> bool {\\n        self.go_to_definition\\n    }\\n\\n    pub fn has_code_actions(&self) -> bool {\\n        self.code_actions\\n    }\\n}\\n\\n/// The foundational input frame.\\n///\\n/// It intentionally owns only input semantics, interaction forwarding, and\\n/// normal children. Applications remain responsible for all presentation.\\n#[derive(IntoElement)]\\npub struct InputBase {\\n    base: crate::ObservedElement<gpui::Stateful<Div>>,\\n    style: StyleRefinement,\\n    semantic_styles: InputStyles,\\n    children: Vec<AnyElement>,\\n    focused: bool,\\n    disabled: bool,\\n    role: crate::RoleOverride,\\n}\\n\\nimpl InputBase {\\n    pub fn new(id: impl Into<ElementId>) -> Self {\\n        Self {\\n            base: div().id(id).test_support(),\\n            style: StyleRefinement::default(),\\n            semantic_styles: InputStyles::default(),\\n            children: Vec::new(),\\n            focused: false,\\n            disabled: false,\\n\"}}"},{"type":"input_text","text":"{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"4c2a16\",\"wall_time_seconds\":0.000017485,\"exit_code\":0,\"original_token_count\":405,\"output\":\"\\nimpl StatefulInteractiveElement for InputBase {}\\n\\nimpl RenderOnce for InputBase {\\n    fn render(self, _: &mut Window, _: &mut App) -> impl IntoElement {\\n        let style = self.resolved_style();\\n        self.base\\n            .when_some(self.role.resolve(|| Role::TextInput), |this, role| {\\n                this.role(role)\\n            })\\n            .children(self.children)\\n            .refine_style(&style)\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n\\n    #[test]\\n    fn frame_accepts_application_owned_content_and_style() {\\n        let _ = InputBase::new(\\\"input\\\")\\n            .focused(true)\\n            .disabled(false)\\n            .styles(|styles| {\\n                styles\\n                    .focused(|style| style.border_1())\\n                    .disabled(|style| style.opacity(0.5))\\n            })\\n            .child(\\\"value\\\")\\n            .opacity(0.8);\\n    }\\n\\n    #[test]\\n    fn semantic_state_styles_override_the_normal_style() {\\n        let focused = InputBase::new(\\\"focused\\\")\\n            .focused(true)\\n            .border_color(gpui::red())\\n            .styles(|styles| styles.focused(|style| style.border_color(gpui::blue())));\\n        assert_eq!(focused.resolved_style().border_color, Some(gpui::blue()));\\n\\n        let disabled = InputBase::new(\\\"disabled\\\")\\n            .focused(true)\\n            .disabled(true)\\n            .opacity(1.)\\n            .styles(|styles| {\\n                styles\\n                    .focused(|style| style.opacity(0.8))\\n                    .disabled(|style| style.opacity(0.5))\\n            });\\n        assert_eq!(disabled.resolved_style().opacity, Some(0.5));\\n    }\\n}\\n\"}}"},{"type":"input_text","text":"{\"i\":2,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"6f12ba\",\"wall_time_seconds\":0.000017594,\"exit_code\":0,\"original_token_count\":652,\"output\":\"//! CSS focus outlines painted around the existing native control geometry.\\n\\nuse gpui_kit::{\\n    AnyElement, App, BorderStyle, Bounds, Element, ElementId, FocusHandle, GlobalElementId,\\n    InspectorElementId, IntoElement, LayoutId, Pixels, Window, outline, px, rgb,\\n};\\n\\n/// Forward the real control's layout, input and accessibility subtree. The\\n/// outline takes no space and follows native keyboard focus rather than clicks.\\npub fn focus_outline(\\n    element: impl IntoElement,\\n    offset: f32,\\n    radius: f32,\\n    color: u32,\\n) -> AnyElement {\\n    FocusOutline {\\n        child: element.into_any_element(),\\n        offset,\\n        radius,\\n        color,\\n    }\\n    .into_any_element()\\n}\\n\\nstruct FocusOutline {\\n    child: AnyElement,\\n    offset: f32,\\n    radius: f32,\\n    color: u32,\\n}\\n\\nimpl IntoElement for FocusOutline {\\n    type Element = Self;\\n\\n    fn into_element(self) -> Self {\\n        self\\n    }\\n}\\n\\nimpl Element for FocusOutline {\\n    type RequestLayoutState = ();\\n    type PrepaintState = Option<FocusHandle>;\\n\\n    fn id(&self) -> Option<ElementId> {\\n        None\\n    }\\n\\n    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {\\n        None\\n    }\\n\\n    fn request_layout(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) -> (LayoutId, Self::RequestLayoutState) {\\n        (self.child.request_layout(window, cx), ())\\n    }\\n\\n    fn prepaint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        _: Bounds<Pixels>,\\n        _: &mut Self::RequestLayoutState,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) -> Self::PrepaintState {\\n        self.child.prepaint(window, cx)\\n    }\\n\\n    fn paint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        bounds: Bounds<Pixels>,\\n        _: &mut Self::RequestLayoutState,\\n        focus: &mut Self::PrepaintState,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) {\\n        self.child.paint(window, cx);\\n        if window.last_input_was_keyboard()\\n            && focus.as_ref().is_some_and(|focus| focus.is_focused(window))\\n        {\\n            let extent = self.offset + 2.;\\n            window.paint_quad(\\n                outline(\\n                    bounds.dilate(px(extent)),\\n                    rgb(self.color),\\n                    BorderStyle::default(),\\n                )\\n                .border_widths(px(2.))\\n                .corner_radii(px((self.radius + extent).max(0.))),\\n            );\\n        }\\n    }\\n}\\n\"}}"},{"type":"input_text","text":"{\"i\":3,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"7c71f5\",\"wall_time_seconds\":0.000038831,\"exit_code\":2,\"original_token_count\":1356,\"output\":\"rg: desktop/gpui/vendor/gpui-base/src/input/textarea.rs: No such file or directory (os error 2)\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1355-    pub(crate) fn readonly(mut self, readonly: bool) -> Self {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1356-        self.readonly = readonly;\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1357-        self\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1358-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1359-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:1360:    pub fn set_readonly(&mut self, readonly: bool, cx: &mut Context<Self>) {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1361-        if self.readonly == readonly {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1362-            return;\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1363-        }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1364-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1365-        self.readonly = readonly;\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1366-        if readonly {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1367-            M::hide_context_menu(self, cx);\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1368-            M::clear_inline_completion(self, cx);\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1369-            self.search_session.replace_mode = false;\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1370-        }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1371-        cx.notify();\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1372-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1373-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1374-    /// Returns true if the user is allowed to change the text.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1375-    ///\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1376-    /// This is false when the input is `disabled` or `readonly`, the programmatic\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1377-    /// APIs (e.g.: [`Self::set_value`], [`Self::insert`]) are not limited by this.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1378-    pub fn is_editable(&self) -> bool {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1379-        !self.disabled && !self.readonly\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1380-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1381-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1382-    /// Set true to clear the input by pressing Escape key.\\n--\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1489-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1490-    /// Return the value of the input field as an owned string.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1491-    ///\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1492-    /// The string is materialized on each call. See [`Self::text`] for the\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1493-    /// [`Rope`] the state owns, which is borrowed and costs nothing to read.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs:1494:    pub fn value(&self) -> SharedString {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1495-        SharedString::new(self.text.to_string())\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1496-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1497-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1498-    /// Return the portion of the value within the input field that\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1499-    /// is selected by the user, as an owned string.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1500-    ///\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1501-    /// The string is materialized on each call. See [`Self::selected_text`]\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1502-    /// for the same selection borrowed out of the [`Rope`] the state owns.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1503-    pub fn selected_value(&self) -> SharedString {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1504-        SharedString::new(self.selected_text().to_string())\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1505-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1506-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1507-    /// Return the value without mask.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1508-    pub fn unmask_value(&self) -> SharedString {\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1509-        self.mask_pattern.unmask(&self.text.to_string()).into()\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1510-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1511-\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1512-    /// Kept so existing render paths keep compiling.\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1513-    ///\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1514-    /// Configuration used to be collected by a facade and applied here; the\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1515-    /// state now configures itself, so this does nothing and can be deleted at\\ndesktop/gpui/vendor/gpui-base/src/input/base/state.rs-1516-    /// the call site.\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c3a-4441-7890-a25b-a9acd621d3aa","create_time":1791206746.68418}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
