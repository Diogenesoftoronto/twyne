tor.tsx:208:import { SlashCommandMenu } from \\\"./slash-command-menu\\\";\\nsrc/components/editor/twyne-editor.tsx:891:            SlashCommand,\\nsrc/components/editor/twyne-editor.tsx:1242:          const slash = getSlashCommandState(editor.state);\\nsrc/components/editor/twyne-editor.tsx:1777:                binding.shortcut,\\nsrc/components/editor/twyne-editor.tsx:1783:                new CustomEvent(\\\"twyne:editor-shortcut\\\", {\\nsrc/components/editor/twyne-editor.tsx:3497:        case \\\"insert.image\\\":\\nsrc/components/editor/twyne-editor.tsx:3500:        case \\\"insert.table\\\":\\nsrc/components/editor/twyne-editor.tsx:3503:        case \\\"insert.mermaid\\\":\\nsrc/components/editor/twyne-editor.tsx:3506:        case \\\"insert.math-inline\\\":\\nsrc/components/editor/twyne-editor.tsx:3509:        case \\\"insert.math-block\\\":\\nsrc/components/editor/twyne-editor.tsx:3512:        case \\\"insert.endnote\\\":\\nsrc/components/editor/twyne-editor.tsx:3516:        case \\\"insert.footnote\\\":\\nsrc/components/editor/twyne-editor.tsx:3533:        case \\\"view.shortcuts\\\":\\nsrc/components/editor/twyne-editor.tsx:3556:      window.addEventListener(\\\"twyne:editor-shortcut\\\", runShortcut);\\nsrc/components/editor/twyne-editor.tsx:3581:        window.removeEventListener(\\\"twyne:editor-shortcut\\\", runShortcut);\\nsrc/components/editor/twyne-editor.tsx:3586:    const selectSlashCommand = $(async (commandId: EditorCommandId) => {\\nsrc/components/editor/twyne-editor.tsx:3589:      editor.commands.removeSlashCommandQuery();\\nsrc/components/editor/twyne-editor.tsx:3817:            <SlashCommandMenu\\nsrc/components/editor/twyne-editor.tsx:3832:              onSelect$={selectSlashCommand}\\nsrc/components/editor/twyne-editor.tsx:3834:                store.editor?.commands.closeSlashCommand();\\nsrc/components/editor/slash-command-menu.stories.tsx:3:import { SlashCommandMenu } from \\\"./slash-command-menu\\\";\\nsrc/components/editor/slash-comma