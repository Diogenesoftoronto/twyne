          self.desk.set_zen(false, false);\n        }\n        if matches!(\n            state,\n            \"desk\"\n                | \"drawer\"\n                | \"board\"\n                | \"source\"\n"},"started_at_ms":1791218826571,"completed_at_ms":1791218826572}}
