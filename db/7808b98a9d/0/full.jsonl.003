{"timestamp":"2026-10-05T16:53:27.444Z","ordinal":42905,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10cfc-0d14-7de1-9db4-5f56bcf4b188","call_id":"call_4KjRAckmm4U3580TiQiieMSC","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"b63839\",\"wall_time_seconds\":0.000027115,\"exit_code\":0,\"original_token_count\":652,\"output\":\"//! CSS focus outlines painted around the existing native control geometry.\\n\\nuse gpui_kit::{\\n    AnyElement, App, BorderStyle, Bounds, Element, ElementId, FocusHandle, GlobalElementId,\\n    InspectorElementId, IntoElement, LayoutId, Pixels, Window, outline, px, rgb,\\n};\\n\\n/// Forward the real control's layout, input and accessibility subtree. The\\n/// outline takes no space and follows native keyboard focus rather than clicks.\\npub fn focus_outline(\\n    element: impl IntoElement,\\n    offset: f32,\\n    radius: f32,\\n    color: u32,\\n) -> AnyElement {\\n    FocusOutline {\\n        child: element.into_any_element(),\\n        offset,\\n        radius,\\n        color,\\n    }\\n    .into_any_element()\\n}\\n\\nstruct FocusOutline {\\n    child: AnyElement,\\n    offset: f32,\\n    radius: f32,\\n    color: u32,\\n}\\n\\nimpl IntoElement for FocusOutline {\\n    type Element = Self;\\n\\n    fn into_element(self) -> Self {\\n        self\\n    }\\n}\\n\\nimpl Element for FocusOutline {\\n    type RequestLayoutState = ();\\n    type PrepaintState = Option<FocusHandle>;\\n\\n    fn id(&self) -> Option<ElementId> {\\n        None\\n    }\\n\\n    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {\\n        None\\n    }\\n\\n    fn request_layout(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) -> (LayoutId, Self::RequestLayoutState) {\\n        (self.child.request_layout(window, cx), ())\\n    }\\n\\n    fn prepaint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        _: Bounds<Pixels>,\\n        _: &mut Self::RequestLayoutState,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) -> Self::PrepaintState {\\n        self.child.prepaint(window, cx)\\n    }\\n\\n    fn paint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        bounds: Bounds<Pixels>,\\n        _: &mut Self::RequestLayoutState,\\n        focus: &mut Self::PrepaintState,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) {\\n        self.child.paint(window, cx);\\n        if window.last_input_was_keyboard()\\n            && focus.as_ref().is_some_and(|focus| focus.is_focused(window))\\n        {\\n            let extent = self.offset + 2.;\\n            window.paint_quad(\\n                outline(\\n                    bounds.dilate(px(extent)),\\n                    rgb(self.color),\\n                    BorderStyle::default(),\\n                )\\n                .border_widths(px(2.))\\n                .corner_radii(px((self.radius + extent).max(0.))),\\n            );\\n        }\\n    }\\n}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10cf3-25ca-7a90-895c-0aef2c6d86fb","create_time":1791219207.4444728}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
