mport { validateCatalog } from \\\"./catalog\\\";\\n+import { accountDisplayName } from \\\"../../../../src/utils/account-display\\\";\\n@@\\n function record(value: unknown): Record<string, unknown> | null {\\n@@\\n }\\n+function publicDisplayName(user: Record<string, unknown>): string {\\n+  return accountDisplayName({\\n+    name: typeof user.name === \\\"string\\\" ? user.name : undefined,\\n+    handle: typeof user.handle === \\\"string\\\" ? user.handle : undefined,\\n+  });\\n+}\\n@@\\n-        displayName: typeof confirmed.user.name === \\\"string\\\" ? confirmed.user.name : \\\"\\\",\\n+        displayName: publicDisplayName(confirmed.user),\\n@@\\n-        displayName: typeof confirmed.user.name === \\\"string\\\" ? confirmed.user.name : \\\"\\\",\\n+        displayName: publicDisplayName(confirmed.user),\\n*** Update File: /home/diogenes/Projects/twyne/desktop/gpui/tools/connected/session.test.ts\\n@@\\n   let sessionStatus = 200;\\n+  let sessionName = \\\"Writer\\\", sessionHandle: string | undefined;\\n@@\\n-            user: { id: sessionSubject, name: \\\"Writer\\\", email: \\\"writer@notorganic.invalid\\\" },\\n+            user: { id: sessionSubject, name: sessionName, handle: sessionHandle, email: \\\"writer@notorganic.invalid\\\" },\\n@@\\n     sessionStatus: (value: number) => { sessionStatus = value; },\\n+    publicName: (name: string, handle?: string) => { sessionName = name; sessionHandle = handle; },\\n@@\\n   test(\\\"malformed credential-store contents produce only a static connection error\\\", async () => {\\n@@\\n   });\\n+\\n+  test(\\\"accepted receipts use Source public names without exposing legacy email or DID labels\\\", async () => {\\n+    const f = fixture();\\n+    f.publicName(\\\"writer.private@example.test\\\", \\\"  morgan  \\\");\\n+    expect((await f.signIn()).displayName).toBe(\\\"morgan\\\");\\n+    f.connected.dispose();\\n+    f.publicName(\\\"did:plc:fixture\\\", \\\"did:plc:fixture\\\");\\n+    const restored = n