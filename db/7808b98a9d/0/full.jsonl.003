nt(super::RichFragment),\n278-    DeleteBackward,\n279-    DeleteForward,\n280-    SplitBlock,\n281-    ToggleMark(Mark),\n282-    SetMark(Mark),\n283-    UnsetMark(MarkKind),\n284-    AddComment(super::CommentAttributes),\n285-    RemoveComment {\n286-        id: String,\n287-    },\n288-    ClearFormatting,\n289-    Recase(TextCase),\n290-    SetParagraph,\n291-    SetHeading(u8),\n292-    SetAlignment(Alignment),\n293-    SetParagraphFormat(ParagraphFormat),\n294-    Indent,\n295-    Outdent,\n296-    ToggleList(ListKind),\n297-    ToggleBlockQuote,\n298-    ToggleCodeBlock,\n299-    InsertInline(InlineObject),\n300-    InsertBlock(BlockObject),\n301-    SetAttributes {\n302-        path: NodePath,\n303-        attributes: Vec<(String, Option<String>)>,\n304-    },\n305-    DeleteNode {\n306-        path: NodePath,\n307-    },\n308-    /// Commit raw LaTeX to the same current math atom. Rendering/preview never\n309-    /// changes this payload, and an old descriptor cannot edit a replacement.\n310-    UpdateMathSource {\n311-        path: NodePath,\n312-        expected: Node,\n313-        source: String,\n314-    },\n315-    /// Patch the actual note atom, refusing an old descriptor rather than\n316-    /// editing whichever node later occupies the same path.\n317-    UpdateNote {\n318-        path: NodePath,\n319-        expected: Node,\n320-        text: Option<String>,\n321-        kind: Option<NoteKind>,\n322-    },\n323-    DeleteNote {\n324-        path: NodePath,\n325-        expected: Node,\n326-    },\n327-    MoveSection {\n328-        source: NodePath,\n329-        target: NodePath,\n330-        placement: super::DropPlacement,\n331-    },\n332-    MoveBlocks {\n333-        parent: NodePath,\n334-        source: std::ops::Range<usize>,\n335-        insert_at: usize,\n336-    },\n337-    Table {\n338-        cell: NodePath,\n339-        command: TableCommand,\n340-    },\n341-    Undo,\n342-    Redo,\n343-}\n344-\n345-#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n346-pub enum TextCase {\n347-    Upper,\n348-    Lower,\n349-    Title,\n350-    Sentence,\n351-}\n352-\n353-impl Command {\n354-    /// Parameterless intents share the web command catalogue's stable IDs.\n355-    /// Commands requiring a dialog/value use the explicit typed variants.\n356-    pub fn from_id(id: &str) -> Option<Self> {\n357-        Some(match id {\n358-            \"format.bold\" => Self::ToggleMark(Mark::Bold),\n359-            \"format.italic\" => Self::ToggleMark(Mark::Italic),\n"},{"type":"input_text","text":"{\"chunk_id\":\"542212\",\"wall_time_seconds\":0.000058232,\"exit_code\":0,\"original_token_count\":8,\"output\":\"desktop/gpui/src/insert_menu\\n\"}"},{"type":"input_text","text":"{}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10d17-989f-7150-9fa5-0c502f3fed47","create_time":1791223350.513842}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
