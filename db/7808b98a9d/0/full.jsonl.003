s/wayland-clipboard/README.md\ndesktop/gpui/fixtures/dossier-conversation/HANDOFF.md\ndesktop/gpui/fixtures/dossier-paper-resize-performance/README.md\ndesktop/gpui/fixtures/math-write/source-css-assessment.md\ndesktop/gpui/fixtures/math-write/README.md\ndesktop/gpui/fixtures/math-write/CONTRACT.md\ndesktop/gpui/fixtures/dossier-multiply/native-probe/X11_ADAPTER.md\ndesktop/gpui/fixtures/distribution/HANDOFF.md\ndesktop/gpui/fixtures/distribution/README.md\ndesktop/gpui/fixtures/native-collaboration/HANDOFF.md\ndesktop/gpui/fixtures/dossier-layout-correction/README.md\ndesktop/gpui/fixtures/dossier-multiply/native-probe/README.md\ndesktop/gpui/fixtures/native-collaboration/README.md\ndesktop/gpui/fixtures/native-audio/HANDOFF.md\ndesktop/gpui/fixtures/dossier-image-lifecycle/retained-settings-host/README.md\ndesktop/gpui/fixtures/native-audio/CONTRACT.md\ndesktop/gpui/fixtures/dossier-image-lifecycle/README.md\ndesktop/gpui/fixtures/math-write/keyboard-isolation-audit/README.md\ndesktop/gpui/fixtures/math-write/current-adoption/CONTRACT.md\ndesktop/gpui/fixtures/math-write/current-adoption/README.md\ndesktop/gpui/fixtures/math-write/current-css/README.md\ndesktop/gpui/fixtures/math-write/renderer-epoch/README.md\ndesktop/gpui/fixtures/math-write/native-input-diagnosis/README.md\ndesktop/gpui/fixtures/math-write/app-source-host/README.md\ndesktop/gpui/fixtures/math-write/edit-source/README.md\ndesktop/gpui/fixtures/math-write/inline-source-flow/README.md\ndesktop/gpui/fixtures/math-write/native-host/README.md\ndesktop/gpui/fixtures/math-write/source-inline-geometry/README.md\ndesktop/gpui/fixtures/math-write/editor-adoption-review/README.md\ndesktop/gpui/fixtures/math-write/mermaid/README.md\ndesktop/gpui/fixtures/dossier-image-lifecycle/native-proof/README.md\ndesktop/gpui/fixtures/math-write/source-host/README.md\ndesktop/gpui/fixtures/math-write/native-source-form/README.md\ndesktop/gpui/fixtures/math-write/source-inline-geometry/admission-review/README.md\ndeskto