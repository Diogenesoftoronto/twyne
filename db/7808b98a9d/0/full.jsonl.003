{"timestamp":"2026-10-05T14:43:50.141Z","ordinal":41705,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a10537-909f-77a3-96d8-dd07161f91ae","turn_id":"01a10c6f-d724-7b02-bb99-7845fa255153","item":{"type":"CommandExecution","id":"exec-2c7e3a72-6f59-46d3-896e-43aaf1388697","process_id":"95103","command":["/bin/bash","-lc","rtk proxy sed -n '1,125p' desktop/gpui/src/gen_ui/budget_oracle_tests.rs"],"cwd":"file:///home/diogenes/Projects/twyne","parsed_cmd":[{"type":"unknown","cmd":"rtk proxy sed -n '1,125p' desktop/gpui/src/gen_ui/budget_oracle_tests.rs"}],"source":"unified_exec_startup","status":"completed","stdout":"use super::budget::SystemOneBudget;\nuse serde_json::Value;\n\nfn oracle() -> Value {\n    serde_json::from_str(include_str!(\"../../fixtures/gen-ui/budget-oracle.json\")).unwrap()\n}\n\n#[test]\nfn shared_budget_waits_match_the_executed_source_queue_and_backoff() {\n    for case in oracle()[\"cases\"].as_array().unwrap() {\n        let mut budget = SystemOneBudget::default();\n        for (index, (step, expected)) in case[\"steps\"]\n            .as_array()\n            .unwrap()\n            .iter()\n            .zip(case[\"frames\"].as_array().unwrap())\n            .enumerate()\n        {\n            let at = step[\"at\"].as_f64().unwrap();\n            match step[\"op\"].as_str().unwrap() {\n                \"spend\" => budget.spend(at),\n                \"fail\" => budget.back_off(at),\n                \"reset\" => budget.reset(),\n                \"wait\" => (),\n                op => panic!(\"Unknown Source budget operation {op}\"),\n            }\n            assert_eq!(\n                budget.wait(at),\n                expected.as_f64().unwrap(),\n                \"{}: frame {index}\",\n                case[\"id\"]\n            );\n        }\n    }\n}\n\n#[cfg(feature = \"native-typst\")]\n#[test]\nfn budget_oracle_matches_the_current_original_source_file() {\n    use sha2::{Digest, Sha256};\n    let project = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../..\");\n    for (path, hash) in oracle()[\"hashes\"].as_object().unwrap() {\n        let bytes = std::fs::read(project.join(path)).unwrap();\n        assert_eq!(\n            format!(\"{:x}\", Sha256::digest(bytes)),\n            hash.as_str().unwrap(),\n            \"Source drift: {path}\"\n        );\n    }\n}\n","stderr":"","aggregated_output":"use super::budget::SystemOneBudget;\nuse serde_json::Value;\n\nfn oracle() -> Value {\n    serde_json::from_str(include_str!(\"../../fixtures/gen-ui/budget-oracle.json\")).unwrap()\n}\n\n#[test]\nfn shared_budget_waits_match_the_executed_source_queue_and_backoff() {\n    for case in oracle()[\"cases\"].as_array().unwrap() {\n        let mut budget = SystemOneBudget::default();\n        for (index, (step, expected)) in case[\"steps\"]\n            .as_array()\n            .unwrap()\n            .iter()\n            .zip(case[\"frames\"].as_array().unwrap())\n            .enumerate()\n        {\n            let at = step[\"at\"].as_f64().unwrap();\n            match step[\"op\"].as_str().unwrap() {\n                \"spend\" => budget.spend(at),\n                \"fail\" => budget.back_off(at),\n                \"reset\" => budget.reset(),\n                \"wait\" => (),\n                op => panic!(\"Unknown Source budget operation {op}\"),\n            }\n            assert_eq!(\n                budget.wait(at),\n                expected.as_f64().unwrap(),\n                \"{}: frame {index}\",\n                case[\"id\"]\n            );\n        }\n    }\n}\n\n#[cfg(feature = \"native-typst\")]\n#[test]\nfn budget_oracle_matches_the_current_original_source_file() {\n    use sha2::{Digest, Sha256};\n    let project = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../..\");\n    for (path, hash) in oracle()[\"hashes\"].as_object().unwrap() {\n        let bytes = std::fs::read(project.join(path)).unwrap();\n        assert_eq!(\n            format!(\"{:x}\", Sha256::digest(bytes)),\n            hash.as_str().unwrap(),\n            \"Source drift: {path}\"\n        );\n    }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":11937},"formatted_output":"use super::budget::SystemOneBudget;\nuse serde_json::Value;\n\nfn oracle() -> Value {\n    serde_json::from_str(include_str!(\"../../fixtures/gen-ui/budget-oracle.json\")).unwrap()\n}\n\n#[test]\nfn shared_budget_waits_match_the_executed_source_queue_and_backoff() {\n    for case in oracle()[\"cases\"].as_array().unwrap() {\n        let mut budget = SystemOneBudget::default();\n        for (index, (step, expected)) in case[\"steps\"]\n            .as_array()\n            .unwrap()\n            .iter()\n            .zip(case[\"frames\"].as_array().unwrap())\n            .enumerate()\n        {\n            let at = step[\"at\"].as_f64().unwrap();\n            match step[\"op\"].as_str().unwrap() {\n                \"spend\" => budget.spend(at),\n                \"fail\" => budget.back_off(at),\n                \"reset\" => budget.reset(),\n                \"wait\" => (),\n                op => panic!(\"Unknown Source budget operation {op}\"),\n            }\n            assert_eq!(\n                budget.wait(at),\n                expected.as_f64().unwrap(),\n                \"{}: frame {index}\",\n                case[\"id\"]\n            );\n        }\n    }\n}\n\n#[cfg(feature = \"native-typst\")]\n#[test]\nfn budget_oracle_matches_the_current_original_source_file() {\n    use sha2::{Digest, Sha256};\n    let project = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../..\");\n    for (path, hash) in oracle()[\"hashes\"].as_object().unwrap() {\n        let bytes = std::fs::read(project.join(path)).unwrap();\n        assert_eq!(\n            format!(\"{:x}\", Sha256::digest(bytes)),\n            hash.as_str().unwrap(),\n            \"Source drift: {path}\"\n        );\n    }\n}\n"},"started_at_ms":1791211430141,"completed_at_ms":1791211430141}}
