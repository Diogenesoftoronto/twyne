ome((key) => !required.includes(key) && !optional.includes(key)))\n    throw new ConnectedError(\"invalidRequest\");\n}\nconst volatileVault: CredentialVault = {\n  async load() { return null; }, async save() { return false; }, async clear() {},\n};\nasync function dispatch(method: string, params: Record<string, unknown>): Promise<unknown> {\n  if (method === \"init\") {\n    if (session) throw new ConnectedError(\"invalidRequest\");\n    fields(params, [\"profile\", \"storage\"]);\n    const profile = record(params.profile);\n    if (!profile || ![\"platform\", \"sessionOnly\"].includes(string(params.storage)))\n      throw new ConnectedError(\"invalidRequest\");\n    fields(profile, [\"siteUrl\", \"convexUrl\", \"callbackOrigin\"]);\n    const configured: ConnectedProfile = {\n      siteUrl: string(profile.siteUrl), convexUrl: string(profile.convexUrl),\n      callbackOrigin: string(profile.callbackOrigin),\n    };\n    session = new ConnectedSession(configured,\n      params.storage === \"platform\" ? new PlatformCredentialVault(configured) : volatileVault);\n    return { protocol: 1 };\n  }\n  if (!session) throw new ConnectedError(\"signedOut\");\n  switch (method) {\n    case \"restore\":\n      fields(params, []);\n      return session.restore();\n    case \"redeem\":\n      fields(params, [\"code\", \"verifier\", \"origin\"]);\n      return session.redeem({ code: string(params.code), verifier: string(params.verifier), origin: string(params.origin) });\n    case \"signOut\":\n      fields(params, []);\n      await session.signOut();\n      return null;\n    case \"request\": {\n      fields(params, [\"leaseId\", \"operation\", \"arguments\"]);\n      const args = record(params.arguments);\n      if (!args) throw new ConnectedError(\"invalidRequest\");\n      return session.request(string(params.leaseId), string(params.operation), args);\n    }\n    default: throw new ConnectedError(\"invalidRequest\");\n  }\n}\nasync function output(value: unknown): Promise<void> {\n  await new Promise<void>((resolve, reject) => {\n    process.stdout.write(JSON.stringify(value) + \"\\n\", (error) => error ? reject(error) : resolve());\n  });\n}\nasync function accept(line: Uint8Array): Promise<void> {\n  let id: string | null = null;\n  try {\n    const message = record(JSON.parse(new TextDecoder(\"utf-8\", { fatal: true }).decode(line)));\n    if (!message) throw new ConnectedError(\"invalidRequest\");\n    fields(message, [\"v\", \"id\", \"method\", \"params\"]);\n    if (message.v !== 1 || typeof message.id !== \"string\" || !/^[a-f0-9-]{36}$/.test(message.id))\n      throw new ConnectedError(\"invalidRequest\");\n    id = message.id;\n    const method = string(message.method), params = record(message.params);\n    if (!params || pending.has(id) || pending.size >= MAX_IN_FLIGHT && method !== \"signOut\")\n      throw new ConnectedError(\"invalidRequest\");\n    pending.add(id);\n    try {\n      const result = await dispatch(method, params);\n      await output({ v: 1, id, ok: true, result });\n    } finally { pending.delete(id); }\n  } catch (error) {\n    const safe = error instanceof ConnectedError ? error : new ConnectedError(\"unavailable\");\n    await output({ v: 1, id, ok: false, error: { kind: safe.kind, message: safe.message } });\n  }\n}\nasync function run(): Promise<void> {\n  const reader = Bun.stdin.stream().getReader();\n  const active = new Set<Promise<void>>();\n  let fragments: Uint8Array[] = [], length = 0;\n  function add(bytes: Uint8Array): void {\n    length += bytes.byteLength;\n    if (length > MAX_LINE_BYTES) throw new ConnectedError(\"invalidRequest\");\n    fragments.push(bytes);\n  }\n  try {\n    for (;;) {\n      const next = await reader.read();\n      if (next.done) break;\n      let start = 0;\n      for (let index = 0; index < next.value.byteLength; index++) {\n        if (next.value[index] !== 10) continue;\n        add(next.value.subarray(start, index));\n        const line = new Uint8Array(length);\n        let offset = 0;\n        for (const part of fragments) { line.set(part, offset); offset += part.byteLength; }\n        fragments = []; length = 0; start = index + 1;\n        const task = accept(line);\n        active.add(task);\n        void task.finally(() => active.delete(task)).catch(() => {});\n      }\n      add(next.value.subarray(start));\n    }\n    if (length) throw new ConnectedError(\"invalidRequest\");\n  } finally {\n    // Closing the native host pipe invalidates every account-qualified request.\n    session?.dispose();\n    reader.releaseLock();\n    await Promise.allSettled(active);\n  }\n}\nif (process.argv[2] === \"--version\") {\n  console.log(\"Twyne connected helper, protocol 1\");\n} else if (process.argv[2] === \"--stdio-v1\" && process.argv.length === 3) {\n  try { await run(); } catch { process.exitCode = 1; }\n} else {\n  process.exitCode = 2;\n}\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /home/diogenes/Projects/twyne/desktop/gpui/tools/connected/main.ts\nA /home/diogenes/Projects/twyne/desktop/gpui/tools/build-connected.ts\n","stderr":""},"started_at_ms":1791215279517,"completed_at_ms":1791215279518}}
