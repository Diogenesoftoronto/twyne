writer), minHeight `${minHeightRem??10}rem`, lineHeight '1.5' (170-181)\\\",\\\"onInput$ sets text.value; onKeyDown$ Escape -> preventDefault + onCancel$, Cmd/Ctrl+Enter -> preventDefault then if !submitDisabled && text.trim() -> onConfirm$(text.value); plain Enter stays newline (182-198)\\\",\\\"helpText optional <p class='mt-2 text-[0.68rem] text-[var(--color-ink-muted)]'> typewriter (200-207)\\\",\\\"Footer class 'mt-5 flex items-center justify-end gap-2'; Cancel button class 'btn-paper text-xs' text 'Cancel' onClick onCancel$ (261-264); Submit button class 'btn-press text-xs text-[var(--color-paper)] disabled:opacity-50 disabled:cursor-not-allowed', style backgroundColor/borderColor var(--color-vermilion), fontFamily var(--font-typewriter), label submitLabel, disabled=submitDisabled||!text.trim() (265-276)\\\"],\\\"behavior\\\":[\\\"useTask$ tracks props.open; on open resets text=initialValue??'', previewHtml/previewError/'', previewBusy false, then queueMicrotask focus textarea (63-73)\\\",\\\"if(!props.open) return null (117)\\\"],\\\"keyboard_and_cancel\\\":[\\\"Escape handled on textarea -> onCancel$ (186-188)\\\",\\\"Cmd/Ctrl+Enter submits only when !submitDisabled && non-empty trimmed (191-197)\\\",\\\"Backdrop click cancels (target===currentTarget) (126-130)\\\",\\\"Cancel button cancels (262)\\\",\\\"Autofocus textarea on open (71)\\\"],\\\"empty_submit_behavior\\\":[\\\"Submit button disabled when submitDisabled||!text.trim() (267)\\\",\\\"Cmd/Ctrl+Enter no-op when empty (194)\\\"],\\\"mermaid_preview\\\":[\\\"useVisibleTask$ tracks text.value and props.preview; returns unless preview==='mermaid' (79-82)\\\",\\\"Empty source clears preview and busy (84-88)\\\",\\\"Debounced 400ms (91-110) with generation guard (mermaidPreviewId) and cancel cleanup (90,98,111-114)\\\",\\\"Success -> previewHtml svg, busy false (99-100)\\\",\\\"Error -> previewHtml '', strip /^Syntax error in (text|graph):\\\\\\\\s*/i, else fallback 'This diagram could not be rendered yet