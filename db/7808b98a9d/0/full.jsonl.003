{"timestamp":"2026-10-05T15:23:25.954Z","ordinal":42062,"type":"token_usage_record","payload":{"thread_id":"01a10537-909f-77a3-96d8-dd07161f91ae","turn_id":"01a10ca3-f662-7822-9d58-47f08a989563","session_id":"01a10537-909f-77a3-96d8-dd07161f91ae","root_turn_id":"01a10ca3-f662-7822-9d58-47f08a989563","response_id":"resp_0acb6e766bb0227d016ac3c06e403887d1890847158f1ffffe","usage":{"input_tokens":79202,"cached_input_tokens":68608,"cache_write_input_tokens":0,"output_tokens":3273,"reasoning_output_tokens":3238,"total_tokens":82475},"turn_token_usage":{"input_tokens":424768,"cached_input_tokens":380032,"cache_write_input_tokens":0,"output_tokens":9421,"reasoning_output_tokens":6450,"total_tokens":434189},"thread_token_usage":{"input_tokens":532316077,"cached_input_tokens":511484928,"cache_write_input_tokens":0,"output_tokens":3417524,"reasoning_output_tokens":1512792,"total_tokens":535733601}}}
{"timestamp":"2026-10-05T15:23:25.989Z","ordinal":42063,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a10537-909f-77a3-96d8-dd07161f91ae","turn_id":"01a10ca3-f662-7822-9d58-47f08a989563","item":{"type":"CommandExecution","id":"exec-52a2df62-7648-4630-9718-cc7111075f4f","process_id":"3885","command":["/bin/bash","-lc","rtk proxy cat convex/schema.ts"],"cwd":"file:///home/diogenes/Projects/twyne","parsed_cmd":[{"type":"unknown","cmd":"rtk proxy cat convex/schema.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"import { defineSchema, defineTable } from \"convex/server\";\nimport { v } from \"convex/values\";\n\n/**\n * One item of a per-user collection.\n *\n * Three collections — folios, custom personas, bibliography entries — used to\n * live as an array inside a single document each. Every edit rewrote the whole\n * document, and the collection could never outgrow Convex's 1MB document cap.\n * These tables replace that arrangement with a row per item.\n *\n * The field and index names are deliberately identical across all three, so a\n * single accessor in `lib/collections.ts` can serve them and they cannot drift\n * apart. `item` stays `v.any()` for the same reason the arrays did: adding a\n * field to a folio should not need a migration.\n */\nconst collectionEntry = {\n  userId: v.string(),\n  /** The item's own id, as the client models it. Unique per user per table. */\n  itemId: v.string(),\n  item: v.any(),\n  /** Position in the collection, so the array round-trips in its own order. */\n  order: v.number(),\n  updatedAt: v.number(),\n};\n\nconst usageTokenFields = {\n  inputTokens: v.optional(v.number()),\n  outputTokens: v.optional(v.number()),\n  cacheReadTokens: v.optional(v.number()),\n  cacheWriteTokens: v.optional(v.number()),\n  reasoningTokens: v.optional(v.number()),\n  totalTokens: v.optional(v.number()),\n};\n\nconst usagePricingSnapshot = v.object({\n  source: v.string(),\n  version: v.string(),\n  currency: v.literal(\"USD\"),\n  inputMicrousdPerMillion: v.number(),\n  outputMicrousdPerMillion: v.number(),\n  cacheReadMicrousdPerMillion: v.optional(v.number()),\n  cacheWriteMicrousdPerMillion: v.optional(v.number()),\n  reasoningMicrousdPerMillion: v.optional(v.number()),\n  longContextThresholdTokens: v.optional(v.number()),\n  longInputMicrousdPerMillion: v.optional(v.number()),\n  longOutputMicrousdPerMillion: v.optional(v.number()),\n});\n\nconst usageMetricFields = {\n  generations: v.number(),\n  completedGenerations: v.number(),\n  failedGenerations: v.number(),\n  logicalActions: v.number(),\n  completedActions: v.number(),\n  failedActions: v.number(),\n  actualCostMicrousd: v.number(),\n  estimatedCostMicrousd: v.number(),\n  localGenerations: v.number(),\n  unknownCostGenerations: v.number(),\n  creditMicrounits: v.number(),\n  inputTokens: v.number(),\n  outputTokens: v.number(),\n  cacheReadTokens: v.number(),\n  cacheWriteTokens: v.number(),\n  reasoningTokens: v.number(),\n  totalTokens: v.number(),\n  inputTokensReported: v.number(),\n  outputTokensReported: v.number(),\n  cacheReadTokensReported: v.number(),\n  cacheWriteTokensReported: v.number(),\n  reasoningTokensReported: v.number(),\n  totalTokensReported: v.number(),\n  inputTokensMissing: v.number(),\n  outputTokensMissing: v.number(),\n  cacheReadTokensMissing: v.number(),\n  cacheWriteTokensMissing: v.number(),\n  reasoningTokensMissing: v.number(),\n  totalTokensMissing: v.number(),\n  reportedTotalDiscrepancies: v.number(),\n};\n\nexport default defineSchema({\n  // Optimistic concurrency head for the bulk browser snapshot. Every push\n  // compares the revision it last pulled with this row before writing, so two\n  // open devices cannot silently ratify stale state over one another.\n  syncHeads: defineTable({\n    userId: v.string(),\n    revision: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  folioEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  personaEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  bibliographyEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  // ── Per-user state, synced from the browser on sign-up and on every change. ──\n  briefs: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    brief: v.any(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // Ephemeral per-turn output for the hosted dossier interview. Convex actions\n  // write cumulative reasoning/text snapshots here while the browser watches\n  // the authenticated query; the client removes the row when the turn settles.\n  dossierInterviewStreams: defineTable({\n    userId: v.string(),\n    streamId: v.string(),\n    text: v.string(),\n    reasoning: v.string(),\n    phase: v.union(v.literal(\"reasoning\"), v.literal(\"answer\")),\n    status: v.union(\n      v.literal(\"running\"),\n      v.literal(\"complete\"),\n      v.literal(\"error\"),\n    ),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_streamId\", [\"userId\", \"streamId\"])\n    // The browser clears its own rows when a turn settles. This is for the\n    // turns whose browser never came back — a closed tab, a lost connection —\n    // so the sweep can find them by age instead of scanning the table.\n    .index(\"by_updatedAt\", [\"updatedAt\"]),\n\n  // The same arrangement for hosted persona notes, keyed by persona so five\n  // editors can fill their own cards at once. Without this the server path\n  // delivered a note in one silent jump, which on a reasoning model means a\n  // blank card for as long as the model thinks.\n  personaNoteStreams: defineTable({\n    userId: v.string(),\n    streamId: v.string(),\n    personaId: v.string(),\n    text: v.string(),\n    reasoning: v.string(),\n    phase: v.union(v.literal(\"reasoning\"), v.literal(\"answer\")),\n    status: v.union(\n      v.literal(\"running\"),\n      v.literal(\"complete\"),\n      v.literal(\"error\"),\n    ),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_streamId\", [\"userId\", \"streamId\"])\n    .index(\"by_userId_streamId_personaId\", [\"userId\", \"streamId\", \"personaId\"])\n    .index(\"by_updatedAt\", [\"updatedAt\"]),\n\n  folios: defineTable({\n    userId: v.string(),\n    folios: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  folioContent: defineTable({\n    userId: v.string(),\n    folioId: v.string(),\n    html: v.string(),\n    format: v.optional(v.union(v.literal(\"html\"), v.literal(\"typst\"))),\n    typstSource: v.optional(v.string()),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // Personal tokens for the CLI and local MCP server. Only a SHA-256 digest\n  // is persisted; the clear-text token is returned once when it is created.\n  integrationTokens: defineTable({\n    userId: v.string(),\n    tokenHash: v.string(),\n    prefix: v.string(),\n    name: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_tokenHash\", [\"tokenHash\"]),\n\n  // Uploaded manuscript images. The editor stores the resolved URL in its\n  // document while this row preserves ownership and the underlying storage\n  // id so files can be looked up and deleted safely.\n  images: defineTable({\n    ownerId: v.string(),\n    folioId: v.string(),\n    storageId: v.id(\"_storage\"),\n    contentType: v.union(\n      v.literal(\"image/gif\"),\n      v.literal(\"image/jpeg\"),\n      v.literal(\"image/png\"),\n      v.literal(\"image/webp\"),\n    ),\n    size: v.number(),\n    createdAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_folioId\", [\"ownerId\", \"folioId\"])\n    .index(\"by_storageId\", [\"storageId\"]),\n\n  // ── Per-day writing activity, for the public \"days writing\" heatmap on\n  // the author profile page. Append-only-ish: one row per (userId, day),\n  // upserted as the user writes. ──\n  writingActivity: defineTable({\n    userId: v.string(),\n    day: v.string(),\n    count: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_day\", [\"userId\", \"day\"]),\n\n  writingActivityDetails: defineTable({\n    userId: v.string(),\n    day: v.string(),\n    folioId: v.string(),\n    count: v.number(),\n    firstOccurredAt: v.number(),\n    lastOccurredAt: v.number(),\n  })\n    .index(\"by_userId_and_day\", [\"userId\", \"day\"])\n    .index(\"by_userId_and_day_and_folioId\", [\"userId\", \"day\", \"folioId\"]),\n\n  // Content-free, append-only provider-attempt ledger for My Desk. Raw rows\n  // and every denormalized aggregate are updated in one mutation.\n  aiUsageEvents: defineTable({\n    ownerId: v.string(),\n    eventKey: v.string(),\n    occurredAt: v.number(),\n    day: v.string(),\n    source: v.union(v.literal(\"hosted\"), v.literal(\"byok\"), v.literal(\"local\")),\n    authority: v.union(\n      v.literal(\"server\"),\n      v.literal(\"provider\"),\n      v.literal(\"client_reported\"),\n    ),\n    feature: v.string(),\n    provider: v.string(),\n    model: v.string(),\n    folioId: v.optional(v.string()),\n    editorialActionId: v.optional(v.string()),\n    traceId: v.string(),\n    attempt: v.number(),\n    outcome: v.union(v.literal(\"completed\"), v.literal(\"failed\")),\n    ...usageTokenFields,\n    costMicrousd: v.optional(v.number()),\n    costKind: v.union(\n      v.literal(\"actual\"),\n      v.literal(\"estimated\"),\n      v.literal(\"local\"),\n      v.literal(\"unknown\"),\n    ),\n    pricingVersion: v.optional(v.string()),\n    pricing: v.optional(usagePricingSnapshot),\n    creditMicrounits: v.optional(v.number()),\n  })\n    .index(\"by_ownerId_and_eventKey\", [\"ownerId\", \"eventKey\"])\n    .index(\"by_ownerId_and_occurredAt\", [\"ownerId\", \"occurredAt\"])\n    .index(\"by_ownerId_and_editorialActionId_and_outcome\", [\n      \"ownerId\",\n      \"editorialActionId\",\n      \"outcome\",\n    ]),\n\n  aiUsageDailyTotals: defineTable({\n    ownerId: v.string(),\n    day: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId_and_day\", [\"ownerId\", \"day\"]),\n\n  aiUsageDailyBreakdowns: defineTable({\n    ownerId: v.string(),\n    day: v.string(),\n    dimension: v.union(\n      v.literal(\"feature\"),\n      v.literal(\"provider_model\"),\n      v.literal(\"folio\"),\n    ),\n    key: v.string(),\n    ...usageMetricFields,\n  })\n    .index(\"by_ownerId_and_dimension_and_day\", [\"ownerId\", \"dimension\", \"day\"])\n    .index(\"by_ownerId_and_day_and_dimension_and_key\", [\n      \"ownerId\",\n      \"day\",\n      \"dimension\",\n      \"key\",\n    ]),\n\n  aiUsageLifetimeTotals: defineTable({\n    ownerId: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  aiUsageLifetimeBreakdowns: defineTable({\n    ownerId: v.string(),\n    dimension: v.union(\n      v.literal(\"feature\"),\n      v.literal(\"provider_model\"),\n      v.literal(\"folio\"),\n    ),\n    key: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId_and_dimension_and_key\", [\"ownerId\", \"dimension\", \"key\"]),\n\n  // Tombstone and resumable cursor for writer-requested synchronized usage\n  // deletion. Its presence is also the ingestion barrier for this owner.\n  aiUsageDeletionJobs: defineTable({\n    ownerId: v.string(),\n    phase: v.number(),\n    deletedCount: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  customPersonas: defineTable({\n    userId: v.string(),\n    personas: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Persona feedback notes — the room's marginalia, persisted per user. ──\n  // Stored server-side so a signed-in user can re-read their notes across\n  // devices. Brief is denormalized so the panel can render summaries cheaply.\n  personaNotes: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    noteId: v.string(),\n    personaId: v.string(),\n    personaName: v.string(),\n    personaColor: v.string(),\n    type: v.union(\n      v.literal(\"encouragement\"),\n      v.literal(\"suggestion\"),\n      v.literal(\"critique\"),\n      v.literal(\"perspective\"),\n    ),\n    feedback: v.string(),\n    traceId: v.optional(v.string()),\n    anchor: v.optional(v.string()),\n    briefTitle: v.optional(v.string()),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_noteId\", [\"userId\", \"noteId\"]),\n\n  // Trace-linked feedback is the durable review queue. Negative feedback is\n  // pending human review; positive feedback is retained for cohort analysis.\n  aiFeedback: defineTable({\n    userId: v.string(),\n    traceId: v.string(),\n    spanId: v.optional(v.string()),\n    feature: v.string(),\n    sentiment: v.union(v.literal(\"positive\"), v.literal(\"negative\")),\n    reason: v.optional(\n      v.union(\n        v.literal(\"grounding\"),\n        v.literal(\"usefulness\"),\n        v.literal(\"tone\"),\n        v.literal(\"incorrect\"),\n        v.literal(\"too_long\"),\n        v.literal(\"other\"),\n      ),\n    ),\n    comment: v.optional(v.string()),\n    folioId: v.optional(v.string()),\n    sessionId: v.optional(v.string()),\n    editorialActionId: v.optional(v.string()),\n    reviewStatus: v.union(\n      v.literal(\"not_required\"),\n      v.literal(\"pending\"),\n      v.literal(\"in_review\"),\n      v.literal(\"resolved\"),\n    ),\n    createdAt: v.number(),\n  })\n    .index(\"by_traceId\", [\"traceId\"])\n    .index(\"by_reviewStatus_createdAt\", [\"reviewStatus\", \"createdAt\"])\n    .index(\"by_userId_createdAt\", [\"userId\", \"createdAt\"]),\n\n  // ── Threaded replies to persona notes, optionally re-prompting the agent. ──\n  personaReplies: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    noteId: v.string(),\n    replyId: v.string(),\n    author: v.string(),\n    authorKind: v.union(v.literal(\"user\"), v.literal(\"persona\")),\n    personaId: v.optional(v.string()),\n    text: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_noteId\", [\"userId\", \"noteId\"]),\n\n  // ── Rubric results — one per folio; legacy rows may omit folioId. ──\n  rubricResults: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    result: v.any(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // ── Editorial change proposals (editors propose edits to the manuscript). ──\n  suggestions: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    suggestionId: v.string(),\n    versionId: v.string(),\n    personaId: v.string(),\n    personaName: v.string(),\n    color: v.string(),\n    blockId: v.string(),\n    original: v.string(),\n    replacement: v.string(),\n    rationale: v.string(),\n    kind: v.union(v.literal(\"sentence\"), v.literal(\"paragraph\")),\n    status: v.union(\n      v.literal(\"open\"),\n      v.literal(\"accepted\"),\n      v.literal(\"rejected\"),\n    ),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_suggestionId\", [\"userId\", \"suggestionId\"]),\n\n  // ── Room settings (tunable assistance) — one per user, latest wins. ──\n  roomSettings: defineTable({\n    userId: v.string(),\n    settings: v.any(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Appearance (theme) — one per user, latest wins.\n  // Its own table rather than a key inside `roomSettings`: that record is\n  // written whole by the personas panel, which knows nothing about themes\n  // and would drop the key on every assistance change. `updatedAt` is what\n  // decides a local-vs-remote conflict when a second device signs in. ──\n  appearance: defineTable({\n    userId: v.string(),\n    preset: v.string(),\n    // Token id -> `#rrggbb`. Validated client-side before it is written into\n    // a CSS custom property; stored loosely so adding a themeable token\n    // later needs no migration.\n    custom: v.optional(v.record(v.string(), v.string())),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Lix snapshots (existing). ──\n  lixBlobs: defineTable({\n    userId: v.string(),\n    blob: v.bytes(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Writer bibliographies — saved sources synced with folio state. ──\n  bibliographies: defineTable({\n    userId: v.string(),\n    entries: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Published pieces — public read-by-slug, owner-only writes. ──\n  // Each row is a snapshot of a folio at publish time. The slug is the\n  // ── Published pieces (post + blog). Same table — kind\n  // discriminates. The reader route is /<handle>/<slug> for writers who\n  // have claimed a handle, falling back to /p/[slug] for legacy links.\n  // The blog stream at /blog only shows \"blog\" pieces authored by an\n  // admin. The ownerId index is for the signed-in user's \"my pieces\"\n  // list; (kind, publishedAt) is for the public blog feed.\n  // `ownerHandle` is denormalized at publish time so the reader route\n  // can resolve without an extra hop; it's null until the owner has\n  // claimed a handle (legacy pieces backfill on next publish). ──\n  published: defineTable({\n    ownerId: v.string(),\n    ownerHandle: v.optional(v.string()),\n    slug: v.string(),\n    folioId: v.string(),\n    kind: v.union(v.literal(\"post\"), v.literal(\"blog\")),\n    title: v.string(),\n    authorName: v.optional(v.string()),\n    briefSummary: v.optional(v.string()),\n    content: v.string(), // sanitized HTML\n    publishedAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_slug\", [\"slug\"])\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerHandle_slug\", [\"ownerHandle\", \"slug\"])\n    .index(\"by_ownerHandle_kind_publishedAt\", [\n      \"ownerHandle\",\n      \"kind\",\n      \"publishedAt\",\n    ])\n    .index(\"by_kind_publishedAt\", [\"kind\", \"publishedAt\"]),\n\n  // ── Admin roster. One row per user who can publish to the\n  // public blog. The first admin bootstraps via\n  // `admins.bootstrap`; subsequent additions are gated on\n  // the caller already being an admin. ──\n  admins: defineTable({\n    userId: v.string(),\n    addedBy: v.optional(v.string()),\n    addedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Writer handles — one per user, claimed on first publish or from\n  // Settings. The handle is the public identity on share URLs\n  // (/<handle>/<slug>) and profile pages (/<handle>). Lowercase,\n  // slugified, validated in convex/profiles.ts. By-handle index is\n  // unique. ──\n  handles: defineTable({\n    userId: v.string(),\n    handle: v.string(),\n    displayName: v.optional(v.string()),\n    bio: v.optional(v.string()),\n    /** Convex storage id for the writer's profile picture, if set. */\n    avatarStorageId: v.optional(v.id(\"_storage\")),\n    publicStats: v.optional(\n      v.object({\n        writingHeatmap: v.boolean(),\n        daysWritten30: v.boolean(),\n        streak: v.union(\n          v.literal(\"off\"),\n          v.literal(\"current\"),\n          v.literal(\"longest\"),\n        ),\n        publicPieceCount: v.boolean(),\n        folioCount: v.boolean(),\n      }),\n    ),\n    claimedAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_handle\", [\"handle\"]),\n\n  // ── Writer-authored inline comments (margin notes, with threads). ──\n  // The CommentMark in the manuscript holds the id; the body, replies,\n  // and resolve state live here. Owner-only.\n  userComments: defineTable({\n    ownerId: v.string(),\n    commentId: v.string(),\n    folioId: v.string(),\n    text: v.string(),\n    author: v.string(),\n    anchor: v.optional(v.string()),\n    resolved: v.boolean(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_commentId\", [\"ownerId\", \"commentId\"]),\n\n  userCommentReplies: defineTable({\n    ownerId: v.string(),\n    replyId: v.string(),\n    commentId: v.string(),\n    author: v.string(),\n    text: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_commentId\", [\"ownerId\", \"commentId\"]),\n\n  // One-to-one identity bridge between a Better Auth product subject and the\n  // DID restored by Twyne's ATProto OAuth client. The mutation enforces both\n  // indexes as unique inside one Convex transaction.\n  providerIdentities: defineTable({\n    productSubject: v.string(),\n    did: v.string(),\n    verificationMethod: v.union(\n      v.literal(\"legacy_atproto_browser_oauth\"),\n      v.literal(\"notorganic_pkce\"),\n    ),\n    sessionVersion: v.number(),\n    verifiedAt: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_productSubject\", [\"productSubject\"])\n    .index(\"by_did\", [\"did\"]),\n\n  /* One row per pre–Not Organic account: when it was told about the move and\n   * when it was retired. Makes the notice send idempotent. */\n  legacyAccountNotices: defineTable({\n    userId: v.string(),\n    email: v.string(),\n    notifiedAt: v.optional(v.number()),\n    retiredAt: v.optional(v.number()),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  accountDeletionJobs: defineTable({\n    ownerId: v.string(),\n    productSubject: v.string(),\n    email: v.optional(v.string()),\n    phase: v.number(),\n    deletedCount: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  /* ── Multiplayer: shared Lix documents ──\n   * When a Pro user shares a folio, its local Lix blob is promoted to a\n   * server-hosted instance. Collaborators open it with Lix sync enabled and\n   * `initSyncProcess` pushes/pulls change-sets through the /lsp/* relay. */\n\n  sharedLixBlobs: defineTable({\n    lixId: v.string(),\n    ownerId: v.string(),\n    folioId: v.string(),\n    folioName: v.string(),\n    storageId: v.id(\"_storage\"),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_ownerId\", [\"ownerId\"]),\n\n  // ── Push-serialization locks — one row per in-flight push. ──\n  // Prevents two concurrent /lsp/push-v1 requests from both reading the\n  // same base blob and the later write clobbering the earlier one.\n  // Stale locks (older than LIX_LOCK_TTL_MS) are reclaimed automatically.\n  lixLocks: defineTable({\n    lixId: v.string(),\n    lockedAt: v.number(),\n  }).index(\"by_lixId\", [\"lixId\"]),\n\n  collaborators: defineTable({\n    lixId: v.string(),\n    userId: v.string(),\n    role: v.union(\n      v.literal(\"owner\"),\n      v.literal(\"editor\"),\n      v.literal(\"commenter\"),\n    ),\n    status: v.union(\n      v.literal(\"pending\"),\n      v.literal(\"accepted\"),\n      v.literal(\"rejected\"),\n    ),\n    invitedBy: v.optional(v.string()),\n    invitedAt: v.number(),\n    acceptedAt: v.optional(v.number()),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_lixId_userId\", [\"lixId\", \"userId\"]),\n\n  presence: defineTable({\n    lixId: v.string(),\n    userId: v.string(),\n    displayName: v.string(),\n    email: v.optional(v.string()),\n    color: v.string(),\n    cursorPos: v.optional(v.number()),\n    selectionAnchor: v.optional(v.number()),\n    selectionHead: v.optional(v.number()),\n    lastSeenAt: v.number(),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_lixId_userId\", [\"lixId\", \"userId\"]),\n\n  // ── Mobile app waitlist — public, unauthenticated signups. ──\n  // One row per (email, platform); dedupe is enforced in convex/waitlist.ts\n  // via the index below rather than a unique constraint (Convex has none).\n  waitlist: defineTable({\n    email: v.string(),\n    platform: v.union(v.literal(\"ios\"), v.literal(\"android\")),\n    createdAt: v.number(),\n  }).index(\"by_email_platform\", [\"email\", \"platform\"]),\n\n  // ── Rate-limit buckets — one row per (action, identifier). ──\n  // Identifier is usually the user's Convex tokenIdentifier; for\n  // unauthed paths (OTP request) it's the email or IP. `count` is\n  // reset when `windowStart` is older than the action's window.\n  // See convex/lib/rateLimit.ts.\n  rateBuckets: defineTable({\n    action: v.string(),\n    identifier: v.string(),\n    count: v.number(),\n    windowStart: v.number(),\n  })\n    .index(\"by_action_identifier\", [\"action\", \"identifier\"])\n    .index(\"by_identifier\", [\"identifier\"]),\n  houses: defineTable({\n    userId: v.string(), name: v.string(), dossier: v.any(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n  houseCollections: defineTable({\n    userId: v.string(), collectionId: v.string(), name: v.string(), description: v.string(),\n    dossier: v.any(), createdAt: v.number(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_collectionId\", [\"userId\", \"collectionId\"]),\n  collectionMembers: defineTable({\n    userId: v.string(), collectionId: v.string(), folioId: v.string(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_collectionId\", [\"userId\", \"collectionId\"])\n    .index(\"by_userId_and_folioId\", [\"userId\", \"folioId\"]),\n  charterItems: defineTable({\n    userId: v.string(), itemId: v.string(),\n    scope: v.union(v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"folio\")),\n    ownerRef: v.string(), text: v.string(), severity: v.union(v.literal(\"must\"), v.literal(\"prefer\")),\n    kind: v.union(v.literal(\"length\"), v.literal(\"citation\"), v.literal(\"style\"), v.literal(\"voice\"), v.literal(\"other\")),\n    order: v.number(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_itemId\", [\"userId\", \"itemId\"]),\n  contextLedger: defineTable({\n    userId: v.string(), entryId: v.string(), at: v.number(),\n    layer: v.union(v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"folio\"), v.literal(\"amendment\"), v.literal(\"charter\")),\n    ownerRef: v.string(), field: v.optional(v.string()), from: v.optional(v.string()), to: v.optional(v.string()),\n    source: v.union(v.literal(\"interview\"), v.literal(\"refine\"), v.literal(\"amendment\"), v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"charter\"), v.literal(\"manual\"), v.literal(\"sync\")),\n    reason: v.optional(v.string()),\n  }).index(\"by_userId_and_at\", [\"userId\", \"at\"])\n    .index(\"by_userId_and_entryId\", [\"userId\", \"entryId\"]),\n});\n","stderr":"","aggregated_output":"import { defineSchema, defineTable } from \"convex/server\";\nimport { v } from \"convex/values\";\n\n/**\n * One item of a per-user collection.\n *\n * Three collections — folios, custom personas, bibliography entries — used to\n * live as an array inside a single document each. Every edit rewrote the whole\n * document, and the collection could never outgrow Convex's 1MB document cap.\n * These tables replace that arrangement with a row per item.\n *\n * The field and index names are deliberately identical across all three, so a\n * single accessor in `lib/collections.ts` can serve them and they cannot drift\n * apart. `item` stays `v.any()` for the same reason the arrays did: adding a\n * field to a folio should not need a migration.\n */\nconst collectionEntry = {\n  userId: v.string(),\n  /** The item's own id, as the client models it. Unique per user per table. */\n  itemId: v.string(),\n  item: v.any(),\n  /** Position in the collection, so the array round-trips in its own order. */\n  order: v.number(),\n  updatedAt: v.number(),\n};\n\nconst usageTokenFields = {\n  inputTokens: v.optional(v.number()),\n  outputTokens: v.optional(v.number()),\n  cacheReadTokens: v.optional(v.number()),\n  cacheWriteTokens: v.optional(v.number()),\n  reasoningTokens: v.optional(v.number()),\n  totalTokens: v.optional(v.number()),\n};\n\nconst usagePricingSnapshot = v.object({\n  source: v.string(),\n  version: v.string(),\n  currency: v.literal(\"USD\"),\n  inputMicrousdPerMillion: v.number(),\n  outputMicrousdPerMillion: v.number(),\n  cacheReadMicrousdPerMillion: v.optional(v.number()),\n  cacheWriteMicrousdPerMillion: v.optional(v.number()),\n  reasoningMicrousdPerMillion: v.optional(v.number()),\n  longContextThresholdTokens: v.optional(v.number()),\n  longInputMicrousdPerMillion: v.optional(v.number()),\n  longOutputMicrousdPerMillion: v.optional(v.number()),\n});\n\nconst usageMetricFields = {\n  generations: v.number(),\n  completedGenerations: v.number(),\n  failedGenerations: v.number(),\n  logicalActions: v.number(),\n  completedActions: v.number(),\n  failedActions: v.number(),\n  actualCostMicrousd: v.number(),\n  estimatedCostMicrousd: v.number(),\n  localGenerations: v.number(),\n  unknownCostGenerations: v.number(),\n  creditMicrounits: v.number(),\n  inputTokens: v.number(),\n  outputTokens: v.number(),\n  cacheReadTokens: v.number(),\n  cacheWriteTokens: v.number(),\n  reasoningTokens: v.number(),\n  totalTokens: v.number(),\n  inputTokensReported: v.number(),\n  outputTokensReported: v.number(),\n  cacheReadTokensReported: v.number(),\n  cacheWriteTokensReported: v.number(),\n  reasoningTokensReported: v.number(),\n  totalTokensReported: v.number(),\n  inputTokensMissing: v.number(),\n  outputTokensMissing: v.number(),\n  cacheReadTokensMissing: v.number(),\n  cacheWriteTokensMissing: v.number(),\n  reasoningTokensMissing: v.number(),\n  totalTokensMissing: v.number(),\n  reportedTotalDiscrepancies: v.number(),\n};\n\nexport default defineSchema({\n  // Optimistic concurrency head for the bulk browser snapshot. Every push\n  // compares the revision it last pulled with this row before writing, so two\n  // open devices cannot silently ratify stale state over one another.\n  syncHeads: defineTable({\n    userId: v.string(),\n    revision: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  folioEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  personaEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  bibliographyEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  // ── Per-user state, synced from the browser on sign-up and on every change. ──\n  briefs: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    brief: v.any(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // Ephemeral per-turn output for the hosted dossier interview. Convex actions\n  // write cumulative reasoning/text snapshots here while the browser watches\n  // the authenticated query; the client removes the row when the turn settles.\n  dossierInterviewStreams: defineTable({\n    userId: v.string(),\n    streamId: v.string(),\n    text: v.string(),\n    reasoning: v.string(),\n    phase: v.union(v.literal(\"reasoning\"), v.literal(\"answer\")),\n    status: v.union(\n      v.literal(\"running\"),\n      v.literal(\"complete\"),\n      v.literal(\"error\"),\n    ),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_streamId\", [\"userId\", \"streamId\"])\n    // The browser clears its own rows when a turn settles. This is for the\n    // turns whose browser never came back — a closed tab, a lost connection —\n    // so the sweep can find them by age instead of scanning the table.\n    .index(\"by_updatedAt\", [\"updatedAt\"]),\n\n  // The same arrangement for hosted persona notes, keyed by persona so five\n  // editors can fill their own cards at once. Without this the server path\n  // delivered a note in one silent jump, which on a reasoning model means a\n  // blank card for as long as the model thinks.\n  personaNoteStreams: defineTable({\n    userId: v.string(),\n    streamId: v.string(),\n    personaId: v.string(),\n    text: v.string(),\n    reasoning: v.string(),\n    phase: v.union(v.literal(\"reasoning\"), v.literal(\"answer\")),\n    status: v.union(\n      v.literal(\"running\"),\n      v.literal(\"complete\"),\n      v.literal(\"error\"),\n    ),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_streamId\", [\"userId\", \"streamId\"])\n    .index(\"by_userId_streamId_personaId\", [\"userId\", \"streamId\", \"personaId\"])\n    .index(\"by_updatedAt\", [\"updatedAt\"]),\n\n  folios: defineTable({\n    userId: v.string(),\n    folios: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  folioContent: defineTable({\n    userId: v.string(),\n    folioId: v.string(),\n    html: v.string(),\n    format: v.optional(v.union(v.literal(\"html\"), v.literal(\"typst\"))),\n    typstSource: v.optional(v.string()),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // Personal tokens for the CLI and local MCP server. Only a SHA-256 digest\n  // is persisted; the clear-text token is returned once when it is created.\n  integrationTokens: defineTable({\n    userId: v.string(),\n    tokenHash: v.string(),\n    prefix: v.string(),\n    name: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_tokenHash\", [\"tokenHash\"]),\n\n  // Uploaded manuscript images. The editor stores the resolved URL in its\n  // document while this row preserves ownership and the underlying storage\n  // id so files can be looked up and deleted safely.\n  images: defineTable({\n    ownerId: v.string(),\n    folioId: v.string(),\n    storageId: v.id(\"_storage\"),\n    contentType: v.union(\n      v.literal(\"image/gif\"),\n      v.literal(\"image/jpeg\"),\n      v.literal(\"image/png\"),\n      v.literal(\"image/webp\"),\n    ),\n    size: v.number(),\n    createdAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_folioId\", [\"ownerId\", \"folioId\"])\n    .index(\"by_storageId\", [\"storageId\"]),\n\n  // ── Per-day writing activity, for the public \"days writing\" heatmap on\n  // the author profile page. Append-only-ish: one row per (userId, day),\n  // upserted as the user writes. ──\n  writingActivity: defineTable({\n    userId: v.string(),\n    day: v.string(),\n    count: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_day\", [\"userId\", \"day\"]),\n\n  writingActivityDetails: defineTable({\n    userId: v.string(),\n    day: v.string(),\n    folioId: v.string(),\n    count: v.number(),\n    firstOccurredAt: v.number(),\n    lastOccurredAt: v.number(),\n  })\n    .index(\"by_userId_and_day\", [\"userId\", \"day\"])\n    .index(\"by_userId_and_day_and_folioId\", [\"userId\", \"day\", \"folioId\"]),\n\n  // Content-free, append-only provider-attempt ledger for My Desk. Raw rows\n  // and every denormalized aggregate are updated in one mutation.\n  aiUsageEvents: defineTable({\n    ownerId: v.string(),\n    eventKey: v.string(),\n    occurredAt: v.number(),\n    day: v.string(),\n    source: v.union(v.literal(\"hosted\"), v.literal(\"byok\"), v.literal(\"local\")),\n    authority: v.union(\n      v.literal(\"server\"),\n      v.literal(\"provider\"),\n      v.literal(\"client_reported\"),\n    ),\n    feature: v.string(),\n    provider: v.string(),\n    model: v.string(),\n    folioId: v.optional(v.string()),\n    editorialActionId: v.optional(v.string()),\n    traceId: v.string(),\n    attempt: v.number(),\n    outcome: v.union(v.literal(\"completed\"), v.literal(\"failed\")),\n    ...usageTokenFields,\n    costMicrousd: v.optional(v.number()),\n    costKind: v.union(\n      v.literal(\"actual\"),\n      v.literal(\"estimated\"),\n      v.literal(\"local\"),\n      v.literal(\"unknown\"),\n    ),\n    pricingVersion: v.optional(v.string()),\n    pricing: v.optional(usagePricingSnapshot),\n    creditMicrounits: v.optional(v.number()),\n  })\n    .index(\"by_ownerId_and_eventKey\", [\"ownerId\", \"eventKey\"])\n    .index(\"by_ownerId_and_occurredAt\", [\"ownerId\", \"occurredAt\"])\n    .index(\"by_ownerId_and_editorialActionId_and_outcome\", [\n      \"ownerId\",\n      \"editorialActionId\",\n      \"outcome\",\n    ]),\n\n  aiUsageDailyTotals: defineTable({\n    ownerId: v.string(),\n    day: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId_and_day\", [\"ownerId\", \"day\"]),\n\n  aiUsageDailyBreakdowns: defineTable({\n    ownerId: v.string(),\n    day: v.string(),\n    dimension: v.union(\n      v.literal(\"feature\"),\n      v.literal(\"provider_model\"),\n      v.literal(\"folio\"),\n    ),\n    key: v.string(),\n    ...usageMetricFields,\n  })\n    .index(\"by_ownerId_and_dimension_and_day\", [\"ownerId\", \"dimension\", \"day\"])\n    .index(\"by_ownerId_and_day_and_dimension_and_key\", [\n      \"ownerId\",\n      \"day\",\n      \"dimension\",\n      \"key\",\n    ]),\n\n  aiUsageLifetimeTotals: defineTable({\n    ownerId: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  aiUsageLifetimeBreakdowns: defineTable({\n    ownerId: v.string(),\n    dimension: v.union(\n      v.literal(\"feature\"),\n      v.literal(\"provider_model\"),\n      v.literal(\"folio\"),\n    ),\n    key: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId_and_dimension_and_key\", [\"ownerId\", \"dimension\", \"key\"]),\n\n  // Tombstone and resumable cursor for writer-requested synchronized usage\n  // deletion. Its presence is also the ingestion barrier for this owner.\n  aiUsageDeletionJobs: defineTable({\n    ownerId: v.string(),\n    phase: v.number(),\n    deletedCount: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  customPersonas: defineTable({\n    userId: v.string(),\n    personas: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Persona feedback notes — the room's marginalia, persisted per user. ──\n  // Stored server-side so a signed-in user can re-read their notes across\n  // devices. Brief is denormalized so the panel can render summaries cheaply.\n  personaNotes: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    noteId: v.string(),\n    personaId: v.string(),\n    personaName: v.string(),\n    personaColor: v.string(),\n    type: v.union(\n      v.literal(\"encouragement\"),\n      v.literal(\"suggestion\"),\n      v.literal(\"critique\"),\n      v.literal(\"perspective\"),\n    ),\n    feedback: v.string(),\n    traceId: v.optional(v.string()),\n    anchor: v.optional(v.string()),\n    briefTitle: v.optional(v.string()),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_noteId\", [\"userId\", \"noteId\"]),\n\n  // Trace-linked feedback is the durable review queue. Negative feedback is\n  // pending human review; positive feedback is retained for cohort analysis.\n  aiFeedback: defineTable({\n    userId: v.string(),\n    traceId: v.string(),\n    spanId: v.optional(v.string()),\n    feature: v.string(),\n    sentiment: v.union(v.literal(\"positive\"), v.literal(\"negative\")),\n    reason: v.optional(\n      v.union(\n        v.literal(\"grounding\"),\n        v.literal(\"usefulness\"),\n        v.literal(\"tone\"),\n        v.literal(\"incorrect\"),\n        v.literal(\"too_long\"),\n        v.literal(\"other\"),\n      ),\n    ),\n    comment: v.optional(v.string()),\n    folioId: v.optional(v.string()),\n    sessionId: v.optional(v.string()),\n    editorialActionId: v.optional(v.string()),\n    reviewStatus: v.union(\n      v.literal(\"not_required\"),\n      v.literal(\"pending\"),\n      v.literal(\"in_review\"),\n      v.literal(\"resolved\"),\n    ),\n    createdAt: v.number(),\n  })\n    .index(\"by_traceId\", [\"traceId\"])\n    .index(\"by_reviewStatus_createdAt\", [\"reviewStatus\", \"createdAt\"])\n    .index(\"by_userId_createdAt\", [\"userId\", \"createdAt\"]),\n\n  // ── Threaded replies to persona notes, optionally re-prompting the agent. ──\n  personaReplies: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    noteId: v.string(),\n    replyId: v.string(),\n    author: v.string(),\n    authorKind: v.union(v.literal(\"user\"), v.literal(\"persona\")),\n    personaId: v.optional(v.string()),\n    text: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_noteId\", [\"userId\", \"noteId\"]),\n\n  // ── Rubric results — one per folio; legacy rows may omit folioId. ──\n  rubricResults: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    result: v.any(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // ── Editorial change proposals (editors propose edits to the manuscript). ──\n  suggestions: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    suggestionId: v.string(),\n    versionId: v.string(),\n    personaId: v.string(),\n    personaName: v.string(),\n    color: v.string(),\n    blockId: v.string(),\n    original: v.string(),\n    replacement: v.string(),\n    rationale: v.string(),\n    kind: v.union(v.literal(\"sentence\"), v.literal(\"paragraph\")),\n    status: v.union(\n      v.literal(\"open\"),\n      v.literal(\"accepted\"),\n      v.literal(\"rejected\"),\n    ),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_suggestionId\", [\"userId\", \"suggestionId\"]),\n\n  // ── Room settings (tunable assistance) — one per user, latest wins. ──\n  roomSettings: defineTable({\n    userId: v.string(),\n    settings: v.any(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Appearance (theme) — one per user, latest wins.\n  // Its own table rather than a key inside `roomSettings`: that record is\n  // written whole by the personas panel, which knows nothing about themes\n  // and would drop the key on every assistance change. `updatedAt` is what\n  // decides a local-vs-remote conflict when a second device signs in. ──\n  appearance: defineTable({\n    userId: v.string(),\n    preset: v.string(),\n    // Token id -> `#rrggbb`. Validated client-side before it is written into\n    // a CSS custom property; stored loosely so adding a themeable token\n    // later needs no migration.\n    custom: v.optional(v.record(v.string(), v.string())),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Lix snapshots (existing). ──\n  lixBlobs: defineTable({\n    userId: v.string(),\n    blob: v.bytes(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Writer bibliographies — saved sources synced with folio state. ──\n  bibliographies: defineTable({\n    userId: v.string(),\n    entries: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Published pieces — public read-by-slug, owner-only writes. ──\n  // Each row is a snapshot of a folio at publish time. The slug is the\n  // ── Published pieces (post + blog). Same table — kind\n  // discriminates. The reader route is /<handle>/<slug> for writers who\n  // have claimed a handle, falling back to /p/[slug] for legacy links.\n  // The blog stream at /blog only shows \"blog\" pieces authored by an\n  // admin. The ownerId index is for the signed-in user's \"my pieces\"\n  // list; (kind, publishedAt) is for the public blog feed.\n  // `ownerHandle` is denormalized at publish time so the reader route\n  // can resolve without an extra hop; it's null until the owner has\n  // claimed a handle (legacy pieces backfill on next publish). ──\n  published: defineTable({\n    ownerId: v.string(),\n    ownerHandle: v.optional(v.string()),\n    slug: v.string(),\n    folioId: v.string(),\n    kind: v.union(v.literal(\"post\"), v.literal(\"blog\")),\n    title: v.string(),\n    authorName: v.optional(v.string()),\n    briefSummary: v.optional(v.string()),\n    content: v.string(), // sanitized HTML\n    publishedAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_slug\", [\"slug\"])\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerHandle_slug\", [\"ownerHandle\", \"slug\"])\n    .index(\"by_ownerHandle_kind_publishedAt\", [\n      \"ownerHandle\",\n      \"kind\",\n      \"publishedAt\",\n    ])\n    .index(\"by_kind_publishedAt\", [\"kind\", \"publishedAt\"]),\n\n  // ── Admin roster. One row per user who can publish to the\n  // public blog. The first admin bootstraps via\n  // `admins.bootstrap`; subsequent additions are gated on\n  // the caller already being an admin. ──\n  admins: defineTable({\n    userId: v.string(),\n    addedBy: v.optional(v.string()),\n    addedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Writer handles — one per user, claimed on first publish or from\n  // Settings. The handle is the public identity on share URLs\n  // (/<handle>/<slug>) and profile pages (/<handle>). Lowercase,\n  // slugified, validated in convex/profiles.ts. By-handle index is\n  // unique. ──\n  handles: defineTable({\n    userId: v.string(),\n    handle: v.string(),\n    displayName: v.optional(v.string()),\n    bio: v.optional(v.string()),\n    /** Convex storage id for the writer's profile picture, if set. */\n    avatarStorageId: v.optional(v.id(\"_storage\")),\n    publicStats: v.optional(\n      v.object({\n        writingHeatmap: v.boolean(),\n        daysWritten30: v.boolean(),\n        streak: v.union(\n          v.literal(\"off\"),\n          v.literal(\"current\"),\n          v.literal(\"longest\"),\n        ),\n        publicPieceCount: v.boolean(),\n        folioCount: v.boolean(),\n      }),\n    ),\n    claimedAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_handle\", [\"handle\"]),\n\n  // ── Writer-authored inline comments (margin notes, with threads). ──\n  // The CommentMark in the manuscript holds the id; the body, replies,\n  // and resolve state live here. Owner-only.\n  userComments: defineTable({\n    ownerId: v.string(),\n    commentId: v.string(),\n    folioId: v.string(),\n    text: v.string(),\n    author: v.string(),\n    anchor: v.optional(v.string()),\n    resolved: v.boolean(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_commentId\", [\"ownerId\", \"commentId\"]),\n\n  userCommentReplies: defineTable({\n    ownerId: v.string(),\n    replyId: v.string(),\n    commentId: v.string(),\n    author: v.string(),\n    text: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_commentId\", [\"ownerId\", \"commentId\"]),\n\n  // One-to-one identity bridge between a Better Auth product subject and the\n  // DID restored by Twyne's ATProto OAuth client. The mutation enforces both\n  // indexes as unique inside one Convex transaction.\n  providerIdentities: defineTable({\n    productSubject: v.string(),\n    did: v.string(),\n    verificationMethod: v.union(\n      v.literal(\"legacy_atproto_browser_oauth\"),\n      v.literal(\"notorganic_pkce\"),\n    ),\n    sessionVersion: v.number(),\n    verifiedAt: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_productSubject\", [\"productSubject\"])\n    .index(\"by_did\", [\"did\"]),\n\n  /* One row per pre–Not Organic account: when it was told about the move and\n   * when it was retired. Makes the notice send idempotent. */\n  legacyAccountNotices: defineTable({\n    userId: v.string(),\n    email: v.string(),\n    notifiedAt: v.optional(v.number()),\n    retiredAt: v.optional(v.number()),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  accountDeletionJobs: defineTable({\n    ownerId: v.string(),\n    productSubject: v.string(),\n    email: v.optional(v.string()),\n    phase: v.number(),\n    deletedCount: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  /* ── Multiplayer: shared Lix documents ──\n   * When a Pro user shares a folio, its local Lix blob is promoted to a\n   * server-hosted instance. Collaborators open it with Lix sync enabled and\n   * `initSyncProcess` pushes/pulls change-sets through the /lsp/* relay. */\n\n  sharedLixBlobs: defineTable({\n    lixId: v.string(),\n    ownerId: v.string(),\n    folioId: v.string(),\n    folioName: v.string(),\n    storageId: v.id(\"_storage\"),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_ownerId\", [\"ownerId\"]),\n\n  // ── Push-serialization locks — one row per in-flight push. ──\n  // Prevents two concurrent /lsp/push-v1 requests from both reading the\n  // same base blob and the later write clobbering the earlier one.\n  // Stale locks (older than LIX_LOCK_TTL_MS) are reclaimed automatically.\n  lixLocks: defineTable({\n    lixId: v.string(),\n    lockedAt: v.number(),\n  }).index(\"by_lixId\", [\"lixId\"]),\n\n  collaborators: defineTable({\n    lixId: v.string(),\n    userId: v.string(),\n    role: v.union(\n      v.literal(\"owner\"),\n      v.literal(\"editor\"),\n      v.literal(\"commenter\"),\n    ),\n    status: v.union(\n      v.literal(\"pending\"),\n      v.literal(\"accepted\"),\n      v.literal(\"rejected\"),\n    ),\n    invitedBy: v.optional(v.string()),\n    invitedAt: v.number(),\n    acceptedAt: v.optional(v.number()),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_lixId_userId\", [\"lixId\", \"userId\"]),\n\n  presence: defineTable({\n    lixId: v.string(),\n    userId: v.string(),\n    displayName: v.string(),\n    email: v.optional(v.string()),\n    color: v.string(),\n    cursorPos: v.optional(v.number()),\n    selectionAnchor: v.optional(v.number()),\n    selectionHead: v.optional(v.number()),\n    lastSeenAt: v.number(),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_lixId_userId\", [\"lixId\", \"userId\"]),\n\n  // ── Mobile app waitlist — public, unauthenticated signups. ──\n  // One row per (email, platform); dedupe is enforced in convex/waitlist.ts\n  // via the index below rather than a unique constraint (Convex has none).\n  waitlist: defineTable({\n    email: v.string(),\n    platform: v.union(v.literal(\"ios\"), v.literal(\"android\")),\n    createdAt: v.number(),\n  }).index(\"by_email_platform\", [\"email\", \"platform\"]),\n\n  // ── Rate-limit buckets — one row per (action, identifier). ──\n  // Identifier is usually the user's Convex tokenIdentifier; for\n  // unauthed paths (OTP request) it's the email or IP. `count` is\n  // reset when `windowStart` is older than the action's window.\n  // See convex/lib/rateLimit.ts.\n  rateBuckets: defineTable({\n    action: v.string(),\n    identifier: v.string(),\n    count: v.number(),\n    windowStart: v.number(),\n  })\n    .index(\"by_action_identifier\", [\"action\", \"identifier\"])\n    .index(\"by_identifier\", [\"identifier\"]),\n  houses: defineTable({\n    userId: v.string(), name: v.string(), dossier: v.any(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n  houseCollections: defineTable({\n    userId: v.string(), collectionId: v.string(), name: v.string(), description: v.string(),\n    dossier: v.any(), createdAt: v.number(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_collectionId\", [\"userId\", \"collectionId\"]),\n  collectionMembers: defineTable({\n    userId: v.string(), collectionId: v.string(), folioId: v.string(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_collectionId\", [\"userId\", \"collectionId\"])\n    .index(\"by_userId_and_folioId\", [\"userId\", \"folioId\"]),\n  charterItems: defineTable({\n    userId: v.string(), itemId: v.string(),\n    scope: v.union(v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"folio\")),\n    ownerRef: v.string(), text: v.string(), severity: v.union(v.literal(\"must\"), v.literal(\"prefer\")),\n    kind: v.union(v.literal(\"length\"), v.literal(\"citation\"), v.literal(\"style\"), v.literal(\"voice\"), v.literal(\"other\")),\n    order: v.number(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_itemId\", [\"userId\", \"itemId\"]),\n  contextLedger: defineTable({\n    userId: v.string(), entryId: v.string(), at: v.number(),\n    layer: v.union(v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"folio\"), v.literal(\"amendment\"), v.literal(\"charter\")),\n    ownerRef: v.string(), field: v.optional(v.string()), from: v.optional(v.string()), to: v.optional(v.string()),\n    source: v.union(v.literal(\"interview\"), v.literal(\"refine\"), v.literal(\"amendment\"), v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"charter\"), v.literal(\"manual\"), v.literal(\"sync\")),\n    reason: v.optional(v.string()),\n  }).index(\"by_userId_and_at\", [\"userId\", \"at\"])\n    .index(\"by_userId_and_entryId\", [\"userId\", \"entryId\"]),\n});\n","exit_code":0,"duration":{"secs":0,"nanos":26311},"formatted_output":"import { defineSchema, defineTable } from \"convex/server\";\nimport { v } from \"convex/values\";\n\n/**\n * One item of a per-user collection.\n *\n * Three collections — folios, custom personas, bibliography entries — used to\n * live as an array inside a single document each. Every edit rewrote the whole\n * document, and the collection could never outgrow Convex's 1MB document cap.\n * These tables replace that arrangement with a row per item.\n *\n * The field and index names are deliberately identical across all three, so a\n * single accessor in `lib/collections.ts` can serve them and they cannot drift\n * apart. `item` stays `v.any()` for the same reason the arrays did: adding a\n * field to a folio should not need a migration.\n */\nconst collectionEntry = {\n  userId: v.string(),\n  /** The item's own id, as the client models it. Unique per user per table. */\n  itemId: v.string(),\n  item: v.any(),\n  /** Position in the collection, so the array round-trips in its own order. */\n  order: v.number(),\n  updatedAt: v.number(),\n};\n\nconst usageTokenFields = {\n  inputTokens: v.optional(v.number()),\n  outputTokens: v.optional(v.number()),\n  cacheReadTokens: v.optional(v.number()),\n  cacheWriteTokens: v.optional(v.number()),\n  reasoningTokens: v.optional(v.number()),\n  totalTokens: v.optional(v.number()),\n};\n\nconst usagePricingSnapshot = v.object({\n  source: v.string(),\n  version: v.string(),\n  currency: v.literal(\"USD\"),\n  inputMicrousdPerMillion: v.number(),\n  outputMicrousdPerMillion: v.number(),\n  cacheReadMicrousdPerMillion: v.optional(v.number()),\n  cacheWriteMicrousdPerMillion: v.optional(v.number()),\n  reasoningMicrousdPerMillion: v.optional(v.number()),\n  longContextThresholdTokens: v.optional(v.number()),\n  longInputMicrousdPerMillion: v.optional(v.number()),\n  longOutputMicrousdPerMillion: v.optional(v.number()),\n});\n\nconst usageMetricFields = {\n  generations: v.number(),\n  completedGenerations: v.number(),\n  failedGenerations: v.number(),\n  logicalActions: v.number(),\n  completedActions: v.number(),\n  failedActions: v.number(),\n  actualCostMicrousd: v.number(),\n  estimatedCostMicrousd: v.number(),\n  localGenerations: v.number(),\n  unknownCostGenerations: v.number(),\n  creditMicrounits: v.number(),\n  inputTokens: v.number(),\n  outputTokens: v.number(),\n  cacheReadTokens: v.number(),\n  cacheWriteTokens: v.number(),\n  reasoningTokens: v.number(),\n  totalTokens: v.number(),\n  inputTokensReported: v.number(),\n  outputTokensReported: v.number(),\n  cacheReadTokensReported: v.number(),\n  cacheWriteTokensReported: v.number(),\n  reasoningTokensReported: v.number(),\n  totalTokensReported: v.number(),\n  inputTokensMissing: v.number(),\n  outputTokensMissing: v.number(),\n  cacheReadTokensMissing: v.number(),\n  cacheWriteTokensMissing: v.number(),\n  reasoningTokensMissing: v.number(),\n  totalTokensMissing: v.number(),\n  reportedTotalDiscrepancies: v.number(),\n};\n\nexport default defineSchema({\n  // Optimistic concurrency head for the bulk browser snapshot. Every push\n  // compares the revision it last pulled with this row before writing, so two\n  // open devices cannot silently ratify stale state over one another.\n  syncHeads: defineTable({\n    userId: v.string(),\n    revision: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  folioEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  personaEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  bibliographyEntries: defineTable(collectionEntry)\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_itemId\", [\"userId\", \"itemId\"]),\n\n  // ── Per-user state, synced from the browser on sign-up and on every change. ──\n  briefs: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    brief: v.any(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // Ephemeral per-turn output for the hosted dossier interview. Convex actions\n  // write cumulative reasoning/text snapshots here while the browser watches\n  // the authenticated query; the client removes the row when the turn settles.\n  dossierInterviewStreams: defineTable({\n    userId: v.string(),\n    streamId: v.string(),\n    text: v.string(),\n    reasoning: v.string(),\n    phase: v.union(v.literal(\"reasoning\"), v.literal(\"answer\")),\n    status: v.union(\n      v.literal(\"running\"),\n      v.literal(\"complete\"),\n      v.literal(\"error\"),\n    ),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_streamId\", [\"userId\", \"streamId\"])\n    // The browser clears its own rows when a turn settles. This is for the\n    // turns whose browser never came back — a closed tab, a lost connection —\n    // so the sweep can find them by age instead of scanning the table.\n    .index(\"by_updatedAt\", [\"updatedAt\"]),\n\n  // The same arrangement for hosted persona notes, keyed by persona so five\n  // editors can fill their own cards at once. Without this the server path\n  // delivered a note in one silent jump, which on a reasoning model means a\n  // blank card for as long as the model thinks.\n  personaNoteStreams: defineTable({\n    userId: v.string(),\n    streamId: v.string(),\n    personaId: v.string(),\n    text: v.string(),\n    reasoning: v.string(),\n    phase: v.union(v.literal(\"reasoning\"), v.literal(\"answer\")),\n    status: v.union(\n      v.literal(\"running\"),\n      v.literal(\"complete\"),\n      v.literal(\"error\"),\n    ),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_streamId\", [\"userId\", \"streamId\"])\n    .index(\"by_userId_streamId_personaId\", [\"userId\", \"streamId\", \"personaId\"])\n    .index(\"by_updatedAt\", [\"updatedAt\"]),\n\n  folios: defineTable({\n    userId: v.string(),\n    folios: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  folioContent: defineTable({\n    userId: v.string(),\n    folioId: v.string(),\n    html: v.string(),\n    format: v.optional(v.union(v.literal(\"html\"), v.literal(\"typst\"))),\n    typstSource: v.optional(v.string()),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // Personal tokens for the CLI and local MCP server. Only a SHA-256 digest\n  // is persisted; the clear-text token is returned once when it is created.\n  integrationTokens: defineTable({\n    userId: v.string(),\n    tokenHash: v.string(),\n    prefix: v.string(),\n    name: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_tokenHash\", [\"tokenHash\"]),\n\n  // Uploaded manuscript images. The editor stores the resolved URL in its\n  // document while this row preserves ownership and the underlying storage\n  // id so files can be looked up and deleted safely.\n  images: defineTable({\n    ownerId: v.string(),\n    folioId: v.string(),\n    storageId: v.id(\"_storage\"),\n    contentType: v.union(\n      v.literal(\"image/gif\"),\n      v.literal(\"image/jpeg\"),\n      v.literal(\"image/png\"),\n      v.literal(\"image/webp\"),\n    ),\n    size: v.number(),\n    createdAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_folioId\", [\"ownerId\", \"folioId\"])\n    .index(\"by_storageId\", [\"storageId\"]),\n\n  // ── Per-day writing activity, for the public \"days writing\" heatmap on\n  // the author profile page. Append-only-ish: one row per (userId, day),\n  // upserted as the user writes. ──\n  writingActivity: defineTable({\n    userId: v.string(),\n    day: v.string(),\n    count: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_day\", [\"userId\", \"day\"]),\n\n  writingActivityDetails: defineTable({\n    userId: v.string(),\n    day: v.string(),\n    folioId: v.string(),\n    count: v.number(),\n    firstOccurredAt: v.number(),\n    lastOccurredAt: v.number(),\n  })\n    .index(\"by_userId_and_day\", [\"userId\", \"day\"])\n    .index(\"by_userId_and_day_and_folioId\", [\"userId\", \"day\", \"folioId\"]),\n\n  // Content-free, append-only provider-attempt ledger for My Desk. Raw rows\n  // and every denormalized aggregate are updated in one mutation.\n  aiUsageEvents: defineTable({\n    ownerId: v.string(),\n    eventKey: v.string(),\n    occurredAt: v.number(),\n    day: v.string(),\n    source: v.union(v.literal(\"hosted\"), v.literal(\"byok\"), v.literal(\"local\")),\n    authority: v.union(\n      v.literal(\"server\"),\n      v.literal(\"provider\"),\n      v.literal(\"client_reported\"),\n    ),\n    feature: v.string(),\n    provider: v.string(),\n    model: v.string(),\n    folioId: v.optional(v.string()),\n    editorialActionId: v.optional(v.string()),\n    traceId: v.string(),\n    attempt: v.number(),\n    outcome: v.union(v.literal(\"completed\"), v.literal(\"failed\")),\n    ...usageTokenFields,\n    costMicrousd: v.optional(v.number()),\n    costKind: v.union(\n      v.literal(\"actual\"),\n      v.literal(\"estimated\"),\n      v.literal(\"local\"),\n      v.literal(\"unknown\"),\n    ),\n    pricingVersion: v.optional(v.string()),\n    pricing: v.optional(usagePricingSnapshot),\n    creditMicrounits: v.optional(v.number()),\n  })\n    .index(\"by_ownerId_and_eventKey\", [\"ownerId\", \"eventKey\"])\n    .index(\"by_ownerId_and_occurredAt\", [\"ownerId\", \"occurredAt\"])\n    .index(\"by_ownerId_and_editorialActionId_and_outcome\", [\n      \"ownerId\",\n      \"editorialActionId\",\n      \"outcome\",\n    ]),\n\n  aiUsageDailyTotals: defineTable({\n    ownerId: v.string(),\n    day: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId_and_day\", [\"ownerId\", \"day\"]),\n\n  aiUsageDailyBreakdowns: defineTable({\n    ownerId: v.string(),\n    day: v.string(),\n    dimension: v.union(\n      v.literal(\"feature\"),\n      v.literal(\"provider_model\"),\n      v.literal(\"folio\"),\n    ),\n    key: v.string(),\n    ...usageMetricFields,\n  })\n    .index(\"by_ownerId_and_dimension_and_day\", [\"ownerId\", \"dimension\", \"day\"])\n    .index(\"by_ownerId_and_day_and_dimension_and_key\", [\n      \"ownerId\",\n      \"day\",\n      \"dimension\",\n      \"key\",\n    ]),\n\n  aiUsageLifetimeTotals: defineTable({\n    ownerId: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  aiUsageLifetimeBreakdowns: defineTable({\n    ownerId: v.string(),\n    dimension: v.union(\n      v.literal(\"feature\"),\n      v.literal(\"provider_model\"),\n      v.literal(\"folio\"),\n    ),\n    key: v.string(),\n    ...usageMetricFields,\n  }).index(\"by_ownerId_and_dimension_and_key\", [\"ownerId\", \"dimension\", \"key\"]),\n\n  // Tombstone and resumable cursor for writer-requested synchronized usage\n  // deletion. Its presence is also the ingestion barrier for this owner.\n  aiUsageDeletionJobs: defineTable({\n    ownerId: v.string(),\n    phase: v.number(),\n    deletedCount: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  customPersonas: defineTable({\n    userId: v.string(),\n    personas: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Persona feedback notes — the room's marginalia, persisted per user. ──\n  // Stored server-side so a signed-in user can re-read their notes across\n  // devices. Brief is denormalized so the panel can render summaries cheaply.\n  personaNotes: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    noteId: v.string(),\n    personaId: v.string(),\n    personaName: v.string(),\n    personaColor: v.string(),\n    type: v.union(\n      v.literal(\"encouragement\"),\n      v.literal(\"suggestion\"),\n      v.literal(\"critique\"),\n      v.literal(\"perspective\"),\n    ),\n    feedback: v.string(),\n    traceId: v.optional(v.string()),\n    anchor: v.optional(v.string()),\n    briefTitle: v.optional(v.string()),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_noteId\", [\"userId\", \"noteId\"]),\n\n  // Trace-linked feedback is the durable review queue. Negative feedback is\n  // pending human review; positive feedback is retained for cohort analysis.\n  aiFeedback: defineTable({\n    userId: v.string(),\n    traceId: v.string(),\n    spanId: v.optional(v.string()),\n    feature: v.string(),\n    sentiment: v.union(v.literal(\"positive\"), v.literal(\"negative\")),\n    reason: v.optional(\n      v.union(\n        v.literal(\"grounding\"),\n        v.literal(\"usefulness\"),\n        v.literal(\"tone\"),\n        v.literal(\"incorrect\"),\n        v.literal(\"too_long\"),\n        v.literal(\"other\"),\n      ),\n    ),\n    comment: v.optional(v.string()),\n    folioId: v.optional(v.string()),\n    sessionId: v.optional(v.string()),\n    editorialActionId: v.optional(v.string()),\n    reviewStatus: v.union(\n      v.literal(\"not_required\"),\n      v.literal(\"pending\"),\n      v.literal(\"in_review\"),\n      v.literal(\"resolved\"),\n    ),\n    createdAt: v.number(),\n  })\n    .index(\"by_traceId\", [\"traceId\"])\n    .index(\"by_reviewStatus_createdAt\", [\"reviewStatus\", \"createdAt\"])\n    .index(\"by_userId_createdAt\", [\"userId\", \"createdAt\"]),\n\n  // ── Threaded replies to persona notes, optionally re-prompting the agent. ──\n  personaReplies: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    noteId: v.string(),\n    replyId: v.string(),\n    author: v.string(),\n    authorKind: v.union(v.literal(\"user\"), v.literal(\"persona\")),\n    personaId: v.optional(v.string()),\n    text: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_noteId\", [\"userId\", \"noteId\"]),\n\n  // ── Rubric results — one per folio; legacy rows may omit folioId. ──\n  rubricResults: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    result: v.any(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"]),\n\n  // ── Editorial change proposals (editors propose edits to the manuscript). ──\n  suggestions: defineTable({\n    userId: v.string(),\n    folioId: v.optional(v.string()),\n    suggestionId: v.string(),\n    versionId: v.string(),\n    personaId: v.string(),\n    personaName: v.string(),\n    color: v.string(),\n    blockId: v.string(),\n    original: v.string(),\n    replacement: v.string(),\n    rationale: v.string(),\n    kind: v.union(v.literal(\"sentence\"), v.literal(\"paragraph\")),\n    status: v.union(\n      v.literal(\"open\"),\n      v.literal(\"accepted\"),\n      v.literal(\"rejected\"),\n    ),\n    createdAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_folioId\", [\"userId\", \"folioId\"])\n    .index(\"by_userId_suggestionId\", [\"userId\", \"suggestionId\"]),\n\n  // ── Room settings (tunable assistance) — one per user, latest wins. ──\n  roomSettings: defineTable({\n    userId: v.string(),\n    settings: v.any(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Appearance (theme) — one per user, latest wins.\n  // Its own table rather than a key inside `roomSettings`: that record is\n  // written whole by the personas panel, which knows nothing about themes\n  // and would drop the key on every assistance change. `updatedAt` is what\n  // decides a local-vs-remote conflict when a second device signs in. ──\n  appearance: defineTable({\n    userId: v.string(),\n    preset: v.string(),\n    // Token id -> `#rrggbb`. Validated client-side before it is written into\n    // a CSS custom property; stored loosely so adding a themeable token\n    // later needs no migration.\n    custom: v.optional(v.record(v.string(), v.string())),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Lix snapshots (existing). ──\n  lixBlobs: defineTable({\n    userId: v.string(),\n    blob: v.bytes(),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Writer bibliographies — saved sources synced with folio state. ──\n  bibliographies: defineTable({\n    userId: v.string(),\n    entries: v.array(v.any()),\n    updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Published pieces — public read-by-slug, owner-only writes. ──\n  // Each row is a snapshot of a folio at publish time. The slug is the\n  // ── Published pieces (post + blog). Same table — kind\n  // discriminates. The reader route is /<handle>/<slug> for writers who\n  // have claimed a handle, falling back to /p/[slug] for legacy links.\n  // The blog stream at /blog only shows \"blog\" pieces authored by an\n  // admin. The ownerId index is for the signed-in user's \"my pieces\"\n  // list; (kind, publishedAt) is for the public blog feed.\n  // `ownerHandle` is denormalized at publish time so the reader route\n  // can resolve without an extra hop; it's null until the owner has\n  // claimed a handle (legacy pieces backfill on next publish). ──\n  published: defineTable({\n    ownerId: v.string(),\n    ownerHandle: v.optional(v.string()),\n    slug: v.string(),\n    folioId: v.string(),\n    kind: v.union(v.literal(\"post\"), v.literal(\"blog\")),\n    title: v.string(),\n    authorName: v.optional(v.string()),\n    briefSummary: v.optional(v.string()),\n    content: v.string(), // sanitized HTML\n    publishedAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_slug\", [\"slug\"])\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerHandle_slug\", [\"ownerHandle\", \"slug\"])\n    .index(\"by_ownerHandle_kind_publishedAt\", [\n      \"ownerHandle\",\n      \"kind\",\n      \"publishedAt\",\n    ])\n    .index(\"by_kind_publishedAt\", [\"kind\", \"publishedAt\"]),\n\n  // ── Admin roster. One row per user who can publish to the\n  // public blog. The first admin bootstraps via\n  // `admins.bootstrap`; subsequent additions are gated on\n  // the caller already being an admin. ──\n  admins: defineTable({\n    userId: v.string(),\n    addedBy: v.optional(v.string()),\n    addedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  // ── Writer handles — one per user, claimed on first publish or from\n  // Settings. The handle is the public identity on share URLs\n  // (/<handle>/<slug>) and profile pages (/<handle>). Lowercase,\n  // slugified, validated in convex/profiles.ts. By-handle index is\n  // unique. ──\n  handles: defineTable({\n    userId: v.string(),\n    handle: v.string(),\n    displayName: v.optional(v.string()),\n    bio: v.optional(v.string()),\n    /** Convex storage id for the writer's profile picture, if set. */\n    avatarStorageId: v.optional(v.id(\"_storage\")),\n    publicStats: v.optional(\n      v.object({\n        writingHeatmap: v.boolean(),\n        daysWritten30: v.boolean(),\n        streak: v.union(\n          v.literal(\"off\"),\n          v.literal(\"current\"),\n          v.literal(\"longest\"),\n        ),\n        publicPieceCount: v.boolean(),\n        folioCount: v.boolean(),\n      }),\n    ),\n    claimedAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_handle\", [\"handle\"]),\n\n  // ── Writer-authored inline comments (margin notes, with threads). ──\n  // The CommentMark in the manuscript holds the id; the body, replies,\n  // and resolve state live here. Owner-only.\n  userComments: defineTable({\n    ownerId: v.string(),\n    commentId: v.string(),\n    folioId: v.string(),\n    text: v.string(),\n    author: v.string(),\n    anchor: v.optional(v.string()),\n    resolved: v.boolean(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_commentId\", [\"ownerId\", \"commentId\"]),\n\n  userCommentReplies: defineTable({\n    ownerId: v.string(),\n    replyId: v.string(),\n    commentId: v.string(),\n    author: v.string(),\n    text: v.string(),\n    createdAt: v.number(),\n  })\n    .index(\"by_ownerId\", [\"ownerId\"])\n    .index(\"by_ownerId_commentId\", [\"ownerId\", \"commentId\"]),\n\n  // One-to-one identity bridge between a Better Auth product subject and the\n  // DID restored by Twyne's ATProto OAuth client. The mutation enforces both\n  // indexes as unique inside one Convex transaction.\n  providerIdentities: defineTable({\n    productSubject: v.string(),\n    did: v.string(),\n    verificationMethod: v.union(\n      v.literal(\"legacy_atproto_browser_oauth\"),\n      v.literal(\"notorganic_pkce\"),\n    ),\n    sessionVersion: v.number(),\n    verifiedAt: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_productSubject\", [\"productSubject\"])\n    .index(\"by_did\", [\"did\"]),\n\n  /* One row per pre–Not Organic account: when it was told about the move and\n   * when it was retired. Makes the notice send idempotent. */\n  legacyAccountNotices: defineTable({\n    userId: v.string(),\n    email: v.string(),\n    notifiedAt: v.optional(v.number()),\n    retiredAt: v.optional(v.number()),\n  }).index(\"by_userId\", [\"userId\"]),\n\n  accountDeletionJobs: defineTable({\n    ownerId: v.string(),\n    productSubject: v.string(),\n    email: v.optional(v.string()),\n    phase: v.number(),\n    deletedCount: v.number(),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  }).index(\"by_ownerId\", [\"ownerId\"]),\n\n  /* ── Multiplayer: shared Lix documents ──\n   * When a Pro user shares a folio, its local Lix blob is promoted to a\n   * server-hosted instance. Collaborators open it with Lix sync enabled and\n   * `initSyncProcess` pushes/pulls change-sets through the /lsp/* relay. */\n\n  sharedLixBlobs: defineTable({\n    lixId: v.string(),\n    ownerId: v.string(),\n    folioId: v.string(),\n    folioName: v.string(),\n    storageId: v.id(\"_storage\"),\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_ownerId\", [\"ownerId\"]),\n\n  // ── Push-serialization locks — one row per in-flight push. ──\n  // Prevents two concurrent /lsp/push-v1 requests from both reading the\n  // same base blob and the later write clobbering the earlier one.\n  // Stale locks (older than LIX_LOCK_TTL_MS) are reclaimed automatically.\n  lixLocks: defineTable({\n    lixId: v.string(),\n    lockedAt: v.number(),\n  }).index(\"by_lixId\", [\"lixId\"]),\n\n  collaborators: defineTable({\n    lixId: v.string(),\n    userId: v.string(),\n    role: v.union(\n      v.literal(\"owner\"),\n      v.literal(\"editor\"),\n      v.literal(\"commenter\"),\n    ),\n    status: v.union(\n      v.literal(\"pending\"),\n      v.literal(\"accepted\"),\n      v.literal(\"rejected\"),\n    ),\n    invitedBy: v.optional(v.string()),\n    invitedAt: v.number(),\n    acceptedAt: v.optional(v.number()),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_lixId_userId\", [\"lixId\", \"userId\"]),\n\n  presence: defineTable({\n    lixId: v.string(),\n    userId: v.string(),\n    displayName: v.string(),\n    email: v.optional(v.string()),\n    color: v.string(),\n    cursorPos: v.optional(v.number()),\n    selectionAnchor: v.optional(v.number()),\n    selectionHead: v.optional(v.number()),\n    lastSeenAt: v.number(),\n  })\n    .index(\"by_lixId\", [\"lixId\"])\n    .index(\"by_userId\", [\"userId\"])\n    .index(\"by_lixId_userId\", [\"lixId\", \"userId\"]),\n\n  // ── Mobile app waitlist — public, unauthenticated signups. ──\n  // One row per (email, platform); dedupe is enforced in convex/waitlist.ts\n  // via the index below rather than a unique constraint (Convex has none).\n  waitlist: defineTable({\n    email: v.string(),\n    platform: v.union(v.literal(\"ios\"), v.literal(\"android\")),\n    createdAt: v.number(),\n  }).index(\"by_email_platform\", [\"email\", \"platform\"]),\n\n  // ── Rate-limit buckets — one row per (action, identifier). ──\n  // Identifier is usually the user's Convex tokenIdentifier; for\n  // unauthed paths (OTP request) it's the email or IP. `count` is\n  // reset when `windowStart` is older than the action's window.\n  // See convex/lib/rateLimit.ts.\n  rateBuckets: defineTable({\n    action: v.string(),\n    identifier: v.string(),\n    count: v.number(),\n    windowStart: v.number(),\n  })\n    .index(\"by_action_identifier\", [\"action\", \"identifier\"])\n    .index(\"by_identifier\", [\"identifier\"]),\n  houses: defineTable({\n    userId: v.string(), name: v.string(), dossier: v.any(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"]),\n  houseCollections: defineTable({\n    userId: v.string(), collectionId: v.string(), name: v.string(), description: v.string(),\n    dossier: v.any(), createdAt: v.number(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_collectionId\", [\"userId\", \"collectionId\"]),\n  collectionMembers: defineTable({\n    userId: v.string(), collectionId: v.string(), folioId: v.string(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_collectionId\", [\"userId\", \"collectionId\"])\n    .index(\"by_userId_and_folioId\", [\"userId\", \"folioId\"]),\n  charterItems: defineTable({\n    userId: v.string(), itemId: v.string(),\n    scope: v.union(v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"folio\")),\n    ownerRef: v.string(), text: v.string(), severity: v.union(v.literal(\"must\"), v.literal(\"prefer\")),\n    kind: v.union(v.literal(\"length\"), v.literal(\"citation\"), v.literal(\"style\"), v.literal(\"voice\"), v.literal(\"other\")),\n    order: v.number(), updatedAt: v.number(),\n  }).index(\"by_userId\", [\"userId\"])\n    .index(\"by_userId_and_itemId\", [\"userId\", \"itemId\"]),\n  contextLedger: defineTable({\n    userId: v.string(), entryId: v.string(), at: v.number(),\n    layer: v.union(v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"folio\"), v.literal(\"amendment\"), v.literal(\"charter\")),\n    ownerRef: v.string(), field: v.optional(v.string()), from: v.optional(v.string()), to: v.optional(v.string()),\n    source: v.union(v.literal(\"interview\"), v.literal(\"refine\"), v.literal(\"amendment\"), v.literal(\"house\"), v.literal(\"collection\"), v.literal(\"charter\"), v.literal(\"manual\"), v.literal(\"sync\")),\n    reason: v.optional(v.string()),\n  }).index(\"by_userId_and_at\", [\"userId\", \"at\"])\n    .index(\"by_userId_and_entryId\", [\"userId\", \"entryId\"]),\n});\n"},"started_at_ms":1791213805988,"completed_at_ms":1791213805989}}
{"timestamp":"2026-10-05T15:23:26.089Z","ordinal":42064,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10ca9-a209-7200-9b0a-f8a911be59eb","call_id":"call_iZm8yAlFfTjjk54lQXX6xNnE","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"4692a6\",\"wall_time_seconds\":0.000026311,\"exit_code\":0,\"original_token_count\":6509,\"output\":\"import { defineSchema, defineTable } from \\\"convex/server\\\";\\nimport { v } from \\\"convex/values\\\";\\n\\n/**\\n * One item of a per-user collection.\\n *\\n * Three collections — folios, custom personas, bibliography entries — used to\\n * live as an array inside a single document each. Every edit rewrote the whole\\n * document, and the collection could never outgrow Convex's 1MB document cap.\\n * These tables replace that arrangement with a row per item.\\n *\\n * The field and index names are deliberately identical across all three, so a\\n * single accessor in `lib/collections.ts` can serve them and they cannot drift\\n * apart. `item` stays `v.any()` for the same reason the arrays did: adding a\\n * field to a folio should not need a migration.\\n */\\nconst collectionEntry = {\\n  userId: v.string(),\\n  /** The item's own id, as the client models it. Unique per user per table. */\\n  itemId: v.string(),\\n  item: v.any(),\\n  /** Position in the collection, so the array round-trips in its own order. */\\n  order: v.number(),\\n  updatedAt: v.number(),\\n};\\n\\nconst usageTokenFields = {\\n  inputTokens: v.optional(v.number()),\\n  outputTokens: v.optional(v.number()),\\n  cacheReadTokens: v.optional(v.number()),\\n  cacheWriteTokens: v.optional(v.number()),\\n  reasoningTokens: v.optional(v.number()),\\n  totalTokens: v.optional(v.number()),\\n};\\n\\nconst usagePricingSnapshot = v.object({\\n  source: v.string(),\\n  version: v.string(),\\n  currency: v.literal(\\\"USD\\\"),\\n  inputMicrousdPerMillion: v.number(),\\n  outputMicrousdPerMillion: v.number(),\\n  cacheReadMicrousdPerMillion: v.optional(v.number()),\\n  cacheWriteMicrousdPerMillion: v.optional(v.number()),\\n  reasoningMicrousdPerMillion: v.optional(v.number()),\\n  longContextThresholdTokens: v.optional(v.number()),\\n  longInputMicrousdPerMillion: v.optional(v.number()),\\n  longOutputMicrousdPerMillion: v.optional(v.number()),\\n});\\n\\nconst usageMetricFields = {\\n  generations: v.number(),\\n  completedGenerations: v.number(),\\n  failedGenerations: v.number(),\\n  logicalActions: v.number(),\\n  completedActions: v.number(),\\n  failedActions: v.number(),\\n  actualCostMicrousd: v.number(),\\n  estimatedCostMicrousd: v.number(),\\n  localGenerations: v.number(),\\n  unknownCostGenerations: v.number(),\\n  creditMicrounits: v.number(),\\n  inputTokens: v.number(),\\n  outputTokens: v.number(),\\n  cacheReadTokens: v.number(),\\n  cacheWriteTokens: v.number(),\\n  reasoningTokens: v.number(),\\n  totalTokens: v.number(),\\n  inputTokensReported: v.number(),\\n  outputTokensReported: v.number(),\\n  cacheReadTokensReported: v.number(),\\n  cacheWriteTokensReported: v.number(),\\n  reasoningTokensReported: v.number(),\\n  totalTokensReported: v.number(),\\n  inputTokensMissing: v.number(),\\n  outputTokensMissing: v.number(),\\n  cacheReadTokensMissing: v.number(),\\n  cacheWriteTokensMissing: v.number(),\\n  reasoningTokensMissing: v.number(),\\n  totalTokensMissing: v.number(),\\n  reportedTotalDiscrepancies: v.number(),\\n};\\n\\nexport default defineSchema({\\n  // Optimistic concurrency head for the bulk browser snapshot. Every push\\n  // compares the revision it last pulled with this row before writing, so two\\n  // open devices cannot silently ratify stale state over one another.\\n  syncHeads: defineTable({\\n    userId: v.string(),\\n    revision: v.number(),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  folioEntries: defineTable(collectionEntry)\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_itemId\\\", [\\\"userId\\\", \\\"itemId\\\"]),\\n\\n  personaEntries: defineTable(collectionEntry)\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_itemId\\\", [\\\"userId\\\", \\\"itemId\\\"]),\\n\\n  bibliographyEntries: defineTable(collectionEntry)\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_itemId\\\", [\\\"userId\\\", \\\"itemId\\\"]),\\n\\n  // ── Per-user state, synced from the browser on sign-up and on every change. ──\\n  briefs: defineTable({\\n    userId: v.string(),\\n    folioId: v.optional(v.string()),\\n    brief: v.any(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_folioId\\\", [\\\"userId\\\", \\\"folioId\\\"]),\\n\\n  // Ephemeral per-turn output for the hosted dossier interview. Convex actions\\n  // write cumulative reasoning/text snapshots here while the browser watches\\n  // the authenticated query; the client removes the row when the turn settles.\\n  dossierInterviewStreams: defineTable({\\n    userId: v.string(),\\n    streamId: v.string(),\\n    text: v.string(),\\n    reasoning: v.string(),\\n    phase: v.union(v.literal(\\\"reasoning\\\"), v.literal(\\\"answer\\\")),\\n    status: v.union(\\n      v.literal(\\\"running\\\"),\\n      v.literal(\\\"complete\\\"),\\n      v.literal(\\\"error\\\"),\\n    ),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_streamId\\\", [\\\"userId\\\", \\\"streamId\\\"])\\n    // The browser clears its own rows when a turn settles. This is for the\\n    // turns whose browser never came back — a closed tab, a lost connection —\\n    // so the sweep can find them by age instead of scanning the table.\\n    .index(\\\"by_updatedAt\\\", [\\\"updatedAt\\\"]),\\n\\n  // The same arrangement for hosted persona notes, keyed by persona so five\\n  // editors can fill their own cards at once. Without this the server path\\n  // delivered a note in one silent jump, which on a reasoning model means a\\n  // blank card for as long as the model thinks.\\n  personaNoteStreams: defineTable({\\n    userId: v.string(),\\n    streamId: v.string(),\\n    personaId: v.string(),\\n    text: v.string(),\\n    reasoning: v.string(),\\n    phase: v.union(v.literal(\\\"reasoning\\\"), v.literal(\\\"answer\\\")),\\n    status: v.union(\\n      v.literal(\\\"running\\\"),\\n      v.literal(\\\"complete\\\"),\\n      v.literal(\\\"error\\\"),\\n    ),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_streamId\\\", [\\\"userId\\\", \\\"streamId\\\"])\\n    .index(\\\"by_userId_streamId_personaId\\\", [\\\"userId\\\", \\\"streamId\\\", \\\"personaId\\\"])\\n    .index(\\\"by_updatedAt\\\", [\\\"updatedAt\\\"]),\\n\\n  folios: defineTable({\\n    userId: v.string(),\\n    folios: v.array(v.any()),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  folioContent: defineTable({\\n    userId: v.string(),\\n    folioId: v.string(),\\n    html: v.string(),\\n    format: v.optional(v.union(v.literal(\\\"html\\\"), v.literal(\\\"typst\\\"))),\\n    typstSource: v.optional(v.string()),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_folioId\\\", [\\\"userId\\\", \\\"folioId\\\"]),\\n\\n  // Personal tokens for the CLI and local MCP server. Only a SHA-256 digest\\n  // is persisted; the clear-text token is returned once when it is created.\\n  integrationTokens: defineTable({\\n    userId: v.string(),\\n    tokenHash: v.string(),\\n    prefix: v.string(),\\n    name: v.string(),\\n    createdAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_tokenHash\\\", [\\\"tokenHash\\\"]),\\n\\n  // Uploaded manuscript images. The editor stores the resolved URL in its\\n  // document while this row preserves ownership and the underlying storage\\n  // id so files can be looked up and deleted safely.\\n  images: defineTable({\\n    ownerId: v.string(),\\n    folioId: v.string(),\\n    storageId: v.id(\\\"_storage\\\"),\\n    contentType: v.union(\\n      v.literal(\\\"image/gif\\\"),\\n      v.literal(\\\"image/jpeg\\\"),\\n      v.literal(\\\"image/png\\\"),\\n      v.literal(\\\"image/webp\\\"),\\n    ),\\n    size: v.number(),\\n    createdAt: v.number(),\\n  })\\n    .index(\\\"by_ownerId\\\", [\\\"ownerId\\\"])\\n    .index(\\\"by_ownerId_folioId\\\", [\\\"ownerId\\\", \\\"folioId\\\"])\\n    .index(\\\"by_storageId\\\", [\\\"storageId\\\"]),\\n\\n  // ── Per-day writing activity, for the public \\\"days writing\\\" heatmap on\\n  // the author profile page. Append-only-ish: one row per (userId, day),\\n  // upserted as the user writes. ──\\n  writingActivity: defineTable({\\n    userId: v.string(),\\n    day: v.string(),\\n    count: v.number(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_day\\\", [\\\"userId\\\", \\\"day\\\"]),\\n\\n  writingActivityDetails: defineTable({\\n    userId: v.string(),\\n    day: v.string(),\\n    folioId: v.string(),\\n    count: v.number(),\\n    firstOccurredAt: v.number(),\\n    lastOccurredAt: v.number(),\\n  })\\n    .index(\\\"by_userId_and_day\\\", [\\\"userId\\\", \\\"day\\\"])\\n    .index(\\\"by_userId_and_day_and_folioId\\\", [\\\"userId\\\", \\\"day\\\", \\\"folioId\\\"]),\\n\\n  // Content-free, append-only provider-attempt ledger for My Desk. Raw rows\\n  // and every denormalized aggregate are updated in one mutation.\\n  aiUsageEvents: defineTable({\\n    ownerId: v.string(),\\n    eventKey: v.string(),\\n    occurredAt: v.number(),\\n    day: v.string(),\\n    source: v.union(v.literal(\\\"hosted\\\"), v.literal(\\\"byok\\\"), v.literal(\\\"local\\\")),\\n    authority: v.union(\\n      v.literal(\\\"server\\\"),\\n      v.literal(\\\"provider\\\"),\\n      v.literal(\\\"client_reported\\\"),\\n    ),\\n    feature: v.string(),\\n    provider: v.string(),\\n    model: v.string(),\\n    folioId: v.optional(v.string()),\\n    editorialActionId: v.optional(v.string()),\\n    traceId: v.string(),\\n    attempt: v.number(),\\n    outcome: v.union(v.literal(\\\"completed\\\"), v.literal(\\\"failed\\\")),\\n    ...usageTokenFields,\\n    costMicrousd: v.optional(v.number()),\\n    costKind: v.union(\\n      v.literal(\\\"actual\\\"),\\n      v.literal(\\\"estimated\\\"),\\n      v.literal(\\\"local\\\"),\\n      v.literal(\\\"unknown\\\"),\\n    ),\\n    pricingVersion: v.optional(v.string()),\\n    pricing: v.optional(usagePricingSnapshot),\\n    creditMicrounits: v.optional(v.number()),\\n  })\\n    .index(\\\"by_ownerId_and_eventKey\\\", [\\\"ownerId\\\", \\\"eventKey\\\"])\\n    .index(\\\"by_ownerId_and_occurredAt\\\", [\\\"ownerId\\\", \\\"occurredAt\\\"])\\n    .index(\\\"by_ownerId_and_editorialActionId_and_outcome\\\", [\\n      \\\"ownerId\\\",\\n      \\\"editorialActionId\\\",\\n      \\\"outcome\\\",\\n    ]),\\n\\n  aiUsageDailyTotals: defineTable({\\n    ownerId: v.string(),\\n    day: v.string(),\\n    ...usageMetricFields,\\n  }).index(\\\"by_ownerId_and_day\\\", [\\\"ownerId\\\", \\\"day\\\"]),\\n\\n  aiUsageDailyBreakdowns: defineTable({\\n    ownerId: v.string(),\\n    day: v.string(),\\n    dimension: v.union(\\n      v.literal(\\\"feature\\\"),\\n      v.literal(\\\"provider_model\\\"),\\n      v.literal(\\\"folio\\\"),\\n    ),\\n    key: v.string(),\\n    ...usageMetricFields,\\n  })\\n    .index(\\\"by_ownerId_and_dimension_and_day\\\", [\\\"ownerId\\\", \\\"dimension\\\", \\\"day\\\"])\\n    .index(\\\"by_ownerId_and_day_and_dimension_and_key\\\", [\\n      \\\"ownerId\\\",\\n      \\\"day\\\",\\n      \\\"dimension\\\",\\n      \\\"key\\\",\\n    ]),\\n\\n  aiUsageLifetimeTotals: defineTable({\\n    ownerId: v.string(),\\n    ...usageMetricFields,\\n  }).index(\\\"by_ownerId\\\", [\\\"ownerId\\\"]),\\n\\n  aiUsageLifetimeBreakdowns: defineTable({\\n    ownerId: v.string(),\\n    dimension: v.union(\\n      v.literal(\\\"feature\\\"),\\n      v.literal(\\\"provider_model\\\"),\\n      v.literal(\\\"folio\\\"),\\n    ),\\n    key: v.string(),\\n    ...usageMetricFields,\\n  }).index(\\\"by_ownerId_and_dimension_and_key\\\", [\\\"ownerId\\\", \\\"dimension\\\", \\\"key\\\"]),\\n\\n  // Tombstone and resumable cursor for writer-requested synchronized usage\\n  // deletion. Its presence is also the ingestion barrier for this owner.\\n  aiUsageDeletionJobs: defineTable({\\n    ownerId: v.string(),\\n    phase: v.number(),\\n    deletedCount: v.number(),\\n    createdAt: v.number(),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_ownerId\\\", [\\\"ownerId\\\"]),\\n\\n  customPersonas: defineTable({\\n    userId: v.string(),\\n    personas: v.array(v.any()),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  // ── Persona feedback notes — the room's marginalia, persisted per user. ──\\n  // Stored server-side so a signed-in user can re-read their notes across\\n  // devices. Brief is denormalized so the panel can render summaries cheaply.\\n  personaNotes: defineTable({\\n    userId: v.string(),\\n    folioId: v.optional(v.string()),\\n    noteId: v.string(),\\n    personaId: v.string(),\\n    personaName: v.string(),\\n    personaColor: v.string(),\\n    type: v.union(\\n      v.literal(\\\"encouragement\\\"),\\n      v.literal(\\\"suggestion\\\"),\\n      v.literal(\\\"critique\\\"),\\n      v.literal(\\\"perspective\\\"),\\n    ),\\n    feedback: v.string(),\\n    traceId: v.optional(v.string()),\\n    anchor: v.optional(v.string()),\\n    briefTitle: v.optional(v.string()),\\n    createdAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_folioId\\\", [\\\"userId\\\", \\\"folioId\\\"])\\n    .index(\\\"by_userId_noteId\\\", [\\\"userId\\\", \\\"noteId\\\"]),\\n\\n  // Trace-linked feedback is the durable review queue. Negative feedback is\\n  // pending human review; positive feedback is retained for cohort analysis.\\n  aiFeedback: defineTable({\\n    userId: v.string(),\\n    traceId: v.string(),\\n    spanId: v.optional(v.string()),\\n    feature: v.string(),\\n    sentiment: v.union(v.literal(\\\"positive\\\"), v.literal(\\\"negative\\\")),\\n    reason: v.optional(\\n      v.union(\\n        v.literal(\\\"grounding\\\"),\\n        v.literal(\\\"usefulness\\\"),\\n        v.literal(\\\"tone\\\"),\\n        v.literal(\\\"incorrect\\\"),\\n        v.literal(\\\"too_long\\\"),\\n        v.literal(\\\"other\\\"),\\n      ),\\n    ),\\n    comment: v.optional(v.string()),\\n    folioId: v.optional(v.string()),\\n    sessionId: v.optional(v.string()),\\n    editorialActionId: v.optional(v.string()),\\n    reviewStatus: v.union(\\n      v.literal(\\\"not_required\\\"),\\n      v.literal(\\\"pending\\\"),\\n      v.literal(\\\"in_review\\\"),\\n      v.literal(\\\"resolved\\\"),\\n    ),\\n    createdAt: v.number(),\\n  })\\n    .index(\\\"by_traceId\\\", [\\\"traceId\\\"])\\n    .index(\\\"by_reviewStatus_createdAt\\\", [\\\"reviewStatus\\\", \\\"createdAt\\\"])\\n    .index(\\\"by_userId_createdAt\\\", [\\\"userId\\\", \\\"createdAt\\\"]),\\n\\n  // ── Threaded replies to persona notes, optionally re-prompting the agent. ──\\n  personaReplies: defineTable({\\n    userId: v.string(),\\n    folioId: v.optional(v.string()),\\n    noteId: v.string(),\\n    replyId: v.string(),\\n    author: v.string(),\\n    authorKind: v.union(v.literal(\\\"user\\\"), v.literal(\\\"persona\\\")),\\n    personaId: v.optional(v.string()),\\n    text: v.string(),\\n    createdAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_folioId\\\", [\\\"userId\\\", \\\"folioId\\\"])\\n    .index(\\\"by_userId_noteId\\\", [\\\"userId\\\", \\\"noteId\\\"]),\\n\\n  // ── Rubric results — one per folio; legacy rows may omit folioId. ──\\n  rubricResults: defineTable({\\n    userId: v.string(),\\n    folioId: v.optional(v.string()),\\n    result: v.any(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_folioId\\\", [\\\"userId\\\", \\\"folioId\\\"]),\\n\\n  // ── Editorial change proposals (editors propose edits to the manuscript). ──\\n  suggestions: defineTable({\\n    userId: v.string(),\\n    folioId: v.optional(v.string()),\\n    suggestionId: v.string(),\\n    versionId: v.string(),\\n    personaId: v.string(),\\n    personaName: v.string(),\\n    color: v.string(),\\n    blockId: v.string(),\\n    original: v.string(),\\n    replacement: v.string(),\\n    rationale: v.string(),\\n    kind: v.union(v.literal(\\\"sentence\\\"), v.literal(\\\"paragraph\\\")),\\n    status: v.union(\\n      v.literal(\\\"open\\\"),\\n      v.literal(\\\"accepted\\\"),\\n      v.literal(\\\"rejected\\\"),\\n    ),\\n    createdAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_folioId\\\", [\\\"userId\\\", \\\"folioId\\\"])\\n    .index(\\\"by_userId_suggestionId\\\", [\\\"userId\\\", \\\"suggestionId\\\"]),\\n\\n  // ── Room settings (tunable assistance) — one per user, latest wins. ──\\n  roomSettings: defineTable({\\n    userId: v.string(),\\n    settings: v.any(),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  // ── Appearance (theme) — one per user, latest wins.\\n  // Its own table rather than a key inside `roomSettings`: that record is\\n  // written whole by the personas panel, which knows nothing about themes\\n  // and would drop the key on every assistance change. `updatedAt` is what\\n  // decides a local-vs-remote conflict when a second device signs in. ──\\n  appearance: defineTable({\\n    userId: v.string(),\\n    preset: v.string(),\\n    // Token id -> `#rrggbb`. Validated client-side before it is written into\\n    // a CSS custom property; stored loosely so adding a themeable token\\n    // later needs no migration.\\n    custom: v.optional(v.record(v.string(), v.string())),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  // ── Lix snapshots (existing). ──\\n  lixBlobs: defineTable({\\n    userId: v.string(),\\n    blob: v.bytes(),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  // ── Writer bibliographies — saved sources synced with folio state. ──\\n  bibliographies: defineTable({\\n    userId: v.string(),\\n    entries: v.array(v.any()),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  // ── Published pieces — public read-by-slug, owner-only writes. ──\\n  // Each row is a snapshot of a folio at publish time. The slug is the\\n  // ── Published pieces (post + blog). Same table — kind\\n  // discriminates. The reader route is /<handle>/<slug> for writers who\\n  // have claimed a handle, falling back to /p/[slug] for legacy links.\\n  // The blog stream at /blog only shows \\\"blog\\\" pieces authored by an\\n  // admin. The ownerId index is for the signed-in user's \\\"my pieces\\\"\\n  // list; (kind, publishedAt) is for the public blog feed.\\n  // `ownerHandle` is denormalized at publish time so the reader route\\n  // can resolve without an extra hop; it's null until the owner has\\n  // claimed a handle (legacy pieces backfill on next publish). ──\\n  published: defineTable({\\n    ownerId: v.string(),\\n    ownerHandle: v.optional(v.string()),\\n    slug: v.string(),\\n    folioId: v.string(),\\n    kind: v.union(v.literal(\\\"post\\\"), v.literal(\\\"blog\\\")),\\n    title: v.string(),\\n    authorName: v.optional(v.string()),\\n    briefSummary: v.optional(v.string()),\\n    content: v.string(), // sanitized HTML\\n    publishedAt: v.number(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_slug\\\", [\\\"slug\\\"])\\n    .index(\\\"by_ownerId\\\", [\\\"ownerId\\\"])\\n    .index(\\\"by_ownerHandle_slug\\\", [\\\"ownerHandle\\\", \\\"slug\\\"])\\n    .index(\\\"by_ownerHandle_kind_publishedAt\\\", [\\n      \\\"ownerHandle\\\",\\n      \\\"kind\\\",\\n      \\\"publishedAt\\\",\\n    ])\\n    .index(\\\"by_kind_publishedAt\\\", [\\\"kind\\\", \\\"publishedAt\\\"]),\\n\\n  // ── Admin roster. One row per user who can publish to the\\n  // public blog. The first admin bootstraps via\\n  // `admins.bootstrap`; subsequent additions are gated on\\n  // the caller already being an admin. ──\\n  admins: defineTable({\\n    userId: v.string(),\\n    addedBy: v.optional(v.string()),\\n    addedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  // ── Writer handles — one per user, claimed on first publish or from\\n  // Settings. The handle is the public identity on share URLs\\n  // (/<handle>/<slug>) and profile pages (/<handle>). Lowercase,\\n  // slugified, validated in convex/profiles.ts. By-handle index is\\n  // unique. ──\\n  handles: defineTable({\\n    userId: v.string(),\\n    handle: v.string(),\\n    displayName: v.optional(v.string()),\\n    bio: v.optional(v.string()),\\n    /** Convex storage id for the writer's profile picture, if set. */\\n    avatarStorageId: v.optional(v.id(\\\"_storage\\\")),\\n    publicStats: v.optional(\\n      v.object({\\n        writingHeatmap: v.boolean(),\\n        daysWritten30: v.boolean(),\\n        streak: v.union(\\n          v.literal(\\\"off\\\"),\\n          v.literal(\\\"current\\\"),\\n          v.literal(\\\"longest\\\"),\\n        ),\\n        publicPieceCount: v.boolean(),\\n        folioCount: v.boolean(),\\n      }),\\n    ),\\n    claimedAt: v.number(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_handle\\\", [\\\"handle\\\"]),\\n\\n  // ── Writer-authored inline comments (margin notes, with threads). ──\\n  // The CommentMark in the manuscript holds the id; the body, replies,\\n  // and resolve state live here. Owner-only.\\n  userComments: defineTable({\\n    ownerId: v.string(),\\n    commentId: v.string(),\\n    folioId: v.string(),\\n    text: v.string(),\\n    author: v.string(),\\n    anchor: v.optional(v.string()),\\n    resolved: v.boolean(),\\n    createdAt: v.number(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_ownerId\\\", [\\\"ownerId\\\"])\\n    .index(\\\"by_ownerId_commentId\\\", [\\\"ownerId\\\", \\\"commentId\\\"]),\\n\\n  userCommentReplies: defineTable({\\n    ownerId: v.string(),\\n    replyId: v.string(),\\n    commentId: v.string(),\\n    author: v.string(),\\n    text: v.string(),\\n    createdAt: v.number(),\\n  })\\n    .index(\\\"by_ownerId\\\", [\\\"ownerId\\\"])\\n    .index(\\\"by_ownerId_commentId\\\", [\\\"ownerId\\\", \\\"commentId\\\"]),\\n\\n  // One-to-one identity bridge between a Better Auth product subject and the\\n  // DID restored by Twyne's ATProto OAuth client. The mutation enforces both\\n  // indexes as unique inside one Convex transaction.\\n  providerIdentities: defineTable({\\n    productSubject: v.string(),\\n    did: v.string(),\\n    verificationMethod: v.union(\\n      v.literal(\\\"legacy_atproto_browser_oauth\\\"),\\n      v.literal(\\\"notorganic_pkce\\\"),\\n    ),\\n    sessionVersion: v.number(),\\n    verifiedAt: v.number(),\\n    createdAt: v.number(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_productSubject\\\", [\\\"productSubject\\\"])\\n    .index(\\\"by_did\\\", [\\\"did\\\"]),\\n\\n  /* One row per pre–Not Organic account: when it was told about the move and\\n   * when it was retired. Makes the notice send idempotent. */\\n  legacyAccountNotices: defineTable({\\n    userId: v.string(),\\n    email: v.string(),\\n    notifiedAt: v.optional(v.number()),\\n    retiredAt: v.optional(v.number()),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n\\n  accountDeletionJobs: defineTable({\\n    ownerId: v.string(),\\n    productSubject: v.string(),\\n    email: v.optional(v.string()),\\n    phase: v.number(),\\n    deletedCount: v.number(),\\n    createdAt: v.number(),\\n    updatedAt: v.number(),\\n  }).index(\\\"by_ownerId\\\", [\\\"ownerId\\\"]),\\n\\n  /* ── Multiplayer: shared Lix documents ──\\n   * When a Pro user shares a folio, its local Lix blob is promoted to a\\n   * server-hosted instance. Collaborators open it with Lix sync enabled and\\n   * `initSyncProcess` pushes/pulls change-sets through the /lsp/* relay. */\\n\\n  sharedLixBlobs: defineTable({\\n    lixId: v.string(),\\n    ownerId: v.string(),\\n    folioId: v.string(),\\n    folioName: v.string(),\\n    storageId: v.id(\\\"_storage\\\"),\\n    createdAt: v.number(),\\n    updatedAt: v.number(),\\n  })\\n    .index(\\\"by_lixId\\\", [\\\"lixId\\\"])\\n    .index(\\\"by_ownerId\\\", [\\\"ownerId\\\"]),\\n\\n  // ── Push-serialization locks — one row per in-flight push. ──\\n  // Prevents two concurrent /lsp/push-v1 requests from both reading the\\n  // same base blob and the later write clobbering the earlier one.\\n  // Stale locks (older than LIX_LOCK_TTL_MS) are reclaimed automatically.\\n  lixLocks: defineTable({\\n    lixId: v.string(),\\n    lockedAt: v.number(),\\n  }).index(\\\"by_lixId\\\", [\\\"lixId\\\"]),\\n\\n  collaborators: defineTable({\\n    lixId: v.string(),\\n    userId: v.string(),\\n    role: v.union(\\n      v.literal(\\\"owner\\\"),\\n      v.literal(\\\"editor\\\"),\\n      v.literal(\\\"commenter\\\"),\\n    ),\\n    status: v.union(\\n      v.literal(\\\"pending\\\"),\\n      v.literal(\\\"accepted\\\"),\\n      v.literal(\\\"rejected\\\"),\\n    ),\\n    invitedBy: v.optional(v.string()),\\n    invitedAt: v.number(),\\n    acceptedAt: v.optional(v.number()),\\n  })\\n    .index(\\\"by_lixId\\\", [\\\"lixId\\\"])\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_lixId_userId\\\", [\\\"lixId\\\", \\\"userId\\\"]),\\n\\n  presence: defineTable({\\n    lixId: v.string(),\\n    userId: v.string(),\\n    displayName: v.string(),\\n    email: v.optional(v.string()),\\n    color: v.string(),\\n    cursorPos: v.optional(v.number()),\\n    selectionAnchor: v.optional(v.number()),\\n    selectionHead: v.optional(v.number()),\\n    lastSeenAt: v.number(),\\n  })\\n    .index(\\\"by_lixId\\\", [\\\"lixId\\\"])\\n    .index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_lixId_userId\\\", [\\\"lixId\\\", \\\"userId\\\"]),\\n\\n  // ── Mobile app waitlist — public, unauthenticated signups. ──\\n  // One row per (email, platform); dedupe is enforced in convex/waitlist.ts\\n  // via the index below rather than a unique constraint (Convex has none).\\n  waitlist: defineTable({\\n    email: v.string(),\\n    platform: v.union(v.literal(\\\"ios\\\"), v.literal(\\\"android\\\")),\\n    createdAt: v.number(),\\n  }).index(\\\"by_email_platform\\\", [\\\"email\\\", \\\"platform\\\"]),\\n\\n  // ── Rate-limit buckets — one row per (action, identifier). ──\\n  // Identifier is usually the user's Convex tokenIdentifier; for\\n  // unauthed paths (OTP request) it's the email or IP. `count` is\\n  // reset when `windowStart` is older than the action's window.\\n  // See convex/lib/rateLimit.ts.\\n  rateBuckets: defineTable({\\n    action: v.string(),\\n    identifier: v.string(),\\n    count: v.number(),\\n    windowStart: v.number(),\\n  })\\n    .index(\\\"by_action_identifier\\\", [\\\"action\\\", \\\"identifier\\\"])\\n    .index(\\\"by_identifier\\\", [\\\"identifier\\\"]),\\n  houses: defineTable({\\n    userId: v.string(), name: v.string(), dossier: v.any(), updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"]),\\n  houseCollections: defineTable({\\n    userId: v.string(), collectionId: v.string(), name: v.string(), description: v.string(),\\n    dossier: v.any(), createdAt: v.number(), updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_and_collectionId\\\", [\\\"userId\\\", \\\"collectionId\\\"]),\\n  collectionMembers: defineTable({\\n    userId: v.string(), collectionId: v.string(), folioId: v.string(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_and_collectionId\\\", [\\\"userId\\\", \\\"collectionId\\\"])\\n    .index(\\\"by_userId_and_folioId\\\", [\\\"userId\\\", \\\"folioId\\\"]),\\n  charterItems: defineTable({\\n    userId: v.string(), itemId: v.string(),\\n    scope: v.union(v.literal(\\\"house\\\"), v.literal(\\\"collection\\\"), v.literal(\\\"folio\\\")),\\n    ownerRef: v.string(), text: v.string(), severity: v.union(v.literal(\\\"must\\\"), v.literal(\\\"prefer\\\")),\\n    kind: v.union(v.literal(\\\"length\\\"), v.literal(\\\"citation\\\"), v.literal(\\\"style\\\"), v.literal(\\\"voice\\\"), v.literal(\\\"other\\\")),\\n    order: v.number(), updatedAt: v.number(),\\n  }).index(\\\"by_userId\\\", [\\\"userId\\\"])\\n    .index(\\\"by_userId_and_itemId\\\", [\\\"userId\\\", \\\"itemId\\\"]),\\n  contextLedger: defineTable({\\n    userId: v.string(), entryId: v.string(), at: v.number(),\\n    layer: v.union(v.literal(\\\"house\\\"), v.literal(\\\"collection\\\"), v.literal(\\\"folio\\\"), v.literal(\\\"amendment\\\"), v.literal(\\\"charter\\\")),\\n    ownerRef: v.string(), field: v.optional(v.string()), from: v.optional(v.string()), to: v.optional(v.string()),\\n    source: v.union(v.literal(\\\"interview\\\"), v.literal(\\\"refine\\\"), v.literal(\\\"amendment\\\"), v.literal(\\\"house\\\"), v.literal(\\\"collection\\\"), v.literal(\\\"charter\\\"), v.literal(\\\"manual\\\"), v.literal(\\\"sync\\\")),\\n    reason: v.optional(v.string()),\\n  }).index(\\\"by_userId_and_at\\\", [\\\"userId\\\", \\\"at\\\"])\\n    .index(\\\"by_userId_and_entryId\\\", [\\\"userId\\\", \\\"entryId\\\"]),\\n});\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10ca3-f662-7822-9d58-47f08a989563","create_time":1791213806.0896435}},"metadata":{"client_authored":false,"f