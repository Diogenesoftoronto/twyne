w_size = self.ranges[i][new_index] as i64;\n            let end = start + old_size;\n            if pos_i <= end {\n                let side = if old_size == 0 {\n                    assoc_i\n                } else if pos_i == start {\n                    -1\n                } else if pos_i == end {\n                    1\n                } else {\n                    assoc_i\n                };\n                let result = start + diff + (if side < 0 { 0 } else { new_size });\n                let boundary = if assoc_neg { start } else { end };\n                let recover = if pos_i == boundary {\n                    None\n                } else {\n                    Some(make_recover(i / 3, (pos_i - start) as usize))\n                };\n                let mut del = if pos_i == start {\n                    DEL_AFTER\n                } else if pos_i == end {\n                    DEL_BEFORE\n                } else {\n                    DEL_ACROSS\n                };\n                let off_side = if assoc_neg { pos_i != start } else { pos_i != end };\n                if off_side {\n                    del |= DEL_SIDE;\n                }\n                return MapResult { pos: result as usize, del_info: del, recover };\n            }\n            diff += new_size - old_size;\n            i += 3;\n        }\n        MapResult { pos: (pos_i + diff) as usize, del_info: 0, recover: None }\n    }\n\n    pub fn touches(&self, pos: usize, token: u64) -> bool {\n        let pos_i = pos as i64;\n        let index = recover_index(token);\n        let old_index: usize = if self.inverted { 2 } else { 1 };\n        let new_index: usize = if self.inverted { 1 } else { 2 };\n        let mut diff: i64 = 0;\n        let len = self.ranges.len();\n        let mut i: usize = 0;\n        while i < len {\n            let start = self.ranges[i][0] as i64 - (if self.inverted { diff } else { 0 });\n            if start > pos_i {\n                break;\n            }\n            let old_size = self.ranges[i][old_index] as i64;\n            let end = start + old_size;\n            if pos_i <= end && i == index * 3 {\n                return true;\n            }\n            diff += self.ranges[i][new_index] as i64 - old_size;\n            i += 3;\n        }\n        false\n    }\n\n    pub fn changed_ranges(&self) -> Vec<[usize; 4]> {\n        let old_index: usize = if self.inverted { 2 } else { 1 };\n        let new_index: usize = if self.inverted { 1 } else { 2 };\n        let len = self.ranges.len();\n        let mut out: Vec<[usize; 4]> = Vec::with_capacity(len / 3);\n        let mut diff: i64 = 0;\n        let mut i: usize = 0;\n        while i < len {\n            let start = self.ranges[i][0] as i64;\n            let old_start = start - (if self.inverted { diff } else { 0 });\n            let new_start = start + (if self.inverted { 0 } else { diff });\n            let old_size = self.ranges[i][old_index] as i64;\n            let new_size = self.ranges[i][new_index] as i64;\n            out.push([\n                old_start as usize,\n                (old_start + old_size) as usize,\n                new_start as usize,\n                (new_start + new_size) as usize,\n            ]);\n            diff += new_size - old_size;\n            i += 3;\n        }\n        out\n    }\n}\n\n","exit_code":0,"duration":{"secs":0,"nanos":13221},"formatted_output":"use std::sync::Arc;\n\nconst LOWER16: u64 = 0xffff;\nconst FACTOR16: u64 = 1 << 16;\n\nconst DEL_BEFORE: u32 = 1;\nconst DEL_AFTER: u32 = 2;\nconst DEL_ACROSS: u32 = 4;\nconst DEL_SIDE: u32 = 8;\n\n#[inline]\nfn make_recover(index: usize, offset: usize) -> u64 {\n    index as u64 + offset as u64 * FACTOR16\n}\n\n#[inline]\nfn recover_index(value: u64) -> usize {\n    (value & LOWER16) as usize\n}\n\n#[inline]\nfn recover_offset(value: u64) -> u64 {\n    (value - (value & LOWER16)) / FACTOR16\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct MapResult {\n    pub pos: usize,\n    pub del_info: u32,\n    pub recover: Option<u64>,\n}\n\nimpl MapResult {\n    pub fn new(pos: usize, del_info: u32, recover: Option<u64>) -> Self {\n        MapResult { pos, del_info, recover }\n    }\n\n    pub fn deleted(&self) -> bool {\n        (self.del_info & DEL_SIDE) > 0\n    }\n\n    pub fn deleted_before(&self) -> bool {\n        (self.del_info & (DEL_BEFORE | DEL_ACROSS)) > 0\n    }\n\n    pub fn deleted_after(&self) -> bool {\n        (self.del_info & (DEL_AFTER | DEL_ACROSS)) > 0\n    }\n\n    pub fn deleted_across(&self) -> bool {\n        (self.del_info & DEL_ACROSS) > 0\n    }\n}\n\n#[derive(Debug, Clone)]\npub struct StepMap {\n    pub ranges: Arc<[[usize; 3]]>,\n    pub inverted: bool,\n}\n\nimpl StepMap {\n    pub fn new(ranges: Vec<[usize; 3]>) -> Self {\n        StepMap { ranges: Arc::from(ranges), inverted: false }\n    }\n\n    pub fn empty() -> Self {\n        StepMap { ranges: Arc::from(Vec::new()), inverted: false }\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.ranges.is_empty()\n    }\n\n    pub fn invert(&self) -> StepMap {\n        StepMap { ranges: Arc::clone(&self.ranges), inverted: !self.inverted }\n    }\n\n    pub fn recover(&self, token: u64) -> usize {\n        let index = recover_index(token);\n        let mut diff: i64 = 0;\n        if !self.inverted {\n            let mut j = 0;\n            while j < index {\n                diff += self.ranges[j][2] as i64 - self.ranges[j][1] as i64;\n                j += 1;\n            }\n        }\n        (self.ranges[index][0] as i64 + diff + recover_offset(token) as i64) as usize\n    }\n\n    pub fn map(&self, pos: usize, assoc: i32) -> usize {\n        self.map_result(pos, assoc).pos\n    }\n\n    pub fn map_result(&self, pos: usize, assoc: i32) -> MapResult {\n        let pos_i = pos as i64;\n        let assoc_i = assoc as i64;\n        let assoc_neg = assoc < 0;\n        let old_index: usize = if self.inverted { 2 } else { 1 };\n        let new_index: usize = if self.inverted { 1 } else { 2 };\n        let mut diff: i64 = 0;\n        let len = self.ranges.len();\n        let mut i: usize = 0;\n        while i < len {\n            let start = self.ranges[i][0] as i64 - (if self.inverted { diff } else { 0 });\n            if start > pos_i {\n                break;\n            }\n            let old_size = self.ranges[i][old_index] as i64;\n            let new_size = self.ranges[i][new_index] as i64;\n            let end = start + old_size;\n            if pos_i <= end {\n                let side = if old_size == 0 {\n                    assoc_i\n                } else if pos_i == start {\n                    -1\n                } else if pos_i == end {\n                    1\n                } else {\n                    assoc_i\n                };\n                let result = start + diff + (if side < 0 { 0 } else { new_size });\n                let boundary = if assoc_neg { start } else { end };\n                let recover = if pos_i == boundary {\n                    None\n                } else {\n                    Some(make_recover(i / 3, (pos_i - start) as usize))\n                };\n                let mut del = if pos_i == start {\n                    DEL_AFTER\n                } else if pos_i == end {\n                    DEL_BEFORE\n                } else {\n                    DEL_ACROSS\n                };\n                let off_side = if assoc_neg { pos_i != start } else { pos_i != end };\n                if off_side {\n                    del |= DEL_SIDE;\n                }\n                return MapResult { pos: result as usize, del_info: del, recover };\n            }\n            diff += new_size - old_size;\n            i += 3;\n        }\n        MapResult { pos: (pos_i + diff) as usize, del_info: 0, recover: None }\n    }\n\n    pub fn touches(&self, pos: usize, token: u64) -> bool {\n        let pos_i = pos as i64;\n        let index = recover_index(token);\n        let old_index: usize = if self.inverted { 2 } else { 1 };\n        let new_index: usize = if self.inverted { 1 } else { 2 };\n        let mut diff: i64 = 0;\n        let len = self.ranges.len();\n        let mut i: usize = 0;\n        while i < len {\n            let start = self.ranges[i][0] as i64 - (if self.inverted { diff } else { 0 });\n            if start > pos_i {\n                break;\n            }\n            let old_size = self.ranges[i][old_index] as i64;\n            let end = start + old_size;\n            if pos_i <= end && i == index * 3 {\n                return true;\n            }\n            diff += self.ranges[i][new_index] as i64 - old_size;\n            i += 3;\n        }\n        false\n    }\n\n    pub fn changed_ranges(&self) -> Vec<[usize; 4]> {\n        let old_index: usize = if self.inverted { 2 } else { 1 };\n        let new_index: usize = if self.inverted { 1 } else { 2 };\n        let len = self.ranges.len();\n        let mut out: Vec<[usize; 4]> = Vec::with_capacity(len / 3);\n        let mut diff: i64 = 0;\n        let mut i: usize = 0;\n        while i < len {\n            let start = self.ranges[i][0] as i64;\n            let old_start = start - (if self.inverted { diff } else { 0 });\n            let new_start = start + (if self.inverted { 0 } else { diff });\n            let old_size = self.ranges[i][old_index] as i64;\n            let new_size = self.ranges[i][new_index] as i64;\n            out.push([\n                old_start as usize,\n                (old_start + old_size) as usize,\n                new_start as usize,\n                (new_start + new_size) as usize,\n            ]);\n            diff += new_size - old_size;\n            i += 3;\n        }\n        out\n    }\n}\n\n"},"started_at_ms":1791210074472,"completed_at_ms":1791210074472}}
{"timestamp":"2026-10-05T14:21:14.551Z","ordinal":41399,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10c70-b1b7-7232-b743-3e3021f0069c","call_id":"call_fFO13WNSLT8GwTgMc9rTAAY8","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"{\"task\":0,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"2a192f\",\"wall_time_seconds\":0.000019846,\"exit_code\":0,\"original_token_count\":652,\"output\":\"//! CSS focus outlines painted around the existing native control geometry.\\n\\nuse gpui_kit::{\\n    AnyElement, App, BorderStyle, Bounds, Element, ElementId, FocusHandle, GlobalElementId,\\n    InspectorElementId, IntoElement, LayoutId, Pixels, Window, outline, px, rgb,\\n};\\n\\n/// Forward the real control's layout, input and accessibility subtree. The\\n/// outline takes no space and follows native keyboard focus rather than clicks.\\npub fn focus_outline(\\n    element: impl IntoElement,\\n    offset: f32,\\n    radius: f32,\\n    color: u32,\\n) -> AnyElement {\\n    FocusOutline {\\n        child: element.into_any_element(),\\n        offset,\\n        radius,\\n        color,\\n    }\\n    .into_any_element()\\n}\\n\\nstruct FocusOutline {\\n    child: AnyElement,\\n    offset: f32,\\n    radius: f32,\\n    color: u32,\\n}\\n\\nimpl IntoElement for FocusOutline {\\n    type Element = Self;\\n\\n    fn into_element(self) -> Self {\\n        self\\n    }\\n}\\n\\nimpl Element for FocusOutline {\\n    type RequestLayoutState = ();\\n    type PrepaintState = Option<FocusHandle>;\\n\\n    fn id(&self) -> Option<ElementId> {\\n        None\\n    }\\n\\n    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {\\n        None\\n    }\\n\\n    fn request_layout(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) -> (LayoutId, Self::RequestLayoutState) {\\n        (self.child.request_layout(window, cx), ())\\n    }\\n\\n    fn prepaint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        _: Bounds<Pixels>,\\n        _: &mut Self::RequestLayoutState,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) -> Self::PrepaintState {\\n        self.child.prepaint(window, cx)\\n    }\\n\\n    fn paint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        bounds: Bounds<Pixels>,\\n        _: &mut Self::RequestLayoutState,\\n        focus: &mut Self::PrepaintState,\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) {\\n        self.child.paint(window, cx);\\n        if window.last_input_was_keyboard()\\n            && focus.as_ref().is_some_and(|focus| focus.is_focused(window))\\n        {\\n            let extent = self.offset + 2.;\\n            window.paint_quad(\\n                outline(\\n                    bounds.dilate(px(extent)),\\n                    rgb(self.color),\\n                    BorderStyle::default(),\\n                )\\n                .border_widths(px(2.))\\n                .corner_radii(px((self.radius + extent).max(0.))),\\n            );\\n        }\\n    }\\n}\\n\"}}"},{"type":"input_text","text":"{\"task\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"d91fe9\",\"wall_time_seconds\":0.000029649,\"exit_code\":0,\"original_token_count\":1663,\"output\":\"use crate::{StateStyle, StyledExt as _, TestSupportExt as _};\\nuse gpui::{\\n    AnyElement, App, Div, ElementId, InteractiveElement, Interactivity, IntoElement, ParentElement,\\n    Refineable as _, RenderOnce, Role, SharedString, StatefulInteractiveElement, StyleRefinement,\\n    Styled, Window, div, prelude::FluentBuilder as _,\\n};\\n\\n/// What the input can offer to its context menu, at the moment it is opened.\\n///\\n/// Built by the input and read by the menu, the fields are private and reached\\n/// through the methods below, so that a new capability can be added without\\n/// breaking the menu builders.\\n///\\n/// ```\\n/// use gpui_base::input::InputContextMenuCapabilities;\\n///\\n/// let capabilities = InputContextMenuCapabilities::new()\\n///     .code_editor(true)\\n///     .selection(true);\\n///\\n/// assert!(capabilities.is_editable());\\n/// assert!(capabilities.has_selection());\\n/// ```\\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\\npub struct InputContextMenuCapabilities {\\n    disabled: bool,\\n    readonly: bool,\\n    code_editor: bool,\\n    selection: bool,\\n    masked: bool,\\n    go_to_definition: bool,\\n    code_actions: bool,\\n}\\n\\nimpl InputContextMenuCapabilities {\\n    pub fn new() -> Self {\\n        Self::default()\\n    }\\n\\n    pub fn disabled(mut self, disabled: bool) -> Self {\\n        self.disabled = disabled;\\n        self\\n    }\\n\\n    pub fn readonly(mut self, readonly: bool) -> Self {\\n        self.readonly = readonly;\\n        self\\n    }\\n\\n    pub fn code_editor(mut self, code_editor: bool) -> Self {\\n        self.code_editor = code_editor;\\n        self\\n    }\\n\\n    /// Set whether the input has a non-empty selection.\\n    pub fn selection(mut self, selection: bool) -> Self {\\n        self.selection = selection;\\n        self\\n    }\\n\\n    /// Set whether the input renders its value masked.\\n    pub fn masked(mut self, masked: bool) -> Self {\\n        self.masked = masked;\\n        self\\n    }\\n\\n    pub fn go_to_definition(mut self, go_to_definition: bool) -> Self {\\n        self.go_to_definition = go_to_definition;\\n        self\\n    }\\n\\n    pub fn code_actions(mut self, code_actions: bool) -> Self {\\n        self.code_actions = code_actions;\\n        self\\n    }\\n\\n    pub fn is_disabled(&self) -> bool {\\n        self.disabled\\n    }\\n\\n    pub fn is_readonly(&self) -> bool {\\n        self.readonly\\n    }\\n\\n    /// Returns true if the user is allowed to change the text.\\n    ///\\n    /// The items that write to the input (Cut, Paste, Code Actions) belong to\\n    /// this, the reading ones (Copy, Go to Definition) do not.\\n    pub fn is_editable(&self) -> bool {\\n        !self.disabled && !self.readonly\\n    }\\n\\n    pub fn is_code_editor(&self) -> bool {\\n        self.code_editor\\n    }\\n\\n    pub fn has_selection(&self) -> bool {\\n        self.selection\\n    }\\n\\n    pub fn is_masked(&self) -> bool {\\n        self.masked\\n    }\\n\\n    /// Returns true if the user is allowed to copy the text out.\\n    ///\\n    /// A masked input keeps its value out of the clipboard, so Copy and Cut\\n    /// are both unavailable while the value is hidden.\\n    pub fn is_copyable(&self) -> bool {\\n        self.selection && !self.masked\\n    }\\n\\n    pub fn has_definition(&self) -> bool {\\n        self.go_to_definition\\n    }\\n\\n    pub fn has_code_actions(&self) -> bool {\\n        self.code_actions\\n    }\\n}\\n\\n/// The foundational input frame.\\n///\\n/// It intentionally owns only input semantics, interaction forwarding, and\\n/// normal children. Applications remain responsible for all presentation.\\n#[derive(IntoElement)]\\npub struct InputBase {\\n    base: crate::ObservedElement<gpui::Stateful<Div>>,\\n    style: StyleRefinement,\\n    semantic_styles: InputStyles,\\n    children: Vec<AnyElement>,\\n    focused: bool,\\n    disabled: bool,\\n    role: crate::RoleOverride,\\n}\\n\\nimpl InputBase {\\n    pub fn new(id: impl Into<ElementId>) -> Self {\\n        Self {\\n            base: div().id(id).test_support(),\\n            style: StyleRefinement::default(),\\n            semantic_styles: InputStyles::default(),\\n            children: Vec::new(),\\n            focused: false,\\n            disabled: false,\\n            role: crate::RoleOverride::Implicit,\\n        }\\n    }\\n    pub fn role(mut self, role: impl Into<crate::RoleOverride>) -> Self {\\n        self.role = role.into();\\n        self\\n    }\\n\\n    pub fn focused(mut self, focused: bool) -> Self {\\n        self.focused = focused;\\n        self\\n    }\\n\\n    pub fn disabled(mut self, disabled: bool) -> Self {\\n        self.disabled = disabled;\\n        self\\n    }\\n\\n    pub fn styles(mut self, build: impl FnOnce(InputStyles) -> InputStyles) -> Self {\\n        self.semantic_styles = build(self.semantic_styles);\\n        self\\n    }\\n\\n    pub fn accessibility_label(mut self, label: impl Into<SharedString>) -> Self {\\n        self.base = self.base.aria_label(label.into());\\n        self\\n    }\\n\\n    fn resolved_style(&self) -> StyleRefinement {\\n        crate::state_style::resolve_style(\\n            &self.style,\\n            [\\n                self.focused.then_some(&self.semantic_styles.focused),\\n                self.disabled.then_some(&self.semantic_styles.disabled),\\n            ]\\n            .into_iter()\\n            .flatten(),\\n        )\\n    }\\n}\\n\\n#[derive(Default)]\\npub struct InputStyles {\\n    focused: StyleRefinement,\\n    disabled: StyleRefinement,\\n}\\n\\nimpl InputStyles {\\n    pub fn focused(mut self, build: impl FnOnce(StateStyle) -> StateStyle) -> Self {\\n        self.focused\\n            .refine(&build(StateStyle::default()).into_refinement());\\n        self\\n    }\\n\\n    pub fn disabled(mut self, build: impl FnOnce(StateStyle) -> StateStyle) -> Self {\\n        self.disabled\\n            .refine(&build(StateStyle::default()).into_refinement());\\n        self\\n    }\\n}\\n\\nimpl Styled for InputBase {\\n    fn style(&mut self) -> &mut StyleRefinement {\\n        &mut self.style\\n    }\\n}\\n\\nimpl ParentElement for InputBase {\\n    fn extend(&mut self, elements: impl IntoIterator<Item = AnyElement>) {\\n        self.children.extend(elements);\\n    }\\n}\\n\\nimpl InteractiveElement for InputBase {\\n    fn track_focus(mut self, focus: &gpui::FocusHandle) -> Self {\\n        self.base = self.base.track_focus(focus);\\n        self\\n    }\\n\\n    fn interactivity(&mut self) -> &mut Interactivity {\\n        self.base.interactivity()\\n    }\\n}\\n\\nimpl StatefulInteractiveElement for InputBase {}\\n\\nimpl RenderOnce for InputBase {\\n    fn render(self, _: &mut Window, _: &mut App) -> impl IntoElement {\\n        let style = self.resolved_style();\\n        self.base\\n            .when_some(self.role.resolve(|| Role::TextInput), |this, role| {\\n                this.role(role)\\n            })\\n            .children(self.children)\\n            .refine_style(&style)\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n\"}}"},{"type":"input_text","text":"{\"task\":2,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"82b4fe\",\"wall_time_seconds\":0.000015041,\"exit_code\":0,\"original_token_count\":606,\"output\":\"desktop/gpui/vendor/gpui-base/src/input/base/mod.rs:1:use crate::{StateStyle, StyledExt as _, TestSupportExt as _};\\ndesktop/gpui/vendor/gpui-pre/src/elements/div.rs:1320:    fn accessibility_id(mut self, id: impl Into<SharedString>) -> Self {\\ndesktop/gpui/vendor/gpui-pre/src/elements/div.rs:2724:                        window.paint_quad(crate::outline(\\ndesktop/gpui/vendor/gpui-pre/src/elements/div.rs:5248:    fn test_accessibility_id_builder_writes_author_id() {\\ndesktop/gpui/vendor/gpui-pre/src/elements/div.rs:5251:            .accessibility_id(\\\"settings.buffer-font-size\\\");\\ndesktop/gpui/vendor/gpui-base/src/lib.rs:173:pub use styled::{RoleOverride, StyledExt, box_shadow, h_flex, v_flex};\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:10:    Capslock, Context, Corners, CursorHideMode, CursorStyle, Decorations, DevicePixels,\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:4379:        corner_radii: Corners<Pixels>,\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:4415:        corner_radii: Corners<Pixels>,\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:4433:            let hole_corner_radii = Corners {\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:4501:    /// Use `Corners::clamp_radii_for_quad_size` if the radii should fit within the bounds.\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:4502:    pub fn paint_quad(&mut self, quad: PaintQuad) {\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:4875:        corner_radii: Corners<Pixels>,\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:7114:                self.paint_quad(crate::fill(hitbox.bounds, crate::rgba(0x61afef4d)));\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:7656:/// Passed as an argument [`Window::paint_quad`].\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:7662:    pub corner_radii: Corners<Pixels>,\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:7675:    pub fn corner_radii(self, corner_radii: impl Into<Corners<Pixels>>) -> Self {\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:7710:    corner_radii: impl Into<Corners<Pixels>>,\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:7727:pub fn fill(bounds: impl Into<Bounds<Pixels>>, background: impl Into<Background>) -> PaintQuad {\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:9471:                    window.paint_quad(fill(bounds, rgb(0xffffff)));\\ndesktop/gpui/vendor/gpui-pre/src/window.rs:9507:                    window.paint_quad(fill(bounds, rgb(0x0000ff)));\\ndesktop/gpui/src/chrome/focus_outline.rs:89:            window.paint_quad(\\n\"}}"},{"type":"input_text","text":"{\"task\":3,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"09d0cc\",\"wall_time_seconds\":0.000013221,\"exit_code\":0,\"original_token_count\":1531,\"output\":\"use std::sync::Arc;\\n\\nconst LOWER16: u64 = 0xffff;\\nconst FACTOR16: u64 = 1 << 16;\\n\\nconst DEL_BEFORE: u32 = 1;\\nconst DEL_AFTER: u32 = 2;\\nconst DEL_ACROSS: u32 = 4;\\nconst DEL_SIDE: u32 = 8;\\n\\n#[inline]\\nfn make_recover(index: usize, offset: usize) -> u64 {\\n    index as u64 + offset as u64 * FACTOR16\\n}\\n\\n#[inline]\\nfn recover_index(value: u64) -> usize {\\n    (value & LOWER16) as usize\\n}\\n\\n#[inline]\\nfn recover_offset(value: u64) -> u64 {\\n    (value - (value & LOWER16)) / FACTOR16\\n}\\n\\n#[derive(Debug, Clone, PartialEq, Eq)]\\npub struct MapResult {\\n    pub pos: usize,\\n    pub del_info: u32,\\n    pub recover: Option<u64>,\\n}\\n\\nimpl MapResult {\\n    pub fn new(pos: usize, del_info: u32, recover: Option<u64>) -> Self {\\n        MapResult { pos, del_info, recover }\\n    }\\n\\n    pub fn deleted(&self) -> bool {\\n        (self.del_info & DEL_SIDE) > 0\\n    }\\n\\n    pub fn deleted_before(&self) -> bool {\\n        (self.del_info & (DEL_BEFORE | DEL_ACROSS)) > 0\\n    }\\n\\n    pub fn deleted_after(&self) -> bool {\\n        (self.del_info & (DEL_AFTER | DEL_ACROSS)) > 0\\n    }\\n\\n    pub fn deleted_across(&self) -> bool {\\n        (self.del_info & DEL_ACROSS) > 0\\n    }\\n}\\n\\n#[derive(Debug, Clone)]\\npub struct StepMap {\\n    pub ranges: Arc<[[usize; 3]]>,\\n    pub inverted: bool,\\n}\\n\\nimpl StepMap {\\n    pub fn new(ranges: Vec<[usize; 3]>) -> Self {\\n        StepMap { ranges: Arc::from(ranges), inverted: false }\\n    }\\n\\n    pub fn empty() -> Self {\\n        StepMap { ranges: Arc::from(Vec::new()), inverted: false }\\n    }\\n\\n    pub fn is_empty(&self) -> bool {\\n        self.ranges.is_empty()\\n    }\\n\\n    pub fn invert(&self) -> StepMap {\\n        StepMap { ranges: Arc::clone(&self.ranges), inverted: !self.inverted }\\n    }\\n\\n    pub fn recover(&self, token: u64) -> usize {\\n        let index = recover_index(token);\\n        let mut diff: i64 = 0;\\n        if !self.inverted {\\n            let mut j = 0;\\n            while j < index {\\n                diff += self.ranges[j][2] as i64 - self.ranges[j][1] as i64;\\n                j += 1;\\n            }\\n        }\\n        (self.ranges[index][0] as i64 + diff + recover_offset(token) as i64) as usize\\n    }\\n\\n    pub fn map(&self, pos: usize, assoc: i32) -> usize {\\n        self.map_result(pos, assoc).pos\\n    }\\n\\n    pub fn map_result(&self, pos: usize, assoc: i32) -> MapResult {\\n        let pos_i = pos as i64;\\n        let assoc_i = assoc as i64;\\n        let assoc_neg = assoc < 0;\\n        let old_index: usize = if self.inverted { 2 } else { 1 };\\n        let new_index: usize = if self.inverted { 1 } else { 2 };\\n        let mut diff: i64 = 0;\\n        let len = self.ranges.len();\\n        let mut i: usize = 0;\\n        while i < len {\\n            let start = self.ranges[i][0] as i64 - (if self.inverted { diff } else { 0 });\\n            if start > pos_i {\\n                break;\\n            }\\n            let old_size = self.ranges[i][old_index] as i64;\\n            let new_size = self.ranges[i][new_index] as i64;\\n            let end = start + old_size;\\n            if pos_i <= end {\\n                let side = if old_size == 0 {\\n                    assoc_i\\n                } else if pos_i == start {\\n                    -1\\n                } else if pos_i == end {\\n                    1\\n                } else {\\n                    assoc_i\\n                };\\n                let result = start + diff + (if side < 0 { 0 } else { new_size });\\n                let boundary = if assoc_neg { start } else { end };\\n                let recover = if pos_i == boundary {\\n                    None\\n                } else {\\n                    Some(make_recover(i / 3, (pos_i - start) as usize))\\n                };\\n                let mut del = if pos_i == start {\\n                    DEL_AFTER\\n                } else if pos_i == end {\\n                    DEL_BEFORE\\n                } else {\\n                    DEL_ACROSS\\n                };\\n                let off_side = if assoc_neg { pos_i != start } else { pos_i != end };\\n                if off_side {\\n                    del |= DEL_SIDE;\\n                }\\n                return MapResult { pos: result as usize, del_info: del, recover };\\n            }\\n            diff += new_size - old_size;\\n            i += 3;\\n        }\\n        MapResult { pos: (pos_i + diff) as usize, del_info: 0, recover: None }\\n    }\\n\\n    pub fn touches(&self, pos: usize, token: u64) -> bool {\\n        let pos_i = pos as i64;\\n        let index = recover_index(token);\\n        let old_index: usize = if self.inverted { 2 } else { 1 };\\n        let new_index: usize = if self.inverted { 1 } else { 2 };\\n        let mut diff: i64 = 0;\\n        let len = self.ranges.len();\\n        let mut i: usize = 0;\\n        while i < len {\\n            let start = self.ranges[i][0] as i64 - (if self.inverted { diff } else { 0 });\\n            if start > pos_i {\\n                break;\\n            }\\n            let old_size = self.ranges[i][old_index] as i64;\\n            let end = start + old_size;\\n            if pos_i <= end && i == index * 3 {\\n                return true;\\n            }\\n            diff += self.ranges[i][new_index] as i64 - old_size;\\n            i += 3;\\n        }\\n        false\\n    }\\n\\n    pub fn changed_ranges(&self) -> Vec<[usize; 4]> {\\n        let old_index: usize = if self.inverted { 2 } else { 1 };\\n        let new_index: usize = if self.inverted { 1 } else { 2 };\\n        let len = self.ranges.len();\\n        let mut out: Vec<[usize; 4]> = Vec::with_capacity(len / 3);\\n        let mut diff: i64 = 0;\\n        let mut i: usize = 0;\\n        while i < len {\\n            let start = self.ranges[i][0] as i64;\\n            let old_start = start - (if self.inverted { diff } else { 0 });\\n            let new_start = start + (if self.inverted { 0 } else { diff });\\n            let old_size = self.ranges[i][old_index] as i64;\\n            let new_size = self.ranges[i][new_index] as i64;\\n            out.push([\\n                old_start as usize,\\n                (old_start + old_size) as usize,\\n                new_start as usize,\\n                (new_start + new_size) as usize,\\n            ]);\\n            diff += new_size - old_size;\\n            i += 3;\\n        }\\n        out\\n    }\\n}\\n\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c6f-d724-7b02-bb99-7845fa255153","create_time":1791210074.5511765}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
