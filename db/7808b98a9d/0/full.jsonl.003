{"timestamp":"2026-10-05T19:28:29.485Z","ordinal":44712,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a10537-909f-77a3-96d8-dd07161f91ae","turn_id":"01a10d89-1468-7f62-b4ea-9863445ef047","item":{"type":"CommandExecution","id":"exec-5c8595ea-ebff-411d-a579-25275a6c9d7d","process_id":"89944","command":["/bin/bash","-lc","rtk proxy cat desktop/gpui/src/app/slash_coordinator.rs"],"cwd":"file:///home/diogenes/Projects/twyne","parsed_cmd":[{"type":"unknown","cmd":"rtk proxy cat desktop/gpui/src/app/slash_coordinator.rs"}],"source":"unified_exec_startup","status":"completed","stdout":"//! Small writing-room host for the independent insert_menu package.\n//! This owns editor identity/lifecycle; the package owns menu/forms/adapters.\nuse super::*;\nuse gpui_kit::{AnyElement, Bounds, Div, Pixels, Stateful, anchored, deferred, point};\nuse twyne_desktop::insert_menu::{\n    self, SlashQuery,\n    form::{FormEvent, InsertFormView},\n    parameters::{FormKind, Parameters},\n    view::{InsertMenuView, MenuEvent},\n};\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nstruct Target {\n    document: Uuid,\n    editor: gpui_kit::EntityId,\n    rich: bool,\n    revision: u64,\n    query: SlashQuery,\n}\n\n#[derive(Default)]\npub(super) struct InsertState {\n    menu: Option<Entity<InsertMenuView>>,\n    menu_subscription: Option<Subscription>,\n    menu_binding: u64,\n    target: Option<Target>,\n    dismissed: Option<Target>,\n    form: Option<Entity<InsertFormView>>,\n    form_subscription: Option<Subscription>,\n    form_target: Option<(Target, String)>,\n    form_scroll: ScrollHandle,\n    plain_revision: u64,\n    body_selection: std::ops::Range<usize>,\n}\n\nimpl WritingRoom {\n    #[cfg(feature = \"ui-tests\")]\n    pub(super) fn capture_insert_menu(\n        &mut self,\n        form: bool,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        self.desk.preferences.compositor_open = false;\n        self.desk.drawer_open = false;\n        let room = cx.weak_entity();\n        window.on_next_frame(move |window, cx| {\n            let _ = room.update(cx, |room, cx| {\n                if let Some(editor) = &room.rich {\n                    let end = editor.read(cx).document().text_len().saturating_sub(1);\n                    editor.update(cx, |editor, cx| {\n                        editor.set_selection(Selection::caret(end), cx).unwrap()\n                    });\n                    window.focus(&editor.read(cx).focus_handle(cx), cx);\n                } else {\n                    room.body.update(cx, |body, cx| {\n                        let end = body.value().trim_end_matches(['\\r', '\\n']).len();\n                        body.set_selected_range(end..end, cx);\n                        body.focus(window, cx);\n                    });\n                }\n                room.refresh_insert_menu(window, cx);\n                if form {\n                    room.choose_insert_command(\"insert.table\", window, cx);\n                }\n            });\n        });\n    }\n    fn insert_available(&self) -> bool {\n        !self.active_document().archived\n            && !self.reading\n            && !self.source_mode\n            && !(self.proof_mode && !self.split_view)\n            && !self.applying_source\n            && !self.standalone_route()\n            && self.dossier.is_none()\n            && self.source_session.as_ref().is_none_or(|s| !s.pending)\n    }\n    fn current_insert_target(\n        &self,\n        require_focus: bool,\n        window: &Window,\n        cx: &App,\n    ) -> Option<Target> {\n        if !self.insert_available() {\n            return None;\n        }\n        let (rich, identity, revision, query) = if let Some(editor) = &self.rich {\n            let identity = editor.entity_id();\n            let editor = editor.read(cx);\n            if editor.is_read_only()\n                || editor.is_composing()\n                || (require_focus && !editor.focus_handle(cx).is_focused(window))\n            {\n                return None;\n            }\n            (\n                true,\n                identity,\n                editor.revision(),\n                insert_menu::detect_rich(editor.document(), editor.selection())?,\n            )\n        } else {\n            let body = self.body.read(cx);\n            let selection = body.selected_range();\n            if selection.start != selection.end\n                || body.is_composing()\n                || (require_focus && !body.focus_handle(cx).is_focused(window))\n            {\n                return None;\n            }\n            let row = body.text().offset_to_point(selection.start).row;\n            let start = body.text().line_start_offset(row);\n            let mut query =\n                insert_menu::detect(&body.text().slice(start..selection.start).to_string())?;\n            query.range.start += start;\n            query.range.end += start;\n            (\n                false,\n                self.body.entity_id(),\n                self.insert.plain_revision,\n                query,\n            )\n        };\n        Some(Target {\n            document: self.active,\n            editor: identity,\n            rich,\n            revision,\n            query,\n        })\n    }\n    pub(super) fn insert_body_event(\n        &mut self,\n        event: &InputEvent,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        if matches!(event, InputEvent::Change) {\n            self.insert.plain_revision = self.insert.plain_revision.saturating_add(1);\n        }\n        self.refresh_insert_menu(window, cx);\n    }\n    pub(super) fn insert_body_selection_changed(\n        &mut self,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        let selection = self.body.read(cx).selected_range();\n        if selection != self.insert.body_selection {\n            self.insert.body_selection = selection;\n            self.refresh_insert_menu(window, cx);\n            self.reveal_caret_next_frame(window, cx);\n        }\n    }\n    pub(super) fn reset_insert_menu(&mut self) {\n        self.insert.menu_binding = self.insert.menu_binding.saturating_add(1);\n        self.insert.target = None;\n        self.insert.dismissed = None;\n        self.insert.form = None;\n        self.insert.form_subscription = None;\n        self.insert.form_target = None;\n    }\n    pub(super) fn refresh_insert_menu(&mut self, window: &mut Window, cx: &mut Context<Self>) {\n        if self.insert.form.is_some() {\n            return;\n        }\n        let target = self.current_insert_target(true, window, cx);\n        if self.insert.dismissed.as_ref() != target.as_ref() {\n            self.insert.dismissed = None;\n        }\n        let target = target.filter(|t| self.insert.dismissed.as_ref() != Some(t));\n        if let Some(target) = &target {\n            if let Some(menu) = &self.insert.menu {\n                menu.update(cx, |menu, cx| menu.set_query(&target.query.query, cx));\n            } else {\n                let menu = cx.new(|cx| InsertMenuView::new(&target.query.query, cx));\n                self.insert.menu_subscription =\n                    Some(\n                        cx.subscribe_in(&menu, window, |this, sender, event, window, cx| {\n                            if this.insert.menu.as_ref() != Some(sender) {\n                                return;\n                            }\n                            match event {\n                                MenuEvent::Choose { id, binding }\n                                    if *binding == this.insert.menu_binding =>\n                                {\n                                    this.choose_insert_command(id, window, cx)\n                                }\n                                MenuEvent::Dismiss { binding }\n                                    if *binding == this.insert.menu_binding =>\n                                {\n                                    this.dismiss_insert(false, window, cx)\n                                }\n                                _ => {}\n                            }\n                        }),\n                    );\n                self.insert.menu = Some(menu);\n            }\n        }\n        if self.insert.target != target {\n            self.insert.menu_binding = self.insert.menu_binding.saturating_add(1);\n            if let Some(menu) = &self.insert.menu {\n                menu.update(cx, |menu, cx| {\n                    menu.set_binding(self.insert.menu_binding, cx)\n                });\n            }\n            self.insert.target = target;\n            cx.notify();\n        }\n    }\n    pub(super) fn sync_insert_presence(&mut self, window: &mut Window, cx: &mut Context<Self>) {\n        if !self.insert_available() {\n            if self.insert.target.is_some() || self.insert.form.is_some() {\n                self.reset_insert_menu();\n            }\n            return;\n        }\n        if self.insert.form.is_none()\n            && self.insert.target.is_some()\n            && self.current_insert_target(true, window, cx) != self.insert.target\n        {\n            self.refresh_insert_menu(window, cx);\n        }\n    }\n    fn insert_anchor(&self, window: &Window, cx: &App) -> Option<Bounds<Pixels>> {\n        let bounds = if let Some(editor) = &self.rich {\n            editor.read(cx).caret_bounds()\n        } else {\n            self.body.read(cx).cursor_layout().map(|l| l.0)\n        }?;\n        let viewport = self.writing_scroll.bounds();\n        (bounds.bottom() > viewport.top()\n            && bounds.top() < viewport.bottom()\n            && bounds.top() < window.viewport_size().height)\n            .then_some(bounds)\n    }\n    fn dismiss_insert(&mut self, focus_editor: bool, window: &mut Window, cx: &mut Context<Self>) {\n        self.insert.dismissed = self\n            .insert\n            .target\n            .clone()\n            .or_else(|| self.insert.form_target.as_ref().map(|t| t.0.clone()));\n        self.insert.target = None;\n        self.insert.form = None;\n        self.insert.form_subscription = None;\n        self.insert.form_target = None;\n        if focus_editor {\n            self.focus_writing(window, cx);\n        }\n        cx.notify();\n    }\n    fn move_insert_selection(\n        &mut self,\n        direction: isize,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) -> bool {\n        self.refresh_insert_menu(window, cx);\n        if self.insert.target.is_none() {\n            return false;\n        }\n        let Some(menu) = &self.insert.menu else {\n            return false;\n        };\n        if !menu.read(cx).has_candidates() {\n            return false;\n        }\n        menu.update(cx, |menu, cx| menu.move_selection(direction, cx));\n        true\n    }\n    fn accept_insert_selection(&mut self, window: &mut Window, cx: &mut Context<Self>) -> bool {\n        self.refresh_insert_menu(window, cx);\n        if self.insert.target.is_none() {\n            return false;\n        }\n        let Some(id) = self\n            .insert\n            .menu\n            .as_ref()\n            .and_then(|m| m.read(cx).selected())\n        else {\n            return false;\n        };\n        self.choose_insert_command(id, window, cx);\n        true\n    }\n    fn choose_insert_command(&mut self, id: &str, window: &mut Window, cx: &mut Context<Self>) {\n        let Some(target) = self.insert.target.clone() else {\n            return;\n        };\n        // Resolve the actual caret/query at activation, never a previous render.\n        if self.current_insert_target(true, window, cx).as_ref() != Some(&target)\n            || !insert_menu::candidates(&target.query.query)\n                .iter()\n                .any(|r| r.command.id == id)\n        {\n            self.refresh_insert_menu(window, cx);\n            return;\n        }\n        if let Some(kind) = FormKind::for_command(id) {\n            let form = cx.new(|cx| InsertFormView::new(kind, window, cx));\n            self.insert.form_subscription =\n                Some(\n                    cx.subscribe_in(&form, window, |this, sender, event, window, cx| {\n                        if this.insert.form.as_ref() != Some(sender) {\n                            return;\n                        }\n                        match event {\n                            FormEvent::Cancel => this.dismiss_insert(true, window, cx),\n                            FormEvent::Insert(values) => {\n                                if let Some((target, id)) = this.insert.form_target.clone() {\n                                    this.commit_insert(target, &id, values, window, cx);\n                                }\n                            }\n                        }\n                    }),\n                );\n            self.insert.form_target = Some((target, id.to_owned()));\n            self.insert.target = None;\n            self.insert.form = Some(form);\n            cx.notify();\n        } else {\n            self.commit_insert(target, id, &Parameters::None, window, cx);\n        }\n    }\n    fn commit_insert(\n        &mut self,\n        target: Target,\n        id: &str,\n        values: &Parameters,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        if self.current_insert_target(false, window, cx).as_ref() != Some(&target) {\n            self.notice = Some(\"The insertion position has changed. Type / again.\".into());\n            self.dismiss_insert(true, window, cx);\n            return;\n        }\n        let result = if target.rich {\n            self.rich\n                .as_ref()\n                .unwrap()\n                .update(cx, |editor, cx| {\n                    editor.insert_from_slash(&target.query, target.revision, id, values, window, cx)\n                })\n                .map(|_| ())\n                .map_err(|e| e.to_string())\n        } else {\n            insert_menu::markdown::plan(&self.body.read(cx).value(), &target.query, id, values)\n                .map(|edit| {\n                    self.body.update(cx, |body, cx| {\n                        body.replace_range_with_selection(\n                            edit.range,\n                            edit.text,\n                            edit.selection,\n                            window,\n                            cx,\n                        )\n                    });\n                })\n                .map_err(str::to_owned)\n        };\n        match result {\n            Ok(()) => {\n                self.reset_insert_menu();\n                self.focus_writing(window, cx);\n                self.changed(window, cx);\n                self.reveal_caret_next_frame(window, cx);\n            }\n            Err(error) => {\n                self.notice = Some(error);\n                self.dismiss_insert(true, window, cx);\n            }\n        }\n        cx.notify();\n    }\n    pub(super) fn insert_key_handlers(\n        &self,\n        element: Stateful<Div>,\n        cx: &mut Context<Self>,\n    ) -> Stateful<Div> {\n        element\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::MoveUp, w, cx| {\n                    if this.move_insert_selection(-1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::MoveDown, w, cx| {\n                    if this.move_insert_selection(1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Up, w, cx| {\n                    if this.move_insert_selection(-1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Down, w, cx| {\n                    if this.move_insert_selection(1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::Enter, w, cx| {\n                    if this.accept_insert_selection(w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Enter, w, cx| {\n                    if this.accept_insert_selection(w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::Escape, w, cx| {\n                    if this.insert.target.is_some() || this.insert.form.is_some() {\n                        this.dismiss_insert(true, w, cx);\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(cx.listener(|this, _: &CloseCompositor, w, cx| {\n                if this.insert.target.is_some() || this.insert.form.is_some() {\n                    this.dismiss_insert(true, w, cx);\n                    cx.stop_propagation();\n                } else {\n                    cx.propagate();\n                }\n            }))\n    }\n    pub(super) fn insert_overlay(\n        &self,\n        window: &Window,\n        cx: &mut Context<Self>,\n    ) -> Option<AnyElement> {\n        let viewport = window.viewport_size();\n        if let Some(form) = &self.insert.form {\n            let left = (f32::from(viewport.width) / 2. - 160.).max(8.);\n            return Some(\n                deferred(\n                    anchored()\n                        .position(point(px(left), px(80.)))\n                        .snap_to_window_with_margin(px(8.))\n                        .child(\n                            div()\n                                .id(\"slash-insert-overlay\")\n                                .max_w(px((f32::from(viewport.width) - 16.).max(0.)))\n                                .max_h(px((f32::from(viewport.height) - 16.).max(0.)))\n                                .overflow_y_scroll()\n                                .track_scroll(&self.insert.form_scroll)\n                                .child(form.clone())\n                                .on_mouse_down_out(cx.listener(|this, _, window, cx| {\n                                    this.dismiss_insert(false, window, cx)\n                                })),\n                        ),\n                )\n                .priority(4)\n                .into_any_element(),\n            );\n        }\n        self.insert.target.as_ref()?;\n        let menu = self.insert.menu.as_ref()?;\n        let anchor = self.insert_anchor(window, cx)?;\n        let width = f32::from(viewport.width);\n        let height = f32::from(viewport.height);\n        let left = f32::from(anchor.left()).min(width - 288. - 8.).max(8.);\n        let below = (height - f32::from(anchor.bottom()) - 14.).max(0.);\n        let above = (f32::from(anchor.top()) - 14.).max(0.);\n        let use_above = below < 200. && above > below;\n        let available = if use_above { above } else { below };\n        let results_height = (available - 40.).clamp(0., 320.);\n        menu.update(cx, |menu, cx| menu.set_max_height(results_height, cx));\n        let top = if use_above {\n            f32::from(anchor.top()) - 6. - results_height - 36.\n        } else {\n            f32::from(anchor.bottom()) + 6.\n        };\n        Some(\n            deferred(\n                anchored()\n                    .position(point(px(left), px(top.max(8.))))\n                    .snap_to_window_with_margin(px(8.))\n                    .child(div().max_w(px((width - 16.).max(0.))).child(menu.clone())),\n            )\n            .priority(3)\n            .into_any_element(),\n        )\n    }\n}\n\n#[cfg(all(test, feature = \"ui-tests\"))]\n#[path = \"slash_tests.rs\"]\nmod tests;\n","stderr":"","aggregated_output":"//! Small writing-room host for the independent insert_menu package.\n//! This owns editor identity/lifecycle; the package owns menu/forms/adapters.\nuse super::*;\nuse gpui_kit::{AnyElement, Bounds, Div, Pixels, Stateful, anchored, deferred, point};\nuse twyne_desktop::insert_menu::{\n    self, SlashQuery,\n    form::{FormEvent, InsertFormView},\n    parameters::{FormKind, Parameters},\n    view::{InsertMenuView, MenuEvent},\n};\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nstruct Target {\n    document: Uuid,\n    editor: gpui_kit::EntityId,\n    rich: bool,\n    revision: u64,\n    query: SlashQuery,\n}\n\n#[derive(Default)]\npub(super) struct InsertState {\n    menu: Option<Entity<InsertMenuView>>,\n    menu_subscription: Option<Subscription>,\n    menu_binding: u64,\n    target: Option<Target>,\n    dismissed: Option<Target>,\n    form: Option<Entity<InsertFormView>>,\n    form_subscription: Option<Subscription>,\n    form_target: Option<(Target, String)>,\n    form_scroll: ScrollHandle,\n    plain_revision: u64,\n    body_selection: std::ops::Range<usize>,\n}\n\nimpl WritingRoom {\n    #[cfg(feature = \"ui-tests\")]\n    pub(super) fn capture_insert_menu(\n        &mut self,\n        form: bool,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        self.desk.preferences.compositor_open = false;\n        self.desk.drawer_open = false;\n        let room = cx.weak_entity();\n        window.on_next_frame(move |window, cx| {\n            let _ = room.update(cx, |room, cx| {\n                if let Some(editor) = &room.rich {\n                    let end = editor.read(cx).document().text_len().saturating_sub(1);\n                    editor.update(cx, |editor, cx| {\n                        editor.set_selection(Selection::caret(end), cx).unwrap()\n                    });\n                    window.focus(&editor.read(cx).focus_handle(cx), cx);\n                } else {\n                    room.body.update(cx, |body, cx| {\n                        let end = body.value().trim_end_matches(['\\r', '\\n']).len();\n                        body.set_selected_range(end..end, cx);\n                        body.focus(window, cx);\n                    });\n                }\n                room.refresh_insert_menu(window, cx);\n                if form {\n                    room.choose_insert_command(\"insert.table\", window, cx);\n                }\n            });\n        });\n    }\n    fn insert_available(&self) -> bool {\n        !self.active_document().archived\n            && !self.reading\n            && !self.source_mode\n            && !(self.proof_mode && !self.split_view)\n            && !self.applying_source\n            && !self.standalone_route()\n            && self.dossier.is_none()\n            && self.source_session.as_ref().is_none_or(|s| !s.pending)\n    }\n    fn current_insert_target(\n        &self,\n        require_focus: bool,\n        window: &Window,\n        cx: &App,\n    ) -> Option<Target> {\n        if !self.insert_available() {\n            return None;\n        }\n        let (rich, identity, revision, query) = if let Some(editor) = &self.rich {\n            let identity = editor.entity_id();\n            let editor = editor.read(cx);\n            if editor.is_read_only()\n                || editor.is_composing()\n                || (require_focus && !editor.focus_handle(cx).is_focused(window))\n            {\n                return None;\n            }\n            (\n                true,\n                identity,\n                editor.revision(),\n                insert_menu::detect_rich(editor.document(), editor.selection())?,\n            )\n        } else {\n            let body = self.body.read(cx);\n            let selection = body.selected_range();\n            if selection.start != selection.end\n                || body.is_composing()\n                || (require_focus && !body.focus_handle(cx).is_focused(window))\n            {\n                return None;\n            }\n            let row = body.text().offset_to_point(selection.start).row;\n            let start = body.text().line_start_offset(row);\n            let mut query =\n                insert_menu::detect(&body.text().slice(start..selection.start).to_string())?;\n            query.range.start += start;\n            query.range.end += start;\n            (\n                false,\n                self.body.entity_id(),\n                self.insert.plain_revision,\n                query,\n            )\n        };\n        Some(Target {\n            document: self.active,\n            editor: identity,\n            rich,\n            revision,\n            query,\n        })\n    }\n    pub(super) fn insert_body_event(\n        &mut self,\n        event: &InputEvent,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        if matches!(event, InputEvent::Change) {\n            self.insert.plain_revision = self.insert.plain_revision.saturating_add(1);\n        }\n        self.refresh_insert_menu(window, cx);\n    }\n    pub(super) fn insert_body_selection_changed(\n        &mut self,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        let selection = self.body.read(cx).selected_range();\n        if selection != self.insert.body_selection {\n            self.insert.body_selection = selection;\n            self.refresh_insert_menu(window, cx);\n            self.reveal_caret_next_frame(window, cx);\n        }\n    }\n    pub(super) fn reset_insert_menu(&mut self) {\n        self.insert.menu_binding = self.insert.menu_binding.saturating_add(1);\n        self.insert.target = None;\n        self.insert.dismissed = None;\n        self.insert.form = None;\n        self.insert.form_subscription = None;\n        self.insert.form_target = None;\n    }\n    pub(super) fn refresh_insert_menu(&mut self, window: &mut Window, cx: &mut Context<Self>) {\n        if self.insert.form.is_some() {\n            return;\n        }\n        let target = self.current_insert_target(true, window, cx);\n        if self.insert.dismissed.as_ref() != target.as_ref() {\n            self.insert.dismissed = None;\n        }\n        let target = target.filter(|t| self.insert.dismissed.as_ref() != Some(t));\n        if let Some(target) = &target {\n            if let Some(menu) = &self.insert.menu {\n                menu.update(cx, |menu, cx| menu.set_query(&target.query.query, cx));\n            } else {\n                let menu = cx.new(|cx| InsertMenuView::new(&target.query.query, cx));\n                self.insert.menu_subscription =\n                    Some(\n                        cx.subscribe_in(&menu, window, |this, sender, event, window, cx| {\n                            if this.insert.menu.as_ref() != Some(sender) {\n                                return;\n                            }\n                            match event {\n                                MenuEvent::Choose { id, binding }\n                                    if *binding == this.insert.menu_binding =>\n                                {\n                                    this.choose_insert_command(id, window, cx)\n                                }\n                                MenuEvent::Dismiss { binding }\n                                    if *binding == this.insert.menu_binding =>\n                                {\n                                    this.dismiss_insert(false, window, cx)\n                                }\n                                _ => {}\n                            }\n                        }),\n                    );\n                self.insert.menu = Some(menu);\n            }\n        }\n        if self.insert.target != target {\n            self.insert.menu_binding = self.insert.menu_binding.saturating_add(1);\n            if let Some(menu) = &self.insert.menu {\n                menu.update(cx, |menu, cx| {\n                    menu.set_binding(self.insert.menu_binding, cx)\n                });\n            }\n            self.insert.target = target;\n            cx.notify();\n        }\n    }\n    pub(super) fn sync_insert_presence(&mut self, window: &mut Window, cx: &mut Context<Self>) {\n        if !self.insert_available() {\n            if self.insert.target.is_some() || self.insert.form.is_some() {\n                self.reset_insert_menu();\n            }\n            return;\n        }\n        if self.insert.form.is_none()\n            && self.insert.target.is_some()\n            && self.current_insert_target(true, window, cx) != self.insert.target\n        {\n            self.refresh_insert_menu(window, cx);\n        }\n    }\n    fn insert_anchor(&self, window: &Window, cx: &App) -> Option<Bounds<Pixels>> {\n        let bounds = if let Some(editor) = &self.rich {\n            editor.read(cx).caret_bounds()\n        } else {\n            self.body.read(cx).cursor_layout().map(|l| l.0)\n        }?;\n        let viewport = self.writing_scroll.bounds();\n        (bounds.bottom() > viewport.top()\n            && bounds.top() < viewport.bottom()\n            && bounds.top() < window.viewport_size().height)\n            .then_some(bounds)\n    }\n    fn dismiss_insert(&mut self, focus_editor: bool, window: &mut Window, cx: &mut Context<Self>) {\n        self.insert.dismissed = self\n            .insert\n            .target\n            .clone()\n            .or_else(|| self.insert.form_target.as_ref().map(|t| t.0.clone()));\n        self.insert.target = None;\n        self.insert.form = None;\n        self.insert.form_subscription = None;\n        self.insert.form_target = None;\n        if focus_editor {\n            self.focus_writing(window, cx);\n        }\n        cx.notify();\n    }\n    fn move_insert_selection(\n        &mut self,\n        direction: isize,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) -> bool {\n        self.refresh_insert_menu(window, cx);\n        if self.insert.target.is_none() {\n            return false;\n        }\n        let Some(menu) = &self.insert.menu else {\n            return false;\n        };\n        if !menu.read(cx).has_candidates() {\n            return false;\n        }\n        menu.update(cx, |menu, cx| menu.move_selection(direction, cx));\n        true\n    }\n    fn accept_insert_selection(&mut self, window: &mut Window, cx: &mut Context<Self>) -> bool {\n        self.refresh_insert_menu(window, cx);\n        if self.insert.target.is_none() {\n            return false;\n        }\n        let Some(id) = self\n            .insert\n            .menu\n            .as_ref()\n            .and_then(|m| m.read(cx).selected())\n        else {\n            return false;\n        };\n        self.choose_insert_command(id, window, cx);\n        true\n    }\n    fn choose_insert_command(&mut self, id: &str, window: &mut Window, cx: &mut Context<Self>) {\n        let Some(target) = self.insert.target.clone() else {\n            return;\n        };\n        // Resolve the actual caret/query at activation, never a previous render.\n        if self.current_insert_target(true, window, cx).as_ref() != Some(&target)\n            || !insert_menu::candidates(&target.query.query)\n                .iter()\n                .any(|r| r.command.id == id)\n        {\n            self.refresh_insert_menu(window, cx);\n            return;\n        }\n        if let Some(kind) = FormKind::for_command(id) {\n            let form = cx.new(|cx| InsertFormView::new(kind, window, cx));\n            self.insert.form_subscription =\n                Some(\n                    cx.subscribe_in(&form, window, |this, sender, event, window, cx| {\n                        if this.insert.form.as_ref() != Some(sender) {\n                            return;\n                        }\n                        match event {\n                            FormEvent::Cancel => this.dismiss_insert(true, window, cx),\n                            FormEvent::Insert(values) => {\n                                if let Some((target, id)) = this.insert.form_target.clone() {\n                                    this.commit_insert(target, &id, values, window, cx);\n                                }\n                            }\n                        }\n                    }),\n                );\n            self.insert.form_target = Some((target, id.to_owned()));\n            self.insert.target = None;\n            self.insert.form = Some(form);\n            cx.notify();\n        } else {\n            self.commit_insert(target, id, &Parameters::None, window, cx);\n        }\n    }\n    fn commit_insert(\n        &mut self,\n        target: Target,\n        id: &str,\n        values: &Parameters,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        if self.current_insert_target(false, window, cx).as_ref() != Some(&target) {\n            self.notice = Some(\"The insertion position has changed. Type / again.\".into());\n            self.dismiss_insert(true, window, cx);\n            return;\n        }\n        let result = if target.rich {\n            self.rich\n                .as_ref()\n                .unwrap()\n                .update(cx, |editor, cx| {\n                    editor.insert_from_slash(&target.query, target.revision, id, values, window, cx)\n                })\n                .map(|_| ())\n                .map_err(|e| e.to_string())\n        } else {\n            insert_menu::markdown::plan(&self.body.read(cx).value(), &target.query, id, values)\n                .map(|edit| {\n                    self.body.update(cx, |body, cx| {\n                        body.replace_range_with_selection(\n                            edit.range,\n                            edit.text,\n                            edit.selection,\n                            window,\n                            cx,\n                        )\n                    });\n                })\n                .map_err(str::to_owned)\n        };\n        match result {\n            Ok(()) => {\n                self.reset_insert_menu();\n                self.focus_writing(window, cx);\n                self.changed(window, cx);\n                self.reveal_caret_next_frame(window, cx);\n            }\n            Err(error) => {\n                self.notice = Some(error);\n                self.dismiss_insert(true, window, cx);\n            }\n        }\n        cx.notify();\n    }\n    pub(super) fn insert_key_handlers(\n        &self,\n        element: Stateful<Div>,\n        cx: &mut Context<Self>,\n    ) -> Stateful<Div> {\n        element\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::MoveUp, w, cx| {\n                    if this.move_insert_selection(-1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::MoveDown, w, cx| {\n                    if this.move_insert_selection(1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Up, w, cx| {\n                    if this.move_insert_selection(-1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Down, w, cx| {\n                    if this.move_insert_selection(1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::Enter, w, cx| {\n                    if this.accept_insert_selection(w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Enter, w, cx| {\n                    if this.accept_insert_selection(w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::Escape, w, cx| {\n                    if this.insert.target.is_some() || this.insert.form.is_some() {\n                        this.dismiss_insert(true, w, cx);\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(cx.listener(|this, _: &CloseCompositor, w, cx| {\n                if this.insert.target.is_some() || this.insert.form.is_some() {\n                    this.dismiss_insert(true, w, cx);\n                    cx.stop_propagation();\n                } else {\n                    cx.propagate();\n                }\n            }))\n    }\n    pub(super) fn insert_overlay(\n        &self,\n        window: &Window,\n        cx: &mut Context<Self>,\n    ) -> Option<AnyElement> {\n        let viewport = window.viewport_size();\n        if let Some(form) = &self.insert.form {\n            let left = (f32::from(viewport.width) / 2. - 160.).max(8.);\n            return Some(\n                deferred(\n                    anchored()\n                        .position(point(px(left), px(80.)))\n                        .snap_to_window_with_margin(px(8.))\n                        .child(\n                            div()\n                                .id(\"slash-insert-overlay\")\n                                .max_w(px((f32::from(viewport.width) - 16.).max(0.)))\n                                .max_h(px((f32::from(viewport.height) - 16.).max(0.)))\n                                .overflow_y_scroll()\n                                .track_scroll(&self.insert.form_scroll)\n                                .child(form.clone())\n                                .on_mouse_down_out(cx.listener(|this, _, window, cx| {\n                                    this.dismiss_insert(false, window, cx)\n                                })),\n                        ),\n                )\n                .priority(4)\n                .into_any_element(),\n            );\n        }\n        self.insert.target.as_ref()?;\n        let menu = self.insert.menu.as_ref()?;\n        let anchor = self.insert_anchor(window, cx)?;\n        let width = f32::from(viewport.width);\n        let height = f32::from(viewport.height);\n        let left = f32::from(anchor.left()).min(width - 288. - 8.).max(8.);\n        let below = (height - f32::from(anchor.bottom()) - 14.).max(0.);\n        let above = (f32::from(anchor.top()) - 14.).max(0.);\n        let use_above = below < 200. && above > below;\n        let available = if use_above { above } else { below };\n        let results_height = (available - 40.).clamp(0., 320.);\n        menu.update(cx, |menu, cx| menu.set_max_height(results_height, cx));\n        let top = if use_above {\n            f32::from(anchor.top()) - 6. - results_height - 36.\n        } else {\n            f32::from(anchor.bottom()) + 6.\n        };\n        Some(\n            deferred(\n                anchored()\n                    .position(point(px(left), px(top.max(8.))))\n                    .snap_to_window_with_margin(px(8.))\n                    .child(div().max_w(px((width - 16.).max(0.))).child(menu.clone())),\n            )\n            .priority(3)\n            .into_any_element(),\n        )\n    }\n}\n\n#[cfg(all(test, feature = \"ui-tests\"))]\n#[path = \"slash_tests.rs\"]\nmod tests;\n","exit_code":0,"duration":{"secs":0,"nanos":14527},"formatted_output":"//! Small writing-room host for the independent insert_menu package.\n//! This owns editor identity/lifecycle; the package owns menu/forms/adapters.\nuse super::*;\nuse gpui_kit::{AnyElement, Bounds, Div, Pixels, Stateful, anchored, deferred, point};\nuse twyne_desktop::insert_menu::{\n    self, SlashQuery,\n    form::{FormEvent, InsertFormView},\n    parameters::{FormKind, Parameters},\n    view::{InsertMenuView, MenuEvent},\n};\n\n#[derive(Clone, Debug, PartialEq, Eq)]\nstruct Target {\n    document: Uuid,\n    editor: gpui_kit::EntityId,\n    rich: bool,\n    revision: u64,\n    query: SlashQuery,\n}\n\n#[derive(Default)]\npub(super) struct InsertState {\n    menu: Option<Entity<InsertMenuView>>,\n    menu_subscription: Option<Subscription>,\n    menu_binding: u64,\n    target: Option<Target>,\n    dismissed: Option<Target>,\n    form: Option<Entity<InsertFormView>>,\n    form_subscription: Option<Subscription>,\n    form_target: Option<(Target, String)>,\n    form_scroll: ScrollHandle,\n    plain_revision: u64,\n    body_selection: std::ops::Range<usize>,\n}\n\nimpl WritingRoom {\n    #[cfg(feature = \"ui-tests\")]\n    pub(super) fn capture_insert_menu(\n        &mut self,\n        form: bool,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        self.desk.preferences.compositor_open = false;\n        self.desk.drawer_open = false;\n        let room = cx.weak_entity();\n        window.on_next_frame(move |window, cx| {\n            let _ = room.update(cx, |room, cx| {\n                if let Some(editor) = &room.rich {\n                    let end = editor.read(cx).document().text_len().saturating_sub(1);\n                    editor.update(cx, |editor, cx| {\n                        editor.set_selection(Selection::caret(end), cx).unwrap()\n                    });\n                    window.focus(&editor.read(cx).focus_handle(cx), cx);\n                } else {\n                    room.body.update(cx, |body, cx| {\n                        let end = body.value().trim_end_matches(['\\r', '\\n']).len();\n                        body.set_selected_range(end..end, cx);\n                        body.focus(window, cx);\n                    });\n                }\n                room.refresh_insert_menu(window, cx);\n                if form {\n                    room.choose_insert_command(\"insert.table\", window, cx);\n                }\n            });\n        });\n    }\n    fn insert_available(&self) -> bool {\n        !self.active_document().archived\n            && !self.reading\n            && !self.source_mode\n            && !(self.proof_mode && !self.split_view)\n            && !self.applying_source\n            && !self.standalone_route()\n            && self.dossier.is_none()\n            && self.source_session.as_ref().is_none_or(|s| !s.pending)\n    }\n    fn current_insert_target(\n        &self,\n        require_focus: bool,\n        window: &Window,\n        cx: &App,\n    ) -> Option<Target> {\n        if !self.insert_available() {\n            return None;\n        }\n        let (rich, identity, revision, query) = if let Some(editor) = &self.rich {\n            let identity = editor.entity_id();\n            let editor = editor.read(cx);\n            if editor.is_read_only()\n                || editor.is_composing()\n                || (require_focus && !editor.focus_handle(cx).is_focused(window))\n            {\n                return None;\n            }\n            (\n                true,\n                identity,\n                editor.revision(),\n                insert_menu::detect_rich(editor.document(), editor.selection())?,\n            )\n        } else {\n            let body = self.body.read(cx);\n            let selection = body.selected_range();\n            if selection.start != selection.end\n                || body.is_composing()\n                || (require_focus && !body.focus_handle(cx).is_focused(window))\n            {\n                return None;\n            }\n            let row = body.text().offset_to_point(selection.start).row;\n            let start = body.text().line_start_offset(row);\n            let mut query =\n                insert_menu::detect(&body.text().slice(start..selection.start).to_string())?;\n            query.range.start += start;\n            query.range.end += start;\n            (\n                false,\n                self.body.entity_id(),\n                self.insert.plain_revision,\n                query,\n            )\n        };\n        Some(Target {\n            document: self.active,\n            editor: identity,\n            rich,\n            revision,\n            query,\n        })\n    }\n    pub(super) fn insert_body_event(\n        &mut self,\n        event: &InputEvent,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        if matches!(event, InputEvent::Change) {\n            self.insert.plain_revision = self.insert.plain_revision.saturating_add(1);\n        }\n        self.refresh_insert_menu(window, cx);\n    }\n    pub(super) fn insert_body_selection_changed(\n        &mut self,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        let selection = self.body.read(cx).selected_range();\n        if selection != self.insert.body_selection {\n            self.insert.body_selection = selection;\n            self.refresh_insert_menu(window, cx);\n            self.reveal_caret_next_frame(window, cx);\n        }\n    }\n    pub(super) fn reset_insert_menu(&mut self) {\n        self.insert.menu_binding = self.insert.menu_binding.saturating_add(1);\n        self.insert.target = None;\n        self.insert.dismissed = None;\n        self.insert.form = None;\n        self.insert.form_subscription = None;\n        self.insert.form_target = None;\n    }\n    pub(super) fn refresh_insert_menu(&mut self, window: &mut Window, cx: &mut Context<Self>) {\n        if self.insert.form.is_some() {\n            return;\n        }\n        let target = self.current_insert_target(true, window, cx);\n        if self.insert.dismissed.as_ref() != target.as_ref() {\n            self.insert.dismissed = None;\n        }\n        let target = target.filter(|t| self.insert.dismissed.as_ref() != Some(t));\n        if let Some(target) = &target {\n            if let Some(menu) = &self.insert.menu {\n                menu.update(cx, |menu, cx| menu.set_query(&target.query.query, cx));\n            } else {\n                let menu = cx.new(|cx| InsertMenuView::new(&target.query.query, cx));\n                self.insert.menu_subscription =\n                    Some(\n                        cx.subscribe_in(&menu, window, |this, sender, event, window, cx| {\n                            if this.insert.menu.as_ref() != Some(sender) {\n                                return;\n                            }\n                            match event {\n                                MenuEvent::Choose { id, binding }\n                                    if *binding == this.insert.menu_binding =>\n                                {\n                                    this.choose_insert_command(id, window, cx)\n                                }\n                                MenuEvent::Dismiss { binding }\n                                    if *binding == this.insert.menu_binding =>\n                                {\n                                    this.dismiss_insert(false, window, cx)\n                                }\n                                _ => {}\n                            }\n                        }),\n                    );\n                self.insert.menu = Some(menu);\n            }\n        }\n        if self.insert.target != target {\n            self.insert.menu_binding = self.insert.menu_binding.saturating_add(1);\n            if let Some(menu) = &self.insert.menu {\n                menu.update(cx, |menu, cx| {\n                    menu.set_binding(self.insert.menu_binding, cx)\n                });\n            }\n            self.insert.target = target;\n            cx.notify();\n        }\n    }\n    pub(super) fn sync_insert_presence(&mut self, window: &mut Window, cx: &mut Context<Self>) {\n        if !self.insert_available() {\n            if self.insert.target.is_some() || self.insert.form.is_some() {\n                self.reset_insert_menu();\n            }\n            return;\n        }\n        if self.insert.form.is_none()\n            && self.insert.target.is_some()\n            && self.current_insert_target(true, window, cx) != self.insert.target\n        {\n            self.refresh_insert_menu(window, cx);\n        }\n    }\n    fn insert_anchor(&self, window: &Window, cx: &App) -> Option<Bounds<Pixels>> {\n        let bounds = if let Some(editor) = &self.rich {\n            editor.read(cx).caret_bounds()\n        } else {\n            self.body.read(cx).cursor_layout().map(|l| l.0)\n        }?;\n        let viewport = self.writing_scroll.bounds();\n        (bounds.bottom() > viewport.top()\n            && bounds.top() < viewport.bottom()\n            && bounds.top() < window.viewport_size().height)\n            .then_some(bounds)\n    }\n    fn dismiss_insert(&mut self, focus_editor: bool, window: &mut Window, cx: &mut Context<Self>) {\n        self.insert.dismissed = self\n            .insert\n            .target\n            .clone()\n            .or_else(|| self.insert.form_target.as_ref().map(|t| t.0.clone()));\n        self.insert.target = None;\n        self.insert.form = None;\n        self.insert.form_subscription = None;\n        self.insert.form_target = None;\n        if focus_editor {\n            self.focus_writing(window, cx);\n        }\n        cx.notify();\n    }\n    fn move_insert_selection(\n        &mut self,\n        direction: isize,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) -> bool {\n        self.refresh_insert_menu(window, cx);\n        if self.insert.target.is_none() {\n            return false;\n        }\n        let Some(menu) = &self.insert.menu else {\n            return false;\n        };\n        if !menu.read(cx).has_candidates() {\n            return false;\n        }\n        menu.update(cx, |menu, cx| menu.move_selection(direction, cx));\n        true\n    }\n    fn accept_insert_selection(&mut self, window: &mut Window, cx: &mut Context<Self>) -> bool {\n        self.refresh_insert_menu(window, cx);\n        if self.insert.target.is_none() {\n            return false;\n        }\n        let Some(id) = self\n            .insert\n            .menu\n            .as_ref()\n            .and_then(|m| m.read(cx).selected())\n        else {\n            return false;\n        };\n        self.choose_insert_command(id, window, cx);\n        true\n    }\n    fn choose_insert_command(&mut self, id: &str, window: &mut Window, cx: &mut Context<Self>) {\n        let Some(target) = self.insert.target.clone() else {\n            return;\n        };\n        // Resolve the actual caret/query at activation, never a previous render.\n        if self.current_insert_target(true, window, cx).as_ref() != Some(&target)\n            || !insert_menu::candidates(&target.query.query)\n                .iter()\n                .any(|r| r.command.id == id)\n        {\n            self.refresh_insert_menu(window, cx);\n            return;\n        }\n        if let Some(kind) = FormKind::for_command(id) {\n            let form = cx.new(|cx| InsertFormView::new(kind, window, cx));\n            self.insert.form_subscription =\n                Some(\n                    cx.subscribe_in(&form, window, |this, sender, event, window, cx| {\n                        if this.insert.form.as_ref() != Some(sender) {\n                            return;\n                        }\n                        match event {\n                            FormEvent::Cancel => this.dismiss_insert(true, window, cx),\n                            FormEvent::Insert(values) => {\n                                if let Some((target, id)) = this.insert.form_target.clone() {\n                                    this.commit_insert(target, &id, values, window, cx);\n                                }\n                            }\n                        }\n                    }),\n                );\n            self.insert.form_target = Some((target, id.to_owned()));\n            self.insert.target = None;\n            self.insert.form = Some(form);\n            cx.notify();\n        } else {\n            self.commit_insert(target, id, &Parameters::None, window, cx);\n        }\n    }\n    fn commit_insert(\n        &mut self,\n        target: Target,\n        id: &str,\n        values: &Parameters,\n        window: &mut Window,\n        cx: &mut Context<Self>,\n    ) {\n        if self.current_insert_target(false, window, cx).as_ref() != Some(&target) {\n            self.notice = Some(\"The insertion position has changed. Type / again.\".into());\n            self.dismiss_insert(true, window, cx);\n            return;\n        }\n        let result = if target.rich {\n            self.rich\n                .as_ref()\n                .unwrap()\n                .update(cx, |editor, cx| {\n                    editor.insert_from_slash(&target.query, target.revision, id, values, window, cx)\n                })\n                .map(|_| ())\n                .map_err(|e| e.to_string())\n        } else {\n            insert_menu::markdown::plan(&self.body.read(cx).value(), &target.query, id, values)\n                .map(|edit| {\n                    self.body.update(cx, |body, cx| {\n                        body.replace_range_with_selection(\n                            edit.range,\n                            edit.text,\n                            edit.selection,\n                            window,\n                            cx,\n                        )\n                    });\n                })\n                .map_err(str::to_owned)\n        };\n        match result {\n            Ok(()) => {\n                self.reset_insert_menu();\n                self.focus_writing(window, cx);\n                self.changed(window, cx);\n                self.reveal_caret_next_frame(window, cx);\n            }\n            Err(error) => {\n                self.notice = Some(error);\n                self.dismiss_insert(true, window, cx);\n            }\n        }\n        cx.notify();\n    }\n    pub(super) fn insert_key_handlers(\n        &self,\n        element: Stateful<Div>,\n        cx: &mut Context<Self>,\n    ) -> Stateful<Div> {\n        element\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::MoveUp, w, cx| {\n                    if this.move_insert_selection(-1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::MoveDown, w, cx| {\n                    if this.move_insert_selection(1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Up, w, cx| {\n                    if this.move_insert_selection(-1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Down, w, cx| {\n                    if this.move_insert_selection(1, w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::Enter, w, cx| {\n                    if this.accept_insert_selection(w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &twyne_desktop::editor::view::Enter, w, cx| {\n                    if this.accept_insert_selection(w, cx) {\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(\n                cx.listener(|this, _: &gpui_kit::base::input::Escape, w, cx| {\n                    if this.insert.target.is_some() || this.insert.form.is_some() {\n                        this.dismiss_insert(true, w, cx);\n                        cx.stop_propagation();\n                    } else {\n                        cx.propagate();\n                    }\n                }),\n            )\n            .capture_action(cx.listener(|this, _: &CloseCompositor, w, cx| {\n                if this.insert.target.is_some() || this.insert.form.is_some() {\n                    this.dismiss_insert(true, w, cx);\n                    cx.stop_propagation();\n                } else {\n                    cx.propagate();\n                }\n            }))\n    }\n    pub(super) fn insert_overlay(\n        &self,\n        window: &Window,\n        cx: &mut Context<Self>,\n    ) -> Option<AnyElement> {\n        let viewport = window.viewport_size();\n        if let Some(form) = &self.insert.form {\n            let left = (f32::from(viewport.width) / 2. - 160.).max(8.);\n            return Some(\n                deferred(\n                    anchored()\n                        .position(point(px(left), px(80.)))\n                        .snap_to_window_with_margin(px(8.))\n                        .child(\n                            div()\n                                .id(\"slash-insert-overlay\")\n                                .max_w(px((f32::from(viewport.width) - 16.).max(0.)))\n                                .max_h(px((f32::from(viewport.height) - 16.).max(0.)))\n                                .overflow_y_scroll()\n                                .track_scroll(&self.insert.form_scroll)\n                                .child(form.clone())\n                                .on_mouse_down_out(cx.listener(|this, _, window, cx| {\n                                    this.dismiss_insert(false, window, cx)\n                                })),\n                        ),\n                )\n                .priority(4)\n                .into_any_element(),\n            );\n        }\n        self.insert.target.as_ref()?;\n        let menu = self.insert.menu.as_ref()?;\n        let anchor = self.insert_anchor(window, cx)?;\n        let width = f32::from(viewport.width);\n        let height = f32::from(viewport.height);\n        let left = f32::from(anchor.left()).min(width - 288. - 8.).max(8.);\n        let below = (height - f32::from(anchor.bottom()) - 14.).max(0.);\n        let above = (f32::from(anchor.top()) - 14.).max(0.);\n        let use_above = below < 200. && above > below;\n        let available = if use_above { above } else { below };\n        let results_height = (available - 40.).clamp(0., 320.);\n        menu.update(cx, |menu, cx| menu.set_max_height(results_height, cx));\n        let top = if use_above {\n            f32::from(anchor.top()) - 6. - results_height - 36.\n        } else {\n            f32::from(anchor.bottom()) + 6.\n        };\n        Some(\n            deferred(\n                anchored()\n                    .position(point(px(left), px(top.max(8.))))\n                    .snap_to_window_with_margin(px(8.))\n                    .child(div().max_w(px((width - 16.).max(0.))).child(menu.clone())),\n            )\n            .priority(3)\n            .into_any_element(),\n        )\n    }\n}\n\n#[cfg(all(test, feature = \"ui-tests\"))]\n#[path = \"slash_tests.rs\"]\nmod tests;\n"},"started_at_ms":1791228509485,"completed_at_ms":1791228509485}}
