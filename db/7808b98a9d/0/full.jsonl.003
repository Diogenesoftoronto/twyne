{"timestamp":"2026-10-05T17:53:37.129Z","ordinal":43721,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a10537-909f-77a3-96d8-dd07161f91ae","turn_id":"01a10d17-989f-7150-9fa5-0c502f3fed47","item":{"type":"CommandExecution","id":"exec-ffcd6452-5ad2-4ce9-89f2-45e2c5ef012f","process_id":"89656","command":["/bin/bash","-lc","rtk proxy cat desktop/gpui/src/editor/mod.rs"],"cwd":"file:///home/diogenes/Projects/twyne","parsed_cmd":[{"type":"unknown","cmd":"rtk proxy cat desktop/gpui/src/editor/mod.rs"}],"source":"unified_exec_startup","status":"completed","stdout":"//! Twyne's structured visual document model.\n//!\n//! HTML is the interoperable visual projection used by the existing editor.\n//! This module retains that tree, including unknown attributes and source\n//! atoms. Authored Typst belongs to the workspace/session layer and is never\n//! generated here from a cached HTML projection.\n//!\n//! Selection offsets count Unicode scalar values in `editing_text()`, not\n//! UTF-8 bytes or UTF-16 code units. Text blocks end with one synthetic newline;\n//! inline/block atoms occupy one U+FFFC object replacement character. Native\n//! views can use `blocks()` and their ranges without flattening the document\n//! into a Markdown editor. HTML and human-readable text are derived only when\n//! requested; editing/history use shared trees with cached subtree lengths.\n\nmod block_moves;\nmod clipboard;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_wayland;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_x11;\nmod command;\nmod comments;\nmod html;\nmod model;\npub mod pagination;\nmod recase;\nmod tables;\nmod transaction;\n\npub use block_moves::{BlockMovePlan, DropPlacement};\npub use clipboard::RichFragment;\npub use command::*;\npub use comments::{CommentAttributes, CommentRange};\npub use html::{HTML_LIMITS, HtmlImport, HtmlLimits, HtmlUsage};\npub use model::*;\npub use transaction::{CommandOutcome, EditDelta, RichEditor};\n\n#[cfg(feature = \"desktop\")]\npub mod view;\n\n#[cfg(feature = \"desktop\")]\npub mod math_source_editor;\n\n#[cfg(test)]\nmod tests;\n","stderr":"","aggregated_output":"//! Twyne's structured visual document model.\n//!\n//! HTML is the interoperable visual projection used by the existing editor.\n//! This module retains that tree, including unknown attributes and source\n//! atoms. Authored Typst belongs to the workspace/session layer and is never\n//! generated here from a cached HTML projection.\n//!\n//! Selection offsets count Unicode scalar values in `editing_text()`, not\n//! UTF-8 bytes or UTF-16 code units. Text blocks end with one synthetic newline;\n//! inline/block atoms occupy one U+FFFC object replacement character. Native\n//! views can use `blocks()` and their ranges without flattening the document\n//! into a Markdown editor. HTML and human-readable text are derived only when\n//! requested; editing/history use shared trees with cached subtree lengths.\n\nmod block_moves;\nmod clipboard;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_wayland;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_x11;\nmod command;\nmod comments;\nmod html;\nmod model;\npub mod pagination;\nmod recase;\nmod tables;\nmod transaction;\n\npub use block_moves::{BlockMovePlan, DropPlacement};\npub use clipboard::RichFragment;\npub use command::*;\npub use comments::{CommentAttributes, CommentRange};\npub use html::{HTML_LIMITS, HtmlImport, HtmlLimits, HtmlUsage};\npub use model::*;\npub use transaction::{CommandOutcome, EditDelta, RichEditor};\n\n#[cfg(feature = \"desktop\")]\npub mod view;\n\n#[cfg(feature = \"desktop\")]\npub mod math_source_editor;\n\n#[cfg(test)]\nmod tests;\n","exit_code":0,"duration":{"secs":0,"nanos":9836},"formatted_output":"//! Twyne's structured visual document model.\n//!\n//! HTML is the interoperable visual projection used by the existing editor.\n//! This module retains that tree, including unknown attributes and source\n//! atoms. Authored Typst belongs to the workspace/session layer and is never\n//! generated here from a cached HTML projection.\n//!\n//! Selection offsets count Unicode scalar values in `editing_text()`, not\n//! UTF-8 bytes or UTF-16 code units. Text blocks end with one synthetic newline;\n//! inline/block atoms occupy one U+FFFC object replacement character. Native\n//! views can use `blocks()` and their ranges without flattening the document\n//! into a Markdown editor. HTML and human-readable text are derived only when\n//! requested; editing/history use shared trees with cached subtree lengths.\n\nmod block_moves;\nmod clipboard;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_wayland;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_x11;\nmod command;\nmod comments;\nmod html;\nmod model;\npub mod pagination;\nmod recase;\nmod tables;\nmod transaction;\n\npub use block_moves::{BlockMovePlan, DropPlacement};\npub use clipboard::RichFragment;\npub use command::*;\npub use comments::{CommentAttributes, CommentRange};\npub use html::{HTML_LIMITS, HtmlImport, HtmlLimits, HtmlUsage};\npub use model::*;\npub use transaction::{CommandOutcome, EditDelta, RichEditor};\n\n#[cfg(feature = \"desktop\")]\npub mod view;\n\n#[cfg(feature = \"desktop\")]\npub mod math_source_editor;\n\n#[cfg(test)]\nmod tests;\n"},"started_at_ms":1791222817129,"completed_at_ms":1791222817129}}
