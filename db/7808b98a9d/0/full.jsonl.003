 {\\n                    let readonly = self.active_document().archived;\\n                    view.update(cx, |view, cx| view.set_read_only(readonly, cx));\\n                }\\n                self.error = None;\\n                self.proof_error = None;\\n                if self.source_mode || self.proof_mode || self.split_view {\\n                    self.schedule_source_proof(window, cx);\\n                }\\n            }\\n            Err(error) => self.error = Some(format!(\\\"Could not discard source: {error:#}\\\")),\\n        }\\n        self.update_revision_capabilities(cx);\\n        cx.notify();\\n    }\\n\\n    fn request_proof(&mut self, apply: bool, window: &mut Window, cx: &mut Context<Self>) {\\n        if self.applying_source {\\n            return;\\n\"}"},{"type":"input_text","text":"{}"},{"type":"input_text","text":"{\"chunk_id\":\"4e56f0\",\"wall_time_seconds\":1.000504485,\"session_id\":14823,\"original_token_count\":93,\"output\":\"• Running devenv:files:cleanup\\n✓ Running devenv:files:cleanup in 15.7ms\\n• Running devenv:files\\n✓ Running devenv:files in 16.5ms\\n• Running devenv:git-hooks:install\\n✓ Running devenv:git-hooks:install in 12.5ms\\n• Running devenv:enterShell\\n✓ Running devenv:enterShell in 10.8ms\\n   Compiling twyne-desktop v0.1.0 (/home/diogenes/Projects/twyne/desktop/gpui)\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10d4c-a644-7d71-9054-bf5cd3583d03","create_time":1791226108.836515}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
