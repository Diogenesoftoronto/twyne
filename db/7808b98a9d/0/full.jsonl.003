s.Expression[] = [];\n  function visit(node: ts.Node) {\n    if (\n      ts.isCallExpression(node) &&\n      ts.isIdentifier(node.expression) &&\n      node.expression.text === \"onDraftChanged\"\n    ) {\n      if (node.arguments.length !== 1)\n        throw new Error(\"Invalid original draft normalization.\");\n      normalizers.push(node.arguments[0]);\n    }\n    ts.forEachChild(node, visit);\n  }\n  visit(routeAst);\n  if (normalizers.length !== 1)\n    throw new Error(\"Original draft normalization is not unique.\");\n  const normalizeText = normalizers[0].getText(routeAst);\n  const code = ts.transpileModule(\n    resultInterface.getText(ast).replace(/^export\\s+/, \"\") +\n      \"\\n\" +\n      minimum.getText(ast) +\n      \"\\n\" +\n      originalFunction +\n      \"\\nsteerBackgroundResearch(instructions);\",\n    {\n      compilerOptions: {\n        target: ts.ScriptTarget.ES2022,\n        module: ts.ModuleKind.None,\n      },\n    },\n  ).outputText;\n  const script = new vm.Script(code);\n  const normalizer = new vm.Script(normalizeText);\n  const rows = [];\n  for (const input of cases) {\n    const calls = {\n      settingsLoads: 0,\n      configuredAiChecks: 0,\n      research: 0,\n      network: 0,\n    };\n    const context = vm.createContext({\n      instructions: input.instructions,\n      activeFolioId: input.folioId,\n      text: input.text,\n"},"started_at_ms":1791203286341,"completed_at_ms":1791203286341}}
{"timestamp":"2026-10-05T12:28:06.432Z","ordinal":40347,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10c09-1da0-71b2-9757-b4e162035eca","call_id":"call_105wpSr9KfJ1xhk5T3Empuj0","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"{}"},{"type":"input_text","text":"{\"index\":0,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"541617\",\"wall_time_seconds\":0.000012103,\"exit_code\":0,\"original_token_count\":1758,\"output\":\"/** Execute the original steering guard prefix in an isolated, provider-free VM. */\\nimport { createHash } from \\\"node:crypto\\\";\\nimport { readFile, writeFile } from \\\"node:fs/promises\\\";\\nimport { resolve } from \\\"node:path\\\";\\nimport vm from \\\"node:vm\\\";\\nimport ts from \\\"typescript\\\";\\n\\nconst project = resolve(import.meta.dir, \\\"../../../..\\\");\\nconst researchPath = \\\"src/utils/background-research.ts\\\";\\nconst routePath = \\\"src/routes/editor/index.tsx\\\";\\nconst hash = (value: string) =>\\n  createHash(\\\"sha256\\\").update(value).digest(\\\"hex\\\");\\n\\ninterface SteeringCase {\\n  name: string;\\n  instructions: string;\\n  folioId: string | null;\\n  text: string;\\n}\\n\\nconst cases: SteeringCase[] = [\\n  {\\n    name: \\\"empty direction before missing draft\\\",\\n    instructions: \\\"\\\",\\n    folioId: null,\\n    text: \\\"\\\",\\n  },\\n  {\\n    name: \\\"ECMAScript whitespace-only direction\\\",\\n    instructions: \\\"\\\\u00a0\\\\u2003\\\\ufeff\\\",\\n    folioId: null,\\n    text: \\\"x\\\".repeat(120),\\n  },\\n  {\\n    name: \\\"missing folio before provider\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: null,\\n    text: \\\"x\\\".repeat(120),\\n  },\\n  {\\n    name: \\\"empty folio id\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"\\\",\\n    text: \\\"x\\\".repeat(120),\\n  },\\n  {\\n    name: \\\"empty manuscript before short draft\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"\\\",\\n  },\\n  {\\n    name: \\\"ECMAScript manuscript whitespace\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\" \\\\t\\\\r\\\\n\\\\u00a0\\\\ufeff\\\\u2028\\\\u2029 \\\",\\n  },\\n  {\\n    name: \\\"119 ASCII UTF16 units\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(119),\\n  },\\n  {\\n    name: \\\"120 ASCII UTF16 units\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(120),\\n  },\\n  {\\n    name: \\\"59 astral characters are 118 units\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"🌿\\\".repeat(59),\\n  },\\n  {\\n    name: \\\"60 astral characters are 120 units\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"🌿\\\".repeat(60),\\n  },\\n  {\\n    name: \\\"astral plus ASCII at119\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"🌿\\\".repeat(59) + \\\"x\\\",\\n  },\\n  {\\n    name: \\\"astral plus ASCII at120\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"🌿\\\".repeat(59) + \\\"xx\\\",\\n  },\\n  {\\n    name: \\\"normalized internal whitespace at120\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(118) + \\\"\\\\u00a0\\\\t\\\\r\\\\n y\\\",\\n  },\\n  {\\n    name: \\\"normalization changes raw120 to119\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(59) + \\\"\\\\r\\\\n\\\" + \\\"x\\\".repeat(59),\\n  },\\n  {\\n    name: \\\"trailing whitespace cannot reach threshold\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(118) + \\\"  \\\",\\n  },\\n  {\\n    name: \\\"NEL is not ECMAScript whitespace\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(59) + \\\" \\\\u0085\\\\t \\\\u0085 \\\" + \\\"x\\\".repeat(59),\\n  },\\n  {\\n    name: \\\"zero-width direction is not trimmed away\\\",\\n    instructions: \\\"\\\\u200b\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(120),\\n  },\\n  {\\n    name: \\\"literal text is not HTML projection\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"<p>\\\" + \\\"x\\\".repeat(119) + \\\"</p>\\\",\\n  },\\n  {\\n    name: \\\"instructions are never executable\\\",\\n    instructions: 'await runOnce(); fetch(\\\"https://provider.invalid/\\\")',\\n    folioId: \\\"draft\\\",\\n    text: \\\"x\\\".repeat(120),\\n  },\\n  {\\n    name: \\\"folio id follows original truthiness\\\",\\n    instructions: \\\"Primary sources\\\",\\n    folioId: \\\" \\\",\\n    text: \\\"x\\\".repeat(120),\\n  },\\n  {\\n    name: \\\"BOM trim leaves120 units\\\",\\n    instructions: \\\"\\\\ufeffPrimary sources\\\\u00a0\\\",\\n    folioId: \\\"draft\\\",\\n    text: \\\"\\\\ufeff\\\" + \\\"x\\\".repeat(120) + \\\"\\\\u00a0\\\",\\n  },\\n];\\n\\nexport async function observeSourceSteering() {\\n  const [research, route] = await Promise.all([\\n    readFile(resolve(project, researchPath), \\\"utf8\\\"),\\n    readFile(resolve(project, routePath), \\\"utf8\\\"),\\n  ]);\\n  const ast = ts.createSourceFile(\\n    researchPath,\\n    research,\\n    ts.ScriptTarget.Latest,\\n    true,\\n  );\\n  const fn = ast.statements.find(\\n    (node): node is ts.FunctionDeclaration =>\\n      ts.isFunctionDeclaration(node) &&\\n      node.name?.text === \\\"steerBackgroundResearch\\\",\\n  );\\n  const minimum = ast.statements.find(\\n    (node): node is ts.VariableStatement =>\\n      ts.isVariableStatement(node) &&\\n      node.declarationList.declarations.some(\\n        (item) =>\\n          ts.isIdentifier(item.name) && item.name.text === \\\"MIN_DRAFT_CHARS\\\",\\n      ),\\n  );\\n  const resultInterface = ast.statements.find(\\n    (node): node is ts.InterfaceDeclaration =>\\n      ts.isInterfaceDeclaration(node) &&\\n      node.name.text === \\\"ResearchCommandResult\\\",\\n  );\\n  if (!fn?.body || !minimum || !resultInterface)\\n    throw new Error(\\\"Missing original steering declarations.\\\");\\n  const boundary = fn.body.statements.find(\\n    (node) =>\\n      ts.isExpressionStatement(node) &&\\n      ts.isAwaitExpression(node.expression) &&\\n      ts.isCallExpression(node.expression.expression) &&\\n      ts.isIdentifier(node.expression.expression.expression) &&\\n      node.expression.expression.expression.text === \\\"runOnce\\\",\\n  );\\n  if (!boundary) throw new Error(\\\"Missing original research boundary.\\\");\\n  const guardText = research.slice(\\n    fn.body.getStart(ast) + 1,\\n    boundary.getStart(ast),\\n  );\\n  const originalFunction =\\n    research\\n      .slice(fn.getStart(ast), boundary.getStart(ast))\\n      .replace(/^export\\\\s+/, \\\"\\\") +\\n    'throw new Error(\\\"Original guards crossed the research boundary.\\\");\\\\n}\\\\n';\\n  const routeAst = ts.createSourceFile(\\n    routePath,\\n    route,\\n    ts.ScriptTarget.Latest,\\n    true,\\n    ts.ScriptKind.TSX,\\n  );\\n  const normalizers: ts.Expression[] = [];\\n  function visit(node: ts.Node) {\\n    if (\\n      ts.isCallExpression(node) &&\\n      ts.isIdentifier(node.expression) &&\\n      node.expression.text === \\\"onDraftChanged\\\"\\n    ) {\\n      if (node.arguments.length !== 1)\\n        throw new Error(\\\"Invalid original draft normalization.\\\");\\n      normalizers.push(node.arguments[0]);\\n    }\\n    ts.forEachChild(node, visit);\\n  }\\n  visit(routeAst);\\n  if (normalizers.length !== 1)\\n    throw new Error(\\\"Original draft normalization is not unique.\\\");\\n  const normalizeText = normalizers[0].getText(routeAst);\\n  const code = ts.transpileModule(\\n    resultInterface.getText(ast).replace(/^export\\\\s+/, \\\"\\\") +\\n      \\\"\\\\n\\\" +\\n      minimum.getText(ast) +\\n      \\\"\\\\n\\\" +\\n      originalFunction +\\n      \\\"\\\\nsteerBackgroundResearch(instructions);\\\",\\n    {\\n      compilerOptions: {\\n        target: ts.ScriptTarget.ES2022,\\n        module: ts.ModuleKind.None,\\n      },\\n    },\\n  ).outputText;\\n  const script = new vm.Script(code);\\n  const normalizer = new vm.Script(normalizeText);\\n  const rows = [];\\n  for (const input of cases) {\\n    const calls = {\\n      settingsLoads: 0,\\n      configuredAiChecks: 0,\\n      research: 0,\\n      network: 0,\\n    };\\n    const context = vm.createContext({\\n      instructions: input.instructions,\\n      activeFolioId: input.folioId,\\n      text: input.text,\\n\"}}"},{"type":"input_text","text":"{\"index\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"1869eb\",\"wall_time_seconds\":0.00002922,\"exit_code\":0,\"original_token_count\":1683,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Parent-only execution: one private Xvfb, five independent native clients.\\n\\nNever runs Cargo/Devenv, never uses the user's display, never removes receipts.\\nRequires an already compiled probe and an explicitly saved runtime environment.\\n\\\"\\\"\\\"\\nimport argparse\\nimport hashlib\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport select\\nimport signal\\nimport subprocess\\nimport time\\nfrom check_pixels import compare\\nfrom x11_driver import OwnedX11\\n\\n\\nALLOWED_ENV = {\\n    \\\"PATH\\\", \\\"LD_LIBRARY_PATH\\\", \\\"VK_ICD_FILENAMES\\\", \\\"VK_DRIVER_FILES\\\", \\\"XDG_DATA_DIRS\\\",\\n    \\\"LIBGL_ALWAYS_SOFTWARE\\\", \\\"MESA_VK_WSI_PRESENT_MODE\\\", \\\"FONTCONFIG_FILE\\\", \\\"FONTCONFIG_PATH\\\",\\n}\\n\\n\\ndef argv(command):\\n    return [\\\"rtk\\\", \\\"proxy\\\", *map(str, command)]\\n\\n\\ndef run(command, env, **options):\\n    return subprocess.run(argv(command), env=env, check=True, stdout=subprocess.PIPE,\\n                          stderr=subprocess.PIPE, **options).stdout\\n\\n\\ndef wait(predicate, app=None, seconds=15):\\n    deadline = time.monotonic() + seconds\\n    while time.monotonic() < deadline:\\n        if app is not None and app.poll() is not None:\\n            raise RuntimeError(f\\\"Owned native probe exited early: {app.returncode}\\\")\\n        try:\\n            value = predicate()\\n        except (subprocess.CalledProcessError, IndexError):\\n            value = None\\n        if value:\\n            return value\\n        time.sleep(0.05)\\n    raise TimeoutError(\\\"Owned probe condition timed out; all files are retained\\\")\\n\\n\\ndef observed(path):\\n    try:\\n        receipt = json.loads(path.read_text())\\n        return receipt if receipt.get(\\\"paint_submissions\\\", 0) > 0 else None\\n    except (FileNotFoundError, json.JSONDecodeError):\\n        return None\\n\\n\\ndef capture(window_id, destination, env):\\n    xwd = destination.with_suffix(\\\".xwd\\\")\\n    run([\\\"xwd\\\", \\\"-silent\\\", \\\"-id\\\", window_id, \\\"-out\\\", xwd], env)\\n    run([\\\"magick\\\", xwd, \\\"-depth\\\", \\\"8\\\", destination], env)\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument(\\\"--binary\\\", required=True, type=Path)\\n    parser.add_argument(\\\"--runtime-env\\\", required=True, type=Path)\\n    parser.add_argument(\\\"--output\\\", required=True, type=Path)\\n    args = parser.parse_args()\\n    if not args.binary.resolve().is_file():\\n        parser.error(\\\"Root must compile the example before running this driver\\\")\\n    if args.output.exists():\\n        parser.error(\\\"Use a NEW output directory; retained failures are never overwritten\\\")\\n    args.output.mkdir(parents=True)\\n    runtime = json.loads(args.runtime_env.read_text())\\n    if not isinstance(runtime, dict) or any(key not in ALLOWED_ENV for key in runtime):\\n        parser.error(\\\"Runtime env must contain only the documented non-credential keys\\\")\\n    env = {key: os.environ[key] for key in [\\\"LANG\\\", \\\"LC_ALL\\\", \\\"PATH\\\"] if key in os.environ}\\n    env.update({key: str(value) for key, value in runtime.items()})\\n    for folder, key in [(\\\"home\\\", \\\"HOME\\\"), (\\\"runtime\\\", \\\"XDG_RUNTIME_DIR\\\"),\\n                        (\\\"config\\\", \\\"XDG_CONFIG_HOME\\\"), (\\\"cache\\\", \\\"XDG_CACHE_HOME\\\"),\\n                        (\\\"data\\\", \\\"XDG_DATA_HOME\\\")]:\\n        private = (args.output / folder).resolve()\\n        private.mkdir(mode=0o700)\\n        env[key] = str(private)\\n    private_runtime = Path(env[\\\"XDG_RUNTIME_DIR\\\"])\\n    env.update({\\n        \\\"XDG_SESSION_TYPE\\\": \\\"x11\\\",\\n        \\\"DBUS_SESSION_BUS_ADDRESS\\\": f\\\"unix:path={private_runtime / 'no-session-bus'}\\\",\\n        \\\"DBUS_SYSTEM_BUS_ADDRESS\\\": f\\\"unix:path={private_runtime / 'no-system-bus'}\\\",\\n        \\\"PULSE_SERVER\\\": f\\\"unix:{private_runtime / 'no-pulse'}\\\",\\n        \\\"PIPEWIRE_REMOTE\\\": str(private_runtime / \\\"no-pipewire\\\"),\\n    })\\n    read_fd, write_fd = os.pipe()\\n    server_log = (args.output / \\\"xvfb.log\\\").open(\\\"wb\\\")\\n    server = subprocess.Popen(argv([\\\"Xvfb\\\", \\\"-displayfd\\\", write_fd, \\\"-screen\\\", \\\"0\\\", \\\"900x720x24\\\", \\\"-nolisten\\\", \\\"tcp\\\"]),\\n                              pass_fds=(write_fd,), stdout=subprocess.DEVNULL, stderr=server_log,\\n                              start_new_session=True, env=env)\\n    os.close(write_fd)\\n    app = None\\n    x11 = None\\n    receipt = {\\\"schema\\\": 1, \\\"scope\\\": \\\"actual private-X11 shader/framebuffer acceptance only\\\",\\n               \\\"executed\\\": True, \\\"binary_sha256\\\": hashlib.sha256(args.binary.read_bytes()).hexdigest(),\\n               \\\"cases\\\": [], \\\"failures\\\": [], \\\"source_radial_raster_parity\\\": False,\\n               \\\"framebuffer_alpha_measured\\\": False, \\\"atlas_adjacency_observed\\\": False}\\n    baseline = None\\n    baseline_receipt = None\\n    try:\\n        if not select.select([read_fd], [], [], 8)[0]:\\n            raise TimeoutError(\\\"Private Xvfb did not supply its own display\\\")\\n        number = os.read(read_fd, 64).decode().strip()\\n        if not number.isdigit():\\n            raise ValueError(\\\"Private displayfd protocol failed\\\")\\n        display = f\\\":{number}\\\"\\n        env[\\\"DISPLAY\\\"] = display\\n        env[\\\"TWYNE_MULTIPLY_OWNED_DISPLAY\\\"] = display\\n        x11 = OwnedX11(env, args.output / \\\"actual-x11-events.json\\\")\\n        for mode in [\\\"baseline\\\", \\\"multiply\\\", \\\"normal-alpha\\\", \\\"per-layer\\\", \\\"beneath\\\"]:\\n            folder = args.output / mode\\n            folder.mkdir()\\n            manifest = folder / \\\"native.json\\\"\\n            log = (folder / \\\"app.log\\\").open(\\\"wb\\\")\\n            app = subprocess.Popen(argv([args.binary.resolve(), display, mode, manifest.resolve()]),\\n                                   env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)\\n            case = {\\\"mode\\\": mode, \\\"errors\\\": []}\\n            try:\\n                ready = wait(lambda: observed(manifest), app)\\n                window_id = wait(lambda: x11.find_named_client(\\n                    \\\"Twyne Multiply Probe\\\", folder / \\\"x11-discovery.json\\\"), app)\\n                # Require two pixel-identical actual client captures. No font,\\n                # pixel-origin, device-size, or animation correction is applied.\\n                previous = None\\n                stable = 0\\n                for attempt in range(20):\\n                    shot = folder / f\\\"candidate-{attempt}.png\\\"\\n                    capture(window_id, shot, env)\\n                    digest = hashlib.sha256(run([\\\"magick\\\", shot, \\\"-depth\\\", \\\"8\\\", \\\"rgb:-\\\"], env)).hexdigest()\\n                    stable = stable + 1 if digest == previous else 0\\n                    previous = digest\\n                    if stable >= 1:\\n                        break\\n                    time.sleep(0.12)\\n                else:\\n                    raise RuntimeError(\\\"Actual live frame did not stabilize\\\")\\n                final = folder / \\\"frame.png\\\"\\n                final.write_bytes(shot.read_bytes())\\n                ready = observed(manifest)\\n                if mode == \\\"baseline\\\":\\n                    baseline, baseline_receipt = final, ready\\n                    case[\\\"baseline_recorded\\\"] = True\\n\"}}"},{"type":"input_text","text":"{\"index\":2,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"b09e7e\",\"wall_time_seconds\":0.000022796,\"exit_code\":0,\"original_token_count\":104,\"output\":\"12:  \\\"scripts\\\": {\\n14:    \\\"i18n:compile\\\": \\\"bun scripts/compile-i18n.ts\\\",\\n25:    \\\"release:check\\\": \\\"bun scripts/check-release-version.ts\\\",\\n55:    \\\"test:e2e\\\": \\\"playwright test\\\",\\n56:    \\\"test:typing\\\": \\\"PLAYWRIGHT_HTML_OPEN=never playwright test e2e/editor-typing-benchmark.e2e.ts --workers=1 --retries=0 --reporter=list,html\\\",\\n72:    \\\"i18n:prepare\\\": \\\"bun scripts/prepare-i18n.ts\\\"\\n79:    \\\"@playwright/test\\\": \\\"^1.61.0\\\",\\n\"}}"},{"type":"input_text","text":"{\"index\":3,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"28e5da\",\"wall_time_seconds\":0.000012252,\"exit_code\":0,\"original_token_count\":1103,\"output\":\"import { describe, expect, test } from \\\"bun:test\\\";\\nimport {\\n  commitVersion,\\n  coolDown,\\n  emptyActivity,\\n  hedgeCount,\\n  readStruggle,\\n  recordEdit,\\n  splitSentences,\\n  STRUGGLE_THRESHOLD,\\n  type BlockActivity,\\n} from \\\"./struggle-signals\\\";\\n\\n/** Record an edit and commit it, as a pause after typing would. */\\nfunction pass(activity: BlockActivity, text: string, now: number) {\\n  return commitVersion(recordEdit(activity, text, now));\\n}\\n\\ndescribe(\\\"splitSentences\\\", () => {\\n  test(\\\"keeps offsets that map back into the paragraph\\\", () => {\\n    const text = \\\"First one here.  Second, longer one! Third?\\\";\\n    const spans = splitSentences(text);\\n    expect(spans.map((s) => s.text)).toEqual([\\n      \\\"First one here.\\\",\\n      \\\"Second, longer one!\\\",\\n      \\\"Third?\\\",\\n    ]);\\n    for (const s of spans) expect(text.slice(s.from, s.to)).toBe(s.text);\\n  });\\n\\n  test(\\\"keeps a trailing fragment without terminal punctuation\\\", () => {\\n    expect(splitSentences(\\\"Done. And then\\\").map((s) => s.text)).toEqual([\\n      \\\"Done.\\\",\\n      \\\"And then\\\",\\n    ]);\\n  });\\n});\\n\\ndescribe(\\\"recordEdit\\\", () => {\\n  test(\\\"counts only the changed middle of the paragraph\\\", () => {\\n    const a = emptyActivity(\\\"The cat sat on the mat.\\\", 0);\\n    const b = recordEdit(a, \\\"The dog sat on the mat.\\\", 1);\\n    expect(b.deleted).toBe(3);\\n    expect(b.inserted).toBe(3);\\n  });\\n\\n  test(\\\"marks growth only past a meaningful amount\\\", () => {\\n    const a = emptyActivity(\\\"Short.\\\", 0);\\n    expect(recordEdit(a, \\\"Short. A\\\", 10).lastGrowthAt).toBe(0);\\n    expect(\\n      recordEdit(a, \\\"Short. A whole new clause here.\\\", 10).lastGrowthAt,\\n    ).toBe(10);\\n  });\\n});\\n\\ndescribe(\\\"readStruggle\\\", () => {\\n  const base =\\n    \\\"The committee met on Tuesday. It decided nothing of consequence. Everyone went home. Nobody minded.\\\";\\n\\n  test(\\\"typing forward is not struggle\\\", () => {\\n    let a = emptyActivity(\\\"\\\", 0);\\n    let text = \\\"\\\";\\n    for (const word of base.split(\\\" \\\")) {\\n      text = text ? `${text} ${word}` : word;\\n      a = pass(a, text, 1);\\n    }\\n    expect(readStruggle(a, 2).score).toBeLessThan(STRUGGLE_THRESHOLD);\\n  });\\n\\n  test(\\\"starting new sentences at the end is not splitting or joining\\\", () => {\\n    let a = emptyActivity(\\\"\\\", 0);\\n    const sentences = base.split(/(?<=\\\\.) /);\\n    let text = \\\"\\\";\\n    for (const sentence of sentences) {\\n      text = text ? `${text} ${sentence}` : sentence;\\n      a = pass(a, text, 1);\\n    }\\n    expect(a.sentenceCountChanges).toBe(0);\\n  });\\n\\n  test(\\\"rewording one sentence three times points at Sentence Lab\\\", () => {\\n    let a = emptyActivity(base, 0);\\n    a = pass(\\n      a,\\n      base.replace(\\\"decided nothing of consequence\\\", \\\"settled nothing at all\\\"),\\n      1,\\n    );\\n    a = pass(\\n      a,\\n      base.replace(\\\"decided nothing of consequence\\\", \\\"reached no decision\\\"),\\n      2,\\n    );\\n    a = pass(\\n      a,\\n      base.replace(\\\"decided nothing of consequence\\\", \\\"adjourned undecided\\\"),\\n      3,\\n    );\\n    const reading = readStruggle(a, 4);\\n    expect(reading.score).toBeGreaterThanOrEqual(STRUGGLE_THRESHOLD);\\n    expect(reading.hints[0].kind).toBe(\\\"sentence-lab\\\");\\n    expect(reading.sentenceIndex).toBe(1);\\n    expect(a.attempts[1]).toContain(\\\"It decided nothing of consequence.\\\");\\n  });\\n\\n  test(\\\"hedging back and forth points at Claim Check\\\", () => {\\n    const plain =\\n      \\\"Remote work is better for deep focus than any open-plan office ever built.\\\";\\n    const hedged =\\n      \\\"Remote work is perhaps better for deep focus than any open-plan office ever built.\\\";\\n    let a = emptyActivity(plain, 0);\\n    a = pass(a, hedged, 1);\\n    a = pass(a, plain, 2);\\n    a = pass(a, hedged, 3);\\n    expect(hedgeCount(hedged)).toBe(1);\\n    expect(readStruggle(a, 4).hints.map((h) => h.kind)).toContain(\\n      \\\"claim-check\\\",\\n    );\\n  });\\n\\n  test(\\\"splitting and joining sentences points at Rhythm Strip\\\", () => {\\n    let a = emptyActivity(base, 0);\\n    a = pass(a, base.replace(\\\"Tuesday. It\\\", \\\"Tuesday and it\\\"), 1);\\n    a = pass(a, base, 2);\\n    a = pass(\\n      a,\\n      base.replace(\\\"consequence. Everyone\\\", \\\"consequence, so everyone\\\"),\\n      3,\\n    );\\n    expect(readStruggle(a, 4).hints.map((h) => h.kind)).toContain(\\n      \\\"rhythm-strip\\\",\\n    );\\n  });\\n\\n  test(\\\"a stall at the end after cutting points at Reader Questions\\\", () => {\\n    const long = `${base} ${base} ${base}`;\\n    let a = emptyActivity(\\n      `${long} A paragraph of padding that the writer then cut away entirely.`,\\n      0,\\n    );\\n    a = pass(a, long, 1_000);\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c03-2660-75c2-b09f-9987333f7d6c","create_time":1791203286.4323258}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
