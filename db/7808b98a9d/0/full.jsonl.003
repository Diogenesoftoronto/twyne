d is never\n//! generated here from a cached HTML projection.\n//!\n//! Selection offsets count Unicode scalar values in `editing_text()`, not\n//! UTF-8 bytes or UTF-16 code units. Text blocks end with one synthetic newline;\n//! inline/block atoms occupy one U+FFFC object replacement character. Native\n//! views can use `blocks()` and their ranges without flattening the document\n//! into a Markdown editor. HTML and human-readable text are derived only when\n//! requested; editing/history use shared trees with cached subtree lengths.\n\nmod block_moves;\nmod clipboard;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_wayland;\n#[cfg(all(feature = \"desktop\", target_os = \"linux\"))]\npub mod clipboard_x11;\nmod command;\nmod comments;\nmod html;\nmod model;\npub mod pagination;\nmod recase;\nmod tables;\nmod transaction;\n\npub use block_moves::{BlockMovePlan, DropPlacement};\npub use clipboard::RichFragment;\npub use command::*;\npub use comments::{CommentAttributes, CommentRange};\npub use html::{HTML_LIMITS, HtmlImport, HtmlLimits, HtmlUsage};\npub use model::*;\npub use transaction::{CommandOutcome, EditDelta, RichEditor};\n\n#[cfg(feature = \"desktop\")]\npub mod view;\n\n#[cfg(feature = \"desktop\")]\npub mod math_source_editor;\n\n#[cfg(test)]\nmod tests;\n"},{"type":"input_text","text":"//! Local manuscript storage and file exchange for Twyne's native writing room.\n\npub mod apparatus;\n#[cfg(feature = \"desktop\")]\npub mod apparatus_view;\n#[cfg(feature = \"desktop\")]\npub mod assets;\npub mod cast;\n#[cfg(feature = \"desktop\")]\npub mod cast_view;\n#[cfg(feature = \"desktop\")]\npub mod chrome;\npub mod citation_anchor;\n#[cfg(feature = \"desktop\")]\npub mod compositor;\npub mod document_edit;\npub mod dossier;\npub mod dossier_conversation;\npub mod dossier_filing;\n#[cfg(feature = \"desktop\")]\npub mod dossier_image_lifecycle;\n#[cfg(feature = \"desktop\")]\npub mod dossier_multiply;\n#[cfg(feature = \"desktop\")]\npub mod dossier_paper;\n#[cfg(feature = \"desktop\")]\npub mod dossier_stamp;\n#[cfg(feature = \"desktop\")]\npub mod dossier_view;\npub mod editor;\npub mod exchange;\npub mod flow;\n#[cfg(feature = \"desktop\")]\npub mod flow_view;\npub mod gen_ui;\npub mod house;\n#[cfg(feature = \"desktop\")]\npub mod house_view;\n#[cfg(feature = \"desktop\")]\npub mod image_import;\n#[cfg(feature = \"desktop\")]\npub mod inline_proof;\npub mod launch_arguments;\npub mod manuscript;\npub mod margin_rail_view;\npub mod marginalia;\n#[cfg(feature = \"desktop\")]\npub mod marginalia_view;\npub mod math_write;\n#[cfg(feature = \"desktop\")]\npub mod native_accounts;\npub mod native_ai;\n#[cfg(feature = \"native-audio\")]\npub mod native_audio;\npub mod native_collaboration;\n#[cfg(feature = \"native-typst\")]\npub mod native_typst;\n#[cfg(feature = \"desktop\")]\npub mod page_furniture;\n#[cfg(feature = \"desktop\")]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10d17-989f-7150-9fa5-0c502f3fed47","create_time":1791222817.4686806}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
