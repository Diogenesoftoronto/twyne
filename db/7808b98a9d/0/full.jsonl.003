ormat!(\"Does `passage` already give {} in support of its main claim? Answer only from the supplied text.\", slot.to_lowercase()))),\n            ])));\n        }\n    }\n    let versions = input.versions[input.versions.len().saturating_sub(3)..].iter().map(|version| quote_prefix(version, 1500)).collect::<Vec<_>>();\n    let signals = input.hints.iter().map(|hint| quote(&hint.reason)).collect::<Vec<_>>();\n    let state = object(vec![\n        (\"passage\".into(), quote_prefix(&input.passage, 3000)),\n        (\"versions\".into(), format!(\"[{}]\", versions.join(\",\"))),\n        (\"signals\".into(), format!(\"[{}]\", signals.join(\",\"))),\n        (\"goal\".into(), quote_prefix(&input.goal, 500)),\n        (\"audience\".into(), quote_prefix(&input.audience, 500)),\n    ]);\n    object(vec![(\"state\".into(), state), (\"questions\".into(), object(questions))])\n}\n\nfn js_number_text(number: &serde_json::Number) -> String {\n    let value = number.as_f64().unwrap_or(f64::NAN);\n    if value == 0. { return \"0\".into(); }\n    let raw = serde_json::Number::from_f64(value).expect(\"JSON numbers are finite\").to_string();\n    let (mantissa, exponent) = raw.split_once(['e', 'E']).map_or((raw.as_str(), 0), |(m, e)| (m, e.parse::<i32>().unwrap()));\n    let negative = mantissa.starts_with('-');\n    let mantissa = mantissa.trim_start_matches('-');\n    let dot = mantissa.find('.').unwrap_or(mantissa.len()) as i32;\n    let mut digits = mantissa.replace('.', \"\");\n    while digits.ends_with('0') && digits.len() > 1 { digits.pop(); }\n    let decimal = dot + exponent;\n    let sign = if negative { \"-\" } else { \"\" };\n    if value.abs() >= 1e-6 && value.abs() < 1e21 {\n        if decimal <= 0 { return format!(\"{sign}0.{}{digits}\", \"0\".repeat((-decimal) as usize)); }\n        if decimal as usize >= digits.len() { return format!(\"{sign}{digits}{}\", \"0\".repeat(decimal as usize - digits.len())); }\n        return format!(\"{sign}{}.{}\", &digits[..decimal as usi