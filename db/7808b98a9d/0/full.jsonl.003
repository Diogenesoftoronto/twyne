         .child(\\n                                Button::new(\\\"in-flow-dismiss\\\")\\n                                    .accessibility_label(\\\"Dismiss this tool\\\")\\n                                    .text_size(px(12.))\\n                                    .line_height(relative(1.55))\\n                                    .when(!self.snapshot.tentative, |button| button.mr(px(8.)))\\n                                    .text_color(rgb(colors.ink_muted))\\n                                    .hover(|style| style.text_color(rgb(colors.vermilion)))\\n                                    .child(\\\"✕\\\")\\n                                    .on_click(cx.listener(|card, _, _, cx| {\\n                                        card.emit(CardAction::Dismiss, cx)\\n                                    })),\\n                            ),\\n                    )\\n                    .child(\\n                        div()\\n                            .mt(px(2.4))\\n                            .italic()\\n                            .text_size(px(13.))\\n                            .text_color(rgb(colors.ink_light))\\n                            .child(SharedString::from(self.snapshot.reason.clone())),\\n                    ),\\n            )\\n            .child(self.body.clone())\\n            .when_some(self.snapshot.notice.clone(), |card, notice| {\\n                card.child(\\n                    div()\\n                        .id(\\\"in-flow-notice\\\")\\n                        .role(Role::Status)\\n                        .text_size(px(12.))\\n                        .text_color(rgb(colors.ink_muted))\\n                        .child(notice),\\n                )\\n            })\\n            .child(self.footer(colors, cx))\\n    }\\n}\\n\"}}"},{"type":"input_text","text":"{\"task\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"0e8d7c\",\"wall_time_seconds\":0.000020586,\"exit_code\":0,\"original_token_count\":219,\"output\":\"//! Original four in-flow writing tools, with Source-compatible spec validation.\\n//!\\n//! A model can only append variants/questions; it cannot replace writer text.\\n//! The view and document/provider adapters own their separate freshness gates.\\n\\npub mod budget;\\npub mod classification;\\npub mod model;\\npub mod notebook;\\npub mod passage;\\npub mod position;\\npub mod props;\\npub mod saved;\\npub mod seed;\\npub mod spec;\\npub mod store;\\npub mod stream;\\npub mod struggle;\\n\\n#[cfg(feature = \\\"desktop\\\")]\\npub mod card;\\n#[cfg(feature = \\\"desktop\\\")]\\nmod input;\\n#[cfg(feature = \\\"desktop\\\")]\\nmod support_text;\\n#[cfg(feature = \\\"desktop\\\")]\\npub mod view;\\n\\n#[cfg(test)]\\nmod budget_oracle_tests;\\n#[cfg(test)]\\nmod classification_oracle_tests;\\n#[cfg(test)]\\nmod integration_oracle_tests;\\n\\n#[cfg(test)]\\nmod seed_oracle_tests;\\n#[cfg(test)]\\nmod source_oracle_tests;\\n#[cfg(test)]\\nmod struggle_oracle_tests;\\n\"}}"},{"type":"input_text","text":"{\"task\":2,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"4943ca\",\"wall_time_seconds\":0.000023773,\"exit_code\":0,\"original_token_count\":388,\"output\":\"        let scale_factor = self.scale_factor();\\n        let content_mask = self.snapped_content_mask();\\n        let opacity = self.element_opacity();\\n        let element_bounds = self.cover_bounds(bounds);\\n        let element_corner_radii = corner_radii.scale(scale_factor);\\n        for shadow in shadows {\\n            if !shadow.inset {\\n                continue;\\n            }\\n            let hole = (bounds + shadow.offset).dilate(-shadow.spread_radius);\\n            // Clamp at zero so a large spread can't produce negative radii, which would\\n            // break the SDF in the shader.\\n            let zero = Pixels::ZERO;\\n            let hole_corner_radii = Corners {\\n                top_left: (corner_radii.top_left - shadow.spread_radius).max(zero),\\n                top_right: (corner_radii.top_right - shadow.spread_radius).max(zero),\\n                bottom_right: (corner_radii.bottom_right - shadow.spread_radius).max(zero),\\n                bottom_left: (corner_radii.bottom_left - shadow.spread_radius).max(zero),\\n            };\\n            self.next_frame.scene.insert_primitive(Shadow {\\n                order: 0,\\n                blur_radius: shadow.blur_radius.scale(scale_factor),\\n                bounds: self.cover_bounds(hole),\\n                content_mask,\\n                corner_radii: hole_corner_radii.scale(scale_factor),\\n                color: shadow.color.opacity(opacity),\\n                element_bounds,\\n                element_corner_radii,\\n                inset: 1,\\n                pad: 0,\\n            });\\n        }\\n    }\\n\"}}"},{"type":"input_text","text":"{\"task\":3,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"8aaaed\",\"wall_time_seconds\":0.000013965,\"exit_code\":0,\"original_token_count\":2363,\"output\":\"//! The four original tool bodies. The host owns passage geometry, document\\n//! commands, provider requests, and the surrounding rail/popover/card shell.\\npub(super) use super::input::field;\\nuse super::input::input_frame;\\nuse super::model::{ToolModel, ToolSnapshot, rhythm_summary};\\nuse super::support_text::support_text;\\nuse crate::{\\n    chrome,\\n    theme::{self, Palette, SERIF_FONT, TYPEWRITER_FONT},\\n};\\nuse gpui_kit::base::{\\n    Button, Checkbox, CheckboxState,\\n    input::{InputBase, InputEvent, InputState, Textarea, TextareaState},\\n};\\nuse gpui_kit::prelude::*;\\nuse gpui_kit::{\\n    AnyElement, Context, Entity, EventEmitter, FocusHandle, IntoElement, Render, Role,\\n    SharedString, Subscription, TestSupportExt, Window, canvas, div, point, px, relative, rgb,\\n};\\nuse serde_json::Value;\\nuse std::{collections::BTreeMap, sync::Arc};\\nuse uuid::Uuid;\\n\\n#[derive(Clone, PartialEq, Eq)]\\npub struct ToolScope {\\n    pub folio: Arc<str>,\\n    pub visit: Uuid,\\n}\\n#[derive(Clone)]\\npub enum ToolAction {\\n    ApplyVariant(String),\\n    HighlightSentence(Option<usize>),\\n    SelectSentence(usize),\\n    SetRhythmBand { min: f64, max: f64 },\\n    Reask(String),\\n    Research { request: Uuid, claim: String },\\n    Jot { request: Uuid, question: String },\\n}\\n#[derive(Clone)]\\npub struct ToolEvent {\\n    pub scope: ToolScope,\\n    pub tool: Uuid,\\n    pub action: ToolAction,\\n}\\n\\npub struct ToolView {\\n    scope: ToolScope,\\n    model: ToolModel,\\n    working: Entity<TextareaState>,\\n    adding: Entity<InputState>,\\n    angle: Entity<InputState>,\\n    minimum: Entity<InputState>,\\n    maximum: Entity<InputState>,\\n    subscriptions: Vec<Subscription>,\\n    bars: BTreeMap<String, BarFocus>,\\n}\\nstruct BarFocus {\\n    handle: FocusHandle,\\n    _subscriptions: [Subscription; 2],\\n}\\nimpl EventEmitter<ToolEvent> for ToolView {}\\n\\nimpl ToolView {\\n    pub fn new(\\n        scope: ToolScope,\\n        snapshot: ToolSnapshot,\\n        window: &mut Window,\\n        cx: &mut Context<Self>,\\n    ) -> Self {\\n        let model = ToolModel::new(snapshot);\\n        let working = cx.new(|cx| {\\n            TextareaState::new(window, cx)\\n                .rows(3)\\n                .submit_on_enter(false)\\n                .default_value(model.working.clone())\\n        });\\n        let adding =\\n            cx.new(|cx| InputState::new(window, cx).placeholder(\\\"Another kind of support…\\\"));\\n        let angle = cx.new(|cx| {\\n            InputState::new(window, cx)\\n                .placeholder(\\\"the piece's intended reader\\\")\\n                .default_value(model.angle.clone())\\n        });\\n        let minimum = cx.new(|cx| {\\n            InputState::new(window, cx)\\n                .default_value(number_text(&model.snapshot.props()[\\\"targetMin\\\"]))\\n        });\\n        let maximum = cx.new(|cx| {\\n            InputState::new(window, cx)\\n                .default_value(number_text(&model.snapshot.props()[\\\"targetMax\\\"]))\\n        });\\n        let mut view = Self {\\n            scope,\\n            model,\\n            working,\\n            adding,\\n            angle,\\n            minimum,\\n            maximum,\\n            subscriptions: Vec::new(),\\n            bars: BTreeMap::new(),\\n        };\\n        view.subscriptions.push(cx.subscribe(\\n            &view.working,\\n            |view, input, event: &InputEvent, cx| {\\n                if matches!(event, InputEvent::Change) && view.model.writable() {\\n                    view.model.working = input.read(cx).value().to_string();\\n                    cx.notify();\\n                }\\n                if matches!(event, InputEvent::Focus | InputEvent::Blur) {\\n                    cx.notify();\\n                }\\n            },\\n        ));\\n        view.subscriptions.push(cx.subscribe_in(\\n            &view.adding,\\n            window,\\n            |view, input, event: &InputEvent, window, cx| {\\n                if matches!(event, InputEvent::PressEnter { .. })\\n                    && view.model.add_support(input.read(cx).value().as_ref())\\n                {\\n                    input.update(cx, |input, cx| input.set_value(\\\"\\\", window, cx));\\n                    cx.notify();\\n                }\\n            },\\n        ));\\n        view.subscriptions.push(cx.subscribe(\\n            &view.angle,\\n            |view, input, event: &InputEvent, cx| {\\n                if !view.model.writable() {\\n                    return;\\n                }\\n                if matches!(event, InputEvent::Change) {\\n                    view.model.angle = input.read(cx).value().to_string();\\n                    cx.notify();\\n                }\\n                if matches!(event, InputEvent::PressEnter { .. }) {\\n                    view.emit(ToolAction::Reask(input.read(cx).value().to_string()), cx);\\n                }\\n            },\\n        ));\\n        for (input, is_min) in [(view.minimum.clone(), true), (view.maximum.clone(), false)] {\\n            view.subscriptions.push(cx.subscribe(\\n                &input,\\n                move |view, input, event: &InputEvent, cx| {\\n                    if !matches!(event, InputEvent::Change | InputEvent::Blur)\\n                        || view.model.snapshot.component() != \\\"RhythmStrip\\\"\\n                    {\\n                        return;\\n                    }\\n                    let Ok(mut value) = input.read(cx).value().parse::<f64>() else {\\n                        return;\\n                    };\\n                    if !value.is_finite() {\\n                        return;\\n                    }\\n                    let props = view.model.snapshot.props();\\n                    let min = props[\\\"targetMin\\\"].as_f64().unwrap();\\n                    let max = props[\\\"targetMax\\\"].as_f64().unwrap();\\n                    if matches!(event, InputEvent::Blur) {\\n                        value = if is_min {\\n                            value.max(1.0).min(max - 1.0).round()\\n                        } else {\\n                            value.max(min + 1.0).min(120.0).round()\\n                        };\\n                    }\\n                    if value != if is_min { min } else { max } {\\n                        view.emit(\\n                            ToolAction::SetRhythmBand {\\n                                min: if is_min { value } else { min },\\n                                max: if is_min { max } else { value },\\n                            },\\n                            cx,\\n                        );\\n                    }\\n                },\\n            ));\\n        }\\n        view.sync_bar_focus(window, cx);\\n        view\\n    }\\n    pub fn scope(&self) -> &ToolScope {\\n        &self.scope\\n    }\\n    pub fn snapshot(&self) -> &ToolSnapshot {\\n        &self.model.snapshot\\n    }\\n    pub fn update(\\n        &mut self,\\n        snapshot: ToolSnapshot,\\n        window: &mut Window,\\n        cx: &mut Context<Self>,\\n    ) -> bool {\\n        if !self.model.update(snapshot) {\\n            return false;\\n        }\\n        if self.model.snapshot.component() == \\\"RhythmStrip\\\" {\\n            for (input, key) in [(&self.minimum, \\\"targetMin\\\"), (&self.maximum, \\\"targetMax\\\")] {\\n                let value = number_text(&self.model.snapshot.props()[key]);\\n                if input.read(cx).value().as_ref() != value {\\n                    input.update(cx, |input, cx| input.set_value(value, window, cx));\\n                }\\n            }\\n        }\\n        self.sync_bar_focus(window, cx);\\n        cx.notify();\\n        true\\n    }\\n    fn sync_bar_focus(&mut self, window: &mut Window, cx: &mut Context<Self>) {\\n        if self.model.snapshot.component() != \\\"RhythmStrip\\\" {\\n            self.bars.clear();\\n            return;\\n        }\\n        let keys: Vec<String> = self.model.snapshot.props()[\\\"sentences\\\"]\\n            .as_array()\\n            .unwrap()\\n            .iter()\\n            .enumerate()\\n            .map(|(i, s)| format!(\\\"{i}-{}\\\", number_text(&s[\\\"words\\\"])))\\n            .collect();\\n        self.bars.retain(|key, _| keys.contains(key));\\n        for (index, key) in keys.into_iter().enumerate() {\\n            if self.bars.contains_key(&key) {\\n                continue;\\n            }\\n            let handle = cx.focus_handle();\\n            let focus = cx.on_focus_in(&handle, window, move |view, _, cx| {\\n                view.emit(ToolAction::HighlightSentence(Some(index)), cx)\\n            });\\n            let blur = cx.on_focus_out(&handle, window, |view, _, _, cx| {\\n                view.emit(ToolAction::HighlightSentence(None), cx)\\n            });\\n            self.bars.insert(\\n                key,\\n                BarFocus {\\n                    handle,\\n                    _subscriptions: [focus, blur],\\n                },\\n            );\\n        }\\n    }\\n    pub fn retire(&mut self, cx: &mut Context<Self>) {\\n        self.emit(ToolAction::HighlightSentence(None), cx);\\n        self.model.retire();\\n        self.bars.clear();\\n        cx.notify();\\n    }\\n    pub fn finish_research(\\n        &mut self,\\n        request: Uuid,\\n        result: Result<(), String>,\\n        cx: &mut Context<Self>,\\n    ) -> bool {\\n        let accepted = self.model.finish_research(request, result);\\n        if accepted {\\n            cx.notify();\\n        }\\n        accepted\\n    }\\n    pub fn finish_jot(&mut self, request: Uuid, saved: bool, cx: &mut Context<Self>) -> bool {\\n        let accepted = self.model.finish_jot(request, saved);\\n        if accepted {\\n            cx.notify();\\n        }\\n        accepted\\n    }\\n    fn emit(&self, action: ToolAction, cx: &mut Context<Self>) {\\n        if self.model.writable() {\\n            cx.emit(ToolEvent {\\n                scope: self.scope.clone(),\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c6f-d724-7b02-bb99-7845fa255153","create_time":1791210093.28889}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
