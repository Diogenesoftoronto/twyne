               }))\\n                            .max_w(px(864.\\n                                * if self.proof_mode {\\n                                    f32::from(self.proof_zoom) / 100.\\n                                } else {\\n                                    1.\\n                                }))\\n                            .child(\\n                                img(image.clone())\\n                                    .w_full()\\n                                    .aspect_ratio((page.width_pt / page.height_pt) as f32),\\n                            )\\n                            .child(\\n                                div()\\n                                    .text_center()\\n                                    .text_size(px(11.))\\n                                    .text_color(rgb(colors.ink_light))\\n                                    .p(px(10.))\\n                                    .child(format!(\\n                                        \\\"Page {} of {}\\\",\\n                                        index + 1,\\n                                        self.proof_images.len()\\n                                    )),\\n                            )\\n                    })),\\n            )\\n    }\\n\\n    fn request_pdf(&mut self, window: &mut Window, cx: &mut Context<Self>) {\\n        if self.applying_source {\\n            return;\\n        }\\n        self.pdf_requested = true;\\n        if let Some(view) = &self.compositor {\\n            view.update(cx, |view, cx| view.set_preparing_pdf(true, cx));\\n        }\\n        self.request_proof(false, window, cx);\\n        if !self.pdf_requested\\n            && let Some(view) = &self.compositor\\n        {\\n            view.update(cx, |view, cx| view.set_preparing_pdf(false, cx));\\n        }\\n    }\\n\\n    fn export_pdf(&mut self, window: &mut Window, cx: &mut Context<Self>) {\\n        let Some(proof) = &self.proof else {\\n            return;\\n        };\\n        let proof = proof.clone();\\n        let name = format!(\\\"{}.pdf\\\", export_filename(&self.active_document().title));\\n        let picker = cx.prompt_for_new_path(self.store.root(), Some(&name));\\n        cx.spawn_in(window, async move |this, cx| {\\n\"}"},{"type":"input_text","text":"{\"i\":3,\"chunk_id\":\"f6950c\",\"wall_time_seconds\":0.000030516,\"exit_code\":0,\"original_token_count\":1446,\"output\":\"                this.show_source_line_prompt(window, cx)\\n            }))\\n            .on_action(cx.listener(|this, _: &ApplySource, window, cx| {\\n                if this.source_mode && !this.standalone_route() && !this.active_document().archived\\n                {\\n                    this.request_proof(true, window, cx);\\n                }\\n            }))\\n            .on_action(cx.listener(|this, _: &Quit, window, cx| {\\n                if this.flush_apparatus(window, cx).is_ok()\\n                    && this.flush_rubric(window, cx).is_ok()\\n                    && this.flush_cast(window, cx).is_ok()\\n                    && this.flush_marginalia(window, cx).is_ok()\\n                    && this.flush_on_shutdown(cx).is_ok()\\n                {\\n                    cx.quit();\\n                }\\n            }))\\n            .when_some(\\n                self.error\\n                    .clone()\\n                    .or(self.proof_error.clone())\\n                    .or(self.cast.boundary_error.clone())\\n                    .or(self.rubric.boundary_error.clone())\\n                    .or(self.apparatus.boundary_error.clone())\\n                    .or(self.flow.error.clone())\\n                    .or(self.notice.clone()),\\n                |this, message| {\\n                    this.child(\\n                        div()\\n                            .flex()\\n                            .items_start()\\n                            .justify_between()\\n                            .gap_3()\\n                            .px_5()\\n                            .py_2()\\n                            .flex_shrink_0()\\n                            .border_b_1()\\n                            .border_color(rgb(palette(cx).rule))\\n                            .bg(rgb(palette(cx).sidebar))\\n                            .child(\\n                                div()\\n                                    .flex_1()\\n                                    .min_w_0()\\n                                    .text_size(px(13.))\\n                                    .text_color(rgb(\\n                                        if self.error.is_some()\\n                                            || self.proof_error.is_some()\\n                                            || self.cast.boundary_error.is_some()\\n                                            || self.rubric.boundary_error.is_some()\\n                                            || self.apparatus.boundary_error.is_some()\\n                                        {\\n                                            palette(cx).vermilion\\n                                        } else {\\n                                            palette(cx).ink_muted\\n                                        },\\n                                    ))\\n                                    .child(message),\\n                            )\\n                            .child(\\n                                Button::new(\\\"dismiss-message\\\")\\n                                    .ghost()\\n                                    .small()\\n                                    .label(if self.error.is_some() {\\n                                        \\\"Retry save\\\"\\n                                    } else if self.proof_error.is_some() {\\n                                        \\\"Retry typesetting\\\"\\n                                    } else if self.cast.boundary_error.is_some() {\\n                                        \\\"Retry Cast save\\\"\\n                                    } else if self.rubric.boundary_error.is_some() {\\n                                        \\\"Retry Rubric save\\\"\\n                                    } else if self.apparatus.boundary_error.is_some() {\\n                                        \\\"Retry Apparatus save\\\"\\n                                    } else if self.flow.error.is_some() {\\n                                        \\\"Retry rhythm save\\\"\\n                                    } else {\\n                                        \\\"Dismiss\\\"\\n                                    })\\n                                    .on_click(cx.listener(|this, _, window, cx| {\\n                                        if this.error.is_some() {\\n                                            let _ = this.flush(cx);\\n                                        } else if this.proof_error.is_some() {\\n                                            this.request_proof(false, window, cx);\\n                                        } else if this.cast.boundary_error.is_some() {\\n                                            let _ = this.flush_cast(window, cx);\\n                                        } else if this.rubric.boundary_error.is_some() {\\n                                            let _ = this.flush_rubric(window, cx);\\n                                        } else if this.apparatus.boundary_error.is_some() {\\n                                            let _ = this.flush_apparatus(window, cx);\\n                                        } else if this.flow.error.is_some() {\\n                                            let _ = this.retry_flow(cx);\\n                                        } else {\\n                                            this.notice = None;\\n                                        }\\n                                        cx.notify();\\n                                    })),\\n                            ),\\n                    )\\n                },\\n            )\\n            .child(\\n                div()\\n                    .flex()\\n                    .flex_1()\\n                    .min_h_0()\\n                    .overflow_hidden()\\n                    .when(show_library, |this| {\\n                        this.child(self.flow_chrome(\\n                            flow_coordinator::RoomPart::Drawer,\\n                            self.library_panel(cx).into_any_element(),\\n                            cx,\\n\"}"},{"type":"input_text","text":"{\"i\":4,\"chunk_id\":\"07beff\",\"wall_time_seconds\":0.00003562,\"exit_code\":0,\"original_token_count\":730,\"output\":\"\\n    #[gpui_kit::test]\\n    fn document_navigation_reveals_the_native_caret_in_long_manuscripts(cx: &mut TestAppContext) {\\n        let (handle, view, store, _directory) = room(cx);\\n        let path = store.root().join(\\\"Long.html\\\");\\n        let html = (0..80)\\n            .map(|index| format!(\\\"<p>Paragraph {index}: a measured line of writing.</p>\\\"))\\n            .collect::<String>();\\n        std::fs::write(&path, html).unwrap();\\n        let document = import_file(&path).unwrap();\\n        cx.update_window(handle, |_, window, cx| {\\n            view.update(cx, |room, cx| {\\n                room.add_document(document, window, cx);\\n            });\\n            window.render_frame(cx);\\n            window.press(\\\"ctrl-end\\\", cx);\\n        })\\n        .unwrap();\\n        cx.run_until_parked();\\n        cx.update_window(handle, |_, window, cx| {\\n            let rich = view.read(cx).rich.clone().unwrap();\\n            for _ in 0..3 {\\n                window.simulate_next_frame(cx);\\n                window.render_frame(cx);\\n            }\\n            let room = view.read(cx);\\n            let viewport = room.writing_scroll.bounds();\\n            let caret = rich.read(cx).caret_bounds().unwrap();\\n            assert!(room.writing_scroll.offset().y < px(-100.));\\n            assert!(\\n                caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom(),\\n                \\\"caret {caret:?}, viewport {viewport:?}\\\"\\n            );\\n            window.input(\\\" Continued\\\", cx);\\n        })\\n        .unwrap();\\n        cx.run_until_parked();\\n        cx.update_window(handle, |_, window, cx| {\\n            let rich = view.read(cx).rich.clone().unwrap();\\n            for _ in 0..3 {\\n                window.simulate_next_frame(cx);\\n                window.render_frame(cx);\\n            }\\n            let caret = rich.read(cx).caret_bounds().unwrap();\\n            let viewport = view.read(cx).writing_scroll.bounds();\\n            assert!(caret.top() >= viewport.top() && caret.bottom() <= viewport.bottom());\\n            window.press(\\\"ctrl-home\\\", cx);\\n        })\\n        .unwrap();\\n        cx.run_until_parked();\\n        cx.update_window(handle, |_, window, cx| {\\n            let rich = view.read(cx).rich.clone().unwrap();\\n            for _ in 0..3 {\\n                window.simulate_next_frame(cx);\\n                window.render_frame(cx);\\n            }\\n            assert_eq!(view.read(cx).writing_scroll.offset().y, px(0.));\\n            assert_eq!(rich.read(cx).selection().head, 0);\\n        })\\n        .unwrap();\\n    }\\n\\n    #[gpui_kit::test]\\n    fn versions_restore_preserves_the_current_draft_and_saves_real_checkpoints(\\n        cx: &mut TestAppContext,\\n    ) {\\n        let (handle, view, store, _directory) = room(cx);\\n        let path = store.root().join(\\\"History.html\\\");\\n        std::fs::write(&path, \\\"<p>The original ending.</p>\\\").unwrap();\\n        let document = import_file(&path).unwrap();\\n        let id = document.id;\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10d17-989f-7150-9fa5-0c502f3fed47","create_time":1791222119.9008977}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
