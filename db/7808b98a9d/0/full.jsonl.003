base/mod.rs-185-}\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-186-\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-187-#[derive(Default)]\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-188-pub struct InputStyles {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-189-    focused: StyleRefinement,\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-190-    disabled: StyleRefinement,\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-191-}\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-192-\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-193-impl InputStyles {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs:194:    pub fn focused(mut self, build: impl FnOnce(StateStyle) -> StateStyle) -> Self {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-195-        self.focused\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-196-            .refine(&build(StateStyle::default()).into_refinement());\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-197-        self\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-198-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-199-\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-200-    pub fn disabled(mut self, build: impl FnOnce(StateStyle) -> StateStyle) -> Self {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-201-        self.disabled\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-202-            .refine(&build(StateStyle::default()).into_refinement());\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-203-        self\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-204-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-205-}\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-206-\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-207-impl Styled for InputBase {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-208-    fn style(&mut self) -> &mut StyleRefinement {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-209-        &mut self.style\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-210-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-211-}\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-212-\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-213-impl ParentElement for InputBase {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-214-    fn extend(&mut self, elements: impl IntoIterator<Item = AnyElement>) {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-215-        self.children.extend(elements);\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-216-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-217-}\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-218-\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-219-impl InteractiveElement for InputBase {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-220-    fn track_focus(mut self, focus: &gpui::FocusHandle) -> Self {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-221-        self.base = self.base.track_focus(focus);\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-222-        self\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-223-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-224-\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-225-    fn interactivity(&mut self) -> &mut Interactivity {\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-226-        self.base.interactivity()\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-227-    }\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-228-}\\ndesktop/gpui/vendor/gpui-base/src/input/base/mod.rs-229-\\n\"}}"},{"type":"input_text","text":"{\"i\":3,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"7f1186\",\"wall_time_seconds\":0.000014251,\"exit_code\":0,\"original_token_count\":1053,\"output\":\"    }\\n\\n    fn resolved_style(&self) -> StyleRefinement {\\n        crate::state_style::resolve_style(\\n            &self.style,\\n            [\\n                match self.state {\\n                    CheckboxState::Unchecked => None,\\n                    CheckboxState::Checked => Some(&self.semantic_styles.checked),\\n                    CheckboxState::Indeterminate => Some(&self.semantic_styles.indeterminate),\\n                },\\n                self.disabled.then_some(&self.semantic_styles.disabled),\\n            ]\\n            .into_iter()\\n            .flatten(),\\n        )\\n    }\\n}\\n\\nimpl Default for CheckboxIndicator {\\n    fn default() -> Self {\\n        Self::new()\\n    }\\n}\\n\\nimpl Styled for CheckboxIndicator {\\n    fn style(&mut self) -> &mut StyleRefinement {\\n        &mut self.style\\n    }\\n}\\n\\nimpl ParentElement for CheckboxIndicator {\\n    fn extend(&mut self, elements: impl IntoIterator<Item = AnyElement>) {\\n        self.children.extend(elements);\\n    }\\n}\\n\\nimpl RenderOnce for CheckboxIndicator {\\n    fn render(self, _: &mut Window, _: &mut App) -> impl IntoElement {\\n        let style = self.resolved_style();\\n        self.base.children(self.children).refine_style(&style)\\n    }\\n}\\n\\nimpl Styled for Checkbox {\\n    fn style(&mut self) -> &mut StyleRefinement {\\n        &mut self.style\\n    }\\n}\\n\\nimpl ParentElement for Checkbox {\\n    fn extend(&mut self, elements: impl IntoIterator<Item = AnyElement>) {\\n        self.children.extend(elements);\\n    }\\n}\\n\\nimpl InteractiveElement for Checkbox {\\n    fn interactivity(&mut self) -> &mut Interactivity {\\n        self.base.interactivity()\\n    }\\n}\\n\\nimpl StatefulInteractiveElement for Checkbox {}\\n\\nimpl RenderOnce for Checkbox {\\n    fn render(self, window: &mut Window, cx: &mut App) -> impl IntoElement {\\n        let focus_handle = self.focus_handle(window, cx);\\n        let disabled = self.disabled;\\n        let next_state = self.state.activated();\\n        let style = self.resolved_style();\\n        let on_change = self.on_change;\\n\\n        self.base\\n            .test_support()\\n            .when_some(self.role.resolve(|| Role::CheckBox), |this, role| {\\n                this.role(role)\\n            })\\n            .aria_toggled(self.state.toggled())\\n            .when_some(self.accessibility_label, |this, label| {\\n                this.aria_label(label)\\n            })\\n            .when(!disabled, |this| {\\n                this.track_focus(\\n                    &focus_handle\\n                        .tab_index(self.tab_index)\\n                        .tab_stop(self.tab_stop),\\n                )\\n            })\\n            .when_some(\\n                (!disabled).then_some(on_change).flatten(),\\n                |this, on_change| {\\n                    this.on_click(move |event, window, cx| {\\n                        on_change(next_state, event, window, cx);\\n                    })\\n                },\\n            )\\n            .children(self.children)\\n            .refine_style(&style)\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n    use std::{\\n        cell::{Cell, RefCell},\\n        rc::Rc,\\n        sync::{Arc, Mutex},\\n    };\\n\\n    use gpui::{\\n        Context, Element as _, KeyDownEvent, KeyUpEvent, Keystroke, Modifiers, Render,\\n        TestAppContext, VisualTestContext, accesskit, canvas, point, px,\\n    };\\n\\n    #[test]\\n    fn indicator_projects_state_styles_over_the_instance_layer() {\\n        let checked_color = gpui::hsla(0.6, 0.7, 0.5, 1.0);\\n        let disabled_color = gpui::hsla(0.1, 0.2, 0.3, 0.5);\\n\\n        let indicator = |state, disabled| {\\n            CheckboxIndicator::new()\\n                .state(state)\\n                .disabled(disabled)\\n                .styles(|styles| {\\n                    styles\\n                        .checked(|style| style.border_color(checked_color))\\n                        .indeterminate(|style| style.opacity(0.7))\\n                        .disabled(|style| style.border_color(disabled_color))\\n                })\\n        };\\n\\n        assert_eq!(\\n            indicator(CheckboxState::Checked, false)\\n                .resolved_style()\\n                .border_color,\\n            Some(checked_color)\\n        );\\n        assert_eq!(\\n            indicator(CheckboxState::Checked, true)\\n                .resolved_style()\\n\"}}"},{"type":"input_text","text":"{\"i\":4,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"432c22\",\"wall_time_seconds\":0.000017955,\"exit_code\":0,\"original_token_count\":468,\"output\":\"        );\\n        let state = Rc::new(RefCell::new(WrappedTrackedLayout::new(\\n            self.label.clone(),\\n            shape,\\n            self.tracking,\\n            self.line_height,\\n            self.policy,\\n        )));\\n        let measure_state = state.clone();\\n        let id = window.request_measured_layout(Style::default(), move |known, available, _, _| {\\n            let width = known.width.or(match available.width {\\n                AvailableSpace::Definite(width) => Some(width),\\n                AvailableSpace::MinContent => Some(px(0.)),\\n                AvailableSpace::MaxContent => None,\\n            });\\n            measure_state.borrow_mut().measure(width)\\n        });\\n        let _ = cx;\\n        (id, state)\\n    }\\n    fn prepaint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        bounds: Bounds<Pixels>,\\n        state: &mut Self::RequestLayoutState,\\n        _: &mut Window,\\n        _: &mut App,\\n    ) {\\n        state.borrow_mut().measure(Some(bounds.size.width));\\n    }\\n    fn paint(\\n        &mut self,\\n        _: Option<&GlobalElementId>,\\n        _: Option<&InspectorElementId>,\\n        bounds: Bounds<Pixels>,\\n        state: &mut Self::RequestLayoutState,\\n        _: &mut (),\\n        window: &mut Window,\\n        cx: &mut App,\\n    ) {\\n        let state = state.borrow();\\n        for (index, position) in &state.placements {\\n            let _ = state.glyphs[*index].shape.paint(\\n                bounds.origin + *position,\\n                px(self.line_height),\\n                TextAlign::Left,\\n                None,\\n                window,\\n                cx,\\n            );\\n        }\\n    }\\n}\\n\\nstruct TrackedRun {\\n    label: SharedString,\\n    size: f32,\\n    tracking: f32,\\n    color: u32,\\n    face: Font,\\n    line_height: f32,\\n}\\nstruct TrackedRunLayout {\\n    parts: Vec<(ShapedLine, Pixels)>,\\n}\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10c3a-4441-7890-a25b-a9acd621d3aa","create_time":1791206640.3556442}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
