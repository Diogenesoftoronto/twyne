 [ctypes.c_void_p, ctypes.c_int]\nx.XCloseDisplay.argtypes = [ctypes.c_void_p]\ndisplay = x.XOpenDisplay(pointer['display'].encode())\nassert display, 'Cannot connect to your desktop display'\ntry:\n    atom = x.XInternAtom(display, b'_NET_WM_PID', 0)\n    actual_type = ctypes.c_ulong()\n    actual_format = ctypes.c_int()\n    count = ctypes.c_ulong()\n    remaining = ctypes.c_ulong()\n    data = ctypes.POINTER(ctypes.c_ubyte)()\n    result = x.XGetWindowProperty(display, window, atom, 0, 1, 0, 0, ctypes.byref(actual_type), ctypes.byref(actual_format), ctypes.byref(count), ctypes.byref(remaining), ctypes.byref(data))\n    assert result == 0 and actual_format.value == 32 and count.value == 1 and data, 'Preview window identity is unavailable'\n    try:\n        observed_pid = ctypes.cast(data, ctypes.POINTER(ctypes.c_ulong))[0]\n    finally:\n        x.XFree(data)\n    assert observed_pid == pid, 'Window belongs to a different process'\n    x.XMapRaised(display, window)\n    x.XSetInputFocus(display, window, 2, 0)\n    x.XSync(display, 0)\n    focused = ctypes.c_ulong()\n    revert = ctypes.c_int()\n    x.XGetInputFocus(display, ctypes.byref(focused), ctypes.byref(revert))\n    assert focused.value == window, 'Desktop did not focus the Twyne window'\n    print(json.dumps({'application':'Twyne GPUI','running':True,'focused':True,'window':hex(window),'pid':pid,'existingSessionPreserved':True}))\nfinally:\n    x.XCloseDisplay(display)\nPY"],"cwd":"file:///home/diogenes/Projects/twyne","parsed_cmd":[{"type":"unknown","cmd":"rtk proxy python3 - <<'PY'\nimport ctypes\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\n\npointer_path = Path('desktop/gpui/target/verification/user-preview-pointer.json')\npointer = json.loads(pointer_path.read_text())\nexpected_binary = Path(pointer['binary']['path'])\npid = 287075\nwindow = int('0x800001', 16)\nos.kill(pid, 0)\nassert Path(f'/proc/{pid}/exe').resolve() == expected_binary.resolve(), 'Preview process identity chan