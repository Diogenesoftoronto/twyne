\\n    pub name: String,\\n    #[serde(default, skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub title: Option<String>,\\n    #[serde(default, skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub description: Option<String>,\\n    #[serde(\\n        default,\\n        rename = \\\"inputSchema\\\",\\n        skip_serializing_if = \\\"Option::is_none\\\"\\n    )]\\n    pub input_schema: Option<Value>,\\n    #[serde(flatten)]\\n    pub extra: Map<String, Value>,\\n}\\n\\n#[derive(Clone, Debug, Deserialize, Serialize)]\\npub struct ResourceListResponse {\\n    pub resources: Vec<AccountResource>,\\n    #[serde(flatten)]\\n    pub extra: Map<String, Value>,\\n}\\n\\n#[derive(Clone, Debug, Deserialize, Serialize)]\\npub struct AccountResource {\\n    pub uri: String,\\n    pub name: String,\\n    #[serde(default, skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub title: Option<String>,\\n    #[serde(default, skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub description: Option<String>,\\n    #[serde(default, rename = \\\"mimeType\\\", skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub mime_type: Option<String>,\\n    #[serde(flatten)]\\n    pub extra: Map<String, Value>,\\n}\\n\\n#[derive(Clone, Debug, Deserialize, Serialize)]\\npub struct ResourceReadResponse {\\n    #[serde(default)]\\n    pub contents: Vec<ResourceContent>,\\n    #[serde(flatten)]\\n    pub extra: Map<String, Value>,\\n}\\n\\n#[derive(Clone, Debug, Deserialize, Serialize)]\\npub struct ResourceContent {\\n    #[serde(default, skip_serializing_if = \\\"Option::is_none\\\")]\\n    pub text: Option<Value>,\\n    #[serde(flatten)]\\n    pub extra: Map<String, Value>,\\n}\\n\\n#[derive(Clone, Debug, Default, Deserialize, Serialize)]\\n#[serde(deny_unknown_fields)]\\npub struct SourcesInput {}\\n\\n#[derive(Clone, Debug, Deserialize, Serialize)]\\n#[serde(deny_unknown_fields)]\\npub struct ResourcesInput {\\n    #[serde(rename = \\\"sourceId\\\")]\\n    pub source_id: String,\\n}\\n\\n#[derive(Clone, Debug, Deserialize, Serialize)]\\n#[serde(deny_unknown_fields)]\\npub struct ReadResourceInput {\\n    #[serde(rename = \\\"sourceId\\\")]\\n    pub source_id: String,\\n    pub uri: String,\\n}\\n\\n#[derive(Clone, Debug, Deserialize, Serialize)]\\n#[serde(deny_unknown_fields)]\\npub struct CallToolInput {\\n    #[serde(rename = \\\"sourceId\\\")]\\n    pub source_id: String,\\n    pub tool: String,\\n    pub arguments: Map<String, Value>,\\n}\\n\\nfn validate_nonempty_utf16(value: &str, limit: usize, field: &str) -> Result<()> {\\n    // The Source segment() guard checks emptiness without trimming IDs.\\n    if value.is_empty() || value.encode_utf16().count() > limit {\\n        bail!(\\\"invalid {field}\\\");\\n    }\\n    Ok(())\\n}\\n\\nimpl ResourcesInput {\\n    pub fn validate(&self) -> Result<()> {\\n        validate_nonempty_utf16(&self.source_id, 256, \\\"sourceId\\\")\\n    }\\n}\\n\\nimpl ReadResourceInput {\\n    pub fn validate(&self) -> Result<()> {\\n        validate_nonempty_utf16(&self.source_id, 256, \\\"sourceId\\\")?;\\n        validate_nonempty_utf16(&self.uri, 4096, \\\"resourceURI\\\")\\n    }\\n}\\n\\nimpl CallToolInput {\\n    pub fn validate(&self) -> Result<()> {\\n        validate_nonempty_utf16(&self.source_id, 256, \\\"sourceId\\\")?;\\n        validate_nonempty_utf16(&self.tool, 256, \\\"tool\\\")?;\\n        // The helper applies the exact Source JSON.stringify(...).length\\n        // admission before dispatch. Map typing already rejects nonobjects.\\n        Ok(())\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n    use serde_json::json;\\n\\n    #[test]\\n    fn validates_js_utf16_limits() {\\n        let input = ResourcesInput {\\n            source_id: \\\"🪼\\\".repeat(128),\\n        };\\n        assert!(input.validate().is_ok());\\n        let input = ResourcesInput {\\n            source_id: \\\"🪼\\\".repeat(129),\\n        };\\n        assert!(input.validate().is_err());\\n        let input = ReadResourceInput {\\n            source_id: \\\"s\\\".into(),\\n            uri: \\\"🪼\\\".repeat(2048),\\n        };\\n        assert!(input.validate().is_ok());\\n        let input = ReadResourceInput {\\n            source_id: \\\"s\\\".into(),\\n            uri: \\\"🪼\\\".repeat(2049),\\n        };\\n        assert!(input.validate().is_err());\\n    }\\n\\n    #[test]\\n    fn validates_arguments_object_and_source_whitespace() {\\n        assert!(\\n            serde_json::from_value::<CallToolInput>(\\n                json!({\\\"sourceId\\\":\\\"s\\\",\\\"tool\\\":\\\"t\\\",\\\"arguments\\\":[]})\\n            )\\n            .is_err()\\n        );\\n        assert!(\\n            ResourcesInput {\\n                source_id: \\\" \\\\u{feff}\\\".into()\\n            }\\n            .validate()\\n            .is_ok()\\n        );\\n        assert!(\\n            ResourcesInput {\\n                source_id: \\\"\\\\u{0085}\\\".into()\\n            }\\n            .validate()\\n            .is_ok()\\n        );\\n        assert!(\\n            serde_json::from_value::<ResourcesInput>(\\n                json!({\\\"sourceId\\\":\\\"s\\\",\\\"owner\\\":\\\"another-account\\\"})\\n            )\\n            .is_err()\\n        );\\n    }\\n\\n    #[test]\\n    fn preserves_unknown_catalog_tool_and_resource_fields() {\\n        let catalog: SourceCatalogResponse = serde_json::from_value(json!({\\n            \\\"data\\\": [{\\\"id\\\":\\\"s\\\",\\\"label\\\":\\\"S\\\",\\\"resources_allowed\\\":false,\\\"futureSource\\\":1,\\n                \\\"tools\\\":[{\\\"name\\\":\\\"t\\\",\\\"inputSchema\\\":{\\\"type\\\":\\\"object\\\"},\\\"futureTool\\\":2}]}],\\n            \\\"futureCatalog\\\":3\\n        }))\\n        .unwrap();\\n        assert_eq!(catalog.extra[\\\"futureCatalog\\\"], json!(3));\\n        assert_eq!(catalog.data[0].extra[\\\"futureSource\\\"], json!(1));\\n        assert_eq!(catalog.data[0].tools[0].extra[\\\"futureTool\\\"], json!(2));\\n        let resources: ResourceListResponse = serde_json::from_value(json!({\\n            \\\"resources\\\":[{\\\"uri\\\":\\\"u\\\",\\\"name\\\":\\\"n\\\",\\\"futureResource\\\":4}],\\\"futureWrapper\\\":5\\n        }))\\n        .unwrap();\\n        assert_eq!(resources.extra[\\\"futureWrapper\\\"], json!(5));\\n        assert_eq!(resources.resources[0].extra[\\\"futureResource\\\"], json!(4));\\n    }\\n}\\n\"}}}"},{"type":"input_text","text":"{\"i\":3,\"result\":{\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"3fb0ab\",\"wall_time_seconds\":0.000026668,\"exit_code\":0,\"original_token_count\":563,\"output\":\"/** Public account identity, kept separate from the private contact address. */\\nexport interface AccountIdentity {\\n  name?: string | null;\\n  handle?: string | null;\\n  image?: string | null;\\n  email?: string | null;\\n}\\n\\nexport interface AccountProfile {\\n  displayName?: string | null;\\n  handle?: string | null;\\n  avatarUrl?: string | null;\\n}\\n\\nexport function accountName(\\n  value: string | null | undefined,\\n): string | undefined {\\n  const name = value?.trim();\\n  // Old sessions may have an email in the name field. Never expose that as\\n  // a label, tooltip, accessible name, initial, or collaborator identity.\\n  if (!name || /\\\\S+@\\\\S+/.test(name) || name.startsWith(\\\"did:\\\"))\\n    return undefined;\\n  return name;\\n}\\n\\nexport function accountAvatarUrl(\\n  value: string | null | undefined,\\n): string | undefined {\\n  const url = value?.trim();\\n  if (!url || /[\\\\\\\\\\\\s]/.test(url)) return undefined;\\n  if (url.startsWith(\\\"/\\\") && !url.startsWith(\\\"//\\\")) return url;\\n  try {\\n    const parsed = new URL(url);\\n    if (parsed.protocol !== \\\"https:\\\" || parsed.username || parsed.password)\\n      return undefined;\\n    return url;\\n  } catch {\\n    return undefined;\\n  }\\n}\\n\\nexport function accountDisplayName(\\n  user: AccountIdentity | null | undefined,\\n  profile?: AccountProfile | null,\\n): string {\\n  return (\\n    accountName(profile?.displayName) ||\\n    accountName(user?.name) ||\\n    accountName(profile?.handle) ||\\n    accountName(user?.handle) ||\\n    \\\"Writer\\\"\\n  );\\n}\\n\\nexport function accountInitials(name: string): string {\\n  const safeName = accountName(name);\\n  if (!safeName) return \\\"W\\\";\\n  const words = safeName.split(/\\\\s+/);\\n  return (\\n    Array.from(words[0])[0] +\\n    (words.length > 1 ? Array.from(words[words.length - 1])[0] : \\\"\\\")\\n  ).toLocaleUpperCase();\\n}\\n\\n/** Merge only authenticated profile fields; email stays available privately. */\\nexport function withAccountProfile<T extends AccountIdentity>(\\n  user: T,\\n  profile: AccountProfile | null,\\n): T & { name: string; image: string | undefined; handle: string | undefined } {\\n  return {\\n    ...user,\\n    name: accountDisplayName(user, profile),\\n    image: accountAvatarUrl(profile?.avatarUrl) || accountAvatarUrl(user.image),\\n    handle: accountName(profile?.handle) || accountName(user.handle),\\n  };\\n}\\n\"}}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10cf3-25ca-7a90-895c-0aef2c6d86fb","create_time":1791220619.8714027}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
