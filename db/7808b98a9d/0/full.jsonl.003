({\\n39-      invalidRequest: \\\"Twyne could not use this request.\\\",\\n40-      signedOut: \\\"Sign in to Twyne to continue.\\\",\\n41-      stale: \\\"The active account changed before this request completed.\\\",\\n42:      unavailable: \\\"Twyne could not connect. Please try again.\\\",\\n43-      unknownOutcome: \\\"The connection was lost after sending this request. Its outcome is unknown.\\\",\\n44:      syncConflict: \\\"This workspace changed on another device. Refresh it before trying again.\\\",\\n45-    }[kind]);\\n46-  }\\n47-}\\n48-const MAX_RESPONSE_BYTES = 32 * 1024 * 1024;\\n49-const COOKIE_KEY = \\\"better-auth_cookie\\\";\\n50-const identityRef = makeFunctionReference<\\\"query\\\">(\\\"native:session\\\");\\n51-function record(value: unknown): Record<string, unknown> | null {\\n52-  return value !== null && typeof value === \\\"object\\\" && !Array.isArray(value)\\n53-    ? value as Record<string, unknown> : null;\\n54-}\\n--\\n138-      const response = await this.#network(request, { redirect: \\\"error\\\", signal });\\n139-      this.#requireEpoch(epoch);\\n140-      if (response.status >= 300 && response.status < 400 ||\\n141-        response.url && new URL(response.url).origin !== expectedOrigin)\\n142:        throw new ConnectedError(\\\"unavailable\\\");\\n143-      const reader = response.body?.getReader();\\n144-      const chunks: Uint8Array[] = [];\\n145-      let length = 0;\\n146-      try {\\n147-        if (reader) for (;;) {\\n148-          const chunk = await reader.read();\\n149-          if (chunk.done) break;\\n150-          length += chunk.value.byteLength;\\n151:          if (length > MAX_RESPONSE_BYTES) throw new ConnectedError(\\\"unavailable\\\");\\n152-          chunks.push(chunk.value);\\n153-        }\\n154-      } catch (error) {\\n155-        await reader?.cancel().catch(() => {});\\n156-        throw error;\\n157-      } finally { reader?.releaseLock(); }\\n158-      this.#requireEpoch(epoch);\\n159-      const b