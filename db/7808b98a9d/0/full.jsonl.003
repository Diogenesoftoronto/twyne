holder: self.placeholder.clone(),\\n673-            mask_placeholder: self.mask_pattern.placeholder(),\\n674-        }\\n675-    }\\n676-\\n677-    /// Whether this input spans more than one line.\\n678-    ///\\n679-    /// Answered by the mode marker, which is fixed when the state is built.\\n680-    /// [`LayoutMode`] holds the row counts and growth policy, not the kind.\\n681-    #[inline]\\n682-    /// Whether this input paints scrollbars.\\n683-    ///\\n684-    /// Only a multi-line input can scroll: a single-line input keeps its\\n685-    /// caret in view by moving its own offset, and never has a viewport a\\n686-    /// user could drag. Adding the editor scrollbar to every input put a\\n--\\n724-            .go_to_definition(go_to_definition)\\n725-            .code_actions(code_actions)\\n726-    }\\n727-\\n728:    pub fn set_text_align(&mut self, text_align: TextAlign, cx: &mut Context<Self>) {\\n729:        if !self.is_single_line() || self.text_align == text_align {\\n730-            return;\\n731-        }\\n732-\\n733:        self.text_align = text_align;\\n734-        cx.notify();\\n735-    }\\n736-\\n737-    /// Flip the password mask.\\n738-    ///\\n739-    /// Setting the mask is a single-line method, but flipping it stays here:\\n740-    /// the reveal button is rendered from the generic path, and it can only be\\n741-    /// switched on through [`crate::input::InputState`] anyway.\\n742-    pub fn toggle_masked(&mut self, _: &mut Window, cx: &mut Context<Self>) {\\n743-        self.masked = !self.masked;\\n744-        cx.notify();\\n745-    }\\n746-\\n747-    pub fn on_context_menu(\\n748-        &mut self,\\n--\\n820-            selecting: false,\\n821-            touch_selection: Default::default(),\\n822-            disabled: false,\\n823-            readonly: false,\\n824:            text_align: TextAlign::Left,\\n825-            masked: false,\\n826-            clean_on_escape: false,\\n827-            submit_on_enter: false,\\n828-      