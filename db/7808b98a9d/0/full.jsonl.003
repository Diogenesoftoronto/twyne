ojects/twyne/desktop/gpui/src/gen_ui/border.rs":{"type":"add","content":"//! Paint the Source card's left border at its outer edge without changing layout.\nuse gpui_kit::{\n    AnyElement, App, Bounds, Corners, Element, ElementId, FocusHandle, GlobalElementId,\n    InspectorElementId, IntoElement, LayoutId, Pixels, Window, fill, px, rgb, size,\n};\n\npub(super) fn accent_border(child: impl IntoElement, color: u32) -> AnyElement {\n    AccentBorder { child: child.into_any_element(), color }.into_any_element()\n}\n\nstruct AccentBorder {\n    child: AnyElement,\n    color: u32,\n}\n\nimpl IntoElement for AccentBorder {\n    type Element = Self;\n    fn into_element(self) -> Self { self }\n}\n\nimpl Element for AccentBorder {\n    type RequestLayoutState = ();\n    type PrepaintState = Option<FocusHandle>;\n\n    fn id(&self) -> Option<ElementId> { None }\n    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> { None }\n\n    fn request_layout(\n        &mut self,\n        _: Option<&GlobalElementId>,\n        _: Option<&InspectorElementId>,\n        window: &mut Window,\n        cx: &mut App,\n    ) -> (LayoutId, Self::RequestLayoutState) {\n        (self.child.request_layout(window, cx), ())\n    }\n\n    fn prepaint(\n        &mut self,\n        _: Option<&GlobalElementId>,\n        _: Option<&InspectorElementId>,\n        _: Bounds<Pixels>,\n        _: &mut Self::RequestLayoutState,\n        window: &mut Window,\n        cx: &mut App,\n    ) -> Self::PrepaintState {\n        self.child.prepaint(window, cx)\n    }\n\n    fn paint(\n        &mut self,\n        _: Option<&GlobalElementId>,\n        _: Option<&InspectorElementId>,\n        bounds: Bounds<Pixels>,\n        _: &mut Self::RequestLayoutState,\n        _: &mut Self::PrepaintState,\n        window: &mut Window,\n        cx: &mut App,\n    ) {\n        self.child.paint(window, cx);\n        window.paint_quad(\n            fill(Bounds::new(bounds.origin, size(px(3.), bounds.size.height)), rgb(self.color))\n                .corner_radii(Corners {\n                    top_left: px(2.), top_right: px(0.),\n                    bottom_left: px(2.), bottom_right: px(0.),\n                }),\n        );\n    }\n}\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /home/diogenes/Projects/twyne/desktop/gpui/src/gen_ui/border.rs\nM /home/diogenes/Projects/twyne/desktop/gpui/src/gen_ui/input.rs\nM /home/diogenes/Projects/twyne/desktop/gpui/src/gen_ui/view.rs\nM /home/diogenes/Projects/twyne/desktop/gpui/src/gen_ui/card.rs\nM /home/diogenes/Projects/twyne/desktop/gpui/src/gen_ui/mod.rs\n","stderr":""},"started_at_ms":1791210154829,"completed_at_ms":1791210154833}}
