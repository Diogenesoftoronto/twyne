n+                    },\n+                    \"maximum typed 200\" => {\n+                        window.click(\"in-flow-max-input\", cx);\n+                        window.press(\"ctrl-a\", cx);\n+                        window.input(\"200\", cx);\n+                    },\n+                    \"minimum cleared and blurred\" => {\n+                        window.click(\"in-flow-min-input\", cx);\n+                        window.press(\"ctrl-a\", cx);\n+                        window.press(\"backspace\", cx);\n+                        window.click(\"in-flow-max-input\", cx);\n+                    },\n+                    action => panic!(\"Unknown Source control action: {action}\"),\n+                }\n+            }).unwrap();\n+            cx.run_until_parked();\n+            cx.update_window(handle, |_, window, cx| {\n+                window.render_frame(cx);\n+                assert_eq!(window.find(\"in-flow-min-input\").value(), frame[\"min\"].as_str(), \"{}\", frame[\"action\"]);\n+                assert_eq!(window.find(\"in-flow-max-input\").value(), frame[\"max\"].as_str(), \"{}\", frame[\"action\"]);\n+            }).unwrap();\n+        }\n+    }\n+    #[gpui_kit::test]\n     fn real_jot_and_keep_buttons_require_saved_data_and_survive_reopen(cx: &mut TestAppContext) {\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/diogenes/Projects/twyne/desktop/gpui/src/app/gen_ui_coordinator.rs\n","stderr":""},"started_at_ms":1791211015384,"completed_at_ms":1791211015386}}
