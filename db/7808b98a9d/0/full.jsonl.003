      });\n+                    }),\n             );\n@@ -663,2 +683,3 @@\n             let jot = question.clone();\n+            let owner = cx.weak_entity();\n             questions = questions.child(\n@@ -669,11 +690,15 @@\n                     .child(\n-                        Checkbox::new(SharedString::from(format!(\"in-flow-question-{index}\")))\n-                            .flex_1()\n-                            .min_w_0()\n-                            .accessibility_label(SharedString::from(question.clone()))\n-                            .checked(answered)\n-                            .disabled(!self.model.writable())\n+                        source_checkbox(\n+                            format!(\"in-flow-question-{index}\"),\n+                            question.clone(),\n+                            answered,\n+                            !self.model.writable(),\n+                            colors,\n+                        )\n                             .child(\n                                 div()\n+                                    .flex_1()\n+                                    .min_w_0()\n                                     .whitespace_normal()\n+                                    .line_height(relative(1.55))\n                                     .when(answered, |this| {\n@@ -683,12 +708,14 @@\n                             )\n-                            .on_change(cx.listener(move |view, checked: &bool, _, cx| {\n-                                if view.model.writable() {\n-                                    if *checked {\n-                                        view.model.answered.insert(answer.clone());\n-                                    } else {\n-                                        view.model.answered.remove(&answer);\n+                            .on_change(move |state, _, _, cx| {\n+                                let _ = owner.update(cx, |view, cx| {\n+                                    if view.model.writable() {\n+                                        if state == CheckboxState::Checked {\n+                                            view.model.answered.insert(answer.clone());\n+                                        } else {\n+                                            view.model.answered.remove(&answer);\n+                                        }\n+                                        cx.notify();\n                                     }\n-                                    cx.notify();\n-                                }\n-                            })),\n+                                });\n+                            }),\n                     )\n@@ -825,7 +852,49 @@\n }\n+fn source_checkbox(\n+    id: String,\n+    label: String,\n+    checked: bool,\n+    disabled: bool,\n+    colors: Palette,\n+) -> Checkbox {\n+    Checkbox::new(SharedString::from(id))\n+        .accessibility_label(SharedString::from(label))\n+        .checked(checked)\n+        .disabled(disabled)\n+        .flex()\n+        .items_start()\n+        .flex_1()\n+        .min_w_0()\n+        .gap(px(7.2))\n+        .child(\n+            div()\n+                .mt(px(2.))\n+                .size(px(13.))\n+                .flex_shrink_0()\n+                .border_1()\n+                .border_color(rgb(if checked { colors.cobalt } else { 0x767676 }))\n+                .rounded(px(2.))\n+                .bg(rgb(if checked { colors.cobalt } else { 0xffffff }))\n+                .when(checked, |this| {\n+                    this.child(\n+                        canvas(\n+                            |bounds, _, _| {\n+                                let mut check = gpui_kit::PathBuilder::stroke(px(1.6));\n+                                check.move_to(bounds.origin + point(px(2.), px(5.5)));\n+                                check.line_to(bounds.origin + point(px(4.5), px(8.)));\n+                                check.line_to(bounds.origin + point(px(9.), px(3.)));\n+                                check.build().expect(\"The fixed checkbox mark is valid\")\n+                            },\n+                            |_, check, window, _| window.paint_path(check, rgb(0xffffff)),\n+                        )\n+                        .size_full(),\n+                    )\n+                }),\n+        )\n+}\n impl Render for ToolView {\n-    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {\n+    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {\n         let colors = *theme::palette(cx);\n         let content = match self.model.snapshot.component() {\n-            \"SentenceLab\" => self.sentence_lab(colors, cx),\n+            \"SentenceLab\" => self.sentence_lab(colors, window, cx),\n             \"RhythmStrip\" => self.rhythm_strip(colors, cx),\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /home/diogenes/Projects/twyne/desktop/gpui/src/gen_ui/view.rs\n","stderr":""},"started_at_ms":1791206835057,"completed_at_ms":1791206835059}}
