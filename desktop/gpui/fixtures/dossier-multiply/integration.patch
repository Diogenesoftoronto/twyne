+    fn opaque_backdrop_and_normal_image_precede_separate_multiply_layer() {
+        let mut scene = Scene::default();
+        scene.push_layer(bounds());
+        scene.insert_primitive(Quad {
+            bounds: bounds(),
+            content_mask: ContentMask { bounds: bounds() },
