      "visibleRows": [
        {
          "sourceLine": 1,
          "rowTexts": [
            "// twyne-document:1"
          ]
        },
        {
          "sourceLine": 116,
          "rowTexts": [
            "#twyne-node(\"h1\", \"{}\")[#text(\"The notebook\")]"
          ]
        },
        {
          "sourceLine": 117,
          "rowTexts": []
        },
        {
          "sourceLine": 118,
          "rowTexts": [
            "#twyne-node(\"p\", \"{}\")[#text(\"The notebook was small enough to carry in ",
            "a coat pocket. By November, its corners had softened and the cover had ",
            "begun to remember the shape of a hand.\")]"
          ]
        },
        {
          "sourceLine": 119,
          "rowTexts": []
        },
        {
          "sourceLine": 120,
          "rowTexts": [
            "#twyne-node(\"p\", \"{}\")[#text(\"Most pages held ordinary things: the name ",
            "of a book, a sentence overheard on the train, the hours of a shop she ",
            "kept arriving at after it had closed.\")]"
          ]
        },
        {
          "sourceLine": 121,
          "rowTexts": []
        },
        {
          "sourceLine": 122,
          "rowTexts": [
            "#twyne-node(\"h2\", \"{}\")[#text(\"A note for the next draft\")]"
          ]
        },
        {
          "sourceLine": 123,
          "rowTexts": []
        },
        {
          "sourceLine": 124,
          "rowTexts": [
            "#twyne-node(\"p\", \"{}\")[#text(\"Keep the opening concrete. Let the change ",
            "in the room carry the ending.\")]"
          ]
        }
      ],
