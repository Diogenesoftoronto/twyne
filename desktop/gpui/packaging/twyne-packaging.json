      "FILE.typ",
      "FILE.html",
      "FILE.md",
      "FILE.txt",
      "FILE.twyne"
    ],
    "environment": {
      "TWYNE_GPUI_DATA_DIR": "Overrides the local library location.",
      "TWYNE_DOCUMENT_HELPER": "Overrides the packaged document helper path."
