  },
  "versions": {
    "productVersionSource": "package.json",
    "nativeCrateVersionSource": "desktop/gpui/Cargo.toml",
    "note": "The native crate and product versions may differ. The flat staged manifest records both without rewriting either; OS metadata templates still require concrete release/build versions."
  },
  "platformAssembly": {
    "status": "not-assembled",
    "macos": "Metadata template and original PNG only. Contents/MacOS helper placement, concrete versions, minimum-OS validation, ICNS creation, signing and runtime launch remain unimplemented.",
    "windows": "Uncompiled resource/manifest templates and original ICO only. Concrete versions, resource compilation, installer/association registration, signing and runtime launch remain unimplemented.",
    "linux": "Desktop/MIME/icon metadata is staged only. No system installation, dependency relocation, clean-host launch or update mechanism is performed."
  }
