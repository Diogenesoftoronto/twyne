{
  "schemaVersion": 2,
  "product": "Twyne",
  "summary": "Offline integrity contract for a flat tree of native Twyne executables, required notices and platform metadata scaffolds. Staging does not assemble/install/sign an OS application bundle.",
  "provenance": {
    "appId": "desktop/gpui/src/main.rs:525",
    "helperDiscovery": "desktop/gpui/src/semantic_bridge.rs:195",
    "mathHelper": "desktop/gpui/src/math_write.rs:678",
    "dataDirectories": "desktop/gpui/src/storage.rs:56",
    "importExtensions": "desktop/gpui/src/storage.rs:310",
    "window": "desktop/gpui/src/main.rs:511",
    "electrobunReference": "electrobun.config.ts",
    "referenceWindow": "desktop/main.ts",
    "releaseWorkflow": ".github/workflows/gpui-desktop.yml"
  },
  "identifiers": {
    "appId": "love.twyne.gpui",
    "linuxDesktopId": "love.twyne.gpui",
    "macBundleId": "love.twyne.gpui",
    "windowsAppUserModelId": "love.twyne.gpui",
    "referenceElectrobunIdentifier": "love.twyne.desktop",
    "dataDirectoryQualifier": "love",
    "dataDirectoryOrganization": "twyne",
    "dataDirectoryApplication": "twyne-gpui",
    "dataDirectoryEnvOverride": "TWYNE_GPUI_DATA_DIR",
    "helperPathEnvOverride": "TWYNE_DOCUMENT_HELPER"
  },
  "executables": [
    {
      "id": "desktop",
      "cargoBinary": "twyne-desktop",
      "targetName": "twyne-desktop",
      "required": true,
      "wired": true,
      "role": "native GPUI application",
      "windowsExtension": ".exe"
    },
    {
      "id": "document",
      "cargoBinary": "twyne-document",
      "targetName": "twyne-document",
      "required": true,
      "wired": true,
      "role": "packaged Bun document helper (source/HTML reconciliation, starter generation, MathJax export)",
      "windowsExtension": ".exe",
      "discovery": "Sibling of the desktop executable; TWYNE_DOCUMENT_HELPER overrides for development."
    },
    {
      "id": "math-write",
      "cargoBinary": "twyne-math-write",
      "targetName": "twyne-math-write",
      "required": true,
      "wired": false,
      "role": "packaged Bun KaTeX Write diagnostic helper",
      "windowsExtension": ".exe",
      "discovery": "Absolute path supplied by the caller; no PATH or sibling discovery is implemented yet.",
      "wiringNote": "Built and copied to target/release by tools/build-helper.ts and required for a complete distribution, but not yet constructed by the application; only tests and the math-write fixtures call MathWriteRenderer::with_executable."
    }
  ],
  "notices": {
    "files": [
      "README.md",
      "PORT_PLAN.md",
      "assets/NOTICE.md",
      "assets/fonts/LICENSE",
      "assets/fonts/NOTICE",
      "vendor/gpui-base/LICENSE-APACHE",
      "vendor/gpui-pre-linux/LICENSE-APACHE",
      "vendor/gpui-pre-wgpu/LICENSE-APACHE",
      "licenses/hypher-LICENSE-APACHE",
      "licenses/hypher-LICENSE-MIT"
    ],
    "globs": [
      "assets/licenses/*",
      "assets/fonts/*OFL.txt",
      "assets/fonts/*LICENSE.txt",
      "licenses/*"
    ]
  },
  "platformMetadata": {
    "linux": [
      {
        "source": "packaging/platform/linux/love.twyne.gpui.desktop",
        "target": "share/applications/love.twyne.gpui.desktop"
      },
      {
        "source": "packaging/platform/linux/love.twyne.gpui.metainfo.xml",
        "target": "share/metainfo/love.twyne.gpui.metainfo.xml"
