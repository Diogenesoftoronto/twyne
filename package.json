{
  "name": "twyne",
  "description": "Twyne — The writer's room, AI-powered editing with a room full of editors",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "version": "0.27.1",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "i18n:package": "bun run --cwd packages/gt-qwik build",
    "i18n:compile": "bun scripts/compile-i18n.ts",
    "i18n:check": "gt translate --dry-run",
    "i18n:translate": "gt translate && bun run i18n:compile",
    "build": "bun run prompts:compile && bun run i18n:prepare && TWYNE_I18N_PREPARED=1 qwik build",
    "build.client": "bun run prompts:compile && bun run i18n:prepare && vite build",
    "build.preview": "bun run prompts:compile && bun run i18n:prepare && vite build --ssr src/entry.preview.tsx",
    "build.types": "bun run prompts:check && bun run i18n:prepare && tsc --incremental --noEmit",
    "build.server": "bun run prompts:compile && bun run i18n:prepare && vite build --ssr src/entry.preview.tsx",
    "deploy": "bun run build.client && bun run build.server && bun server.js",
    "preversion": "bun run release:check",
    "postversion": "bun run release:check",
    "release:check": "bun scripts/check-release-version.ts",
    "release:version": "bun pm version",
    "release:publish": "git push --follow-tags",
    "desktop": "electrobun dev && electrobun run",
    "desktop.build": "electrobun build",
    "dev": "bun run prompts:compile && bun run i18n:prepare && concurrently --names \"CONVEX,VITE\" --prefix-colors cyan,magenta \"npx convex dev\" \"vite --mode ssr\"",
    "dev.frontend": "bun run prompts:compile && bun run i18n:prepare && vite --mode ssr --host 127.0.0.1 --port ${TWYNE_DEV_PORT:-5173} --strictPort",
    "dev.backend": "bun run prompts:compile && npx convex dev",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "bun run prompts:compile && bun run i18n:prepare && TWYNE_I18N_PREPARED=1 qwik build preview && vite preview --open",
    "start": "bun run prompts:compile && bun run i18n:prepare && vite --open --mode ssr",
    "serve": "node server.js",
    "storybook": "storybook dev --host 127.0.0.1 -p ${TWYNE_STORYBOOK_PORT:-6006} --ci",
    "storybook.build": "storybook build",
    "test": "bun run prompts:check && bun run i18n:prepare && bun test --conditions=production --preload ./tests/qwik-test-preload.ts tests src convex evals packages",
    "tools:build": "bun run --cwd packages/twyne-tools build",
    "tools:check": "bun run --cwd packages/twyne-tools check",
    "tools:test": "bun --cwd packages/twyne-tools test",
    "test:e2e": "playwright test",
    "test:typing": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/editor-typing-benchmark.e2e.ts --workers=1 --retries=0 --reporter=list,html",
    "test:sync-perf": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/sync-multi-tab.e2e.ts --workers=1 --retries=0 --reporter=list,html",
    "ci": "dagger call all",
    "ci.test": "dagger call test",
    "ci.build": "dagger call build export --path ./build-output",
    "ci.package": "dagger call package export --path ./release",
    "eval": "tsx evals/run-experiment.ts",
    "eval:judge": "tsx evals/judge.ts",
    "eval:rubric": "tsx evals/run-rubric.ts",
    "eval:apparatus": "tsx evals/run-apparatus.ts",
    "eval:extract": "tsx evals/run-extract.ts",
    "eval:interview": "tsx evals/run-interview.ts",
    "eval:robustness": "tsx evals/run-robustness.ts",
    "eval:brief": "bun evals/run-brief-strength.ts",
    "eval:local": "tsx evals/run-local-model.ts",
    "eval:app": "bun evals/app/run.ts",
    "app:local": "bun evals/app/local-app.ts",
    "prompts:optimize": "python evals/optimize_prompts.py",
    "prompts:optimize:dry": "python evals/optimize_prompts.py --dry-run",
    "prompts:compile": "bun scripts/compile-prompts.ts",
    "prompts:check": "bun scripts/compile-prompts.ts --check",
    "test:mutation": "stryker run",
    "i18n:prepare": "bun scripts/prepare-i18n.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:manual": "playwright test --config playwright.manual.config.ts",
    "eval:instruments": "bun evals/instruments/run.ts",
    "eval:room-routing": "bun evals/instruments/room-routing.ts",
    "bench:instruments": "bun evals/instruments/run.ts --benchmark-only",
    "test:models": "playwright test --config playwright.models.config.ts",
    "desktop.gpui": "bun desktop/gpui/tools/build-helper.ts run",
    "desktop.gpui.build": "bun desktop/gpui/tools/build-helper.ts build",
    "desktop.gpui.build-helper": "bun desktop/gpui/tools/build-helper.ts",
    "desktop.gpui.package": "rtk proxy bun desktop/gpui/packaging/stage.ts stage",
    "desktop.gpui.package.verify": "rtk proxy bun desktop/gpui/packaging/stage.ts verify",
    "desktop.gpui.package.test": "rtk proxy bun test desktop/gpui/fixtures/distribution/stage.test.ts",
    "desktop.gpui.check": "cargo check --locked --manifest-path desktop/gpui/Cargo.toml",
    "desktop.gpui.test": "cargo test --locked --no-default-features --manifest-path desktop/gpui/Cargo.toml",
    "desktop.gpui.test-ui": "cargo test --locked --features ui-tests --manifest-path desktop/gpui/Cargo.toml"
  },
  "devDependencies": {
    "@builder.io/qwik": "npm:@qwik.dev/core@2.0.0-rc.4",
    "@builder.io/qwik-city": "npm:@qwik.dev/router@2.0.0-rc.4",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@popmelt.com/core": "0.24.2",
    "@qwik.dev/core": "2.0.0-rc.4",
    "@qwik.dev/router": "2.0.0-rc.4",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^25.9.12",
    "agent-browser": "^0.27.3",
    "concurrently": "^9.2.5",
    "convex-test": "^0.0.54",
    "electrobun": "^1.18.1",
    "entities": "^8.1.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "2.0.0-rc.4",
    "eslint-plugin-qwik-guards": "workspace:*",
    "globals": "16.4.0",
    "gt": "^2.28.5",
    "gt-qwik": "workspace:*",
    "jsdom": "26.1.0",
    "lucide-react": "^1.80.0",
    "prettier": "3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.34.5",
    "storybook": "^10.6.9",
    "storybook-framework-qwik": "^0.6.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "^5.3.1",
    "undici": "^6.29.1",
    "vite": "8.2.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@builder.io/qwik": "npm:@qwik.dev/core@2.0.0-rc.4",
    "@builder.io/qwik-city": "npm:@qwik.dev/router@2.0.0-rc.4",
    "undici": "^6.29.1",
    "@codemirror/view": "6.44.0",
    "prosemirror-model": "1.25.13",
    "prosemirror-transform": "1.12.7",
    "prosemirror-view": "1.44.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.144",
    "@ai-sdk/google": "^3.0.151",
    "@ai-sdk/openai": "^3.0.146",
    "@arizeai/openinference-vercel": "^2",
    "@atproto/api": "^0.20.44",
    "@atproto/oauth-client-browser": "^0.4.9",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.44.0",
    "@convex-dev/better-auth": "^0.12.7",
    "@huggingface/tokenizers": "0.1.3",
    "@huggingface/transformers": "^4.3.2",
    "@json-render/core": "^0.21.4",
    "@lezer/highlight": "^1.2.5",
    "@lix-js/plugin-json": "file:packages/lix-plugin-json",
    "@lix-js/sdk": "0.4.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-subscript": "3.35.0",
    "@tiptap/extension-superscript": "3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-table-cell": "^3.35.0",
    "@tiptap/extension-table-header": "^3.35.0",
    "@tiptap/extension-table-row": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "3.35.0",
    "@tiptap/extension-typography": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/marked": "^6.0.0",
    "ai": "^6.0.337",
    "audio-decode": "^3.12.0",
    "better-auth": "~1.6.35",
    "convex": "^1.51.0",
    "docx": "^9.16.0",
    "fflate": "0.8.3",
    "harper.js": "^2.13.0",
    "ipaddr.js": "^2.5.0",
    "katex": "^0.18.10",
    "mammoth": "^1.13.0",
    "marked": "^18.3.0",
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.17.2",
    "onnxruntime-web": "1.23.2",
    "posthog-js": "^1.455.2",
    "reicon": "1.2.1",
    "resend": "^6.40.0",
    "wav-encoder": "^1.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "packages/gt-qwik",
    "packages/eslint-plugin-qwik-guards"
  ]
}
