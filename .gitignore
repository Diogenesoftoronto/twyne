# Build
/dist
packages/*/dist
!packages/lix-plugin-json/dist/
!packages/lix-plugin-json/dist/**
/lib
/lib-types
/release
/server

# Storybook build output
/storybook-static

# Electrobun desktop build output
/build
/artifacts

# Scratch / agent state
/tmp
.agents/

# Development
node_modules
.env
.envrc
*.local
.direnv/

# Cache
.cache
.mf
.rollup.cache
tsconfig.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Browser test artifacts
/playwright-report/
/test-results/

# Agent / AI tool configs (per-developer)
.claude/
.codex/
.cursor/
.factory/
.gemini/
.opencode/
.pi/

# Editor
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets

.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Yarn
.yarn/*
!.yarn/releases

# Tool state (Entire / .zero)
.entire/
.zero/

# Dagger CI — generated SDK + exported artifacts
.dagger/sdk/
/build-output/

# generated by `npm run eval` (Arize experiment runs)
evals/runs.json
evals/scores.json
evals/rubric-scores.json
evals/apparatus-scores.json
evals/robustness-scores.json
.stryker-tmp
reports/
stryker.log

# devenv (nix dev shell) — local build cache
.devenv/
.pre-commit-config.yaml

# Local Popmelt annotations, screenshots, threads, and project memory
.popmelt/

# Local visual review captures and composition history.
.house-shots/
**/.hyperframes/
/launch-videos/renders/work-*/

